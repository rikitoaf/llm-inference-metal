# Shared settings for every script in this workspace. Scripts source this file;
# anything already set in the environment wins (e.g. `CTX=262144 ./scripts/serve-llama.sh`).

STACK_ROOT="${STACK_ROOT:-/Users/abdul.rakib/agentMania/dsh-qwen-jev}"

# --- model profile: which model both backends serve (README section 33) ---
# qwen   Splash: Unsloth Qwen3.8-27B UD-IQ3_XXS (follows the Hub's latest commit);
#        llama.cpp: GSQ-RCO IQ2_S with its MTP head. The default.
# swift  Swift 1.5 Qwen3.8-27B Uncensored (ajgazin, Dynamic-MTP UD-IQ3_XXS) on both backends. Splash pairs it
#        with the same DFlash2 drafter and never loads its MTP layer; llama.cpp uses that layer (SPEC=mtp...).
# SPLASH_MODEL, SPLASH_REVISION and MODEL below override a profile's choice.
MODEL_PROFILE="${MODEL_PROFILE:-qwen}"
_hf_hub="${HF_HUB_CACHE:-${HF_HOME:-$HOME/.cache/huggingface}/hub}"
case "$MODEL_PROFILE" in
  qwen)
    _profile_splash="unsloth/Qwen3.8-27B-GGUF:UD-IQ3_XXS"; _profile_revision=""
    _profile_gguf="/Users/abdul.rakib/models/Qwen3.8-27B-GSQ-RCO-IQ2_S-mtp.gguf"
    MODEL_LABEL="Qwen3.8 27B UD-IQ3_XXS" ;;
  swift)
    _profile_splash="ajgazin/Swift-1.5-Qwen3.8-27B-Uncensored-Dynamic-MTP-GGUF:UD-IQ3_XXS"
    _profile_revision="540448475b2a84843fa2a54fcfd9c888de8a99ca"   # the commit downloaded and verified 2026-10-08
    _profile_gguf="$_hf_hub/models--ajgazin--Swift-1.5-Qwen3.8-27B-Uncensored-Dynamic-MTP-GGUF/snapshots/$_profile_revision/Swift-1.5-Qwen3.8-27B-Uncensored-Dynamic-MTP-UD-IQ3_XXS.gguf"
    MODEL_LABEL="Swift 1.5 Qwen3.8 27B Uncensored UD-IQ3_XXS" ;;
  *) echo "error: MODEL_PROFILE must be qwen or swift (config/stack.env)" >&2; return 1 2>/dev/null || exit 1 ;;
esac

# --- model server (llama.cpp fork + /v1/decision patch) ---
LLAMA_SERVER="${LLAMA_SERVER:-$STACK_ROOT/llama/atomic-llama-cpp-turboquant/build/bin/llama-server}"
MODEL="${MODEL:-$_profile_gguf}"
MODEL_ALIAS="${MODEL_ALIAS:-qwen3.8-27b-local}"
LLAMA_HOST="${LLAMA_HOST:-127.0.0.1}"
LLAMA_PORT="${LLAMA_PORT:-8080}"
CTX="${CTX:-262144}"            # 256K is the model maximum; fits with JEV off (README section 19.3 update)
CTK="${CTK:-turbo4}"
CTV="${CTV:-turbo3}"
# JEV gates are off by default (2026-10-02): they add no speed, context or measured accuracy, and on
# llama.cpp their 8 decision sequences hold ~3.5 GiB of recurrent state. JEV=1 turns them back on.
JEV="${JEV:-0}"
if [[ "$JEV" == "1" ]]; then DECISION_SEQS="${DECISION_SEQS:-8}"; else DECISION_SEQS="${DECISION_SEQS:-0}"; fi
SPEC="${SPEC:-mtp+ngram}"        # mtp+ngram | ngram | mtp | none (MTP needs the IQ small-batch kernels, patch 0002)
MTP_DRAFT="${MTP_DRAFT:-2}"      # MTP draft depth (tokens drafted per step)

# --- which model server the harness talks to ---
# llama:  llama-server above (GSQ-RCO IQ2_S, TurboQuant KV, MTP+n-gram, JEV via /v1/decision)
# splash: Splash (Unsloth UD-IQ3_XXS + DFlash2 block drafter, JEV via /v1/systemone); scripts/serve-splash.sh
# lithos: lithos-metal (Metal megakernels + DSpark drafter, turbo-int4 KV); scripts/serve-lithos.sh, README section 34
BACKEND="${BACKEND:-splash}"   # measured faster on the agent loop: README section 31
SPLASH_MODEL="${SPLASH_MODEL:-$_profile_splash}"
# A commit to serve; empty follows the repository's default branch, which Splash re-checks at every start
# and downloads again when it moved. The swift profile pins the commit it was verified at.
SPLASH_REVISION="${SPLASH_REVISION-$_profile_revision}"
SPLASH_PORT="${SPLASH_PORT:-8000}"
# Splash built from splash/splash-src (1.2.1 + TurboQuant KV, README section 32) when present,
# else Homebrew's splash (1.1.0, INT8/BF16 KV only).
# Default engine since 2026-11-10 (user decision): the DSpine drafter build (splash/dev-dspine = production + DSpine
# behind SPLASH_DRAFTER). Real sessions: +7-14% tok/s at 40-160K context. SPLASH_ENGINE=production returns to
# splash/splash-src with DFlash2. SPLASH_SRC, when set, wins over both.
SPLASH_ENGINE="${SPLASH_ENGINE:-dspine}"
case "$SPLASH_ENGINE" in
  production) _engine_src="$STACK_ROOT/splash/splash-src" ;;
  # Park lane on by default since 2026-11-12 (A/B splash/dev-park2/dev/park-ab-2: follow-up prompt time -31..-44%,
  # turn wall -13..-21% at ~75-90K). splash/dev-park2 = dev-dspine + the park lane; SPLASH_PARK_LANE=0 turns it off
  # (that path is identical to dev-dspine).
  # 8 verify rows from 64K since 2026-11-17 (A/B ~/longctx-ab-quick: ms/cycle 118.6 -> 102.0 at 68K and
  # 131.4 -> 109.3 at 103K; tok/s +4.7% at 68K, +31% at 103K, +23.7% overall; greedy identical with it off,
  # near-ties only with it on, distribution tests p = 1.0). splash/dev-longctx = dev-park2 + this policy.
  # SPLASH_VERIFY_ROWS_LONG=16 turns it off; SPLASH_VERIFY_ROWS_LONG_FROM moves the threshold.
  # Faster prefill attention since 2026-11-18 (A/B ~/prefill-ab-quick: TTFT -8.5% at 60K, -13% at 100K, agent turns
  # -12.3% per uncached token; greedy identical with it off, near-ties only and distribution tests pass with it on).
  # splash/dev-prefill-attn = dev-longctx + the v2 kernel. SPLASH_PREFILL_ATTN_V2=0 turns it off.
  *)          _engine_src="$STACK_ROOT/splash/dev-prefill-attn"; SPLASH_DRAFTER="${SPLASH_DRAFTER:-dspine}"
              SPLASH_PREFILL_ATTN_V2="${SPLASH_PREFILL_ATTN_V2-1}"; export SPLASH_PREFILL_ATTN_V2
              SPLASH_PARK_LANE="${SPLASH_PARK_LANE-1}"
              SPLASH_VERIFY_ROWS_LONG="${SPLASH_VERIFY_ROWS_LONG-8}"
              SPLASH_VERIFY_ROWS_LONG_FROM="${SPLASH_VERIFY_ROWS_LONG_FROM-65536}"
              export SPLASH_DRAFTER SPLASH_PARK_LANE SPLASH_VERIFY_ROWS_LONG SPLASH_VERIFY_ROWS_LONG_FROM ;;
esac
SPLASH_SRC="${SPLASH_SRC:-$_engine_src}"
# Context cap (tokens, e.g. 131072 or 128K; empty = auto from free memory at start). Lower it to leave the host more
# headroom: each 1K tokens of turbo-int4 KV is 16.5 MiB, so 172K -> 128K frees ~0.7 GiB.
SPLASH_MAX_CONTEXT="${SPLASH_MAX_CONTEXT:-}"
# turbo-int4: ~192K context, prefill level with INT8, needles 9/9, judgment KL 0.007 vs INT8 (2026-10-06).
# turbo: ~213K, 2.2x slower attention. int8: ~94K. The turbo formats need the source build.
SPLASH_KV_FORMAT="${SPLASH_KV_FORMAT:-turbo-int4}"     # turbo-int4 | turbo | int8 | bf16
SPLASH_PERSISTENT_CACHE="${SPLASH_PERSISTENT_CACHE:-1}" # keep the SSD prefix cache across restarts
# Splash caps each persistent-cache namespace at SPLASH_CACHE_DISK, but every model, KV format and quantizer revision
# gets its own, and old ones were never removed (101 GB by 2026-10-15). serve-splash.sh keeps the most recently used
# ones within this total and deletes the rest (splash/tools/prune_splash_cache.py).
SPLASH_CACHE_TOTAL_DISK="${SPLASH_CACHE_TOTAL_DISK:-48G}"
# Speculation knobs (splash/SPEED_PLAN.md, SPEED_LOG.md). Empty = Splash's behaviour.
# dsh sends no temperature, so agent requests would sample at the model's 1.0. 0.6 is Qwen's recommended temperature
# for thinking mode and raises DFlash2's acceptance: 400 tokens of code, 5.23 -> 5.60 tokens per cycle with the draft
# scale below (2026-10-15 sweep). It changes the output distribution (to Qwen's recommended one). Set by the user's
# decision on 2026-10-21; empty restores Splash's 1.0.
SPLASH_DEFAULT_TEMPERATURE="${SPLASH_DEFAULT_TEMPERATURE-0.6}"
# The draft proposes at this fraction of the temperature; the output distribution stays exact (sampled requests only).
# Inert while SPLASH_DRAFT_TREE=1: the tree selector takes the draft's argmax path (sampling.metal draft_select_tree);
# it only acts on the chain (SPLASH_DRAFT_TREE=0).
SPLASH_DRAFT_TEMPERATURE_SCALE="${SPLASH_DRAFT_TEMPERATURE_SCALE-0.35}"
# Draft tree (splash/SPEED_LOG.md): each decode step verifies a 16-node best-first tree of DFlash's candidates in
# 16 rows instead of a 7-token chain (decode runs one lane). Agent-like prompts, greedy: 3.68 -> 4.46 tokens/cycle,
# 41.7 -> 51.5 tok/s (+23.5%); code at T 0.6: +23.6%. Exact sampling; greedy text can differ where two tokens nearly
# tie (the tree's recurrent and attention sums run in another order). 0 restores DFlash's chain.
SPLASH_DRAFT_TREE="${SPLASH_DRAFT_TREE-1}"
# Draft head shortlist (splash/SPEED_LOG.md, 2026-11-01): the draft's vocabulary head scores only token ids below this
# (rounded up to whole tiles) plus the added tokens (<|im_end|>, <think>, <tool_call>, ...): 98,816 of 248,320 rows.
# Greedy text identical; agent prompts +1.7%, T 0.6 cycles 86.7 -> 84.3 ms. A prompt with more than 10% of its tokens
# outside the shortlist (CJK, Cyrillic, ...) keeps the full head. Empty or 0 restores the full head.
SPLASH_DRAFT_HEAD_ROWS="${SPLASH_DRAFT_HEAD_ROWS-98304}"
# Copy extension (splash/SPEED_LOG.md, 2026-11-03; needs SPLASH_DRAFT_TREE=1): the tree's most probable depth-7 path
# is matched against the request's own history (prompt + output) and the tokens that followed the match are chained at
# depths 8-15 in place of the tree's least probable rows. Real dsh-session prompts at T 0.6: 4.97 -> 5.80 tokens/cycle
# (+16.7%), +0.3 ms/cycle. Exact sampling; greedy text can differ at near-ties. 0 restores the plain tree.
SPLASH_DRAFT_COPY="${SPLASH_DRAFT_COPY-1}"
# Thinking-off requests (dsh's compaction summary, the runaway guard's steer) keep the session's cached prefix:
# rendered with the thinking-on system prompt and a closed think block (server/frontend.py; 2026-11-10: a 92K-token
# compaction prompt was prefilled cold in 305 s without it, 0.4 s TTFT with it). 0 turns it off.
SPLASH_NO_THINK_KEEPS_PREFIX="${SPLASH_NO_THINK_KEEPS_PREFIX-1}"
# Idle: Splash drops its weights after SPLASH_IDLE_RELEASE without a request (its --idle-release; "off" keeps them),
# and scripts/idle-stop.sh stops the whole server after SPLASH_IDLE_STOP (e.g. 30m), so the GPU and its memory are
# completely free; scripts/qwen starts it again on demand (~45 s). Empty or off = never.
SPLASH_IDLE_RELEASE="${SPLASH_IDLE_RELEASE:-10m}"
SPLASH_IDLE_STOP="${SPLASH_IDLE_STOP:-off}"
# Usage logs of every Splash start (splash/tools/step_report.py reads them): serve.log, the server's console, and
# steps.jsonl, one line per prefill chunk and decode cycle (SPLASH_STEP_LOG). Empty disables both.
SPLASH_LOG_DIR="${SPLASH_LOG_DIR-$STACK_ROOT/logs/splash}"
# --- lithos-metal (README section 34) ---
# Built from lithos/lithos-src (lithos-metal + patches/0004: the turbo-int4 KV cache and GGUF weights read as llama.cpp
# stores them) in its own venv. It serves MODEL_PROFILE's GGUF (Splash's file: Unsloth UD-IQ3_XXS, or Swift's) with the
# local DSpark drafter, so nothing is downloaded; LITHOS_MODEL / LITHOS_DRAFT take any qwen35 / DSpark GGUF, a
# safetensors directory or a Hub id (e.g. mlx-community/Qwen3.8-27B-4bit; LITHOS_DRAFT=auto picks its LithosAI head).
LITHOS_SRC="${LITHOS_SRC:-$STACK_ROOT/lithos/lithos-src}"
case "$MODEL_PROFILE" in
  swift) _lithos_gguf="$_profile_gguf" ;;
  *) _lithos_gguf="$(ls "$_hf_hub"/models--unsloth--Qwen3.8-27B-GGUF/snapshots/*/Qwen3.8-27B-UD-IQ3_XXS.gguf 2>/dev/null | head -1)" ;;
esac
LITHOS_MODEL="${LITHOS_MODEL:-$_lithos_gguf}"
LITHOS_DRAFT="${LITHOS_DRAFT:-/Users/abdul.rakib/models/dspark/Qwen3.8-27B-DSpark-Q8_0.gguf}"   # auto | none | a path or Hub id
LITHOS_PORT="${LITHOS_PORT:-8001}"
# turbo-int4 for the target's K/V (16.5 KiB per token, BF16: 64 KiB) and the DSpark drafter's context cache: 170K of
# context costs 3.6 GiB of cache; with the weights ~16.4 GiB resident (README 34). bf16 only fits ~32K.
LITHOS_KV_FORMAT="${LITHOS_KV_FORMAT:-turbo-int4}"     # turbo-int4 | bf16
LITHOS_MAX_CONTEXT="${LITHOS_MAX_CONTEXT:-174080}"      # 170K; dsh gets this minus 12K (reply budget + margin)
LITHOS_PREFIX_DISK="${LITHOS_PREFIX_DISK:-32G}"         # prefix checkpoints on the SSD (0 = memory only): a 100K-token
LITHOS_PREFIX_MEMORY="${LITHOS_PREFIX_MEMORY:-1G}"      # checkpoint is ~2.4 GiB, written through to disk above this host budget
case "$BACKEND" in
  splash) MODEL_PORT="$SPLASH_PORT" ;;
  lithos) MODEL_PORT="$LITHOS_PORT" ;;
  *) MODEL_PORT="$LLAMA_PORT" ;;
esac

# --- harness (DeepSeek Harness) ---
NODE_BIN="${NODE_BIN:-/Users/abdul.rakib/.nvm/versions/node/v22.22.3/bin}"
DSH_BIN="${DSH_BIN:-$STACK_ROOT/harness/node_modules/.bin/dsh}"
DSH_HOME="${DSH_HOME:-$STACK_ROOT/dsh-home}"

# --- JEV gates (read by the dsh-plugin-jev plugin through the dsh config, and by scripts) ---
JEV_URL="${JEV_URL:-http://$LLAMA_HOST:$LLAMA_PORT/v1/decision}"
