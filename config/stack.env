# Shared settings for every script in this workspace. Scripts source this file;
# anything already set in the environment wins (e.g. `CTX=262144 ./scripts/serve-llama.sh`).

STACK_ROOT="${STACK_ROOT:-/Users/abdul.rakib/agentMania/dsh-qwen-jev}"

# --- model profile: which model both backends serve (README section 33) ---
# qwen   Splash: Unsloth Qwen3.8-27B UD-IQ3_XXS (follows the Hub's latest commit);
#        llama.cpp: GSQ-RCO IQ2_S with its MTP head. The default.
# swift  Swift 1.5 Qwen3.8-27B Uncensored (ajgazin, Dynamic-MTP UD-IQ3_XXS) on both backends. Splash pairs it
#        with the same DFlash2 drafter and never loads its MTP layer; llama.cpp uses that layer (SPEC=mtp...).
# SPLASH_MODEL, SPLASH_REVISION and MODEL below override a profile's choice.
MODEL_PROFILE="${MODEL_PROFILE:-qwen}"
_hf_hub="${HF_HUB_CACHE:-${HF_HOME:-$HOME/.cache/huggingface}/hub}"
case "$MODEL_PROFILE" in
  qwen)
    _profile_splash="unsloth/Qwen3.8-27B-GGUF:UD-IQ3_XXS"; _profile_revision=""
    _profile_gguf="/Users/abdul.rakib/models/Qwen3.8-27B-GSQ-RCO-IQ2_S-mtp.gguf"
    MODEL_LABEL="Qwen3.8 27B UD-IQ3_XXS" ;;
  swift)
    _profile_splash="ajgazin/Swift-1.5-Qwen3.8-27B-Uncensored-Dynamic-MTP-GGUF:UD-IQ3_XXS"
    _profile_revision="540448475b2a84843fa2a54fcfd9c888de8a99ca"   # the commit downloaded and verified 2026-10-08
    _profile_gguf="$_hf_hub/models--ajgazin--Swift-1.5-Qwen3.8-27B-Uncensored-Dynamic-MTP-GGUF/snapshots/$_profile_revision/Swift-1.5-Qwen3.8-27B-Uncensored-Dynamic-MTP-UD-IQ3_XXS.gguf"
    MODEL_LABEL="Swift 1.5 Qwen3.8 27B Uncensored UD-IQ3_XXS" ;;
  *) echo "error: MODEL_PROFILE must be qwen or swift (config/stack.env)" >&2; return 1 2>/dev/null || exit 1 ;;
esac

# --- model server (llama.cpp fork + /v1/decision patch) ---
LLAMA_SERVER="${LLAMA_SERVER:-$STACK_ROOT/llama/atomic-llama-cpp-turboquant/build/bin/llama-server}"
MODEL="${MODEL:-$_profile_gguf}"
MODEL_ALIAS="${MODEL_ALIAS:-qwen3.8-27b-local}"
LLAMA_HOST="${LLAMA_HOST:-127.0.0.1}"
LLAMA_PORT="${LLAMA_PORT:-8080}"
CTX="${CTX:-262144}"            # 256K is the model maximum; fits with JEV off (README section 19.3 update)
CTK="${CTK:-turbo4}"
CTV="${CTV:-turbo3}"
# JEV gates are off by default (2026-10-02): they add no speed, context or measured accuracy, and on
# llama.cpp their 8 decision sequences hold ~3.5 GiB of recurrent state. JEV=1 turns them back on.
JEV="${JEV:-0}"
if [[ "$JEV" == "1" ]]; then DECISION_SEQS="${DECISION_SEQS:-8}"; else DECISION_SEQS="${DECISION_SEQS:-0}"; fi
SPEC="${SPEC:-mtp+ngram}"        # mtp+ngram | ngram | mtp | none (MTP needs the IQ small-batch kernels, patch 0002)
MTP_DRAFT="${MTP_DRAFT:-2}"      # MTP draft depth (tokens drafted per step)

# --- which model server the harness talks to ---
# llama:  llama-server above (GSQ-RCO IQ2_S, TurboQuant KV, MTP+n-gram, JEV via /v1/decision)
# splash: Splash (Unsloth UD-IQ3_XXS + DFlash2 block drafter, JEV via /v1/systemone); scripts/serve-splash.sh
BACKEND="${BACKEND:-splash}"   # measured faster on the agent loop: README section 31
SPLASH_MODEL="${SPLASH_MODEL:-$_profile_splash}"
# A commit to serve; empty follows the repository's default branch, which Splash re-checks at every start
# and downloads again when it moved. The swift profile pins the commit it was verified at.
SPLASH_REVISION="${SPLASH_REVISION-$_profile_revision}"
SPLASH_PORT="${SPLASH_PORT:-8000}"
# Splash built from splash/splash-src (1.2.1 + TurboQuant KV, README section 32) when present,
# else Homebrew's splash (1.1.0, INT8/BF16 KV only).
SPLASH_SRC="${SPLASH_SRC:-$STACK_ROOT/splash/splash-src}"
# turbo-int4: ~192K context, prefill level with INT8, needles 9/9, judgment KL 0.007 vs INT8 (2026-10-06).
# turbo: ~213K, 2.2x slower attention. int8: ~94K. The turbo formats need the source build.
SPLASH_KV_FORMAT="${SPLASH_KV_FORMAT:-turbo-int4}"     # turbo-int4 | turbo | int8 | bf16
SPLASH_PERSISTENT_CACHE="${SPLASH_PERSISTENT_CACHE:-1}" # keep the SSD prefix cache across restarts
if [[ "$BACKEND" == "splash" ]]; then MODEL_PORT="$SPLASH_PORT"; else MODEL_PORT="$LLAMA_PORT"; fi

# --- harness (DeepSeek Harness) ---
NODE_BIN="${NODE_BIN:-/Users/abdul.rakib/.nvm/versions/node/v22.22.3/bin}"
DSH_BIN="${DSH_BIN:-$STACK_ROOT/harness/node_modules/.bin/dsh}"
DSH_HOME="${DSH_HOME:-$STACK_ROOT/dsh-home}"

# --- JEV gates (read by the dsh-plugin-jev plugin through the dsh config, and by scripts) ---
JEV_URL="${JEV_URL:-http://$LLAMA_HOST:$LLAMA_PORT/v1/decision}"
