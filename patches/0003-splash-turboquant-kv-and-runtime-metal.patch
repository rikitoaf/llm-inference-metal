+// After draft_select_tree, one threadgroup per tree lane (SPLASH_DRAFT_COPY=1): extends the tree past DFlash's depth
+// with tokens copied from the lane's history. The tip is the tree's most probable node at depth
+// SPLASH_DRAFT_PROPOSAL_TOKENS, the first at that depth in row order. The eight tokens on its path (the anchor, then
+// its proposals) are matched against the history from their end, n = 8 down to params.min_match tokens, at the
+// latest occurrence of the longest match, and the tokens that followed it (from the history, then from the path
+// itself) are the copy. The k-th copy token's probability is the tip's, as draft_select_tree scores it, times the
+// first k factors of params.log_accept for the match length. The copy takes the tree's last rows, which hold its
+// least probable nodes, for as long as it is the more probable, so the tree stays the best-first choice over both:
+// copy row k + 1 chains below the tip at depth 8 + k, with its token, tree entry and RoPE position written as
+// draft_select_tree writes its own, and its row draws with an extension uniform (TargetSamplingParams::tree_mask).
+// The tree depends only on the draft and the history, never on the cycle's uniforms, so acceptance stays exact.
+kernel void draft_copy_extend(
+    device const uint *candidates [[buffer(0)]],
+    device const float *unary [[buffer(1)]],
+    device const float *partial_values [[buffer(2)]],
+    device uint *tokens [[buffer(3)]],
+    device SplashDraftTree *trees [[buffer(4)]],
+    device uint *positions [[buffer(5)]],
+    device const uint *history [[buffer(6)]],
+    device SplashDraftCopyOutcome *outcomes [[buffer(7)]],
+    constant SplashDraftCopyParams &params [[buffer(8)]],
+    uint batch [[threadgroup_position_in_grid]],
+    uint thread_index [[thread_index_in_threadgroup]],
+    uint threads [[threads_per_threadgroup]],
+    uint lane [[thread_index_in_simdgroup]],
+    uint simd_group [[simdgroup_index_in_threadgroup]]) {
+  constexpr uint Rows = SPLASH_TARGET_VERIFY_ROWS;
+  constexpr uint Positions = SPLASH_DRAFT_PROPOSAL_TOKENS;
+  constexpr uint Shards = SPLASH_DRAFT_SAMPLING_SHARDS;
+  constexpr uint Candidates = SPLASH_DRAFT_CANDIDATES;
+  constexpr uint Match = SPLASH_DRAFT_COPY_MATCH;
+  constexpr uint CopyRows = SPLASH_DRAFT_COPY_ROWS;
+  threadgroup uint query[Match];
+  threadgroup uint tip_row;
+  threadgroup uint best[32];
+  if (batch >= params.lanes)
+    return;
+  device SplashDraftTree &tree = trees[batch];
+  candidates += batch * Positions * Candidates;
+  unary += batch * Positions * Candidates;
+  device const float *tables = partial_values +
+                               params.lanes * Positions * Shards * Candidates +
+                               batch * Positions * Candidates * Candidates;
+  tokens += batch * (Rows - 1);
+  positions += batch * Rows * 3;
+  history += ulong(batch) * params.history_stride;
+  const uint length = params.history_tokens[batch];
+
+  // Each row's log-probability as draft_select_tree chose it: its parent's plus its candidate's log-softmax among
+  // the parent's children. Only thread 0 holds them.
+  float log_probability[Rows];
+  if (thread_index == 0) {
+    const auto score = [&](uint position, uint from, uint j) {
+      return unary[position * Candidates + j] +
+             tables[(position * Candidates + from) * Candidates + j];
+    };
+    uint candidate[Rows];
+    uint tip = 0;
+    candidate[0] = 0;
+    log_probability[0] = 0.0f;
+    for (uint r = 1; r < Rows; ++r) {
+      const uint position = tree.depth[r] - 1, from = candidate[tree.parent[r]];
+      uint j = 0;
+      while (j + 1 < Candidates && candidates[position * Candidates + j] != tokens[r - 1])
+        ++j;
+      float maximum = -INFINITY;
+      for (uint c = 0; c < Candidates; ++c)
+        maximum = max(maximum, score(position, from, c));
+      float sum = 0.0f;
+      for (uint c = 0; c < Candidates; ++c)
+        sum += exp(score(position, from, c) - maximum);
+      log_probability[r] = log_probability[tree.parent[r]] + score(position, from, j) - (maximum + log(sum));
+      candidate[r] = j;
+      if (!tip && tree.depth[r] == Positions)
+        tip = r;
+    }
+    tip_row = tip;
+    if (tip) {
+      uint at = tip;
+      for (uint i = Match - 1; i > 0; --i) {
+        query[i] = tokens[at - 1];
+        at = tree.parent[at];
+      }
+      query[0] = params.anchor[batch];
+    }
+  }
+  threadgroup_barrier(mem_flags::mem_threadgroup);
+  const uint tip = tip_row;
+  if (!tip || !length) {
+    if (thread_index == 0)
+      outcomes[batch] = SplashDraftCopyOutcome{0, 0, tip, 0};
+    return;
+  }
+
+  // The longest match ending at each history position whose token is the query's last, then the longest overall,
+  // the latest on ties: (match << 24) | end, end < 2^24 (SPLASH_MAXIMUM_CONTEXT_TOKENS).
+  uint found = 0;
+  for (uint i = thread_index; i < length; i += threads) {
+    if (history[i] != query[Match - 1])
+      continue;
+    uint n = 1;
+    while (n < Match && n <= i && history[i - n] == query[Match - 1 - n])
+      ++n;
+    if (n >= params.min_match)
+      found = max(found, (n << 24) | i);
+  }
+  found = simd_max(found);
+  if (lane == 0)
+    best[simd_group] = found;
+  threadgroup_barrier(mem_flags::mem_threadgroup);
+  if (thread_index != 0)
+    return;
+  for (uint group = 1; group < (threads + 31) / 32; ++group)
+    found = max(found, best[group]);
+  if (!found) {
+    outcomes[batch] = SplashDraftCopyOutcome{0, 0, tip, 0};
+    return;
+  }
+  const uint match = found >> 24, end = found & 0xffffffu;
+  uint copy[CopyRows];
+  for (uint k = 0; k < CopyRows; ++k) {
+    const uint at = end + 1 + k;
+    copy[k] = at < length ? history[at] : query[at - length];
+  }
+  // Copy row k + 1 replaces row Rows - 1 - k while it is the more probable: both sequences only fall, so the rows
+  // kept are the most probable of the two together, and the tip, more probable than any copy row, stays.
+  uint rows = 0;
+  float value = log_probability[tip];
+  while (rows < CopyRows && Rows - 1 - rows > tip) {
+    const float next = value + params.log_accept[match - 1][rows];
+    if (!(next > log_probability[Rows - 1 - rows]))
+      break;
+    value = next;
+    ++rows;
+  }
+  for (uint k = 0; k < rows; ++k) {
+    const uint r = Rows - rows + k, parent = k ? r - 1 : tip;
+    tree.parent[r] = parent;
+    tree.depth[r] = Positions + 1 + k;
+    tree.ancestors[r] = tree.ancestors[parent] | (1u << r);
+    tree.path[r] = r;
+    tokens[r - 1] = copy[k];
+    for (uint axis = 0; axis < 3; ++axis)
+      positions[r * 3 + axis] = positions[axis] + Positions + 1 + k;
+  }
+  outcomes[batch] = SplashDraftCopyOutcome{rows, match, tip, end};
+}
