+
+  // Each lane's history: random alphabet tokens, then the tip path's last n tokens and a continuation, then more.
+  const auto *before = static_cast<const SplashDraftTree *>(trees.contents());
+  const auto *proposed = static_cast<const uint32_t *>(tokens.contents());
+  auto *histories = static_cast<uint32_t *>(history.contents());
+  for (uint32_t lane = 0; lane < lanes; ++lane) {
+    const uint32_t length = lane == 1 && !deep ? 0 : 200 + random.next() % 3000;
+    params.history_tokens[lane] = length;
+    uint32_t *lane_history = histories + uint64_t{lane} * stride;
+    for (uint32_t i = 0; i < length; ++i)
+      lane_history[i] = 3 + random.next() % 80;
+    uint32_t tip = 0;
+    for (uint32_t r = 1; r < rows && !tip; ++r)
+      tip = before[lane].depth[r] == kPositions ? r : 0;
+    if (!tip || length < 40)
+      continue;
+    std::array<uint32_t, SPLASH_DRAFT_COPY_MATCH> path{};
+    for (uint32_t i = SPLASH_DRAFT_COPY_MATCH - 1, at = tip; i > 0; --i, at = before[lane].parent[at])
+      path[i] = proposed[lane * (rows - 1) + at - 1];
+    path[0] = params.anchor[lane];
+    for (uint32_t echo = 0; echo < 2; ++echo) {
+      const uint32_t n = 1 + random.next() % SPLASH_DRAFT_COPY_MATCH;
+      // The second echo ends the history now and then, so the copy runs on into the path itself.
+      const uint32_t at = echo && random.next() % 3 == 0 ? length - n : random.next() % (length - 20);
+      for (uint32_t i = 0; i < n; ++i)
