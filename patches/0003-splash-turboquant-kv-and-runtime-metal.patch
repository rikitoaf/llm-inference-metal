+kernel void decode_accept_tree(
+    device const uint *draft_tokens [[buffer(0)]],
+    device uint *target_tokens [[buffer(1)]],
+    device uint *retained [[buffer(2)]],
+    device uint *accepted_count [[buffer(3)]],
+    device SplashDraftTree *trees [[buffer(4)]],
+    constant AcceptBatchParams &params [[buffer(5)]],
+    uint batch [[threadgroup_position_in_grid]]) {
+  AcceptParams lane_params{params.remaining[batch], params.stop_token_0,
+                           params.stop_token_1};
+  accept_tree_lane(draft_tokens + batch * SPLASH_DRAFT_PROPOSAL_TOKENS,
+                   target_tokens + batch * SPLASH_TARGET_VERIFY_ROWS, trees[batch],
+                   retained[batch], accepted_count[batch], lane_params);
+}
