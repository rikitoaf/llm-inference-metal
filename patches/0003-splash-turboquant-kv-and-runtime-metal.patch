+// A tree lane's acceptance (draft_select_tree): from the anchor, the node's row draw (its argmax, or its plain draw:
+// a tree lane's q is zero) is accepted when a child of the node holds it, and the walk continues at that child;
+// otherwise it is the correction. As in the chain, the output tokens are the accepted tokens followed by the
+// correction or bonus token, and path[d] records the row of the accepted node at depth d for the commits. A copy
+// extension (draft_copy_extend) takes the walk past DFlash's depth, to at most Rows - 1 accepted tokens.
+inline void accept_tree_lane(device const uint *draft_tokens, device uint *output_tokens,
+                             device SplashDraftTree &tree, device uint &retained,
+                             device uint &accepted_count, AcceptParams params) {
+  constexpr uint Rows = SPLASH_TARGET_VERIFY_ROWS;
+  uint draws[Rows];
+  for (uint r = 0; r < Rows; ++r)
+    draws[r] = output_tokens[r];
+  uint node = 0, accepted = 0;
+  tree.path[0] = 0;
+  while (accepted < Rows - 1) {
+    const uint token = draws[node];
+    uint child = 0;
+    for (uint r = node + 1; r < Rows && !child; ++r)
+      if (tree.parent[r] == node && draft_tokens[r - 1] == token)
+        child = r;
+    if (!child)
+      break;
+    output_tokens[accepted] = token;
+    ++accepted;
+    tree.path[accepted] = child;
+    node = child;
+  }
+  output_tokens[accepted] = draws[node];
+  for (uint d = accepted + 1; d < Rows; ++d)
+    tree.path[d] = d;
+  finish_acceptance(output_tokens, accepted, params, retained, accepted_count);
+}
