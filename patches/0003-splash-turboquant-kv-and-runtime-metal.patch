diff --git a/dev/benchmarks/decode_run.mm b/dev/benchmarks/decode_run.mm
new file mode 100644
index 0000000..94013dd
--- /dev/null
+++ b/dev/benchmarks/decode_run.mm
@@ -0,0 +1,398 @@
+// Generation through the production executor, for speculative-decoding measurements.
+//
+//   decode-run METALLIB MODEL_ROOT PROMPTS [--new-tokens N] [--temperature T] [--top-p P] [--top-k K]
+//              [--seed S] [--repeat R] [--kv-format int8|bf16|turbo|turbo-int4] [--output FILE] [--profile 1]
+//
+// PROMPTS holds one prompt per line as token ids. Each one is prefilled cold on one lane and decoded until a stop
+// token or N new tokens (default 512), one cycle at a time, with the runtime's switches read from the environment
+// as the server reads them (SPLASH_DRAFT_TREE, SPLASH_DRAFT_COPY, SPLASH_DRAFT_HEAD_ROWS, ...). Sampling defaults
+// to greedy; T > 0 samples with top-p 0.95 and top-k 20 (Qwen's generation config) unless given. Per prompt it
+// prints the tokens, cycles, tokens per cycle, the fused GPU time per cycle (mean and median), the cycles that
+// kept more than a draft block (a draft tree's copy extension), the wall time per cycle and an FNV-1a digest of
+// the tokens, then the decode cycles' tokens per second of wall time; --output writes the tokens, one prompt per
+// line. --repeat R generates each prompt R times, with seeds S, S + 1, ..., one output line each (sampled
+// distributions of two builds or switches can then be compared). --profile 1 replays every decode cycle's
+// dispatches as separate commands (BackendInstrumentation, as decode-profile does) and prints each pipeline's GPU
+// time per cycle at the end; the cycles' own timings then include the replay.
+
+#include "engine/Types.hpp"
+#include "model/Runtime.hpp"
+#include "ops/PageStorage.hpp"
+#include "metal/BackendInstrumentation.hpp"
+#include "metal/MetalBackend.hpp"
+#include "model/ModelFactory.hpp"
+#include "engine/MemoryGovernor.hpp"
+#include "model/QwenState.hpp"
+
+#import <Foundation/Foundation.h>
+
+#include <algorithm>
+#include <charconv>
+#include <chrono>
+#include <cstdint>
+#include <cstdio>
+#include <filesystem>
+#include <fstream>
+#include <iostream>
+#include <map>
+#include <sstream>
+#include <span>
+#include <string>
+#include <string_view>
+#include <vector>
+
+using namespace splash;
+using namespace splash::engine;
+
+namespace {
+
+// FNV-1a over token ids.
+uint64_t digest(std::span<const uint32_t> tokens) {
+  uint64_t hash = 14695981039346656037ULL;
+  for (const uint32_t token : tokens)
+    for (uint32_t shift = 0; shift < 32; shift += 8)
+      hash = (hash ^ ((token >> shift) & 0xffU)) * 1099511628211ULL;
+  return hash;
+}
+
+std::vector<std::vector<uint32_t>> readPrompts(const std::string &path) {
+  std::ifstream file(path);
+  if (!file)
+    throw std::invalid_argument("cannot read " + path);
+  std::vector<std::vector<uint32_t>> prompts;
+  for (std::string line; std::getline(file, line);) {
+    std::istringstream ids(line);
+    std::vector<uint32_t> prompt;
+    for (uint32_t id; ids >> id;)
+      prompt.push_back(id);
+    if (!prompt.empty())
+      prompts.push_back(std::move(prompt));
+  }
+  if (prompts.empty())
+    throw std::invalid_argument(path + " holds no prompt");
+  return prompts;
+}
+
+// GPU time per pipeline over the profiled decode cycles (--profile).
+struct Attribution final {
+  uint64_t dispatches = 0;
+  double gpuSeconds = 0.0;
+};
+std::map<std::string, Attribution> profile;
+uint64_t profiledCycles = 0;
+metal::MetalBackend *profiledBackend = nullptr;
+
+struct Run final {
+  std::vector<uint32_t> tokens;
+  std::vector<double> cycleMilliseconds;
+  // The tokens the decode cycles emitted (the prefill selects the first) and their wall time on the host,
+  // encoding and finalizing included.
+  uint64_t decodeTokens = 0;
+  double wallMilliseconds = 0.0;
+  uint32_t extendedCycles = 0;
+};
+
+Run generate(model::Runtime &executor, uint64_t id, const std::vector<uint32_t> &pages,
+             std::span<const uint32_t> prompt, uint32_t newTokens, const SamplingParameters &sampling) {
+  EngineRequest request;
+  request.id = id;
+  request.prompt.assign(prompt.begin(), prompt.end());
+  request.maxNewTokens = newTokens;
+  request.sampling = sampling;
+  executor.beginColdRequest(request.modelView(), 0);
+  Run run;
+  uint64_t position = 0;
+  bool finished = false;
+  while (position < prompt.size()) {
+    const uint32_t count = std::min<uint32_t>(model::ExecutionLimits::prefillTokenBudget,
+                                              static_cast<uint32_t>(prompt.size() - position));
+    BatchPlan plan{.kind = WorkKind::Prefill, .items = {{id, count, static_cast<uint32_t>(position)}},
+                   .decodeStage = DecodeStage::Regular};
+    ModelBatchItem item{id, position, count, pages, 1};
+    item.inputTokens = prompt.subspan(position, count);
+    auto results = executor.prefill(plan, std::span<const ModelBatchItem>(&item, 1));
+    if (results.size() != 1 || results[0].consumedPromptTokens != count || !results[0].failure.empty())
+      throw std::runtime_error("prefill failed: " + (results.empty() ? std::string() : results[0].failure));
+    run.tokens.insert(run.tokens.end(), results[0].outputTokens.begin(), results[0].outputTokens.end());
+    finished = results[0].finished;
+    position += count;
+  }
+  while (!finished && run.tokens.size() < newTokens) {
+    BatchPlan plan;
+    plan.kind = WorkKind::Decode;
+    plan.items.push_back({id, 0, 0});
+    std::vector<ModelBatchItem> items{{id, position, 0, pages, 1}};
+    if (profiledBackend)
+      metal::BackendInstrumentation::setDispatchProfiling(*profiledBackend, true);
+    const auto started = std::chrono::steady_clock::now();
+    auto results = executor.decode(plan, items);
+    run.wallMilliseconds +=
+        std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - started).count();
+    if (results.size() != 1 || !results[0].failure.empty())
+      throw std::runtime_error("decode failed: " + (results.empty() ? std::string() : results[0].failure));
+    const ModelStepResult &result = results[0];
+    run.tokens.insert(run.tokens.end(), result.outputTokens.begin(), result.outputTokens.end());
+    run.decodeTokens += result.outputTokens.size();
+    run.cycleMilliseconds.push_back(executor.telemetry().lastDecodeGpuSeconds * 1e3);
+    if (profiledBackend) {
+      metal::BackendInstrumentation::setDispatchProfiling(*profiledBackend, false);
+      for (const metal::DispatchTiming &timing : metal::BackendInstrumentation::takeDispatchProfile(*profiledBackend)) {
+        Attribution &entry = profile[timing.pipelineName];
+        ++entry.dispatches;
+        entry.gpuSeconds += timing.gpuSeconds;
+      }
+      ++profiledCycles;
+    }
+    run.extendedCycles += result.outputTokens.size() - result.outputTokensWithoutKv >
+                          model::ExecutionLimits::draftQueryRows;
+    position += result.outputTokens.size() - result.outputTokensWithoutKv;
+    finished = result.finished;
+  }
+  executor.end(id);
+  return run;
+}
+
+// Score-only prefill: the raw logits of `candidates` after `prompt` (ModelRequest::scoreTokens).
+std::vector<float> score(model::Runtime &executor, uint64_t id, const std::vector<uint32_t> &pages,
+                         std::span<const uint32_t> prompt, std::span<const uint32_t> candidates) {
+  EngineRequest request;
+  request.id = id;
+  request.prompt.assign(prompt.begin(), prompt.end());
+  request.scoreTokens.assign(candidates.begin(), candidates.end());
+  executor.beginColdRequest(request.modelView(), 0);
+  std::vector<float> logits;
+  for (uint64_t position = 0; position < prompt.size();) {
+    const uint32_t count = std::min<uint32_t>(model::ExecutionLimits::prefillTokenBudget,
+                                              static_cast<uint32_t>(prompt.size() - position));
+    BatchPlan plan{.kind = WorkKind::Prefill, .items = {{id, count, static_cast<uint32_t>(position)}},
+                   .decodeStage = DecodeStage::Regular};
+    ModelBatchItem item{id, position, count, pages, 1};
+    item.inputTokens = prompt.subspan(position, count);
+    auto results = executor.prefill(plan, std::span<const ModelBatchItem>(&item, 1));
+    if (results.size() != 1 || !results[0].failure.empty())
+      throw std::runtime_error("score prefill failed");
+    logits = results[0].scoreLogits;
+    position += count;
+  }
+  executor.end(id);
+  return logits;
+}
+
+template <class T> T parse(std::string_view text, std::string_view label) {
+  T value{};
+  auto result = std::from_chars(text.data(), text.data() + text.size(), value);
+  if (result.ec != std::errc{} || result.ptr != text.data() + text.size())
+    throw std::invalid_argument(std::string(label) + " is not a number");
+  return value;
+}
+
+} // namespace
+
+int main(int argc, char **argv) {
+  @autoreleasepool {
+    try {
+      if (argc < 4) {
+        std::cerr << "usage: decode-run METALLIB MODEL_ROOT PROMPTS [--new-tokens N] [--temperature T] "
+                     "[--top-p P] [--top-k K] [--seed S] [--repeat R] [--kv-format int8|bf16|turbo|turbo-int4] "
+                     "[--output FILE]\n";
+        return 2;
+      }
+      uint32_t newTokens = 512, repeats = 1;
+      SamplingParameters sampling;
+      bool topP = false, topK = false;
+      kv::Format format = kv::Format::TurboInt4;
+      std::string output, scores;
+      bool profiling = false;
+      for (int index = 4; index < argc; index += 2) {
+        const std::string_view option(argv[index]);
+        if (index + 1 >= argc)
+          throw std::invalid_argument(std::string(option) + " requires a value");
+        const std::string_view value(argv[index + 1]);
+        if (option == "--new-tokens")
+          newTokens = parse<uint32_t>(value, option);
+        else if (option == "--temperature")
+          sampling.temperature = std::stof(std::string(value));
+        else if (option == "--top-p")
+          sampling.topP = std::stof(std::string(value)), topP = true;
+        else if (option == "--top-k")
+          sampling.topK = parse<uint32_t>(value, option), topK = true;
+        else if (option == "--seed")
+          sampling.seed = parse<uint64_t>(value, option);
+        else if (option == "--repeat")
+          repeats = parse<uint32_t>(value, option);
+        else if (option == "--profile")
+          profiling = value == "1";
+        else if (option == "--output")
+          output = value;
+        else if (option == "--score")
+          scores = value;
+        else if (option == "--kv-format") {
+          if (value != "int8" && value != "bf16" && value != "turbo" && value != "turbo-int4")
+            throw std::invalid_argument("--kv-format takes int8, bf16, turbo or turbo-int4");
+          format = value == "int8"    ? kv::Format::Int8
+                   : value == "bf16"  ? kv::Format::BFloat16
+                   : value == "turbo" ? kv::Format::Turbo
+                                      : kv::Format::TurboInt4;
+        } else
+          throw std::invalid_argument("unknown option " + std::string(option));
+      }
+      if (sampling.temperature > 0.0F) {
+        if (!topP)
+          sampling.topP = 0.95F;
+        if (!topK)
+          sampling.topK = 20;
+      }
+      // --score FILE: lines of a prefix's token ids, '|', then candidate ids; prints their logits after it.
+      std::vector<std::vector<uint32_t>> prompts, candidates;
+      if (!scores.empty()) {
+        std::ifstream file(scores);
+        for (std::string line; std::getline(file, line);) {
+          const size_t bar = line.find('|');
+          if (bar == std::string::npos)
+            continue;
+          std::istringstream head(line.substr(0, bar)), tail(line.substr(bar + 1));
+          prompts.emplace_back();
+          candidates.emplace_back();
+          for (uint32_t id; head >> id;)
+            prompts.back().push_back(id);
+          for (uint32_t id; tail >> id;)
+            candidates.back().push_back(id);
+        }
+      } else {
+        prompts = readPrompts(argv[3]);
+      }
+
+      metal::MetalBackend backend(argv[1]);
+      const std::filesystem::path root(argv[2]);
+      model::ModelPackage model =
+          model::loadModelPackage(backend, root, model::inspectModelPackage(root));
+      ops::ExecutionPlans operators(backend.capabilities());
+      size_t longest = 0;
+      for (const auto &prompt : prompts)
+        longest = std::max(longest, prompt.size());
+      const uint32_t pagesPerLane =
+          static_cast<uint32_t>((longest + newTokens + 2 * model::ExecutionLimits::maximumStepTokens) /
+                                kv::kPageTokens) + 2;
+      const kv::Layout kvLayout = model.targetKvLayout(format);
+      const uint32_t extentPages = kvLayout.maximumExtentPages();
+      const uint32_t pageCount = (pagesPerLane + extentPages - 1) / extentPages * extentPages;
+      MemoryGovernor governor(backend, backend.capabilities().recommendedMaxWorkingSetBytes, 1,
+                              queryHostAvailableMemory, 0);
+      kv::PageStorage pages(backend, governor.allocationAdmission(), kvLayout, pageCount, extentPages);
+      for (uint32_t extent = 0; extent < pageCount / extentPages; ++extent)
+        if (!pages.allocateExtent(extent))
+          throw std::runtime_error("could not allocate the KV extents");
+      model::QwenStateStorage states(backend, governor.allocationAdmission(), model.stateLayout(), nullptr);
+      model::RuntimeContext context{backend, model, pages, states, operators};
+      model::Runtime executor(context);
+      std::vector<uint32_t> lanePages(pagesPerLane);
+      for (uint32_t page = 0; page < pagesPerLane; ++page)
+        lanePages[page] = page;
+
+      const char *tree = std::getenv("SPLASH_DRAFT_TREE");
+      const char *copy = std::getenv("SPLASH_DRAFT_COPY");
+      std::printf("device %s, %zu prompts, %u new tokens, kv %s, temperature %g, draft tree %s, copy %s\n",
+                  backend.capabilities().deviceName.c_str(), prompts.size(), newTokens,
+                  std::string(kv::formatName(format)).c_str(), double(sampling.temperature),
+                  tree ? tree : "unset", copy ? copy : "unset");
+      if (!scores.empty()) {
+        // One candidate: its logit against the whole vocabulary's largest (the prefix's greedy choice).
+        std::vector<uint32_t> vocabulary(248320);
+        for (uint32_t token = 0; token < vocabulary.size(); ++token)
+          vocabulary[token] = token;
+        for (size_t index = 0; index < prompts.size(); ++index) {
+          const bool whole = candidates[index].size() == 1;
+          const std::vector<float> logits = score(executor, 2 + index, lanePages, prompts[index],
+                                                  whole ? std::span<const uint32_t>(vocabulary) : candidates[index]);
+          std::printf("score %zu: %zu prefix tokens:", index, prompts[index].size());
+          if (whole) {
+            const auto best = std::max_element(logits.begin(), logits.end()) - logits.begin();
+            const uint32_t check = candidates[index][0];
+            std::printf(" argmax %u=%.4f, %u=%.4f, margin %.4f", uint32_t(best), double(logits[best]), check,
+                        double(logits[check]), double(logits[best] - logits[check]));
+          } else {
+            for (size_t c = 0; c < logits.size(); ++c)
+              std::printf(" %u=%.4f", candidates[index][c], double(logits[c]));
+          }
+          std::printf("\n");
+          std::fflush(stdout);
+        }
+        return 0;
+      }
+      // A short warm-up request compiles the pipelines before anything is timed.
+      static_cast<void>(generate(executor, 1, lanePages, std::span(prompts[0]).first(std::min<size_t>(64, prompts[0].size())),
+                                 32, sampling));
+      if (profiling)
+        profiledBackend = &backend;
+
+      std::FILE *tokens = output.empty() ? nullptr : std::fopen(output.c_str(), "w");
+      if (!output.empty() && !tokens)
+        throw std::runtime_error("cannot write " + output);
+      uint64_t allTokens = 0, allCycles = 0, allExtended = 0, allDecodeTokens = 0;
+      double allMilliseconds = 0.0, allWall = 0.0;
+      uint64_t nextId = 2;
+      for (size_t run_index = 0; run_index < prompts.size() * repeats; ++run_index) {
+        const size_t index = run_index / repeats;
+        SamplingParameters seeded = sampling;
+        seeded.seed = sampling.seed + run_index % repeats;
+        Run run = generate(executor, nextId++, lanePages, prompts[index], newTokens, seeded);
+        std::vector<double> sorted = run.cycleMilliseconds;
+        std::sort(sorted.begin(), sorted.end());
+        double sum = 0.0;
+        for (double value : sorted)
+          sum += value;
+        const size_t cycles = sorted.size();
+        std::printf("prompt %zu: %zu prompt tokens, %zu tokens in %zu cycles (%.3f per cycle), gpu %.2f ms mean "
+                    "%.2f median per cycle, wall %.2f ms per cycle, %u cycles past a draft block, digest %016llx\n",
+                    index, prompts[index].size(), run.tokens.size(), cycles,
+                    cycles ? double(run.tokens.size()) / cycles : 0.0, cycles ? sum / cycles : 0.0,
+                    cycles ? sorted[cycles / 2] : 0.0, cycles ? run.wallMilliseconds / cycles : 0.0,
+                    run.extendedCycles,
+                    static_cast<unsigned long long>(digest(run.tokens)));
+        std::fflush(stdout);
+        allTokens += run.tokens.size();
+        allCycles += cycles;
+        allExtended += run.extendedCycles;
+        allMilliseconds += sum;
+        allDecodeTokens += run.decodeTokens;
+        allWall += run.wallMilliseconds;
+        if (tokens) {
+          for (size_t i = 0; i < run.tokens.size(); ++i)
+            std::fprintf(tokens, i ? " %u" : "%u", run.tokens[i]);
+          std::fprintf(tokens, "\n");
+        }
+      }
+      if (tokens)
+        std::fclose(tokens);
+      std::printf("total: %llu tokens in %llu cycles (%.3f per cycle), gpu %.2f ms per cycle, %.2f tokens/s of gpu, "
+                  "%llu cycles past a draft block\n",
+                  static_cast<unsigned long long>(allTokens), static_cast<unsigned long long>(allCycles),
+                  allCycles ? double(allTokens) / allCycles : 0.0, allCycles ? allMilliseconds / allCycles : 0.0,
+                  allMilliseconds > 0.0 ? allTokens / (allMilliseconds / 1e3) : 0.0,
+                  static_cast<unsigned long long>(allExtended));
+      // Decode alone, on the host's clock: the decode cycles' tokens over their wall time.
+      std::printf("decode: %llu tokens in %llu cycles (%.3f per cycle), wall %.2f ms per cycle, %.2f tokens/s\n",
+                  static_cast<unsigned long long>(allDecodeTokens), static_cast<unsigned long long>(allCycles),
+                  allCycles ? double(allDecodeTokens) / allCycles : 0.0, allCycles ? allWall / allCycles : 0.0,
+                  allWall > 0.0 ? allDecodeTokens / (allWall / 1e3) : 0.0);
+      if (profiledCycles) {
+        std::vector<std::pair<std::string, Attribution>> rows(profile.begin(), profile.end());
+        std::sort(rows.begin(), rows.end(),
+                  [](const auto &left, const auto &right) { return left.second.gpuSeconds > right.second.gpuSeconds; });
+        double sum = 0.0;
+        for (const auto &[_, entry] : rows)
+          sum += entry.gpuSeconds;
+        std::printf("\n== %llu decode cycles as separate dispatches: %.3f ms per cycle ==\n%-44s %9s %10s\n",
+                    static_cast<unsigned long long>(profiledCycles), sum * 1e3 / profiledCycles, "pipeline", "count",
+                    "gpu_ms");
+        for (const auto &[name, entry] : rows)
+          std::printf("%-44s %9.2f %10.4f\n", name.c_str(), double(entry.dispatches) / profiledCycles,
+                      entry.gpuSeconds * 1e3 / profiledCycles);
+      }
+      return 0;
+    } catch (const std::exception &error) {
+      std::cerr << "decode-run: " << error.what() << '\n';
+      return 1;
+    }
+  }
+}
