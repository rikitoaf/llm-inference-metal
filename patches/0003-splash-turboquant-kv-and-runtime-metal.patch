+// A format-specific kernel's entries for the two GQA layouts, per format.
+struct FormatKernels final {
+  std::string_view q8[2], bf16[2], turbo[2], turboInt4[2];
+};
+
+std::string_view formatPipeline(KernelLayout layout, kv::Format format,
+                                const FormatKernels &names) noexcept {
+  const auto pick = [layout](const std::string_view (&entry)[2]) {
+    return pipeline(layout, entry[0], entry[1]);
+  };
+  switch (format) {
+  case kv::Format::BFloat16: return pick(names.bf16);
+  case kv::Format::Turbo: return pick(names.turbo);
+  case kv::Format::TurboInt4: return pick(names.turboInt4);
+  case kv::Format::Int8: break;
+  }
+  return pick(names.q8);
+}
+
+[[nodiscard]] constexpr bool turboFormat(kv::Format format) noexcept {
+  return format == kv::Format::Turbo || format == kv::Format::TurboInt4;
+}
+
+// The reduction of a split: TurboQuant formats rotate the output back.
+std::string_view reducePipeline(KernelLayout layout, kv::Format format, std::string_view stem) {
+  // stem is "prefill_attention_reduce" or "verify_attention_reduce"
+  static const std::string names[2][3][2] = {
+      {{"prefill_attention_reduce", "prefill_attention_reduce_kv2_g8"},
+       {"prefill_attention_reduce_turbo", "prefill_attention_reduce_turbo_kv2_g8"},
+       {"prefill_attention_reduce_turbo_int4", "prefill_attention_reduce_turbo_int4_kv2_g8"}},
+      {{"verify_attention_reduce", "verify_attention_reduce_kv2_g8"},
+       {"verify_attention_reduce_turbo", "verify_attention_reduce_turbo_kv2_g8"},
+       {"verify_attention_reduce_turbo_int4", "verify_attention_reduce_turbo_int4_kv2_g8"}}};
+  const auto &family = names[stem.starts_with("verify") ? 1 : 0];
+  const auto &entry = format == kv::Format::Turbo       ? family[1]
+                      : format == kv::Format::TurboInt4 ? family[2]
+                                                        : family[0];
+  return pipeline(layout, entry[0], entry[1]);
+}
+
+// TurboQuant attention reads queries rotated into its keys' basis: rotate
+// `vectors` head vectors of `queries` in place before the split reads them
+// (the encoder is serial). Turbo rotates each 128 dimensions with one
+// simdgroup, TurboInt4 each 256-dimension head vector.
+void addTurboQueryRotation(metal::CommandGraph &graph, metal::MetalBuffer queries,
+                           uint64_t vectors, uint32_t headDimension, kv::Format format) {
+  if (!vectors || vectors > std::numeric_limits<uint32_t>::max())
+    throw std::invalid_argument("invalid TurboQuant query rotation size");
+  const bool full = format == kv::Format::TurboInt4;
+  const uint64_t simdgroupTasks = full ? vectors : vectors * (headDimension / kv::kTurboGroup);
+  const uint64_t simdgroups = metal::CommandGraph::kDefaultThreads / 32;
+  graph.add(std::string(full ? "turbo_rotate_queries_256" : "turbo_rotate_queries"),
+            {std::move(queries)}, SplashTurboRotateParams{static_cast<uint32_t>(vectors)},
+            {(simdgroupTasks + simdgroups - 1) / simdgroups, 1, 1});
+}
