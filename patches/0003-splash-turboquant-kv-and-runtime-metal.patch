new file mode 100644
index 0000000..406046d
--- /dev/null
+++ b/dev/tools/vocab_shortlist.py
@@ -0,0 +1,98 @@
+#!/usr/bin/env python3
+"""Check the vocabulary order SPLASH_DRAFT_HEAD_ROWS relies on, from a Hugging Face tokenizer directory.
+
+The draft head's shortlist (runtime/model/DFlashDraft.hpp, DFlashHeadShortlist) scores the first N ids and the
+256-row tiles from the first added token on. That pays only if a byte-level BPE's ids follow its merge order and
+the leading merges are the ones agent text uses. This prints, read-only:
+- whether every merged token's id increases with its merge rank;
+- the script mix of each block of ids (ASCII, CJK, Cyrillic, ...), and where the CJK block starts;
+- the added tokens and the tail the shortlist keeps for them.
+
+    vocab_shortlist.py install/models/.metadata/<digest>/tokenizer [--block 16384] [--rows 98304]
+"""
+import argparse, collections, json, pathlib, unicodedata
+
+TILE = 256  # QUANT_TILE_ROWS (runtime/metal/abi/QuantFormat.h)
+
+
+def byte_decoder():
+    # GPT-2's byte-to-unicode table, inverted.
+    bs = list(range(ord('!'), ord('~') + 1)) + list(range(ord('¡'), ord('¬') + 1)) + list(range(ord('®'), ord('ÿ') + 1))
+    cs = bs[:]
+    n = 0
+    for b in range(256):
+        if b not in bs:
+            bs.append(b)
+            cs.append(256 + n)
+            n += 1
+    return {chr(c): b for b, c in zip(bs, cs)}
+
+
+def script(text):
+    stripped = text.strip()
+    if not stripped:
+        return 'space'
+    if all(ord(c) < 128 for c in stripped):
+        return 'ascii'
+    names = {unicodedata.name(c, '?').split(' ')[0] for c in stripped if ord(c) >= 128}
+    if names <= {'?'}:
+        return 'partial-utf8'
+    if names & {'CJK', 'HIRAGANA', 'KATAKANA', 'HANGUL'}:
+        return 'cjk'
+    if 'CYRILLIC' in names:
+        return 'cyrillic'
+    if 'LATIN' in names:
+        return 'latin-ext'
+    if names & {'ARABIC', 'HEBREW'}:
+        return 'arabic/hebrew'
+    return 'other'
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    parser.add_argument('tokenizer', type=pathlib.Path, help='directory with tokenizer.json and tokenizer_config.json')
+    parser.add_argument('--block', type=int, default=16384)
+    parser.add_argument('--rows', type=int, default=98304, help='SPLASH_DRAFT_HEAD_ROWS')
+    args = parser.parse_args()
+    model = json.loads((args.tokenizer / 'tokenizer.json').read_text())['model']
+    config = json.loads((args.tokenizer / 'tokenizer_config.json').read_text())
+    vocab = model['vocab']
+    text_of = {i: s for s, i in vocab.items()}
+    decode = byte_decoder()
+    rank = {}
+    for r, merge in enumerate(model['merges']):
+        a, b = merge.split(' ', 1) if isinstance(merge, str) else merge
+        rank[vocab[a + b]] = r
+    ordered = sorted(rank)
+    inversions = sum(rank[x] > rank[y] for x, y in zip(ordered, ordered[1:]))
+    print(f"{model['type']}: {len(vocab)} ids, {len(rank)} merges, {len(vocab) - len(rank)} base tokens; "
+          f"merge rank decreases {inversions} times in id order")
+
+    def text(i):
+        return bytes(decode[c] for c in text_of[i]).decode('utf-8', 'replace')
+
+    top = max(text_of) + 1
+    for lo in range(0, top, args.block):
+        counts = collections.Counter(script(text(i)) for i in range(lo, min(lo + args.block, top)) if i in text_of)
+        total = sum(counts.values()) or 1
+        print(f'{lo:>7}-{min(lo + args.block, top) - 1:>7} ' +
+              ' '.join(f'{k}:{100 * v / total:.0f}%' for k, v in counts.most_common(5)))
+    # The first 1,024-id block that is mostly CJK.
+    for lo in range(0, top, 1024):
+        if sum(script(text(i)) == 'cjk' for i in range(lo, min(lo + 1024, top)) if i in text_of) > 512:
+            print(f'CJK merges start near id {lo}')
+            break
+
+    added = sorted(int(k) for k in config.get('added_tokens_decoder', {}))
+    if added:
+        names = config['added_tokens_decoder']
+        print(f'added tokens {added[0]}-{added[-1]} ({len(added)}): ' +
+              ' '.join(names[str(i)]['content'] for i in added))
+        split = -(-args.rows // TILE) * TILE
+        tail = added[0] // TILE * TILE
+        print(f'shortlist at --rows {args.rows}: ids [0, {split}) and [{tail}, end of the head), '
+              f'{split} + the tail rows')
+
+
+if __name__ == '__main__':
+    main()
