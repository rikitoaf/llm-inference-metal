+// test building.
+#define GRID_BYTES_TEST(F, name)                                                                                  \
+kernel void gguf_test_grid_bytes_##name(device atomic_uint *mismatch [[buffer(0)]], constant uint &pass [[buffer(1)]], \
+    uint tid [[thread_position_in_grid]], uint lane [[thread_index_in_threadgroup]]) {                            \
+  threadgroup half stage[32 * 32], bytes[32 * 32];                                                                \
+  grid_bytes_equality<F>(mismatch, pass, tid, stage + lane * 32, bytes + lane * 32);                              \
+}
