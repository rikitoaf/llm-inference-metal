+// The staged grid decode the fp16 grids (HalfGrid formats) replaced: byte magnitudes converted to fp32 in the tile.
+template <class F>
+inline void dequant32_grid_bytes(typename F::Payload w, typename F::Meta meta, threadgroup half *dst) {
+  const QuantCoef k = F::coef(meta, F::chunk(w, 0));
+  for (ushort c = 0; c < 4; ++c) {
+    const typename F::Chunk q = F::chunk(w, c);
+    const uint2 g = F::grid(q); const uint s = F::signs(q);
+    half4 lo = half4(float4(as_type<uchar4>(g.x)) * k.s.x), hi = half4(float4(as_type<uchar4>(g.y)) * k.s.y);
+    lo = select(lo, -lo, bool4(s & 1, s & 2, s & 4, s & 8));
+    hi = select(hi, -hi, bool4(s & 16, s & 32, s & 64, s & 128));
+    *((threadgroup half4 *)(dst + 4 * c)) = lo; *((threadgroup half4 *)(dst + 16 + 4 * c)) = hi;
+  }
+}
+// A synthetic group: grid entry e[i] for elements 4i..4i+3, sign bits from `signs`, the 4-bit scale `sc`.
+inline FmtIQ3XXS::Payload grid_group(FmtIQ3XXS, thread const uint *e, uint signs, uint sc) {
+  return {uint2(e[0] | e[1] << 8 | e[2] << 16 | e[3] << 24, e[4] | e[5] << 8 | e[6] << 16 | e[7] << 24),
+          (signs & 0x0FFFFFFFu) | sc << 28};
+}
+inline FmtIQ3S::Payload grid_group(FmtIQ3S, thread const uint *e, uint signs, uint sc) {
+  FmtIQ3S::Payload w;
+  for (ushort c = 0; c < 4; ++c)   // bits 30, 31 are unused: random, as the decode must ignore them
+    w.a[c] = (e[c] & 0xFF) | (e[4 + c] & 0xFF) << 8 | ((signs >> (8 * c)) & 0xFF) << 16 | (e[c] >> 8) << 24 |
+             (e[4 + c] >> 8) << 25 | sc << 26 | ((signs >> (2 * c)) & 3) << 30;
+  return w;
