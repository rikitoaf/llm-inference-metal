+  std::vector<uint32_t> positionsBefore(anchorPositions, anchorPositions + lanes * rows * 3);
+
+  CommandGraph copy;
+  DraftSelector::addCopyExtension(
+      copy, {candidates, unary, partialValues, tokens, trees, positions, history, outcomes}, params);
+  static_cast<void>(backend.submitCommand(copy.dispatches()));
+
+  const auto *after = static_cast<const SplashDraftTree *>(trees.contents());
+  const auto *outcome = static_cast<const SplashDraftCopyOutcome *>(outcomes.contents());
+  for (uint32_t lane = 0; lane < lanes; ++lane) {
+    const CopyReference expected = copyReference(
+        ids + lane * kPositions * kCandidates, scores + lane * kPositions * kCandidates,
+        tables + lane * kPositions * kCandidates * kCandidates, treesBefore[lane],
+        tokensBefore.data() + lane * (rows - 1), params.anchor[lane], histories + uint64_t{lane} * stride,
+        params.history_tokens[lane], params);
+    const SplashDraftCopyOutcome &got = outcome[lane];
+    copyCoverage.noTip += !expected.tip;
+    copyCoverage.noMatch += expected.tip && !expected.match;
