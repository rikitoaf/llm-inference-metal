+// A draft tree's copy extension (draft_copy_extend) against a double-precision reference. Trees come from
+// draft_select_tree over designed scores (a likely chain to depth 7 among random siblings, at a few sharpnesses,
+// or flat scores whose tree never reaches depth 7); histories hold an echo of the tip's path suffix, of random
+// length, followed by a continuation, among random tokens drawn from the same few ids, so shorter, longer and
+// repeated matches occur too. The reference recomputes every row's log-probability, finds the tip, the longest
+// and latest history match and the rows the copy wins, and the GPU's tree, tokens, positions and outcome must
+// match it; only a competition decided within fp32 rounding may differ by its last row.
+struct CopyReference final {
+  uint32_t rows = 0, match = 0, tip = 0, end = 0;
+  std::array<uint32_t, SPLASH_DRAFT_COPY_ROWS> copy{};
+  // How close the decisive comparison of the copy rows' count was, in log-probability.
+  double margin = INFINITY;
+};
+
+// The cases the copy extension tests reached: no tip, a tip without a match, a match whose copy loses every
+// row, some rows, every row, and a copy that runs on past the history into the path.
+struct CopyCoverage final {
+  uint32_t noTip = 0, noMatch = 0, noRows = 0, someRows = 0, allRows = 0, intoPath = 0;
+};
+CopyCoverage copyCoverage;
+
+CopyReference copyReference(const uint32_t *candidates, const float *unary, const float *tables,
+                            const SplashDraftTree &tree, const uint32_t *tokens, uint32_t anchor,
+                            const uint32_t *history, uint32_t length, const SplashDraftCopyParams &params) {
+  constexpr uint32_t rows = SPLASH_TARGET_VERIFY_ROWS;
+  CopyReference result;
+  std::array<double, rows> logProbability{};
+  std::array<uint32_t, rows> candidate{};
+  const auto score = [&](uint32_t position, uint32_t from, uint32_t j) {
+    return double(unary[position * kCandidates + j]) + tables[(position * kCandidates + from) * kCandidates + j];
+  };
+  for (uint32_t r = 1; r < rows; ++r) {
+    const uint32_t position = tree.depth[r] - 1, from = candidate[tree.parent[r]];
+    uint32_t j = 0;
+    while (j + 1 < kCandidates && candidates[position * kCandidates + j] != tokens[r - 1])
+      ++j;
+    double maximum = -INFINITY, sum = 0.0;
+    for (uint32_t c = 0; c < kCandidates; ++c)
+      maximum = std::max(maximum, score(position, from, c));
+    for (uint32_t c = 0; c < kCandidates; ++c)
+      sum += std::exp(score(position, from, c) - maximum);
+    logProbability[r] = logProbability[tree.parent[r]] + score(position, from, j) - maximum - std::log(sum);
+    candidate[r] = j;
+    if (!result.tip && tree.depth[r] == kPositions)
+      result.tip = r;
+  }
+  if (!result.tip || !length)
+    return result;
+  std::array<uint32_t, SPLASH_DRAFT_COPY_MATCH> query{};
+  for (uint32_t i = SPLASH_DRAFT_COPY_MATCH - 1, at = result.tip; i > 0; --i, at = tree.parent[at])
+    query[i] = tokens[at - 1];
+  query[0] = anchor;
+  for (uint32_t end = 0; end < length; ++end) {
+    uint32_t n = 0;
+    while (n < SPLASH_DRAFT_COPY_MATCH && n <= end && history[end - n] == query[SPLASH_DRAFT_COPY_MATCH - 1 - n])
+      ++n;
+    if (n >= params.min_match && n >= result.match) {
+      result.match = n;
+      result.end = end;
+    }
+  }
+  if (!result.match)
+    return result;
+  for (uint32_t k = 0; k < SPLASH_DRAFT_COPY_ROWS; ++k) {
+    const uint32_t at = result.end + 1 + k;
+    result.copy[k] = at < length ? history[at] : query[at - length];
+  }
+  double value = logProbability[result.tip];
+  while (result.rows < SPLASH_DRAFT_COPY_ROWS && rows - 1 - result.rows > result.tip) {
+    const double next = value + params.log_accept[result.match - 1][result.rows];
+    const double against = logProbability[rows - 1 - result.rows];
+    result.margin = std::min(result.margin, std::fabs(next - against));
+    if (!(next > against))
+      break;
+    value = next;
+    ++result.rows;
+  }
+  return result;
+}
+
+void copyExtension(MetalBackend &backend, uint32_t lanes, float sharpness, bool deep, uint32_t trial) {
+  Random random(0xc0b1e5 + lanes * 131 + trial * 2 + deep);
+  constexpr uint32_t rows = SPLASH_TARGET_VERIFY_ROWS;
+  const auto workspace = DraftSelector::workspace(lanes * kPositions);
+  const uint32_t stride = 4096;
+  MetalBuffer candidates = allocate(backend, workspace.candidatesBytes);
+  MetalBuffer unary = allocate(backend, workspace.unaryBytes);
+  MetalBuffer partialValues = allocate(backend, workspace.partialValuesBytes);
+  MetalBuffer tokens = allocate(backend, uint64_t{lanes} * (rows - 1) * sizeof(uint32_t));
+  MetalBuffer probabilities = allocate(backend, workspace.proposalProbabilitiesBytes);
+  MetalBuffer trees = allocate(backend, uint64_t{lanes} * sizeof(SplashDraftTree));
+  MetalBuffer positions = allocate(backend, uint64_t{lanes} * rows * 3 * sizeof(uint32_t));
+  MetalBuffer history = allocate(backend, uint64_t{lanes} * stride * sizeof(uint32_t));
+  MetalBuffer outcomes = allocate(backend, uint64_t{lanes} * sizeof(SplashDraftCopyOutcome));
+  auto *ids = static_cast<uint32_t *>(candidates.contents());
+  auto *scores = static_cast<float *>(unary.contents());
+  auto *tables = static_cast<float *>(partialValues.contents()) + lanes * kPositions * kShards * kCandidates;
+  // Ids from a small alphabet, distinct within a position, so histories built from them repeat.
+  for (uint32_t i = 0; i < lanes * kPositions; ++i)
+    for (uint32_t j = 0; j < kCandidates; ++j)
+      ids[i * kCandidates + j] = 3 + (i * 7 + j * 5) % 40 + 40 * (j % 2);
+  for (uint32_t i = 0; i < lanes * kPositions * kCandidates; ++i)
+    scores[i] = deep && i % kCandidates == 0 ? sharpness : 0.6F * random.unit();
+  for (uint32_t i = 0; i < lanes * kPositions * kCandidates * kCandidates; ++i)
+    tables[i] = 0.3F * random.unit();
+  SelectorBatchParams select{};
+  select.lanes = lanes;
+  select.vocabulary = 1003;
+  select.tree_mask = (1u << lanes) - 1;
+  SplashDraftCopyParams params{};
+  params.lanes = lanes;
+  params.history_stride = stride;
+  params.min_match = 1 + random.next() % 4;
+  for (uint32_t n = 0; n < SPLASH_DRAFT_COPY_MATCH; ++n)
+    for (uint32_t k = 0; k < SPLASH_DRAFT_COPY_ROWS; ++k)
