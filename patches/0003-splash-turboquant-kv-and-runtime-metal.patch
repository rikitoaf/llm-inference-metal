+  dequant32_grid_bytes<F>(w, d, bytes);
+  uint first = 32, firstValues = 0;
+  bool signedZerosOnly = true;
+  for (uint i = 0; i < 32; ++i) {
+    const ushort got = as_type<ushort>(stage[i]), want = as_type<ushort>(bytes[i]);
+    if (got == want) continue;
