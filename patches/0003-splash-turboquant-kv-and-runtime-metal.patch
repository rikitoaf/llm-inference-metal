@@ -0,0 +1,48 @@
+#include "metal/abi/PagedAttention.h"
+#include "metal/kernels/common/turbo_kv.h"
+
+// Rotates head vectors in place into the basis TurboQuant pages store keys
+// and values in (turbo_kv.h): the queries of a TurboQuant attention, before
+// its split. Each simdgroup rotates one 128-dimension group, so a 256-thread
+// threadgroup covers four head vectors.
+kernel void turbo_rotate_queries(device bfloat *vectors [[buffer(0)]],
+                                 constant SplashTurboRotateParams &params [[buffer(1)]],
+                                 uint group [[threadgroup_position_in_grid]],
+                                 uint simd_lane [[thread_index_in_simdgroup]],
+                                 uint simd_group [[simdgroup_index_in_threadgroup]],
+                                 uint simdgroups [[simdgroups_per_threadgroup]]) {
+  const ulong rotation_group = ulong(group) * simdgroups + simd_group;
+  if (rotation_group >= ulong(params.vectors) * SplashTurboGroups)
+    return;
+  device bfloat *x = vectors + rotation_group * SplashTurboGroup;
+  float v[4];
+#pragma unroll
+  for (uint r = 0; r < 4; ++r)
+    v[r] = float(x[32 * r + simd_lane]);
+  splash_turbo_rotate(v, simd_lane, false);
+#pragma unroll
+  for (uint r = 0; r < 4; ++r)
+    x[32 * r + simd_lane] = bfloat(v[r]);
+}
+
+// The 256-point rotation of TurboQuant int4 pages: one simdgroup per head
+// vector, eight per 256-thread threadgroup.
+kernel void turbo_rotate_queries_256(device bfloat *vectors [[buffer(0)]],
+                                     constant SplashTurboRotateParams &params [[buffer(1)]],
+                                     uint group [[threadgroup_position_in_grid]],
+                                     uint simd_lane [[thread_index_in_simdgroup]],
+                                     uint simd_group [[simdgroup_index_in_threadgroup]],
+                                     uint simdgroups [[simdgroups_per_threadgroup]]) {
+  const ulong vector = ulong(group) * simdgroups + simd_group;
+  if (vector >= params.vectors)
+    return;
+  device bfloat *x = vectors + vector * SPLASH_KV_HEAD_DIMENSION;
+  float v[8];
+#pragma unroll
+  for (uint r = 0; r < 8; ++r)
+    v[r] = float(x[32 * r + simd_lane]);
+  splash_turbo_rotate256(v, simd_lane, false);
+#pragma unroll
+  for (uint r = 0; r < 8; ++r)
+    x[32 * r + simd_lane] = bfloat(v[r]);
+}
