new file mode 100644
index 0000000..01517fe
--- /dev/null
+++ b/dev/tools/shortlist_dump.py
@@ -0,0 +1,72 @@
+#!/usr/bin/env python3
+"""What SPLASH_DRAFT_HEAD_ROWS would cost on recorded draft cycles, and whether two dumps agree.
+
+Reads SPLASH_DRAFT_DUMP files (runtime/model/Runtime.mm, dumpDraftCycle: one JSON line per one-lane decode cycle
+with the draft's 7 x 16 candidates and the target's retained tokens). The shortlist scores ids [0, split) and
+[tail, vocabulary) (DFlashHeadShortlist; tail 247808 holds Qwen's added tokens 248044-248076).
+
+    shortlist_dump.py DUMP [--rows 98304] [--tail 247808]
+        How often the full head's candidates and the target's tokens leave the shortlist, and the accepted
+        tokens a shortlisted draft could not have proposed: a cycle's acceptance stops at its first accepted
+        token outside the shortlist (an upper bound on the loss; the shortlist's replacement candidates are
+        not in the dump).
+    shortlist_dump.py DUMP --against SHORTLISTED_DUMP
+        The same greedy requests with the flag off (DUMP) and on: the cycles must agree, candidates and unary
+        scores bit for bit, until the first cycle whose full-head candidates leave the shortlist.
+"""
+import argparse, json
+
+TILE = 256  # QUANT_TILE_ROWS
+
+
+def cycles(path):
+    with open(path) as lines:
+        return [json.loads(line) for line in lines if line.strip()]
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    parser.add_argument('dump')
+    parser.add_argument('--rows', type=int, default=98304, help='SPLASH_DRAFT_HEAD_ROWS')
+    parser.add_argument('--tail', type=int, default=247808, help='the first shortlisted tile of added tokens')
+    parser.add_argument('--against', help='a dump of the same greedy requests with the shortlist on')
+    args = parser.parse_args()
+    split = -(-args.rows // TILE) * TILE
+    inside = lambda token: token < split or token >= args.tail
+    full = cycles(args.dump)
+
+    if args.against:
+        short = cycles(args.against)
+        # A full-head candidate outside the shortlist is replaced, so that cycle differs: the expected first one.
+        for index, (a, b) in enumerate(zip(full, short)):
+            if a['candidates'] != b['candidates'] or a['unary'] != b['unary'] or a['output'] != b['output']:
+                leaves = not all(inside(t) for t in a['candidates'])
+                print(f'cycles 0-{index - 1} agree; cycle {index} (position {a["position"]}) differs and its '
+                      f'full-head candidates {"leave the shortlist: expected" if leaves else "do not leave it: FAIL"}')
+                return 0 if leaves else 1
+        print(f'all {min(len(full), len(short))} common cycles agree')
+        return 0
+
+    slots = sum(len(c['candidates']) for c in full)
+    slots_out = sum(not inside(t) for c in full for t in c['candidates'])
+    cycles_out = sum(any(not inside(t) for t in c['candidates']) for c in full)
+    outputs = [t for c in full for t in c['output']]
+    outputs_out = sum(not inside(t) for t in outputs)
+    kept = kept_short = 0
+    for c in full:
+        accepted = c['accepted']
+        drafted = c['output'][:accepted]
+        stop = next((i for i, t in enumerate(drafted) if not inside(t)), accepted)
+        kept += accepted + 1
+        kept_short += stop + 1
+    print(f'shortlist [0, {split}) + [{args.tail}, end): {len(full)} cycles')
+    print(f'  candidate slots outside: {slots_out}/{slots} ({100 * slots_out / max(slots, 1):.3f}%), '
+          f'in {cycles_out} cycles ({100 * cycles_out / max(len(full), 1):.2f}%)')
+    print(f'  target tokens outside: {outputs_out}/{len(outputs)} ({100 * outputs_out / max(len(outputs), 1):.3f}%)')
+    print(f'  tokens/cycle {kept / len(full):.4f} -> at least {kept_short / len(full):.4f} '
+          f'({100 * (kept_short / kept - 1):+.3f}%)')
+    return 0
+
+
+if __name__ == '__main__':
+    raise SystemExit(main())
