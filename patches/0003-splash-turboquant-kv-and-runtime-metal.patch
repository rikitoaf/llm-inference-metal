diff --git a/dev/tools/flatten_metal.py b/dev/tools/flatten_metal.py
new file mode 100755
index 0000000..ecdfb88
--- /dev/null
+++ b/dev/tools/flatten_metal.py
@@ -0,0 +1,62 @@
+#!/usr/bin/env python3
+"""Flatten a Splash .metal kernel file into one self-contained source for runtime compilation.
+
+The engine's offline build compiles each runtime/metal/kernels/{prefill,decode,shared}/*.metal with
+`-Iruntime`; Metal's runtime compiler (MTLDevice newLibraryWithSource:) has no include path, so
+every `#include "metal/..."` is inlined here, once per file (#pragma once semantics). System
+includes (<metal_stdlib>, <MetalPerformancePrimitives/...>) stay as they are.
+
+    flatten_metal.py RUNTIME_ROOT KERNEL.metal > out.metal
+    flatten_metal.py RUNTIME_ROOT --all OUT_DIR        # every production kernel, one file each
+"""
+import pathlib, re, sys
+
+INCLUDE = re.compile(r'^\s*#\s*include\s+"([^"]+)"\s*$')
+PRAGMA_ONCE = re.compile(r'^\s*#\s*pragma\s+once\s*$')
+
+
+def label(root: pathlib.Path, path: pathlib.Path) -> str:
+    try:
+        return str(path.relative_to(root.resolve()))
+    except ValueError:                     # a file outside the runtime tree, e.g. a test kernel
+        return str(path)
+
+
+def flatten(root: pathlib.Path, path: pathlib.Path, seen: set, out: list):
+    path = path.resolve()
+    if path in seen:
+        return
+    seen.add(path)
+    out.append(f"// ---- begin {label(root, path)}\n")
+    for line in path.read_text().splitlines(keepends=True):
+        if PRAGMA_ONCE.match(line):
+            continue
+        m = INCLUDE.match(line)
+        if m:
+            target = (root / m[1]) if m[1].startswith("metal/") else (path.parent / m[1])
+            if not target.exists():
+                raise SystemExit(f"{path}: cannot resolve include {m[1]}")
+            flatten(root, target, seen, out)
+            continue
+        out.append(line)
+    if not out[-1].endswith("\n"):
+        out.append("\n")
+    out.append(f"// ---- end {label(root, path)}\n")
+
+
+def flatten_file(root, kernel):
+    out = []
+    flatten(pathlib.Path(root), pathlib.Path(kernel), set(), out)
+    return "".join(out)
+
+
+if __name__ == "__main__":
+    root = pathlib.Path(sys.argv[1])
+    if len(sys.argv) == 4 and sys.argv[2] == "--all":
+        dest = pathlib.Path(sys.argv[3])
+        dest.mkdir(parents=True, exist_ok=True)
+        for phase in ("prefill", "decode", "shared"):
+            for kernel in sorted((root / "metal" / "kernels" / phase).glob("*.metal")):
+                (dest / f"{phase}__{kernel.stem}.metal").write_text(flatten_file(root, kernel))
+    else:
+        sys.stdout.write(flatten_file(root, sys.argv[2]))
