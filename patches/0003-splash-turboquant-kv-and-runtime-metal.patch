+// The tile dequantizes each page's keys, then its values, into one
+// SplashKvPageTokens x SplashKvHeadDimension bf16 tile in threadgroup memory
+// (16 KiB) and runs the same MPP products on it. The stored norms are folded
+// into the dequantized values, so the softmax applies no scales; keys and
+// values stay in the rotated basis, which the rotated queries share and the
+// reduce undoes. Tokens past the visible history dequantize to zero.
+
+// Keys, token-major like the device layout. The page's packed planes (32
+// tokens x 8 chunks x 16 bytes) and norms are first staged in threadgroup
+// memory with one coalesced load per thread: 32 dependent device loads per
+// lane were the tile's largest cost. Then simdgroup c owns dimensions
+// 32c..32c+31, one per lane, and walks the tokens reading broadcast words.
+// `staging` holds 264 uint4 and is free at this point of the page loop.
+inline void splash_turbo_dequantize_keys(SplashTurboPageTensors page,
+                                         threadgroup SplashTurboTileElement *tile,
+                                         threadgroup uint4 *staging, uint valid_tokens,
+                                         uint thread_index, uint simd_lane,
+                                         uint simd_group) {
+  constexpr uint D = SplashKvHeadDimension;
+  constexpr uint Words = SplashKvPageTokens * SplashTurboChunks;          // 256 uint4
+  constexpr uint Norms = SplashKvPageTokens * SplashTurboGroups;          // 64 half
+  static_assert(Words == 256 && Norms * 2 == 8 * 16, "one uint4 per thread, 8 for the norms");
+  threadgroup half *norms = reinterpret_cast<threadgroup half *>(staging + Words);
+  staging[thread_index] =
+      thread_index / SplashTurboChunks < valid_tokens
+          ? reinterpret_cast<device const uint4 *>(page.key_planes)[thread_index]
+          : uint4(0);
+  if (thread_index < 8)
+    reinterpret_cast<threadgroup uint4 *>(norms)[thread_index] =
+        reinterpret_cast<device const uint4 *>(page.key_norms)[thread_index];
+  threadgroup_barrier(mem_flags::mem_threadgroup);
+  const uint chunk = simd_group;
+  const uint dimension = chunk * 32 + simd_lane;
+  const uint group = chunk / (SplashTurboGroup / 32);
+  // The codebook lives in registers, centroid i in lane i: a lookup is one
+  // shuffle instead of a constant-memory read whose index differs per lane.
+  const float codebook = SplashTurboCentroids4[simd_lane & 15u];
+  for (uint token = 0; token < SplashKvPageTokens; ++token) {
+    float value = 0.0f;
+    if (token < valid_tokens) {
+      const uint4 word = staging[token * SplashTurboChunks + chunk];
+      const uint index = ((word.x >> simd_lane) & 1u) | (((word.y >> simd_lane) & 1u) << 1) |
+                         (((word.z >> simd_lane) & 1u) << 2) |
+                         (((word.w >> simd_lane) & 1u) << 3);
+      value = simd_shuffle(codebook, ushort(index)) *
+              float(norms[token * SplashTurboGroups + group]);
+    }
+    tile[token * D + dimension] = SplashTurboTileElement(value);
+  }
+}
+
+// Values, dimension-major as PV reads them: simdgroup c owns the chunk's 32
+// dimensions and lane t the page's token t, whose three planes and norm it
+// loads once.
+inline void splash_turbo_dequantize_values(SplashTurboPageTensors page,
+                                           threadgroup SplashTurboTileElement *tile,
+                                           uint valid_tokens, uint simd_lane,
+                                           uint simd_group) {
+  constexpr uint N = SplashKvPageTokens;
+  const uint chunk = simd_group;
+  const uint token = simd_lane;
+  const uint group = chunk / (SplashTurboGroup / 32);
+  uint plane0 = 0, plane1 = 0, plane2 = 0;
+  float norm = 0.0f;
+  if (token < valid_tokens) {
+    device const uint *planes =
+        page.value_planes + (token * SplashTurboChunks + chunk) * SplashTurboValuePlanes;
+    plane0 = planes[0];
+    plane1 = planes[1];
+    plane2 = planes[2];
+    norm = float(page.value_norms[token * SplashTurboGroups + group]);
+  }
+  const float codebook = SplashTurboCentroids3[simd_lane & 7u];   // as for the keys
+#pragma unroll 8
+  for (uint bit = 0; bit < 32; ++bit) {
+    const uint index = ((plane0 >> bit) & 1u) | (((plane1 >> bit) & 1u) << 1) |
+                       (((plane2 >> bit) & 1u) << 2);
+    tile[(chunk * 32 + bit) * N + token] = SplashTurboTileElement(simd_shuffle(codebook, ushort(index)) * norm);
+  }
+}
+
+// splash_paged_attention_tile for TurboQuant pages; the same partition,
+// softmax and partial outputs. kv_tile holds N x D bf16.
+template <uint KVHeads, uint QueryHeadsPerKVHead, uint RowsPerTile>
+inline void splash_paged_attention_turbo_tile(
+    device bfloat *tile_queries, device const SplashKvPage *page_table,
+    SplashKvLayer kv, uint kv_head, uint committed_tokens, uint active_rows, uint splits,
+    uint split, device float *partials, device float *statistics, ulong slot,
+    threadgroup float *scores, threadgroup bfloat *probabilities,
+    threadgroup float *row_max, threadgroup float *row_sum,
+    threadgroup float *previous_scale, threadgroup atomic_uint *rescale,
+    threadgroup SplashTurboTileElement *kv_tile, uint thread_index, uint simd_lane,
+    uint simd_group) {
+  constexpr ushort M = RowsPerTile * QueryHeadsPerKVHead;
+  constexpr ushort N = SplashKvPageTokens;
+  constexpr ushort D = SplashKvHeadDimension;
+  static_assert(D / 32 == 8, "eight simdgroups dequantize one chunk each");
+  static_assert(uint(M) * N * sizeof(float) >= (256 + 8) * 16,
+                "the score tile stages a page's packed keys");
+  uint visible_tokens = committed_tokens + active_rows;
+  uint pages = splash_attention_pages(visible_tokens);
+  uint per_split = splash_attention_pages_per_split(pages, splits);
+  uint page_begin = split * per_split;
+  if (page_begin >= pages)
+    return;
+  uint page_end = min(pages, page_begin + per_split);
+  if (thread_index < M) {
+    row_max[thread_index] = -INFINITY;
+    row_sum[thread_index] = 0.0f;
+  }
+  threadgroup_barrier(mem_flags::mem_threadgroup);
+
+  auto qt = tensor(tile_queries, dextents<int, 2>{D, M}, array<int, 2>{1, D});
+  auto st = tensor(scores, dextents<int, 2>{N, M}, array<int, 2>{1, N});
+  auto pt = tensor(probabilities, dextents<int, 2>{N, M}, array<int, 2>{1, N});
+  auto kt = tensor(kv_tile, dextents<int, 2>{D, N}, array<int, 2>{1, D});
+  auto vt = tensor(kv_tile, dextents<int, 2>{N, D}, array<int, 2>{1, N});
+  auto p0 = pt.slice<N, M>(0, 0);
+  auto q0 = qt.slice<D, M>(0, 0);
+  auto k0 = kt.template slice<D, N>(0, 0);
+  auto v0 = vt.template slice<N, D>(0, 0);
+  const SplashTurboAddressing<KVHeads> addressing(kv, kv_head);
+  constexpr auto qk_descriptor =
+      matmul2d_descriptor(M, N, D, false, true, false,
+                          matmul2d_descriptor::mode::multiply);
+  constexpr auto pv_descriptor =
+      matmul2d_descriptor(M, D, N, false, true, true,
+                          matmul2d_descriptor::mode::multiply_accumulate);
+  matmul2d<qk_descriptor, execution_simdgroups<8>> qk;
+  matmul2d<pv_descriptor, execution_simdgroups<8>> pv;
+  auto running = pv.template get_destination_cooperative_tensor<
+      decltype(p0), decltype(v0), float>();
+  const bool running_full =
+      uint(running.get_capacity()) * (8u * 32u) == uint(M) * D;
+#pragma unroll
+  for (ushort index = 0; index < running.get_capacity(); ++index) {
+    if (running_full || running.is_valid_element(index))
+      running[index] = 0.0f;
+  }
+
+  for (uint page = page_begin; page < page_end; ++page) {
+    const SplashTurboPageTensors tensors = addressing.page(page_table[page]);
+    uint token_start = page * N;
+    const uint valid_tokens = min(uint(N), visible_tokens - token_start);
+    // The previous page's softmax consumed the scores: they stage the keys.
+    splash_turbo_dequantize_keys(tensors, kv_tile,
+                                 reinterpret_cast<threadgroup uint4 *>(scores), valid_tokens,
+                                 thread_index, simd_lane, simd_group);
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    auto page_scores = qk.template get_destination_cooperative_tensor<
+        decltype(q0), decltype(k0), float>();
+    qk.run(q0, k0, page_scores);
+    page_scores.store(st.slice<N, M>(0, 0));
+    if (thread_index == 0)
+      atomic_store_explicit(rescale, 0u, memory_order_relaxed);
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    splash_attention_page_softmax<QueryHeadsPerKVHead, RowsPerTile, false>(
+        scores, probabilities, row_max, row_sum, previous_scale, rescale,
+        nullptr, nullptr, token_start, visible_tokens, committed_tokens,
+        active_rows, thread_index);
+    // QK finished reading the keys before the barrier above; the values
+    // take the tile over while the softmax runs.
+    splash_turbo_dequantize_values(tensors, kv_tile, valid_tokens, simd_lane, simd_group);
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    if (atomic_load_explicit(rescale, memory_order_relaxed)) {
+#pragma unroll
+      for (ushort index = 0; index < running.get_capacity(); ++index) {
+        if (!running_full && !running.is_valid_element(index))
+          continue;
+        auto coordinates = running.get_multidimensional_index(index);
+        running[index] *= previous_scale[coordinates[1]];
+      }
+    }
+    pv.run(p0, v0, running);
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+  }
+  auto target = tensor(partials + slot * M * D, dextents<int, 2>{D, M},
+                       array<int, 2>{1, D});
+  running.store(target.slice<D, M>(0, 0));
+  if (thread_index < M) {
+    statistics[(slot * M + thread_index) * 2] = row_max[thread_index];
+    statistics[(slot * M + thread_index) * 2 + 1] = row_sum[thread_index];
+  }
+}
+
+// ---- TurboQuant int4 pages (turbo_kv.h) -----------------------------------
+// The INT8 tile with 4-bit operands: MPP multiplies the rotated queries by the
+// int4 keys and the probabilities by the int4 values straight from the pages,
+// both token-major, and the softmax applies the per-token fp32 scales as for
+// INT8. No dequantization loop; the reduce rotates the output back.
+template <uint KVHeads, uint QueryHeadsPerKVHead, uint RowsPerTile>
+inline void splash_paged_attention_turbo_int4_tile(
+    device bfloat *tile_queries, device const SplashKvPage *page_table,
+    SplashKvLayer kv, uint kv_head, uint committed_tokens, uint active_rows, uint splits,
+    uint split, device float *partials, device float *statistics, ulong slot,
+    threadgroup float *scores, threadgroup bfloat *probabilities,
+    threadgroup float *row_max, threadgroup float *row_sum,
+    threadgroup float *previous_scale, threadgroup atomic_uint *rescale,
+    uint thread_index) {
+  constexpr ushort M = RowsPerTile * QueryHeadsPerKVHead;
+  constexpr ushort N = SplashKvPageTokens;
+  constexpr ushort D = SplashKvHeadDimension;
+  uint visible_tokens = committed_tokens + active_rows;
+  uint pages = splash_attention_pages(visible_tokens);
+  uint per_split = splash_attention_pages_per_split(pages, splits);
+  uint page_begin = split * per_split;
+  if (page_begin >= pages)
+    return;
+  uint page_end = min(pages, page_begin + per_split);
+  if (thread_index < M) {
+    row_max[thread_index] = -INFINITY;
+    row_sum[thread_index] = 0.0f;
+  }
+  threadgroup_barrier(mem_flags::mem_threadgroup);
+
+  // int4b_format tensors take byte pointers and the dense layout: element
+  // (d, n) of a page slab at d + n * D, keys and values alike.
+  using Int4Tensor = tensor<device int4b_format, dextents<int, 2>, tensor_inline>;
+  auto qt = tensor(tile_queries, dextents<int, 2>{D, M}, array<int, 2>{1, D});
+  auto st = tensor(scores, dextents<int, 2>{N, M}, array<int, 2>{1, N});
+  auto pt = tensor(probabilities, dextents<int, 2>{N, M}, array<int, 2>{1, N});
+  auto p0 = pt.slice<N, M>(0, 0);
+  auto q0 = qt.slice<D, M>(0, 0);
+  auto operand_type = Int4Tensor(static_cast<device uchar *>(nullptr), dextents<int, 2>{D, N});
+  auto k0 = operand_type.template slice<D, N>(0, 0);
+  auto v0 = operand_type.template slice<D, N>(0, 0);
+  const SplashTurboInt4Addressing<KVHeads> addressing(kv, kv_head);
+  constexpr auto qk_descriptor =
+      matmul2d_descriptor(M, N, D, false, true, false,
+                          matmul2d_descriptor::mode::multiply);
+  // Token-major values: PV takes them untransposed.
+  constexpr auto pv_descriptor =
+      matmul2d_descriptor(M, D, N, false, false, true,
+                          matmul2d_descriptor::mode::multiply_accumulate);
+  matmul2d<qk_descriptor, execution_simdgroups<8>> qk;
+  matmul2d<pv_descriptor, execution_simdgroups<8>> pv;
+  auto running = pv.template get_destination_cooperative_tensor<
+      decltype(p0), decltype(v0), float>();
+  const bool running_full =
+      uint(running.get_capacity()) * (8u * 32u) == uint(M) * D;
+#pragma unroll
+  for (ushort index = 0; index < running.get_capacity(); ++index) {
+    if (running_full || running.is_valid_element(index))
+      running[index] = 0.0f;
+  }
+
+  for (uint page = page_begin; page < page_end; ++page) {
+    const SplashTurboInt4PageTensors tensors = addressing.page(page_table[page]);
+    uint token_start = page * N;
+    auto kt = Int4Tensor(tensors.keys, dextents<int, 2>{D, N});
+    auto vt = Int4Tensor(tensors.values, dextents<int, 2>{D, N});
+    auto page_scores = qk.template get_destination_cooperative_tensor<
+        decltype(q0), decltype(k0), float>();
+    auto ks = kt.template slice<D, N>(0, 0);
+    qk.run(q0, ks, page_scores);
+    page_scores.store(st.slice<N, M>(0, 0));
+    if (thread_index == 0)
+      atomic_store_explicit(rescale, 0u, memory_order_relaxed);
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    splash_attention_page_softmax<QueryHeadsPerKVHead, RowsPerTile, true>(
+        scores, probabilities, row_max, row_sum, previous_scale, rescale,
+        reinterpret_cast<device const float4 *>(tensors.key_scales),
+        reinterpret_cast<device const float4 *>(tensors.value_scales), token_start,
+        visible_tokens, committed_tokens, active_rows, thread_index);
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    if (atomic_load_explicit(rescale, memory_order_relaxed)) {
+#pragma unroll
+      for (ushort index = 0; index < running.get_capacity(); ++index) {
+        if (!running_full && !running.is_valid_element(index))
+          continue;
+        auto coordinates = running.get_multidimensional_index(index);
+        running[index] *= previous_scale[coordinates[1]];
+      }
+    }
+    auto vs = vt.template slice<D, N>(0, 0);
+    pv.run(p0, vs, running);
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+  }
+  auto target = tensor(partials + slot * M * D, dextents<int, 2>{D, M},
+                       array<int, 2>{1, D});
+  running.store(target.slice<D, M>(0, 0));
+  if (thread_index < M) {
+    statistics[(slot * M + thread_index) * 2] = row_max[thread_index];
+    statistics[(slot * M + thread_index) * 2 + 1] = row_sum[thread_index];
+  }
 }
