+  if (atomic_fetch_add_explicit(&mismatch[0], 1u, memory_order_relaxed) == 0) {
+    atomic_store_explicit(&mismatch[1], pass, memory_order_relaxed);
+    atomic_store_explicit(&mismatch[2], t, memory_order_relaxed);
+    atomic_store_explicit(&mismatch[3], first, memory_order_relaxed);
+    atomic_store_explicit(&mismatch[4], firstValues, memory_order_relaxed);
