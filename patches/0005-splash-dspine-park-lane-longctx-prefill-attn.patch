+void Cache::adoptRequest(uint64_t from, uint64_t to) {
+  if (!to)
+    throw std::invalid_argument("invalid request id");
+  const auto found = requests_.find(from);
+  if (found == requests_.end())
+    throw std::out_of_range("unknown request");
+  if (found->second.pendingRestores || found->second.restoreFailed)
+    throw std::logic_error("an adopted request has KV restores of its own");
+  if (from == to)
+    return;
+  if (requests_.contains(to))
+    throw std::invalid_argument("duplicate request id");
+  auto entry = requests_.extract(found);
+  entry.key() = to;
+  requests_.insert(std::move(entry));
+}
