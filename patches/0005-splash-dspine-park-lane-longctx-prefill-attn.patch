+StateAdmission Runtime::adopt(uint64_t parkedId, const ModelRequest &request) {
+  const auto found = impl_->requests.find(parkedId);
+  if (found == impl_->requests.end() || !found->second.parked)
+    throw std::logic_error("no parked lane to adopt");
+  const uint32_t stateLane = found->second.stateLane;
+  const QwenLogicalLengths lengths = impl_->states.metadata(stateLane).lengths;
+  // The lane holds the request's first restoredTokens tokens and prefill
+  // goes on from there; at least one prompt token is left to select from, or
+  // to score (the engine adopts no score request; the runtime oracle test
+  // reads the adopted path's logits through one).
+  if (!request.id || !request.restoredTokens ||
+      request.prompt.size() <= request.restoredTokens || !request.images.empty() ||
+      lengths.targetTokens != request.restoredTokens ||
+      !lengths.hasCompleteDraftWindow(draftContextWindow()))
+    return {};
+  if (request.id != parkedId && impl_->requests.contains(request.id))
+    throw std::logic_error("request is already active");
+  // As beginAt() starts a request, on the lane as it is: the recurrent and
+  // conv state, parity, draft ring (either drafter's context) and lengths
+  // stay, while what the parked request selected, sampled or was masked
+  // with ends with its entry. The shortlist decision and the copy history
+  // are the new prompt's, as beginAt() makes them.
+  Impl::Request entry;
+  entry.id = request.id;
+  entry.stateLane = stateLane;
+  entry.resident = true;
+  entry.promptTokens = static_cast<uint32_t>(request.prompt.size());
+  entry.maxNewTokens = request.maxNewTokens;
+  entry.sampling = request.sampling;
+  entry.constraint = request.constraint;
+  entry.flags = request.flags;
+  entry.restoredTokens = request.restoredTokens;
+  entry.fullDraftHead = impl_->promptLeavesShortlist(request.prompt);
+  entry.scoreTokens.assign(request.scoreTokens.begin(), request.scoreTokens.end());
+  if (Impl::draftCopyEnabled())
+    entry.copyHistory.assign(request.prompt.begin(), request.prompt.end());
+  impl_->bindPenalties(entry, request.prompt);
+  impl_->states.reassignLane(stateLane, parkedId, request.id);
+  // The page list is the parked request's, under the new request's id; the
+  // copy history is uploaded afresh under either id.
+  impl_->pageTableBindings[stateLane] = {};
