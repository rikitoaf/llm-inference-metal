+#pragma once
+
+#include <array>
+#include <cstdint>
+#include <filesystem>
+#include <string_view>
+
+namespace splash::model {
+
+// The speculative-decoding drafter a process runs, chosen once from SPLASH_DRAFTER: unset or "dflash2" runs the
+// package's DFlash2 draft (the default; every DFlash2 path is unchanged), "dspine" runs Tencent's DSpine draft
+// (DSpineDraft.hpp) loaded from its safetensors snapshot. Anything else stops the process at startup.
+enum class DrafterKind : uint32_t { DFlash2 = 0, DSpine = 1 };
+
+[[nodiscard]] DrafterKind selectedDrafter();
+[[nodiscard]] std::string_view drafterName(DrafterKind kind) noexcept;
+
+// The draft context window in tokens, which is also the slots of each draft ring: DFlash2's 2048
+// (SPLASH_DRAFT_SLIDING_WINDOW), or for DSpine SPLASH_DSPINE_WINDOW (default 8192, its trained window; a multiple
+// of 128 from 2048 to 8192). Every draft row of a request attends the window's last positions before its anchor.
+[[nodiscard]] uint32_t draftContextWindow();
+
+// The DSpine checkpoint directory (config.json, model.safetensors): SPLASH_DSPINE_DIR, or the Hugging Face cache
+// snapshot of tencent/Qwen3.8-27B-DSpine-b16 that stage 1 used.
+[[nodiscard]] std::filesystem::path dspineCheckpointDirectory();
+
+// The target layers (0-based; their outputs, HF hidden_states[L + 1]) DSpine reads, from its dflash_config.
+inline constexpr std::array<uint32_t, 5> kDSpineCaptureLayers{1, 16, 31, 46, 61};
+// The largest DSpine context window the kernels and rings support.
+inline constexpr uint32_t kDSpineMaximumWindow = 8192;
+
+} // namespace splash::model
