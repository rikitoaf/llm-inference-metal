diff --git a/dev/benchmarks/dspine_golden.mm b/dev/benchmarks/dspine_golden.mm
new file mode 100644
index 0000000..5c4ba2a
--- /dev/null
+++ b/dev/benchmarks/dspine_golden.mm
@@ -0,0 +1,351 @@
+// DSpine Metal port vs Tencent's MLX reference (golden files of dev/golden/dspine, phase0.py golden).
+//
+//   SPLASH_DRAFTER=dspine SPLASH_DSPINE_WINDOW=2048 dspine-golden METALLIB MODEL_ROOT GOLDEN_DIR [--report FILE]
+//
+// Loads the package with the DSpine draft, writes the golden context rows into a window-2048 ring through the
+// production context writer (DSpineDraft::addContextPrefill), and for each golden cycle, in order (the ring takes
+// the rows between cycles), runs the production draft forward (DSpineDraft::addDecode, 16 rows, the head shortlist)
+// and compares with the reference: final normed rows, the last layer's stash (raw, rms, q), the candidate sets and
+// the refinement tables (matched by token ids), plus the decision the tree draws from them (the greedy chain). The
+// report is JSON; the exit code is 0 when every tolerance holds (they are bf16-level, see DSPINE-PORT.md).
+
+#include "metal/MetalBackend.hpp"
+#include "model/DSpineDraft.hpp"
+#include "model/ModelFactory.hpp"
+#include "model/QwenTarget.hpp"
+#include "model/RuntimeArenas.hpp"
+#include "ops/RoPE.hpp"
+
+#import <Foundation/Foundation.h>
+
+#include <algorithm>
+#include <cmath>
+#include <cstdio>
+#include <cstring>
+#include <filesystem>
+#include <fstream>
+#include <iostream>
+#include <map>
+#include <sstream>
+#include <string>
+#include <vector>
+
+using namespace splash;
+using namespace splash::model;
+
+namespace {
+
+struct NpyArray final {
+  std::string descr;
+  std::vector<size_t> shape;
+  std::vector<char> data;
+  size_t count() const {
+    size_t n = 1;
+    for (size_t d : shape) n *= d;
+    return n;
+  }
+  template <class T> const T *as() const { return reinterpret_cast<const T *>(data.data()); }
+};
+
+NpyArray readNpy(const std::filesystem::path &path) {
+  std::ifstream file(path, std::ios::binary);
+  if (!file) throw std::runtime_error("cannot read " + path.string());
+  char magic[6];
+  file.read(magic, 6);
+  if (std::memcmp(magic, "\x93NUMPY", 6) != 0) throw std::runtime_error("not an npy file: " + path.string());
+  uint8_t version[2];
+  file.read(reinterpret_cast<char *>(version), 2);
+  uint32_t headerLength = 0;
+  if (version[0] == 1) {
+    uint16_t length = 0;
+    file.read(reinterpret_cast<char *>(&length), 2);
+    headerLength = length;
+  } else {
+    file.read(reinterpret_cast<char *>(&headerLength), 4);
+  }
+  std::string header(headerLength, '\0');
+  file.read(header.data(), headerLength);
+  NpyArray result;
+  const auto descr = header.find("'descr': '");
+  result.descr = header.substr(descr + 10, header.find('\'', descr + 10) - descr - 10);
+  if (header.find("'fortran_order': False") == std::string::npos) throw std::runtime_error("fortran npy");
+  const auto open = header.find('(', header.find("'shape'")), close = header.find(')', open);
+  std::stringstream dims(header.substr(open + 1, close - open - 1));
+  for (std::string part; std::getline(dims, part, ',');)
+    if (part.find_first_not_of(' ') != std::string::npos) result.shape.push_back(std::stoul(part));
+  const size_t item = result.descr.back() == '8' ? 8 : result.descr.back() == '4' ? 4 : 2;
+  result.data.resize(result.count() * item);
+  file.read(result.data.data(), result.data.size());
+  if (!file) throw std::runtime_error("truncated npy " + path.string());
+  return result;
+}
+
+float bf16(uint16_t bits) {
+  const uint32_t value = uint32_t(bits) << 16;
+  float out;
+  std::memcpy(&out, &value, 4);
+  return out;
+}
+
+struct Stats final {
+  double maxAbs = 0, maxRef = 0, sumAbs = 0, cosineMin = 1, cosineSum = 0;
+  size_t count = 0, rows = 0;
+  void rowsOf(const float *ours, const float *reference, size_t rowCount, size_t width) {
+    for (size_t r = 0; r < rowCount; ++r) {
+      double dot = 0, a2 = 0, b2 = 0;
+      for (size_t c = 0; c < width; ++c) {
+        const double a = ours[r * width + c], b = reference[r * width + c];
+        maxAbs = std::max(maxAbs, std::abs(a - b));
+        maxRef = std::max(maxRef, std::abs(b));
+        sumAbs += std::abs(a - b);
+        dot += a * b;
+        a2 += a * a;
+        b2 += b * b;
+        ++count;
+      }
+      const double cosine = (a2 > 0 && b2 > 0) ? dot / std::sqrt(a2 * b2) : (a2 == b2 ? 1.0 : 0.0);
+      cosineMin = std::min(cosineMin, cosine);
+      cosineSum += cosine;
+      ++rows;
+    }
+  }
+  std::string json() const {
+    char text[256];
+    std::snprintf(text, sizeof text,
+                  "{\"max_abs\":%.6g,\"max_ref\":%.6g,\"rel_max\":%.6g,\"mean_abs\":%.6g,\"cosine_min\":%.8f,"
+                  "\"cosine_mean\":%.8f}",
+                  maxAbs, maxRef, maxRef > 0 ? maxAbs / maxRef : 0.0, count ? sumAbs / count : 0.0, cosineMin,
+                  rows ? cosineSum / rows : 1.0);
+    return text;
+  }
+};
+
+std::vector<float> widen(const uint16_t *bits, size_t count) {
+  std::vector<float> out(count);
+  for (size_t i = 0; i < count; ++i) out[i] = bf16(bits[i]);
+  return out;
+}
+
+// The greedy chain draft_select_dflash's T = 0 walk takes over tables [positions][16][16] (unary 0).
+std::vector<uint32_t> greedyChain(const uint32_t *candidates, const float *tables, uint32_t positions) {
+  std::vector<uint32_t> chain;
+  uint32_t from = 0;
+  for (uint32_t d = 0; d < positions; ++d) {
+    uint32_t best = 0;
+    for (uint32_t j = 1; j < 16; ++j)
+      if (tables[(d * 16 + from) * 16 + j] > tables[(d * 16 + from) * 16 + best]) best = j;
+    chain.push_back(candidates[d * 16 + best]);
+    from = best;
+  }
+  return chain;
+}
+
+} // namespace
+
+int main(int argc, char **argv) {
+  @autoreleasepool {
+    try {
+      if (argc < 4) {
+        std::cerr << "usage: dspine-golden METALLIB MODEL_ROOT GOLDEN_DIR [--report FILE]\n";
+        return 2;
+      }
+      std::string reportPath;
+      for (int i = 4; i + 1 < argc; i += 2)
+        if (std::string_view(argv[i]) == "--report") reportPath = argv[i + 1];
+      if (selectedDrafter() != DrafterKind::DSpine)
+        throw std::invalid_argument("set SPLASH_DRAFTER=dspine");
+      const std::filesystem::path golden(argv[3]);
+      NSData *metaData = [NSData dataWithContentsOfFile:[NSString stringWithUTF8String:(golden / "meta.json").c_str()]];
+      NSDictionary *meta = [NSJSONSerialization JSONObjectWithData:metaData options:0 error:nil];
+      const uint32_t window = [meta[@"window"] unsignedIntValue];
+      const uint32_t contextFirst = [meta[@"context_first_position"] unsignedIntValue];
+      if (window != draftContextWindow())
+        throw std::invalid_argument("the goldens use window " + std::to_string(window) + ": set SPLASH_DSPINE_WINDOW");
+      const NpyArray contextHidden = readNpy(golden / "context_hidden.npy");
+      const NpyArray anchors = readNpy(golden / "anchors.npy"), positionsNpy = readNpy(golden / "positions.npy");
+      const NpyArray refFinal = readNpy(golden / "final_normed.npy"), refRaw = readNpy(golden / "stash_raw.npy");
+      const NpyArray refRms = readNpy(golden / "stash_rms.npy"), refPacked = readNpy(golden / "stash_packed.npy");
+      const NpyArray refCandidates = readNpy(golden / "candidates.npy"), refTables = readNpy(golden / "tables.npy");
+      const NpyArray refProjected = readNpy(golden / "context_projected.npy");
+      const size_t cycles = anchors.count();
+
+      metal::MetalBackend backend(argv[1]);
+      const std::filesystem::path root(argv[2]);
+      ModelPackage package = loadModelPackage(backend, root, inspectModelPackage(root));
+      ops::ExecutionPlans operators(backend.capabilities());
+      const RuntimeGeometry geometry = RuntimeGeometry::from(package, kv::Format::TurboInt4);
+      QwenTarget target(std::get<Qwen3_8Weights>(package.target), geometry.target, backend, operators);
+      DSpineDraft draft(package.dspine, backend, operators);
+      PrefillArena prefill(backend, geometry, operators);
+      DecodeArena decode(backend, geometry, operators);
+      const auto shortlist = dflashHeadShortlist(backend, target.vocabularyProjection(), 98304, 248044);
+
+      // The lane's ring: DSpine's window of slots per KV head, keys [head][slot][dim], values [head][dim][slot].
+      const DraftStateLayout ringLayout = geometry.draft.stateLayout();
+      std::vector<DFlashDraftRingLayer> ring(ringLayout.layers);
+      for (auto &layer : ring) {
+        layer.keys = backend.allocateBuffer(ringLayout.tensorBytes(), metal::BufferStorage::Shared, "golden-ring-k");
+        layer.values = backend.allocateBuffer(ringLayout.tensorBytes(), metal::BufferStorage::Shared, "golden-ring-v");
+        std::memset(layer.keys.contents(), 0, layer.keys.sizeBytes());
+        std::memset(layer.values.contents(), 0, layer.values.sizeBytes());
+      }
+      const uint32_t width = geometry.target.capturedHiddenSize();
+      const auto writeContext = [&](uint32_t begin, uint32_t end) {
+        for (uint32_t start = begin; start < end;) {
+          const uint32_t rows = std::min<uint32_t>(end - start, ExecutionLimits::prefillTokenBudget);
+          std::memcpy(prefill.get(PrefillTensor::Captured).contents(),
+                      contextHidden.as<uint16_t>() + uint64_t(start - contextFirst) * width,
+                      uint64_t(rows) * width * 2);
+          auto *draftPositions = static_cast<uint32_t *>(prefill.get(PrefillTensor::DraftPositions).contents());
+          for (uint32_t r = 0; r < rows; ++r) draftPositions[r] = start + r;
+          metal::CommandGraph graph;
+          ops::RoPE::addTables(graph, prefill.get(PrefillTensor::TargetPositions),
+                               prefill.get(PrefillTensor::DraftPositions),
+                               prefill.get(PrefillTensor::TargetInverseFrequencies),
+                               prefill.get(PrefillTensor::DraftInverseFrequencies),
+                               prefill.get(PrefillTensor::RopeCos), prefill.get(PrefillTensor::RopeSin),
+                               prefill.get(PrefillTensor::DraftRopeCos), prefill.get(PrefillTensor::DraftRopeSin),
+                               {1, rows}, ExecutionLimits::prefillTokenBudget);
+          const DFlashPrefillSpan span{0, rows, start, ring};
+          draft.addContextPrefill(graph,
+                                  {prefill.get(PrefillTensor::Captured), prefill.get(PrefillTensor::ProjectionSums),
+                                   prefill.get(PrefillTensor::ContextProjected),
+                                   prefill.get(PrefillTensor::ContextHidden), prefill.get(PrefillTensor::ContextKv),
+                                   prefill.get(PrefillTensor::DraftRopeCos), prefill.get(PrefillTensor::DraftRopeSin)},
+                                  rows, std::span(&span, 1));
+          static_cast<void>(backend.submitCommand(graph.dispatches()));
+          start += rows;
+        }
+      };
+
+      Stats finalStats, rawStats, rmsStats, qStats, tableStats, projectedStats;
+      double overlapSum = 0, overlapMin = 1;
+      size_t tableMatched = 0, tableTotal = 0, chainFirstAgree = 0, chainPrefixSum = 0;
+      std::vector<double> tableDiffs;
+      uint32_t written = contextFirst;
+      for (size_t c = 0; c < cycles; ++c) {
+        const uint32_t anchor = anchors.as<int32_t>()[c];
+        const uint32_t position = static_cast<uint32_t>(positionsNpy.as<int64_t>()[c]);
+        writeContext(written, position);
+        if (c == 0) {
+          // The context projection hidden_norm(fc(rows)) of the last prefill chunk, against the reference's.
+          const uint32_t rows = std::min<uint32_t>(position - contextFirst, ExecutionLimits::prefillTokenBudget);
+          const uint32_t first = position - rows;
+          const auto ours = widen(static_cast<const uint16_t *>(prefill.get(PrefillTensor::ContextHidden).contents()),
+                                  uint64_t(rows) * 5120);
+          const auto reference = widen(refProjected.as<uint16_t>() + uint64_t(first - contextFirst) * 5120,
+                                       uint64_t(rows) * 5120);
+          projectedStats.rowsOf(ours.data(), reference.data(), rows, 5120);
+        }
+        written = position;
+        // The block: anchor + 15 masks, embedded by the target's table; RoPE positions p .. p + 15.
+        auto *tokens = static_cast<uint32_t *>(decode.get(0, DecodeTensor::DraftInputTokens).contents());
+        auto *blockPositions = static_cast<uint32_t *>(decode.get(0, DecodeTensor::DraftPositions).contents());
+        for (uint32_t r = 0; r < 16; ++r) {
+          tokens[r] = r ? package.dspine.layout.maskToken : anchor;
+          blockPositions[r] = position + r;
+        }
+        metal::CommandGraph graph;
+        ops::RoPE::addTables(graph, decode.get(0, DecodeTensor::Positions), decode.get(0, DecodeTensor::DraftPositions),
+                             prefill.get(PrefillTensor::TargetInverseFrequencies),
+                             prefill.get(PrefillTensor::DraftInverseFrequencies), decode.get(0, DecodeTensor::RopeCos),
+                             decode.get(0, DecodeTensor::RopeSin), decode.get(0, DecodeTensor::DraftRopeCos),
+                             decode.get(0, DecodeTensor::DraftRopeSin), {1, 16}, 16);
+        target.addEmbedding(graph, decode.get(0, DecodeTensor::DraftInputTokens), decode.get(0, DecodeTensor::DraftHidden0),
+                            16);
+        DSpineDecodeInputs inputs{decode.get(0, DecodeTensor::DraftHidden0), decode.get(0, DecodeTensor::DraftRopeCos),
+                                  decode.get(0, DecodeTensor::DraftRopeSin), ring, decode.get(0, DecodeTensor::Logits),
+                                  decode.linearScratch(), decode.gateScratch()};
+        draft.addDecode(graph, inputs, target.vocabularyProjection(), position, anchor, 16,
+                        shortlist ? &*shortlist : nullptr);
+        static_cast<void>(backend.submitCommand(graph.dispatches()));
+
+        const ops::DSpineScratch &s = draft.scratch();
+        const auto final = widen(static_cast<const uint16_t *>(s.finalNormed.contents()), 16 * 5120);
+        const auto refF = widen(refFinal.as<uint16_t>() + c * 16 * 5120, 16 * 5120);
+        finalStats.rowsOf(final.data(), refF.data(), 16, 5120);
+        const auto raw = widen(static_cast<const uint16_t *>(s.layerOutput.contents()), 16 * 5120);
+        const auto refR = widen(refRaw.as<uint16_t>() + c * 16 * 5120, 16 * 5120);
+        rawStats.rowsOf(raw.data(), refR.data(), 16, 5120);
+        rmsStats.rowsOf(static_cast<const float *>(s.rowRms.contents()), refRms.as<float>() + c * 16, 1, 16);
+        std::vector<float> q(16 * 512), refQ(16 * 512);
+        const auto *packed = static_cast<const uint16_t *>(s.packed.contents());
+        for (uint32_t r = 0; r < 16; ++r)
+          for (uint32_t k = 0; k < 512; ++k) {
+            q[r * 512 + k] = bf16(packed[r * 1536 + k]);
+            refQ[r * 512 + k] = bf16(refPacked.as<uint16_t>()[(c * 16 + r) * 1536 + k]);
+          }
+        qStats.rowsOf(q.data(), refQ.data(), 16, 512);
+
+        const auto *candidates = static_cast<const uint32_t *>(s.candidates.contents());
+        const auto *tables = static_cast<const float *>(s.tables.contents());
+        const int32_t *refC = refCandidates.as<int32_t>() + c * 15 * 16;
+        const float *refT = refTables.as<float>() + c * 15 * 16 * 16;
+        for (uint32_t i = 0; i < 15; ++i) {
+          std::map<uint32_t, uint32_t> refIndex, prevRefIndex;
+          for (uint32_t j = 0; j < 16; ++j) refIndex[refC[i * 16 + j]] = j;
+          if (i) for (uint32_t j = 0; j < 16; ++j) prevRefIndex[refC[(i - 1) * 16 + j]] = j;
+          uint32_t overlap = 0;
+          for (uint32_t j = 0; j < 16; ++j) overlap += refIndex.count(candidates[i * 16 + j]);
+          overlapSum += overlap / 16.0;
+          overlapMin = std::min(overlapMin, overlap / 16.0);
+          for (uint32_t k = 0; k < 16; ++k) {
+            // Row 0's predecessor is the anchor for every k; later rows match k by its token.
+            int refK = 0;
+            if (i) {
+              const auto found = prevRefIndex.find(candidates[(i - 1) * 16 + k]);
+              if (found == prevRefIndex.end()) { tableTotal += 16; continue; }
+              refK = int(found->second);
+            }
+            for (uint32_t j = 0; j < 16; ++j) {
+              ++tableTotal;
+              const auto found = refIndex.find(candidates[i * 16 + j]);
+              if (found == refIndex.end()) continue;
+              const float ours = tables[(i * 16 + k) * 16 + j];
+              const float reference = refT[(i * 16 + refK) * 16 + found->second];
+              tableDiffs.push_back(std::abs(double(ours) - reference));
+              tableStats.maxAbs = std::max(tableStats.maxAbs, std::abs(double(ours) - reference));
+              tableStats.maxRef = std::max(tableStats.maxRef, std::abs(double(reference)));
+              ++tableMatched;
+            }
+          }
+        }
+        std::vector<uint32_t> refCandidatesU(refC, refC + 15 * 16);
+        const auto ourChain = greedyChain(candidates, tables, 15);
+        const auto refChain = greedyChain(refCandidatesU.data(), refT, 15);
+        chainFirstAgree += ourChain[0] == refChain[0];
+        size_t prefix = 0;
+        while (prefix < 15 && ourChain[prefix] == refChain[prefix]) ++prefix;
+        chainPrefixSum += prefix;
+        std::printf("cycle %zu p=%u anchor=%u: final cos_min %.6f, candidates overlap %.3f, chain prefix %zu/15\n",
+                    c, position, anchor, finalStats.cosineMin, overlapSum / ((c + 1) * 15.0), prefix);
+        std::fflush(stdout);
+      }
+      std::sort(tableDiffs.begin(), tableDiffs.end());
+      const double tableMedian = tableDiffs.empty() ? 0 : tableDiffs[tableDiffs.size() / 2];
+      const double tableP99 = tableDiffs.empty() ? 0 : tableDiffs[tableDiffs.size() * 99 / 100];
+      const double overlapMean = overlapSum / (cycles * 15.0);
+      const double chainFirst = double(chainFirstAgree) / cycles, chainPrefix = double(chainPrefixSum) / cycles;
+      // Tolerances: bf16 activations through 5 layers (the reference itself moves ~1% of a row's max between 8- and
+      // 16-row GEMMs), candidate lists equal up to near-ties, tables close in logits, the tree's decisions alike.
+      const bool pass = projectedStats.cosineMin > 0.9999 && finalStats.cosineMin > 0.999 &&
+                        rawStats.cosineMin > 0.999 && qStats.cosineMin > 0.999 && overlapMean >= 0.95 &&
+                        tableMedian < 0.05 && tableP99 < 0.5 && chainFirst >= 0.9;
+      std::ostringstream report;
+      report << "{\"cycles\":" << cycles << ",\"window\":" << window << ",\"context_projected\":" << projectedStats.json()
+             << ",\"final_normed\":" << finalStats.json() << ",\"stash_raw\":" << rawStats.json()
+             << ",\"stash_rms\":" << rmsStats.json() << ",\"stash_q\":" << qStats.json()
+             << ",\"candidate_overlap_mean\":" << overlapMean << ",\"candidate_overlap_min\":" << overlapMin
+             << ",\"tables_matched\":" << tableMatched << ",\"tables_total\":" << tableTotal
+             << ",\"table_abs_median\":" << tableMedian << ",\"table_abs_p99\":" << tableP99
+             << ",\"table_abs_max\":" << tableStats.maxAbs << ",\"chain_first_agree\":" << chainFirst
+             << ",\"chain_prefix_mean\":" << chainPrefix << ",\"pass\":" << (pass ? "true" : "false") << "}\n";
+      std::cout << report.str();
+      if (!reportPath.empty()) std::ofstream(reportPath) << report.str();
+      return pass ? 0 : 1;
+    } catch (const std::exception &error) {
+      std::cerr << "dspine-golden: " << error.what() << '\n';
+      return 2;
+    }
+  }
+}
