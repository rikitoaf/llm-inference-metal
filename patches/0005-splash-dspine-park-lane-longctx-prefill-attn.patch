+bool Runtime::park(uint64_t requestId, uint32_t committedTokens) {
+  const auto found = impl_->requests.find(requestId);
+  if (found == impl_->requests.end())
+    return false;
+  Impl::Request &entry = found->second;
+  // A finished lane between commands: its prompt is done, its selection
+  // committed (no mask in flight or awaited) and its committed state is the
+  // engine's committed tokens. A terminal anchor (a stop token or the last
+  // budgeted token) has no KV row and is not among them.
+  if (entry.parked || !entry.resident || !entry.promptComplete ||
+      entry.replayingGeneration || entry.verifyMaskInFlight ||
+      entry.decodeStage != DecodeStage::Regular || !entry.scoreTokens.empty() ||
+      !entry.images.empty() || !committedTokens)
