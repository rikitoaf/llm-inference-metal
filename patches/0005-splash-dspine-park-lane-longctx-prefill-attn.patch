+// Grid positions, 32 threads: row `position`'s top 16 from its shard partials, candidates [position][16] in rank
+// order.
+kernel void dspine_merge_candidates(device const uint *partial_ids [[buffer(0)]],
+                                    device const float *partial_values [[buffer(1)]],
+                                    device uint *candidates [[buffer(2)]],
+                                    uint position [[threadgroup_position_in_grid]],
+                                    uint lane [[thread_index_in_simdgroup]]) {
+  float value;
+  uint token;
+  top16_merge_shards(partial_ids, partial_values, position, lane, value, token);
+  if (lane < SPLASH_DSPINE_CANDIDATES)
+    candidates[position * SPLASH_DSPINE_CANDIDATES + lane] = token;
+}
+
+// SPLASH_VERIFY_ROWS_LONG: marks the tree's tail rows [first_tail_row, Rows) unverified when the expected accepted
+// tokens they add (the sum of their path probabilities by the draft's tables; a copy row's by its calibrated
+// acceptance) is below keep_mass. The decision reads the draft's outputs only, never the target's draws, so the
+// tree stays independent of the cycle's uniforms and sampling stays exact; the verified rows are the tree's first
+// rows, which a best-first tree of that size would hold as well (a copy chain lives in the tail and goes with it).
+inline void draft_tree_cut_improbable_tail(device SplashDraftTree &tree, thread const float *log_probability,
+                                           uint first_tail_row, float keep_mass,
+                                           device SplashVerifyTailReport &report) {
+  constexpr uint Rows = SPLASH_TARGET_VERIFY_ROWS;
+  if (first_tail_row == 0 || first_tail_row >= Rows)
+    return;
+  float tail_mass = 0.0f;
+  for (uint r = 0; r < Rows; ++r) {
+    report.row_log_probability[r] = log_probability[r];
+    if (r >= first_tail_row)
+      tail_mass += exp(log_probability[r]);
+  }
+  report.unverified_rows = 0;
+  if (!(tail_mass < keep_mass))
+    return;
+  for (uint r = first_tail_row; r < Rows; ++r)
+    tree.ancestors[r] |= SPLASH_DRAFT_TREE_ROW_UNVERIFIED;
+  report.unverified_rows = Rows - first_tail_row;
+}
+
+// One thread: draft_select_tree over p.positions positions, the score of child j of a node whose candidate is
+// `from` being tables[position][from][j] (row 0's predecessor is the anchor: every `from` alike, candidate 0 used).
+// Writes the verify rows' tokens, the tree and the rows' RoPE positions (the anchor's plus the depth).
+kernel void dspine_select_tree(device const uint *candidates [[buffer(0)]],
+                               device const float *tables [[buffer(1)]],
+                               device uint *tokens [[buffer(2)]],
+                               device SplashDraftTree *trees [[buffer(3)]],
+                               device uint *positions [[buffer(4)]],
+                               device SplashVerifyTailReport *tail_report [[buffer(5)]],
+                               constant DSpineTreeParams &p [[buffer(6)]],
+                               uint thread_id [[thread_position_in_grid]]) {
+  constexpr uint Rows = SPLASH_TARGET_VERIFY_ROWS;
+  constexpr uint Candidates = SPLASH_DSPINE_CANDIDATES;
+  if (thread_id != 0)
+    return;
+  const uint Positions = p.positions;
+  device SplashDraftTree &tree = trees[0];
+  const auto score = [&](uint position, uint from, uint j) {
+    return tables[(position * Candidates + from) * Candidates + j];
+  };
+  const auto log_normalizer = [&](uint position, uint from) {
+    float maximum = -INFINITY;
+    for (uint j = 0; j < Candidates; ++j)
+      maximum = max(maximum, score(position, from, j));
+    float sum = 0.0f;
+    for (uint j = 0; j < Candidates; ++j)
+      sum += exp(score(position, from, j) - maximum);
+    return maximum + log(sum);
+  };
+  uint candidate[Rows], depth[Rows], parent[Rows], ancestors[Rows], taken[Rows];
+  float log_probability[Rows], normalizer[Rows];
+  candidate[0] = 0;
+  depth[0] = 0;
+  parent[0] = 0xffffffffu;
+  ancestors[0] = 1u;
+  taken[0] = 0;
+  log_probability[0] = 0.0f;
+  normalizer[0] = log_normalizer(0, 0);
+  for (uint r = 1; r < Rows; ++r) {
+    float best = -INFINITY;
+    uint best_node = 0, best_child = 0;
+    for (uint n = 0; n < r; ++n) {
+      if (depth[n] >= Positions)
+        continue;
+      for (uint j = 0; j < Candidates; ++j) {
+        if (taken[n] & (1u << j))
+          continue;
+        const float value = log_probability[n] + score(depth[n], candidate[n], j) - normalizer[n];
+        if (value > best) {
+          best = value;
+          best_node = n;
+          best_child = j;
+        }
+      }
+    }
+    taken[best_node] |= 1u << best_child;
+    candidate[r] = best_child;
+    depth[r] = depth[best_node] + 1;
+    parent[r] = best_node;
+    ancestors[r] = ancestors[best_node] | (1u << r);
+    taken[r] = 0;
+    log_probability[r] = best;
+    normalizer[r] = depth[r] < Positions ? log_normalizer(depth[r], best_child) : 0.0f;
+    tokens[r - 1] = candidates[depth[best_node] * Candidates + best_child];
+  }
+  for (uint r = 0; r < Rows; ++r) {
+    tree.parent[r] = parent[r];
+    tree.depth[r] = depth[r];
+    tree.ancestors[r] = ancestors[r];
+    tree.path[r] = r;
+    for (uint axis = 0; axis < 3; ++axis)
+      positions[r * 3 + axis] = positions[axis] + depth[r];
+  }
+  draft_tree_cut_improbable_tail(tree, log_probability, p.tail_first_row, p.tail_keep_mass, tail_report[0]);
+}
+
+// One threadgroup of 1024: draft_copy_extend on a DSpine tree. The tip is the first row at depth 7; the eight tokens
+// of its path are matched against the history (longest match >= min_match, latest on ties) and the tokens after the
+// match chain below the tip at depths 8.. in the tree's last rows while their prior beats the row they replace.
+kernel void dspine_copy_extend(device const uint *candidates [[buffer(0)]],
+                               device const float *tables [[buffer(1)]],
+                               device uint *tokens [[buffer(2)]],
+                               device SplashDraftTree *trees [[buffer(3)]],
+                               device uint *positions [[buffer(4)]],
+                               device const uint *history [[buffer(5)]],
+                               device SplashDraftCopyOutcome *outcomes [[buffer(6)]],
+                               device SplashVerifyTailReport *tail_report [[buffer(7)]],
+                               constant DSpineTreeParams &params [[buffer(8)]],
+                               uint thread_index [[thread_index_in_threadgroup]],
+                               uint threads [[threads_per_threadgroup]],
+                               uint lane [[thread_index_in_simdgroup]],
+                               uint simd_group [[simdgroup_index_in_threadgroup]]) {
+  constexpr uint Rows = SPLASH_TARGET_VERIFY_ROWS;
+  constexpr uint Candidates = SPLASH_DSPINE_CANDIDATES;
+  constexpr uint Match = SPLASH_DSPINE_COPY_TIP_DEPTH + 1;
+  constexpr uint TipDepth = SPLASH_DSPINE_COPY_TIP_DEPTH;
+  threadgroup uint query[Match];
+  threadgroup uint tip_row;
+  threadgroup uint best[32];
+  device SplashDraftTree &tree = trees[0];
+  const uint length = params.history_tokens;
+  float log_probability[Rows];
+  if (thread_index == 0) {
+    const auto score = [&](uint position, uint from, uint j) {
+      return tables[(position * Candidates + from) * Candidates + j];
+    };
+    uint candidate[Rows];
+    uint tip = 0;
+    candidate[0] = 0;
+    log_probability[0] = 0.0f;
+    for (uint r = 1; r < Rows; ++r) {
+      const uint position = tree.depth[r] - 1, from = candidate[tree.parent[r]];
+      uint j = 0;
+      while (j + 1 < Candidates && candidates[position * Candidates + j] != tokens[r - 1])
+        ++j;
+      float maximum = -INFINITY;
+      for (uint c = 0; c < Candidates; ++c)
+        maximum = max(maximum, score(position, from, c));
+      float sum = 0.0f;
+      for (uint c = 0; c < Candidates; ++c)
+        sum += exp(score(position, from, c) - maximum);
+      log_probability[r] = log_probability[tree.parent[r]] + score(position, from, j) - (maximum + log(sum));
+      candidate[r] = j;
+      if (!tip && tree.depth[r] == TipDepth)
+        tip = r;
+    }
+    tip_row = tip;
+    if (tip) {
+      uint at = tip;
+      for (uint i = Match - 1; i > 0; --i) {
+        query[i] = tokens[at - 1];
+        at = tree.parent[at];
+      }
+      query[0] = params.anchor;
+    }
+  }
+  threadgroup_barrier(mem_flags::mem_threadgroup);
+  const uint tip = tip_row;
+  if (!tip || !length) {
+    if (thread_index == 0) {
+      outcomes[0] = SplashDraftCopyOutcome{0, 0, tip, 0};
+      draft_tree_cut_improbable_tail(tree, log_probability, params.tail_first_row, params.tail_keep_mass, tail_report[0]);
+    }
+    return;
+  }
+  uint found = 0;
+  for (uint i = thread_index; i < length; i += threads) {
+    if (history[i] != query[Match - 1])
+      continue;
+    uint n = 1;
+    while (n < Match && n <= i && history[i - n] == query[Match - 1 - n])
+      ++n;
+    if (n >= params.min_match)
+      found = max(found, (n << 24) | i);
+  }
+  found = simd_max(found);
+  if (lane == 0)
+    best[simd_group] = found;
+  threadgroup_barrier(mem_flags::mem_threadgroup);
+  if (thread_index != 0)
+    return;
+  for (uint group = 1; group < (threads + 31) / 32; ++group)
+    found = max(found, best[group]);
+  if (!found) {
+    outcomes[0] = SplashDraftCopyOutcome{0, 0, tip, 0};
+    draft_tree_cut_improbable_tail(tree, log_probability, params.tail_first_row, params.tail_keep_mass, tail_report[0]);
+    return;
+  }
+  const uint match = found >> 24, end = found & 0xffffffu;
+  constexpr uint CopyRows = Rows - Match;
+  uint copy[CopyRows];
+  for (uint k = 0; k < CopyRows; ++k) {
+    const uint at = end + 1 + k;
+    copy[k] = at < length ? history[at] : query[at - length];
+  }
+  uint rows = 0;
+  float value = log_probability[tip];
+  while (rows < CopyRows && Rows - 1 - rows > tip) {
+    const float next = value + params.log_accept[match - 1][rows];
+    if (!(next > log_probability[Rows - 1 - rows]))
+      break;
+    value = next;
+    ++rows;
+  }
+  for (uint k = 0; k < rows; ++k) {
+    const uint r = Rows - rows + k, parent = k ? r - 1 : tip;
+    tree.parent[r] = parent;
+    tree.depth[r] = TipDepth + 1 + k;
+    tree.ancestors[r] = tree.ancestors[parent] | (1u << r);
+    tree.path[r] = r;
+    tokens[r - 1] = copy[k];
+    for (uint axis = 0; axis < 3; ++axis)
+      positions[r * 3 + axis] = positions[axis] + TipDepth + 1 + k;
+    log_probability[r] = log_probability[parent] + params.log_accept[match - 1][k];
+  }
+  outcomes[0] = SplashDraftCopyOutcome{rows, match, tip, end};
+  draft_tree_cut_improbable_tail(tree, log_probability, params.tail_first_row, params.tail_keep_mass, tail_report[0]);
+}
