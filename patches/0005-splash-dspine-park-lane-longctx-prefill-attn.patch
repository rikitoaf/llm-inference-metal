new file mode 100644
index 0000000..e718c31
--- /dev/null
+++ b/runtime/model/DrafterSelection.cpp
@@ -0,0 +1,53 @@
+#include "model/DrafterSelection.hpp"
+#include "metal/abi/ExecutionGeometry.h"
+
+#include <cstdlib>
+#include <stdexcept>
+#include <string>
+
+namespace splash::model {
+
+DrafterKind selectedDrafter() {
+  static const DrafterKind kind = [] {
+    const char *value = std::getenv("SPLASH_DRAFTER");
+    if (!value || !*value || std::string_view(value) == "dflash2")
+      return DrafterKind::DFlash2;
+    if (std::string_view(value) == "dspine")
+      return DrafterKind::DSpine;
+    throw std::invalid_argument(std::string("SPLASH_DRAFTER takes dflash2 or dspine, not ") + value);
+  }();
+  return kind;
+}
+
+std::string_view drafterName(DrafterKind kind) noexcept {
+  return kind == DrafterKind::DSpine ? "dspine" : "dflash2";
+}
+
+uint32_t draftContextWindow() {
+  static const uint32_t window = [] {
+    if (selectedDrafter() != DrafterKind::DSpine)
+      return uint32_t{SPLASH_DRAFT_SLIDING_WINDOW};
+    const char *value = std::getenv("SPLASH_DSPINE_WINDOW");
+    if (!value || !*value)
+      return kDSpineMaximumWindow;
+    char *end = nullptr;
+    const unsigned long tokens = std::strtoul(value, &end, 10);
+    if (*end || tokens < 2048 || tokens > kDSpineMaximumWindow || tokens % 128)
+      throw std::invalid_argument("SPLASH_DSPINE_WINDOW takes a multiple of 128 from 2048 to 8192");
+    return static_cast<uint32_t>(tokens);
+  }();
+  return window;
+}
+
+std::filesystem::path dspineCheckpointDirectory() {
+  if (const char *value = std::getenv("SPLASH_DSPINE_DIR"); value && *value)
+    return value;
+  const char *home = std::getenv("HOME");
+  if (!home)
+    throw std::invalid_argument("SPLASH_DSPINE_DIR is unset and so is HOME");
+  return std::filesystem::path(home) /
+         ".cache/huggingface/hub/models--tencent--Qwen3.8-27B-DSpine-b16/snapshots/"
+         "ea909c0f5fab8865f9e14600334f55f7ce47308f";
+}
+
+} // namespace splash::model
