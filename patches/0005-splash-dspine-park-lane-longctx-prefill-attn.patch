+std::string Engine::parkMismatch(const Request &active, bool resuming) const {
+  const std::vector<uint32_t> &parked = parked_->tokens;
+  if (resuming)
+    return "(a suspended request resumes)";
+  if (!active.request.images.empty())
+    return "(request " + std::to_string(active.request.id) + " has images)";
+  if (!active.request.scoreTokens.empty())
+    return "(request " + std::to_string(active.request.id) + " is a score request)";
+  // The prompt as the engine built it: an unstarted request's exact tokens.
+  const std::span<const uint32_t> prompt =
+      std::span<const uint32_t>(active.exactTokens).first(active.promptTokens);
+  const auto differs =
+      std::mismatch(parked.begin(), parked.end(), prompt.begin(), prompt.end()).first;
+  if (differs != parked.end())
+    return "(request " + std::to_string(active.request.id) + " differs at token " +
+           std::to_string(differs - parked.begin()) + " of its " +
+           std::to_string(prompt.size()) + ")";
+  // Prefill selects the first token from the prompt's last row.
+  if (prompt.size() <= parked.size())
+    return "(request " + std::to_string(active.request.id) + "'s prompt of " +
+           std::to_string(prompt.size()) + " tokens ends there)";
+  return {};
