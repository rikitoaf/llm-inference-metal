+DSpineScratch allocateDSpineScratch(metal::MetalBackend &backend, uint32_t layers, uint32_t intermediateSize) {
+  DSpineScratch s;
+  const auto make = [&](uint64_t bytes, const char *label) {
+    metal::MetalBuffer buffer = backend.allocateBuffer(bytes, metal::BufferStorage::Shared, label);
+    std::memset(buffer.contents(), 0, buffer.sizeBytes());
+    return buffer;
+  };
+  const uint64_t hiddenRows = uint64_t{kRows} * kShape.hiddenSize * 2;
+  for (uint32_t i = 0; i < 2; ++i) {
+    s.residual[i] = make(hiddenRows, "dspine-residual");
+    s.normed[i] = make(hiddenRows, "dspine-normed");
+  }
+  s.qkv = make(uint64_t{kRows} * kShape.qkvSize * 2, "dspine-qkv");
+  s.queries = make(uint64_t{kShape.kvHeads} * 2 * 32 * kShape.headDimension * 2, "dspine-queries");
+  s.blockKeys = make(uint64_t{kShape.kvHeads} * kRows * kShape.headDimension * 2, "dspine-block-keys");
+  s.blockValues = make(uint64_t{kShape.kvHeads} * kRows * kShape.headDimension * 2, "dspine-block-values");
+  s.attentionPartials =
+      make(uint64_t{kShape.kvHeads} * 2 * kSplits * (32 * kShape.headDimension + 64) * 4, "dspine-attention-partials");
+  s.attention = make(uint64_t{kRows} * kShape.attentionSize * 2, "dspine-attention");
+  s.afterAttention = make(hiddenRows, "dspine-after-attention");
+  s.mlpNormalized = make(hiddenRows, "dspine-mlp-normalized");
+  s.intermediate = make(uint64_t{kRows} * intermediateSize * 2, "dspine-intermediate");
+  s.layerOutput = make(hiddenRows, "dspine-layer-output");
+  s.bridgeNormalized = make(hiddenRows, "dspine-bridge-normalized");
+  s.rowRms = make(uint64_t{kRows} * 4, "dspine-row-rms");
+  s.projected = make(uint64_t{kRows} * kShape.codeSize * 2, "dspine-projected");
+  s.codes = make(uint64_t{kRows} * kShape.codeSize * 2, "dspine-codes");
+  s.packed = make(uint64_t{kRows} * 3 * kShape.bridgeRank * 2, "dspine-packed");
+  s.message = make(uint64_t{kRows} * kShape.bridgeRank * 2, "dspine-message");
+  s.delta = make(hiddenRows, "dspine-delta");
+  s.partialIds = make(uint64_t{kPositions} * kShards * kCandidates * 4, "dspine-partial-ids");
+  s.partialValues = make(uint64_t{kPositions} * kShards * kCandidates * 4, "dspine-partial-values");
+  s.candidates = make(uint64_t{kPositions} * kCandidates * 4, "dspine-candidates");
+  s.messages = make(uint64_t{kPositions} * kCandidates * kShape.bridgeRank * 4, "dspine-tail-messages");
+  s.refined = make(uint64_t{kPositions} * kCandidates * kShape.hiddenSize * 4, "dspine-tail-refined");
+  s.tables = make(uint64_t{kPositions} * kCandidates * kCandidates * 4, "dspine-tables");
+  s.senders = make(uint64_t{kPositions} * kCandidates * 4, "dspine-senders");
+  s.codeProducts = make(uint64_t{kPositions} * kCandidates * 2 * kShape.bridgeRank * 4, "dspine-code-products");
+  s.finalNormed = s.normed[layers & 1];
+  return s;
+}
+
+void DSpineOps::addAttentionPrepare(metal::CommandGraph &graph, const DSpineScratch &scratch,
+                                    metal::MetalBuffer queryNorm, metal::MetalBuffer keyNorm,
+                                    metal::MetalBuffer ropeCos, metal::MetalBuffer ropeSin,
+                                    const DSpineBlockParams &block) {
+  requireBlock(block);
+  requireBuffer(ropeCos, uint64_t{block.rows} * kShape.headDimension / 2 * 4, "rope");
+  graph.add("dspine_attention_prepare",
+            {scratch.qkv, scratch.queries, std::move(queryNorm), std::move(keyNorm), std::move(ropeCos),
+             std::move(ropeSin), scratch.blockKeys, scratch.blockValues},
+            block, {uint64_t{block.rows} * (kShape.queryHeads + kShape.kvHeads), 1, 1}, {kThreads, 1, 1});
+}
+
+void DSpineOps::addAttention(metal::CommandGraph &graph, const DSpineScratch &scratch, metal::MetalBuffer ringKeys,
+                             metal::MetalBuffer ringValues, const DSpineBlockParams &block) {
+  requireBlock(block);
+  if (block.window != block.ring_slots || block.ring_slots % 128)
+    throw std::invalid_argument("DSpine attention needs window == ring slots, a multiple of 128");
+  const uint64_t ringBytes = uint64_t{kShape.kvHeads} * block.ring_slots * kShape.headDimension * 2;
+  requireBuffer(ringKeys, ringBytes, "ring keys");
+  requireBuffer(ringValues, ringBytes, "ring values");
+  const uint32_t halves = block.rows / 8;
+  graph.add("dspine_attention_split",
+            {scratch.queries, std::move(ringKeys), std::move(ringValues), scratch.blockKeys, scratch.blockValues,
+             scratch.attentionPartials},
+            block, {uint64_t{kShape.kvHeads} * halves, 1, kSplits}, {kThreads, 1, 1});
+  graph.add("dspine_attention_reduce", {scratch.attentionPartials, scratch.attention}, block,
+            {uint64_t{kShape.kvHeads} * halves, 1, 1}, {kThreads, 1, 1});
+}
+
+void DSpineOps::addProjection(metal::CommandGraph &graph, metal::MetalBuffer input, metal::MetalBuffer weights,
+                              metal::MetalBuffer output, uint32_t rows, uint32_t inputSize, uint32_t outputSize,
+                              uint32_t weightRow) {
+  if (!rows || inputSize % 8 || outputSize % 8)
+    throw std::invalid_argument("invalid DSpine projection");
+  requireBuffer(input, uint64_t{rows} * inputSize * 2, "projection input");
+  requireBuffer(weights, (uint64_t{weightRow} + outputSize) * inputSize * 2, "projection weights");
+  requireBuffer(output, uint64_t{rows} * outputSize * 2, "projection output");
+  const DSpineProjectParams params{rows, inputSize, outputSize, weightRow};
+  graph.add("dspine_project_bf16", {std::move(input), std::move(weights), std::move(output)}, params,
+            {outputSize / 8, (rows + 31) / 32, 1}, {32 * 16, 1, 1});
+}
+
+void DSpineOps::addBridgeNormalize(metal::CommandGraph &graph, metal::MetalBuffer raw, metal::MetalBuffer normalized,
+                                   metal::MetalBuffer rms, uint32_t rows) {
+  graph.add("dspine_bridge_normalize", {std::move(raw), std::move(normalized), std::move(rms)}, {rows, 1, 1},
+            {kThreads, 1, 1});
+}
+
+void DSpineOps::addBridgeCodes(metal::CommandGraph &graph, metal::MetalBuffer projected, metal::MetalBuffer codebook,
+                               metal::MetalBuffer codes, const DSpineBlockParams &block) {
+  graph.add("dspine_bridge_codes", {std::move(projected), std::move(codebook), std::move(codes)}, block,
+            {block.rows, 1, 1}, {kThreads, 1, 1});
+}
+
+void DSpineOps::addBridgeMessage(metal::CommandGraph &graph, metal::MetalBuffer packed, metal::MetalBuffer gateBias,
+                                 metal::MetalBuffer message, const DSpineBlockParams &block) {
+  const uint64_t elements = uint64_t{block.rows} * kShape.bridgeRank;
+  graph.add("dspine_bridge_message", {std::move(packed), std::move(gateBias), std::move(message)}, block,
+            {(elements + kThreads - 1) / kThreads, 1, 1}, {kThreads, 1, 1});
+}
+
+void DSpineOps::addBridgeWrite(metal::CommandGraph &graph, metal::MetalBuffer raw, metal::MetalBuffer rms,
+                               metal::MetalBuffer delta, metal::MetalBuffer nextNorm, metal::MetalBuffer residualOut,
+                               metal::MetalBuffer normedOut, uint32_t rows) {
+  requireBuffer(nextNorm, uint64_t{kShape.hiddenSize} * 2, "next norm (bf16)");
+  graph.add("dspine_bridge_write",
+            {std::move(raw), std::move(rms), std::move(delta), std::move(nextNorm), std::move(residualOut),
+             std::move(normedOut)},
+            {rows, 1, 1}, {kThreads, 1, 1});
+}
+
+void DSpineOps::addContextRows(metal::CommandGraph &graph, metal::MetalBuffer contextKv, metal::MetalBuffer keyNorm,
+                               metal::MetalBuffer ropeCos, metal::MetalBuffer ropeSin, metal::MetalBuffer keys,
+                               metal::MetalBuffer values, uint32_t tokens, uint32_t startPosition,
+                               uint32_t ringSlots) {
+  if (!tokens)
+    throw std::invalid_argument("DSpine context rows: no tokens");
+  requireBuffer(contextKv, uint64_t{tokens} * 2 * kShape.kvHeads * kShape.headDimension * 2, "context kv");
+  requireBuffer(ropeCos, uint64_t{tokens} * kShape.headDimension / 2 * 4, "context rope");
+  const uint64_t ringBytes = uint64_t{kShape.kvHeads} * ringSlots * kShape.headDimension * 2;
+  requireBuffer(keys, ringBytes, "ring keys");
+  requireBuffer(values, ringBytes, "ring values");
+  const DSpineContextParams params{tokens, startPosition, ringSlots, 0};
+  graph.add("dspine_context_kv",
+            {std::move(contextKv), std::move(keyNorm), std::move(ropeCos), std::move(ropeSin), std::move(keys),
+             std::move(values)},
+            params, {uint64_t{tokens} * kShape.kvHeads, 1, 1}, {kThreads, 1, 1});
+}
+
+void DSpineOps::addContextCommit(metal::CommandGraph &graph, metal::MetalBuffer contextKv,
+                                 metal::MetalBuffer keyNorm, metal::MetalBuffer ropeCos, metal::MetalBuffer ropeSin,
+                                 metal::MetalBuffer keys, metal::MetalBuffer values, metal::MetalBuffer retained,
+                                 uint32_t tokens, uint32_t startPosition, uint32_t ringSlots) {
+  requireBuffer(contextKv, uint64_t{tokens} * 2 * kShape.kvHeads * kShape.headDimension * 2, "commit context kv");
+  const DSpineContextParams params{tokens, startPosition, ringSlots, 0};
+  graph.add("dspine_context_kv_commit",
+            {std::move(contextKv), std::move(keyNorm), std::move(ropeCos), std::move(ropeSin), std::move(keys),
+             std::move(values), std::move(retained)},
+            params, {uint64_t{tokens} * kShape.kvHeads, 1, 1}, {kThreads, 1, 1});
+}
+
+void DSpineOps::addCandidates(metal::CommandGraph &graph, metal::MetalBuffer logits, const DSpineScratch &scratch,
+                              const DraftLogitsParams &columns, uint32_t positions) {
+  if (!positions || positions > kPositions)
+    throw std::invalid_argument("invalid DSpine positions");
+  requireBuffer(logits, (uint64_t{positions} + 1) * columns.width * 4, "draft logits");
+  const DSpineLogitsParams params{columns.width, columns.split, columns.offset, positions};
+  graph.add("dspine_select_top16_sharded", {std::move(logits), scratch.partialIds, scratch.partialValues}, params,
+            {uint64_t{positions} * kShards, 1, 1}, {kThreads, 1, 1});
+  graph.add("dspine_merge_candidates", {scratch.partialIds, scratch.partialValues, scratch.candidates},
+            {positions, 1, 1}, {32, 1, 1});
+}
+
+void DSpineOps::addRefinement(metal::CommandGraph &graph, const DSpineScratch &scratch, metal::MetalBuffer codebook,
+                              metal::MetalBuffer packedWeight, metal::MetalBuffer gateBias,
+                              metal::MetalBuffer lastWriteWeights, metal::MetalBuffer finalNorm,
+                              metal::MetalBuffer headCodes, metal::MetalBuffer headMeta, uint32_t headGroups,
+                              uint32_t positions, uint32_t anchor) {
+  const DSpineTailParams params{positions, anchor, headGroups, kShape.hiddenSize};
+  const uint32_t pairs = positions * kCandidates;
+  // SPLASH_DSPINE_TAIL=scalar: the first, scalar refinement kernels (kept for A/B); default: the MMA GEMMs.
+  static const bool scalar = [] {
+    const char *value = std::getenv("SPLASH_DSPINE_TAIL");
+    return value && std::string_view(value) == "scalar";
+  }();
+  if (scalar) {
+    graph.add("dspine_tail_messages",
+              {std::move(codebook), std::move(packedWeight), std::move(gateBias), scratch.packed, scratch.candidates,
+               scratch.messages},
+              params, {kShape.bridgeRank / 8, 1, 1}, {kThreads, 1, 1});
+    graph.add("dspine_tail_refine",
+              {scratch.messages, std::move(lastWriteWeights), scratch.layerOutput, scratch.rowRms, scratch.refined},
+              params, {kShape.hiddenSize / 256, (pairs + 7) / 8, 1}, {kThreads, 1, 1});
+    graph.add("dspine_tail_tables",
+              {scratch.refined, std::move(finalNorm), std::move(headCodes), std::move(headMeta), scratch.candidates,
+               scratch.tables},
+              params, {pairs, 1, 1}, {kThreads, 1, 1});
+    return;
+  }
+  graph.add("dspine_tail_senders", {scratch.candidates, scratch.senders}, params, {(pairs + 255) / 256, 1, 1},
+            {kThreads, 1, 1});
+  const DSpineGemmParams codes{pairs, kShape.codeSize, 2 * kShape.bridgeRank, kShape.bridgeRank, 32.0F, 0, 0, 0};
+  graph.add("dspine_tail_gemm_codes", {std::move(codebook), scratch.senders, packedWeight, scratch.codeProducts},
+            codes, {2 * kShape.bridgeRank / 8, (pairs + 31) / 32, 1}, {512, 1, 1});
+  graph.add("dspine_tail_gate", {scratch.codeProducts, scratch.packed, std::move(gateBias), scratch.messages}, params,
+            {(uint64_t{pairs} * kShape.bridgeRank + kThreads - 1) / kThreads, 1, 1}, {kThreads, 1, 1});
+  const DSpineGemmParams write{pairs, kShape.bridgeRank, kShape.hiddenSize, 0, 1.0F, 0, 0, 0};
+  graph.add("dspine_tail_gemm_write", {scratch.messages, scratch.senders, std::move(lastWriteWeights), scratch.refined},
+            write, {kShape.hiddenSize / 8, (pairs + 31) / 32, 1}, {512, 1, 1});
+  graph.add("dspine_tail_tables_from_product",
+            {scratch.refined, std::move(finalNorm), std::move(headCodes), std::move(headMeta), scratch.candidates,
+             scratch.tables, scratch.layerOutput, scratch.rowRms},
+            params, {pairs, 1, 1}, {kThreads, 1, 1});
+}
+
+void DSpineOps::addTree(metal::CommandGraph &graph, const DSpineScratch &scratch, metal::MetalBuffer proposedTokens,
+                        metal::MetalBuffer tree, metal::MetalBuffer positions, uint32_t positionsCount,
+                        uint32_t anchor, const VerifyTailPolicy &tail) {
+  DSpineTreeParams params{};
+  params.positions = positionsCount;
+  params.anchor = anchor;
+  params.tail_first_row = tail.firstTailRow;
+  params.tail_keep_mass = tail.keepMass;
+  requireBuffer(tail.report, sizeof(SplashVerifyTailReport), "verify tail report");
+  requireBuffer(proposedTokens, (SPLASH_TARGET_VERIFY_ROWS - 1) * 4, "proposed tokens");
+  requireBuffer(tree, sizeof(SplashDraftTree), "draft tree");
+  requireBuffer(positions, SPLASH_TARGET_VERIFY_ROWS * 3 * 4, "verify positions");
+  graph.add("dspine_select_tree",
+            {scratch.candidates, scratch.tables, std::move(proposedTokens), std::move(tree), std::move(positions),
+             tail.report},
+            params, {1, 1, 1}, {1, 1, 1});
+}
+
+void DSpineOps::addCopyExtension(metal::CommandGraph &graph, const DSpineScratch &scratch,
+                                 metal::MetalBuffer proposedTokens, metal::MetalBuffer tree,
+                                 metal::MetalBuffer positions, uint32_t positionsCount, uint32_t anchor,
+                                 const DSpineCopyInputs &copy, const VerifyTailPolicy &tail) {
+  DSpineTreeParams params{};
+  params.positions = positionsCount;
+  params.anchor = anchor;
+  params.tail_first_row = tail.firstTailRow;
+  params.tail_keep_mass = tail.keepMass;
+  requireBuffer(tail.report, sizeof(SplashVerifyTailReport), "verify tail report");
+  params.history_tokens = copy.historyTokens;
+  params.min_match = copy.minimumMatch;
+  std::memcpy(params.log_accept, copy.logAccept, sizeof params.log_accept);
+  if (!copy.minimumMatch || copy.minimumMatch > SPLASH_DSPINE_COPY_TIP_DEPTH + 1)
+    throw std::invalid_argument("invalid DSpine copy minimum match");
+  requireBuffer(copy.history, std::max<uint64_t>(uint64_t{copy.historyTokens} * 4, 1), "copy history");
+  requireBuffer(copy.outcomes, sizeof(SplashDraftCopyOutcome), "copy outcomes");
+  graph.add("dspine_copy_extend",
+            {scratch.candidates, scratch.tables, std::move(proposedTokens), std::move(tree), std::move(positions),
+             copy.history, copy.outcomes, tail.report},
+            params, {1, 1, 1}, {1024, 1, 1});
+}
+
+} // namespace splash::ops
