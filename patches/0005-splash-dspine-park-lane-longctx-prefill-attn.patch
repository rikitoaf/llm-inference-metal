+void requireBuffer(const metal::MetalBuffer &buffer, uint64_t bytes, const char *what) {
+  if (!buffer || buffer.sizeBytes() < bytes)
+    throw std::invalid_argument(std::string("DSpine buffer too small: ") + what);
+}
+
+void requireBlock(const DSpineBlockParams &block) {
+  if (!block.rows || block.rows > kRows || (block.rows % 8) != 0)
+    throw std::invalid_argument("DSpine block rows must be 8 or 16");
+}
