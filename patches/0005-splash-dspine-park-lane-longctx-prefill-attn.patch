+// SPLASH_PARK_LANE's model path (Runtime::park, Runtime::adopt): a lane whose
+// state decode left (verify, the tree scan and the commit) is kept at its
+// committed tokens, handed to the next turn's request, and continued by
+// prefill from a mid-page position; against a cold prefill of that whole
+// prompt. Same math in a different summation order (the m16 verify
+// projections against the prefill tiles, the decode tree scan against the
+// chunked GDN prefill, verify attention against prefill attention): the
+// greedy tokens may differ only at a near-tie, and the final-row logits
+// within bf16 rounding. The numbers are printed for the record.
+namespace park_oracle {
+
+std::vector<uint32_t> patternTokens(std::span<const uint32_t> seed, uint32_t count,
+                                    uint32_t offset, uint32_t period) {
+  std::vector<uint32_t> result(count);
+  for (uint32_t index = 0; index < count; ++index)
+    result[index] = seed[(offset + index % period) % seed.size()];
+  return result;
+}
+
+struct GreedyRun final {
+  std::vector<uint32_t> tokens;
+  // The committed length after each decode cycle (the commit boundaries).
+  std::vector<uint64_t> commitPositions;
+  uint32_t cycles = 0;
+  uint32_t fullRetentionCycles = 0;
+  uint32_t lastWithoutKv = 0;
+  bool finished = false;
+};
+
+// Decodes greedily until `budget` tokens are out or the request finishes; with
+// stopAfterFullRetention, stops after the first cycle whose verify retained
+// every row (gdn_commit_phase returns early then).
+GreedyRun decodeGreedy(model::Runtime &executor, const model::QwenStateStorage &states,
+                       uint64_t requestId, uint32_t lane, uint32_t budget,
+                       const std::vector<uint32_t> &pageTable, bool stopAfterFullRetention) {
+  GreedyRun run;
+  while (run.tokens.size() < budget && !run.finished) {
+    const uint64_t position = states.metadata(lane).lengths.targetTokens;
+    const ModelStepResult step = decodeOne(executor, requestId, position, pageTable);
+    require(step.failure.empty(), "park oracle: decode failed: " + step.failure);
+    run.tokens.insert(run.tokens.end(), step.outputTokens.begin(), step.outputTokens.end());
+    run.lastWithoutKv = step.outputTokensWithoutKv;
+    run.finished = step.finished;
+    run.commitPositions.push_back(states.metadata(lane).lengths.targetTokens);
+    ++run.cycles;
+    if (step.acceptedDraftTokens + 1 >= model::ExecutionLimits::targetVerifyRows) {
+      ++run.fullRetentionCycles;
+      if (stopAfterFullRetention)
+        break;
+    }
+  }
+  return run;
+}
+
+double bfloatUlp(double reference) {
+  const double magnitude = std::max(std::fabs(reference), 1e-30);
+  return std::ldexp(1.0, static_cast<int>(std::floor(std::log2(magnitude))) - 7);
+}
+
+struct StateDifference final {
+  Similarity recurrent, convolution;
+};
+
+// The committed GDN state of two lanes, as the oracle's partition-equivalence
+// check compares a 16-row chunk with two M8 commits: cosine of the bf16 conv
+// history and of the f32 recurrent state (all elements), with the largest
+// absolute difference.
+StateDifference compareStates(const metal::MetalBackend &backend, const model::QwenStateStorage &states,
+                              uint32_t left, uint32_t right) {
+  const model::GdnStateLayout &layout = states.layout().target;
+  return {compareFloat(recurrentHalf(backend, states.current(left), layout),
+                       recurrentHalf(backend, states.current(right), layout),
+                       std::numeric_limits<uint64_t>::max()),
+          compareBfloat(convolutionHalf(backend, states.current(left), layout),
+                        convolutionHalf(backend, states.current(right), layout),
+                        std::numeric_limits<uint64_t>::max())};
+}
+
+std::ostream &operator<<(std::ostream &out, const StateDifference &d) {
+  return out << "recurrent cos=" << d.recurrent.cosine << " max_abs=" << d.recurrent.maximumAbsolute
+             << " norms=" << d.recurrent.leftNorm << "/" << d.recurrent.rightNorm
+             << " conv cos=" << d.convolution.cosine << " max_abs=" << d.convolution.maximumAbsolute;
+}
+
+// Raw final-row logits of `options` after `context`, from a cold prefill.
+std::vector<float> coldScores(model::Runtime &executor, uint64_t requestId, uint32_t lane,
+                              const std::vector<uint32_t> &context,
+                              const std::vector<uint32_t> &options,
+                              const std::vector<uint32_t> &pageTable) {
+  EngineRequest score = makeRequest(requestId, context, 0);
+  score.scoreTokens = options;
+  beginCold(executor, score, lane);
+  const ModelStepResult scored = prefillChunk(executor, requestId, 0, context, pageTable);
+  executor.end(requestId);
+  require(scored.scoreLogits.size() == options.size(), "park oracle: score probe returned the wrong count");
+  return scored.scoreLogits;
+}
+
+struct Scenario final {
+  std::string name;
+  std::vector<uint32_t> prompt;
+  uint32_t decodeBudget = 40;
+  bool stopAfterFullRetention = false;
+  uint32_t suffixOffset = 7;
+};
+
+// Lanes 0 (decode, then adopted), 1 (cold, one chunk), 2 (cold, two chunks
+// split where the adoption is: the summation-order baseline), 3 (score
+// probes); pages 0-15, 16-31, 32-47, 48-63.
+void runScenario(model::Runtime &executor, const model::QwenStateStorage &states,
+                 const metal::MetalBackend &backend, std::span<const uint32_t> seed,
+                 const Scenario &scenario, uint64_t &nextId, bool &anyNearTie, double &worstMargin) {
+  constexpr uint32_t kDecodeLane = 0, kColdLane = 1, kChunkedLane = 2, kProbeLane = 3;
+  const std::vector<uint32_t> decodePages = pageRange(0, 16), coldPages = pageRange(16, 16),
+                              chunkedPages = pageRange(32, 16), probePages = pageRange(48, 16);
+  const uint32_t promptTokens = static_cast<uint32_t>(scenario.prompt.size());
+  const uint64_t turnId = nextId++, adoptedId = nextId++, coldId = nextId++, chunkedId = nextId++;
+
+  // Turn 1: prefill the prompt, decode, park at the committed tokens.
+  EngineRequest turn = makeRequest(turnId, scenario.prompt, scenario.decodeBudget);
+  beginCold(executor, turn, kDecodeLane);
+  requireOpen(prefillChunk(executor, turnId, 0, scenario.prompt, decodePages), scenario.name.c_str());
+  const GreedyRun first = decodeGreedy(executor, states, turnId, kDecodeLane, scenario.decodeBudget,
+                                       decodePages, scenario.stopAfterFullRetention);
+  const uint64_t committed = states.metadata(kDecodeLane).lengths.targetTokens;
+  require(!first.tokens.empty() && committed > promptTokens &&
+              committed == promptTokens + first.tokens.size() - first.lastWithoutKv,
+          "park oracle: the committed tokens are not the prompt plus the output with KV rows");
+  require(committed % kv::kPageTokens != 0, "park oracle: the parked position is page-aligned; pick another prompt");
+  require(executor.park(turnId, static_cast<uint32_t>(committed)), "park oracle: the model refused to park a finished lane");
+  require(!executor.park(turnId, static_cast<uint32_t>(committed)), "park oracle: a parked lane parked twice");
+  bool decodeRejected = false;
+  try {
+    static_cast<void>(decodeOne(executor, turnId, committed, decodePages));
+  } catch (const std::exception &) {
+    decodeRejected = true;
+  }
+  require(decodeRejected, "park oracle: a parked lane accepted a decode");
+
+  // Turn 2: the prompt, the output as the client sends it back, new input.
+  std::vector<uint32_t> next = scenario.prompt;
+  next.insert(next.end(), first.tokens.begin(), first.tokens.end());
+  const std::vector<uint32_t> suffix = patternTokens(seed, kv::kPageTokens + 9, scenario.suffixOffset, 41);
+  next.insert(next.end(), suffix.begin(), suffix.end());
+  const uint32_t nextTokens = static_cast<uint32_t>(next.size());
+  EngineRequest adopted = makeRequest(adoptedId, next, 64);
+  {
+    ModelRequest refused = adopted.modelView();
+    refused.restoredTokens = static_cast<uint32_t>(committed) - 1;
+    require(!executor.adopt(turnId, refused).granted(), "park oracle: adoption at the wrong length was granted");
+    require(states.metadata(kDecodeLane).requestId == turnId, "park oracle: a refused adoption changed the lane");
+  }
+  ModelRequest view = adopted.modelView();
+  view.restoredTokens = static_cast<uint32_t>(committed);
+  const StateAdmission admission = executor.adopt(turnId, view);
+  require(admission.granted() && *admission.lane == kDecodeLane &&
+              states.metadata(kDecodeLane).requestId == adoptedId,
+          "park oracle: adoption was refused or moved the lane");
+  executor.setDraftContextPlan(adoptedId, planDraftContext(static_cast<uint32_t>(committed), nextTokens, {}));
+  requireOpen(prefillChunk(executor, adoptedId, static_cast<uint32_t>(committed),
+                           std::span<const uint32_t>(next).subspan(committed), decodePages),
+              "park oracle: adopted prefill");
+  require(states.metadata(kDecodeLane).lengths.targetTokens == nextTokens &&
+              states.metadata(kDecodeLane).lengths.hasCompleteDraftWindow(model::draftContextWindow()),
+          "park oracle: the adopted prefill left the wrong length or an incomplete draft window");
+
+  // Cold: the whole prompt in one prefill.
+  EngineRequest cold = makeRequest(coldId, next, 64);
+  beginCold(executor, cold, kColdLane);
+  requireOpen(prefillChunk(executor, coldId, 0, next, coldPages), "park oracle: cold prefill");
+  // The baseline: the same prompt prefilled in two chunks split at the
+  // adoption point (prefill continuing its own chunk, today's path).
+  EngineRequest chunked = makeRequest(chunkedId, next, 64);
+  beginCold(executor, chunked, kChunkedLane);
+  requireOpen(prefillChunk(executor, chunkedId, 0, std::span<const uint32_t>(next).first(committed), chunkedPages),
+              "park oracle: chunked prefill, first chunk");
+  requireOpen(prefillChunk(executor, chunkedId, static_cast<uint32_t>(committed),
+                           std::span<const uint32_t>(next).subspan(committed), chunkedPages),
+              "park oracle: chunked prefill, second chunk");
+  // A second baseline with the adopted lane's own boundaries: the prompt, each
+  // decode commit, then the suffix, all by prefill (the like-for-like
+  // summation-order control for a lane that went through many commits).
+  const uint64_t cycleChunkedId = nextId++;
+  EngineRequest cycleChunked = makeRequest(cycleChunkedId, next, 64);
+  beginCold(executor, cycleChunked, kProbeLane);
+  {
+    std::vector<uint64_t> boundaries{promptTokens};
+    for (uint64_t position : first.commitPositions)
+      if (position > boundaries.back() && position <= committed)
+        boundaries.push_back(position);
+    if (boundaries.back() != committed)
+      boundaries.push_back(committed);
+    boundaries.push_back(nextTokens);
+    uint64_t begin = 0;
+    for (uint64_t end : boundaries) {
+      requireOpen(prefillChunk(executor, cycleChunkedId, static_cast<uint32_t>(begin),
+                               std::span<const uint32_t>(next).subspan(begin, end - begin), probePages),
+                  "park oracle: cycle-chunked prefill");
+      begin = end;
+    }
+  }
+  const StateDifference adoptedState = compareStates(backend, states, kDecodeLane, kColdLane);
+  const StateDifference chunkedState = compareStates(backend, states, kChunkedLane, kColdLane);
+  const StateDifference cycleChunkedState = compareStates(backend, states, kProbeLane, kColdLane);
+  executor.end(cycleChunkedId);
+  std::cout << "park_oracle " << scenario.name << ": prompt=" << promptTokens << " decoded=" << first.tokens.size()
+            << " cycles=" << first.cycles << " full_retention_cycles=" << first.fullRetentionCycles
+            << " committed=" << committed << " (page offset " << committed % kv::kPageTokens << ")"
+            << " suffix_rows=" << nextTokens - committed << " next=" << nextTokens << '\n';
+  std::cout << "park_oracle " << scenario.name << " gdn_state adopted_vs_cold: " << adoptedState << '\n';
+  std::cout << "park_oracle " << scenario.name << " gdn_state two_chunks_vs_cold: " << chunkedState << '\n';
+  std::cout << "park_oracle " << scenario.name << " gdn_state cycle_chunks_vs_cold (" << first.cycles + 2
+            << " chunks): " << cycleChunkedState << '\n';
+  // Decode-left state continued by prefill must sit where prefill continuing
+  // its own chunk (production's path) sits: the cosine distance to the cold
+  // state within 1.5x the two-chunk baseline's, and the largest element
+  // difference within 1.5x the baseline's or 0.2% of the state's norm (one
+  // element of tens of millions is a noisy extreme).
+  // The baseline is the larger drift of the two prefill controls (two
+  // chunks; the lane's own commit boundaries); both ratios are printed.
+  const auto withinBaseline = [](const Similarity &adopted, const Similarity &twoChunks,
+                                 const Similarity &cycleChunks, const char *what, const std::string &name) {
+    const double distance = 1.0 - adopted.cosine;
+    const double twoDistance = 1.0 - twoChunks.cosine, cycleDistance = 1.0 - cycleChunks.cosine;
+    const double baselineDistance = std::max(twoDistance, cycleDistance);
+    const double baselineMaxAbs = std::max(twoChunks.maximumAbsolute, cycleChunks.maximumAbsolute);
+    std::cout << "park_oracle " << name << " " << what
+              << ": cosine_distance_ratio vs two_chunks=" << distance / std::max(twoDistance, 1e-12)
+              << " vs cycle_chunks=" << distance / std::max(cycleDistance, 1e-12)
+              << " max_abs_ratio vs two_chunks=" << adopted.maximumAbsolute / std::max(twoChunks.maximumAbsolute, 1e-12)
+              << " vs cycle_chunks=" << adopted.maximumAbsolute / std::max(cycleChunks.maximumAbsolute, 1e-12) << '\n';
+    require(distance <= 1.5 * baselineDistance + 1e-7,
+            "park oracle: " + name + " " + what + " cosine distance beyond 1.5x the prefill baselines");
+    require(adopted.maximumAbsolute <= std::max(1.5 * baselineMaxAbs, 2e-3 * twoChunks.rightNorm),
+            "park oracle: " + name + " " + what + " max element difference beyond 1.5x the prefill baselines");
+  };
+  withinBaseline(adoptedState.recurrent, chunkedState.recurrent, cycleChunkedState.recurrent, "recurrent", scenario.name);
+  withinBaseline(adoptedState.convolution, chunkedState.convolution, cycleChunkedState.convolution, "conv", scenario.name);
+  executor.end(chunkedId);
+
+  // 64 greedy tokens each way.
+  const GreedyRun adoptedRun = decodeGreedy(executor, states, adoptedId, kDecodeLane, 64, decodePages, false);
+  const GreedyRun coldRun = decodeGreedy(executor, states, coldId, kColdLane, 64, coldPages, false);
+  executor.end(adoptedId);
+  executor.end(coldId);
+  const size_t common = std::min(adoptedRun.tokens.size(), coldRun.tokens.size());
+  size_t differs = 0;
+  while (differs < common && adoptedRun.tokens[differs] == coldRun.tokens[differs])
+    ++differs;
+  std::cout << "park_oracle " << scenario.name << " greedy: adopted=" << adoptedRun.tokens.size()
+            << " cold=" << coldRun.tokens.size() << " agree=" << differs << "/" << common;
+  if (differs == common && adoptedRun.tokens.size() == coldRun.tokens.size()) {
+    std::cout << " identical\n";
+  } else if (differs == common) {
+    std::cout << " (one finished earlier; identical up to there)\n";
+  } else {
+    // The top-2 margin at the first differing token, from a cold prefill of
+    // the context before it: a near-tie is the summation order, anything
+    // else is a state bug.
+    std::vector<uint32_t> context = next;
+    context.insert(context.end(), adoptedRun.tokens.begin(), adoptedRun.tokens.begin() + differs);
+    const std::vector<uint32_t> options{adoptedRun.tokens[differs], coldRun.tokens[differs]};
+    const std::vector<float> logits = coldScores(executor, nextId++, kProbeLane, context, options, probePages);
+    const double margin = std::fabs(double(logits[0]) - double(logits[1]));
+    worstMargin = std::max(worstMargin, margin);
+    anyNearTie = true;
+    std::cout << " first difference at " << differs << ": adopted token " << options[0] << " logit " << logits[0]
+              << ", cold token " << options[1] << " logit " << logits[1] << ", margin " << margin << '\n';
+    require(margin < 1.0, "park oracle: the greedy texts differ at a token that is not a near-tie (margin " +
+                              std::to_string(margin) + " logits)");
+  }
+}
