+// The final-row logits through the adopted path: a score request adopts the
+// parked lane (the engine never sends one; the runtime allows it), and the
+// same options are scored by a cold prefill.
+void compareAdoptedLogits(model::Runtime &executor, const model::QwenStateStorage &states,
+                          std::span<const uint32_t> seed, uint64_t &nextId) {
+  constexpr uint32_t kDecodeLane = 0, kColdLane = 1;
+  const std::vector<uint32_t> decodePages = pageRange(0, 16), coldPages = pageRange(16, 16);
+  const std::vector<uint32_t> prompt = patternTokens(seed, 2 * kv::kPageTokens + 11, 0, 53);
+  const uint64_t turnId = nextId++, scoreId = nextId++, coldId = nextId++;
+  EngineRequest turn = makeRequest(turnId, prompt, 40);
+  beginCold(executor, turn, kDecodeLane);
+  requireOpen(prefillChunk(executor, turnId, 0, prompt, decodePages), "park oracle logits");
+  const GreedyRun first = decodeGreedy(executor, states, turnId, kDecodeLane, 40, decodePages, false);
+  const uint64_t committed = states.metadata(kDecodeLane).lengths.targetTokens;
+  require(executor.park(turnId, static_cast<uint32_t>(committed)), "park oracle logits: park refused");
+  std::vector<uint32_t> next = prompt;
+  next.insert(next.end(), first.tokens.begin(), first.tokens.end());
+  const std::vector<uint32_t> suffix = patternTokens(seed, kv::kPageTokens + 5, 11, 37);
+  next.insert(next.end(), suffix.begin(), suffix.end());
+  // Options: every distinct token of the conversation (the likeliest
+  // continuations are among them) up to the score limit.
+  std::vector<uint32_t> options = next;
+  std::sort(options.begin(), options.end());
+  options.erase(std::unique(options.begin(), options.end()), options.end());
+  if (options.size() > model::ExecutionLimits::maximumScoreOptions)
+    options.resize(model::ExecutionLimits::maximumScoreOptions);
+  EngineRequest scored = makeRequest(scoreId, next, 0);
+  scored.scoreTokens = options;
+  ModelRequest view = scored.modelView();
+  view.restoredTokens = static_cast<uint32_t>(committed);
+  require(executor.adopt(turnId, view).granted(), "park oracle logits: a score request could not adopt");
+  executor.setDraftContextPlan(scoreId, planDraftContext(static_cast<uint32_t>(committed),
+                                                         static_cast<uint32_t>(next.size()), {}));
+  const ModelStepResult adoptedScore =
+      prefillChunk(executor, scoreId, static_cast<uint32_t>(committed),
+                   std::span<const uint32_t>(next).subspan(committed), decodePages);
+  executor.end(scoreId);
+  require(adoptedScore.finished && adoptedScore.scoreLogits.size() == options.size(),
+          "park oracle logits: the adopted score prefill returned no logits");
+  const std::vector<float> coldLogits = coldScores(executor, coldId, kColdLane, next, options, coldPages);
+  // The baseline: the same options scored after a prefill in two chunks split
+  // at the adoption point (prefill continuing its own chunk).
+  const uint64_t chunkedId = nextId++;
+  EngineRequest chunked = makeRequest(chunkedId, next, 0);
+  chunked.scoreTokens = options;
+  beginCold(executor, chunked, kColdLane);
+  requireOpen(prefillChunk(executor, chunkedId, 0, std::span<const uint32_t>(next).first(committed), coldPages),
+              "park oracle logits: chunked first chunk");
+  const ModelStepResult chunkedScore =
+      prefillChunk(executor, chunkedId, static_cast<uint32_t>(committed),
+                   std::span<const uint32_t>(next).subspan(committed), coldPages);
+  executor.end(chunkedId);
+  require(chunkedScore.scoreLogits.size() == options.size(), "park oracle logits: the chunked score returned no logits");
+  double maxAbs = 0, maxReference = 0, baselineMaxAbs = 0;
+  size_t adoptedBest = 0, coldBest = 0;
+  for (size_t i = 0; i < options.size(); ++i) {
+    const double reference = coldLogits[i], got = adoptedScore.scoreLogits[i];
+    require(std::isfinite(got) && std::isfinite(reference), "park oracle logits: a logit is not finite");
+    maxAbs = std::max(maxAbs, std::fabs(got - reference));
+    baselineMaxAbs = std::max(baselineMaxAbs, std::fabs(double(chunkedScore.scoreLogits[i]) - reference));
+    maxReference = std::max(maxReference, std::fabs(reference));
+    if (adoptedScore.scoreLogits[i] > adoptedScore.scoreLogits[adoptedBest])
+      adoptedBest = i;
+    if (coldLogits[i] > coldLogits[coldBest])
+      coldBest = i;
+  }
+  // Within 1.5x what prefill continuing its own chunk (production's path)
+  // drifts by, or the oracle's own rule for logits of different graphs
+  // (probeLoss: graphDrift, 3% of the distribution's scale), whichever is
+  // larger.
+  const double allowance = std::max(0.03 * maxReference, 1.5 * baselineMaxAbs);
+  const size_t outside = maxAbs > allowance ? 1 : 0;
+  std::cout << "park_oracle logits: options=" << options.size() << " committed=" << committed
+            << " (page offset " << committed % kv::kPageTokens << ") suffix_rows=" << next.size() - committed
+            << " adopted_vs_cold max_abs_diff=" << maxAbs << " two_chunks_vs_cold max_abs_diff=" << baselineMaxAbs
+            << " max_|logit|=" << maxReference << " allowance=" << allowance
+            << " argmax " << (adoptedBest == coldBest ? "same" : "differs");
+  if (adoptedBest != coldBest) {
+    const double margin = std::fabs(double(coldLogits[adoptedBest]) - double(coldLogits[coldBest]));
+    std::cout << " (cold margin " << margin << ")";
+    require(margin < 1.0, "park oracle logits: the adopted path's best option is not a near-tie");
+  }
+  std::cout << '\n';
+  require(outside == 0, "park oracle logits: the adopted path's logits drift by " + std::to_string(maxAbs) +
+                            " against an allowance of " + std::to_string(allowance));
+}
+
+void requireParkedLaneContinuesAsColdPrefill(model::Runtime &executor,
+                                             const model::QwenStateStorage &states,
+                                             const metal::MetalBackend &backend,
+                                             std::span<const uint32_t> seed) {
+  uint64_t nextId = 700;
+  bool anyNearTie = false;
+  double worstMargin = 0;
+  // A: two pages plus an odd tail, 40 decoded tokens, the suffix from mid-page.
+  runScenario(executor, states, backend, seed, {"A_midpage", patternTokens(seed, 2 * kv::kPageTokens + 13, 0, 53), 40, false, 7},
+              nextId, anyNearTie, worstMargin);
+  // B: a repeated motif so the tree retains every verify row (gdn_commit_phase
+  // returns early), parked right after such a commit.
+  runScenario(executor, states, backend, seed, {"B_full_retention", patternTokens(seed, 3 * kv::kPageTokens + 5, 20, 12), 48, true, 29},
+              nextId, anyNearTie, worstMargin);
+  // C: a longer decode (several pages of decode-written KV before the suffix).
+  runScenario(executor, states, backend, seed, {"C_long_decode", patternTokens(seed, 2 * kv::kPageTokens + 7, 9, 31), 120, false, 17},
+              nextId, anyNearTie, worstMargin);
+  compareAdoptedLogits(executor, states, seed, nextId);
+  std::cout << "park_oracle: PASS near_ties=" << (anyNearTie ? "yes" : "no") << " worst_margin=" << worstMargin << '\n';
+}
