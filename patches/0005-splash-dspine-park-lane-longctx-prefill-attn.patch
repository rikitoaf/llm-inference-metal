+#pragma once
+
+// Host dispatch of the DSpine draft kernels (kernels/decode/dspine.metal and the DSpine selection kernels in
+// kernels/decode/sampling.metal). model::DSpineDraft composes them with the shared Linear and Normalization ops.
+
+#include "metal/CommandGraph.hpp"
+#include "metal/MetalBackend.hpp"
+#include "metal/abi/DSpine.h"
+#include "metal/abi/Sampling.h"
+
+#include <cstdint>
+
+namespace splash::ops {
+
+struct DSpineShape final {
+  uint32_t hiddenSize = 0;
+  uint32_t queryHeads = 0;
+  uint32_t kvHeads = 0;
+  uint32_t headDimension = 0;
+  uint32_t attentionSize = 0;
+  uint32_t qkvSize = 0;
+  uint32_t codeSize = 0;
+  uint32_t bridgeRank = 0;
+  bool operator==(const DSpineShape &) const = default;
+};
+
+// The shape the kernels compile in.
+inline constexpr DSpineShape kDSpineKernelShape{5120, 32, 8, 128, 4096, 6144, 1024, 512};
+
+// A DSpine block's working tensors, for one lane and up to SPLASH_DSPINE_MAXIMUM_ROWS rows, allocated zeroed once
+// (rows past a block stay zero: the attention masks them, but their values are multiplied by zero probabilities).
+struct DSpineScratch final {
+  // Layer stream: residual[i] and normed[i] ping-pong between layers (normed = the next layer's input).
+  metal::MetalBuffer residual[2];      // [16][5120] bf16
+  metal::MetalBuffer normed[2];        // [16][5120] bf16
+  metal::MetalBuffer qkv;              // [16][6144] bf16
+  metal::MetalBuffer queries;          // [8][2][4][8][128] bf16 (attention tiles)
+  metal::MetalBuffer blockKeys;        // [8][16][128] bf16
+  metal::MetalBuffer blockValues;      // [8][128][16] bf16
+  metal::MetalBuffer attentionPartials;  // [8][2][splits][32 x 130] fp32
+  metal::MetalBuffer attention;        // [16][4096] bf16
+  metal::MetalBuffer afterAttention;   // [16][5120] bf16 (h)
+  metal::MetalBuffer mlpNormalized;    // [16][5120] bf16
+  metal::MetalBuffer intermediate;     // [16][17408] bf16
+  metal::MetalBuffer layerOutput;      // [16][5120] bf16: the bridge's raw input; after the last layer, stash raw
+  // Bridge.
+  metal::MetalBuffer bridgeNormalized; // [16][5120] bf16
+  metal::MetalBuffer rowRms;           // [16] fp32: after the last layer, stash rms
+  metal::MetalBuffer projected;        // [16][1024] bf16
+  metal::MetalBuffer codes;            // [16][1024] bf16
+  metal::MetalBuffer packed;           // [16][1536] bf16: after the last layer, stash packed (q = columns 0..511)
+  metal::MetalBuffer message;          // [16][512] bf16
+  metal::MetalBuffer delta;            // [16][5120] bf16
+  // Candidates and refinement.
+  metal::MetalBuffer partialIds;       // [15][shards][16] u32
+  metal::MetalBuffer partialValues;    // [15][shards][16] fp32
+  metal::MetalBuffer candidates;       // [15][16] u32 token ids, rank order
+  metal::MetalBuffer messages;         // [15 x 16][512] fp32
+  metal::MetalBuffer refined;          // [15 x 16][5120] fp32
+  metal::MetalBuffer tables;           // [15][16][16] fp32
+  metal::MetalBuffer senders;          // [15 x 16] u32: each pair's sender token
+  metal::MetalBuffer codeProducts;     // [15 x 16][1024] fp32: [G_p e | A e]
+  // The final normed rows (normed[layers & 1] after the forward), a view kept for readers.
+  metal::MetalBuffer finalNormed;
+};
+
+[[nodiscard]] DSpineScratch allocateDSpineScratch(metal::MetalBackend &backend, uint32_t layers,
+                                                  uint32_t intermediateSize);
+
+// The copy extension's inputs: the lane's history (tokens before the anchor) and its outcome record.
+struct DSpineCopyInputs final {
+  metal::MetalBuffer history;
+  uint32_t historyTokens = 0;
+  uint32_t minimumMatch = 3;
+  metal::MetalBuffer outcomes;
+  float logAccept[8][8]{};
+};
+
+// SPLASH_VERIFY_ROWS_LONG: which verify rows a cycle may leave unverified (DSpineTreeParams::tail_first_row,
+// tail_keep_mass) and where the decision is reported. firstTailRow 0: every row is verified.
+struct VerifyTailPolicy final {
+  uint32_t firstTailRow = 0;
+  float keepMass = 0.0F;
+  metal::MetalBuffer report;   // SplashVerifyTailReport, always bound
+};
+
+class DSpineOps final {
+public:
+  static void addAttentionPrepare(metal::CommandGraph &graph, const DSpineScratch &scratch,
+                                  metal::MetalBuffer queryNorm, metal::MetalBuffer keyNorm,
+                                  metal::MetalBuffer ropeCos, metal::MetalBuffer ropeSin,
+                                  const DSpineBlockParams &block);
+  static void addAttention(metal::CommandGraph &graph, const DSpineScratch &scratch, metal::MetalBuffer ringKeys,
+                           metal::MetalBuffer ringValues, const DSpineBlockParams &block);
+  // out = input x W[weightRow .. weightRow + outputSize)^T, bf16.
+  static void addProjection(metal::CommandGraph &graph, metal::MetalBuffer input, metal::MetalBuffer weights,
+                            metal::MetalBuffer output, uint32_t rows, uint32_t inputSize, uint32_t outputSize,
+                            uint32_t weightRow = 0);
+  static void addBridgeNormalize(metal::CommandGraph &graph, metal::MetalBuffer raw, metal::MetalBuffer normalized,
+                                 metal::MetalBuffer rms, uint32_t rows);
+  static void addBridgeCodes(metal::CommandGraph &graph, metal::MetalBuffer projected, metal::MetalBuffer codebook,
+                             metal::MetalBuffer codes, const DSpineBlockParams &block);
+  static void addBridgeMessage(metal::CommandGraph &graph, metal::MetalBuffer packed, metal::MetalBuffer gateBias,
+                               metal::MetalBuffer message, const DSpineBlockParams &block);
+  static void addBridgeWrite(metal::CommandGraph &graph, metal::MetalBuffer raw, metal::MetalBuffer rms,
+                             metal::MetalBuffer delta, metal::MetalBuffer nextNorm, metal::MetalBuffer residualOut,
+                             metal::MetalBuffer normedOut, uint32_t rows);
+  static void addContextRows(metal::CommandGraph &graph, metal::MetalBuffer contextKv, metal::MetalBuffer keyNorm,
+                             metal::MetalBuffer ropeCos, metal::MetalBuffer ropeSin, metal::MetalBuffer keys,
+                             metal::MetalBuffer values, uint32_t tokens, uint32_t startPosition, uint32_t ringSlots);
+  static void addContextCommit(metal::CommandGraph &graph, metal::MetalBuffer contextKv, metal::MetalBuffer keyNorm,
+                               metal::MetalBuffer ropeCos, metal::MetalBuffer ropeSin, metal::MetalBuffer keys,
+                               metal::MetalBuffer values, metal::MetalBuffer retained, uint32_t tokens,
+                               uint32_t startPosition, uint32_t ringSlots);
+  // The candidates of `positions` proposal rows from the logits rows (rows 1..positions of a block).
+  static void addCandidates(metal::CommandGraph &graph, metal::MetalBuffer logits, const DSpineScratch &scratch,
+                            const DraftLogitsParams &columns, uint32_t positions);
+  static void addRefinement(metal::CommandGraph &graph, const DSpineScratch &scratch, metal::MetalBuffer codebook,
+                            metal::MetalBuffer packedWeight, metal::MetalBuffer gateBias,
+                            metal::MetalBuffer lastWriteWeights, metal::MetalBuffer finalNorm,
+                            metal::MetalBuffer headCodes, metal::MetalBuffer headMeta, uint32_t headGroups,
+                            uint32_t positions, uint32_t anchor);
+  static void addTree(metal::CommandGraph &graph, const DSpineScratch &scratch, metal::MetalBuffer proposedTokens,
+                      metal::MetalBuffer tree, metal::MetalBuffer positions, uint32_t positionsCount,
+                      uint32_t anchor, const VerifyTailPolicy &tail);
+  static void addCopyExtension(metal::CommandGraph &graph, const DSpineScratch &scratch,
+                               metal::MetalBuffer proposedTokens, metal::MetalBuffer tree,
+                               metal::MetalBuffer positions, uint32_t positionsCount, uint32_t anchor,
+                               const DSpineCopyInputs &copy, const VerifyTailPolicy &tail);
+};
+
+} // namespace splash::ops
