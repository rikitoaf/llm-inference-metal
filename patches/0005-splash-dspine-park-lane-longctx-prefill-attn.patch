+// DSpine checkpoint -> Splash weight images (model/DSpineDraft.hpp): the backbone's projections quantized to affine
+// Q4 (group 64) exactly as DraftCheckpoint.cpp quantizes DFlash2's, every other tensor copied as stored (bf16).
+#include "model/AffinePlan.hpp"
+#include "model/DSpineDraft.hpp"
+
+#include <array>
+#include <memory>
+#include <string>
+#include <utility>
+#include <vector>
+
+namespace splash::model {
+namespace {
+
+using affine::copy;
+using affine::Image;
+
+constexpr std::string_view kDSpineMagic = "MDSP0001";
+
+void quantized(Image &image, std::initializer_list<std::pair<std::string, uint32_t>> parts, uint32_t rows,
+               uint32_t columns) {
+  validateQ4Layout(rows, columns);
+  affine::Section section;
+  section.kind = affine::SectionKind::Quantize;
+  section.rows = rows;
+  section.columns = columns;
+  section.bytes = uint64_t(rows) * columns / 2 + uint64_t(rows) * columns / 16;
+  uint32_t sourceRows = 0;
+  for (const auto &[name, count] : parts) {
+    affine::ProjectionPart part{count, {}};
+    part.fields.push_back({name + ".weight", {"BF16"}, {count, columns}});
+    section.parts.push_back(std::move(part));
+    sourceRows += count;
+  }
+  if (sourceRows != rows) throw WeightStoreError("DSpine projection parts do not fill its rows");
+  affine::append(image, std::move(section));
+}
+
+Image layerImage(const DSpineDraftLayout &layout, uint32_t layer) {
+  Image result = affine::image("layer-" + std::to_string(layer) + ".bin", kDSpineMagic, layer, 0);
+  const std::string prefix = "layers." + std::to_string(layer) + ".";
+  const std::string attention = prefix + "self_attn.";
+  const uint32_t hidden = layout.hiddenSize, kv = layout.kvHeads * layout.headDimension;
+  copy(result, prefix + "input_layernorm.weight", {hidden});
+  quantized(result, {{attention + "q_proj", layout.attentionSize}, {attention + "k_proj", kv}, {attention + "v_proj", kv}},
+            layout.qkvSize, hidden);
+  copy(result, attention + "q_norm.weight", {layout.headDimension});
+  copy(result, attention + "k_norm.weight", {layout.headDimension});
+  quantized(result, {{attention + "o_proj", hidden}}, hidden, layout.attentionSize);
+  copy(result, prefix + "post_attention_layernorm.weight", {hidden});
+  quantized(result, {{prefix + "mlp.gate_proj", layout.intermediateSize}}, layout.intermediateSize, hidden);
+  quantized(result, {{prefix + "mlp.up_proj", layout.intermediateSize}}, layout.intermediateSize, hidden);
+  quantized(result, {{prefix + "mlp.down_proj", hidden}}, hidden, layout.intermediateSize);
+  return result;
+}
+
+// The bridge's gate, predecessor_gate and prev weights are consecutive 1 MiB sections (whole 16 KiB alignment
+// units), so they read back as the one [1536, 1024] packed weight [G_q; G_p; A] the reference prepares.
+Image modelImage(const DSpineDraftLayout &layout) {
+  Image result = affine::image("model.bin", kDSpineMagic, layout.layers, 1);
+  const std::string bridge = "selected_prefix_bridge.";
+  quantized(result, {{"fc", layout.hiddenSize}}, layout.hiddenSize, layout.targetHiddenSize);
+  copy(result, "hidden_norm.weight", {layout.hiddenSize});
+  copy(result, "norm.weight", {layout.hiddenSize});
+  copy(result, bridge + "early_read_weights", {layout.layers - 1, layout.codeSize, layout.hiddenSize});
+  copy(result, bridge + "read_weight", {layout.codeSize, layout.hiddenSize});
+  copy(result, bridge + "gate.weight", {layout.bridgeRank, layout.codeSize});
+  copy(result, bridge + "predecessor_gate.weight", {layout.bridgeRank, layout.codeSize});
+  copy(result, bridge + "prev.weight", {layout.bridgeRank, layout.codeSize});
+  copy(result, bridge + "gate.bias", {layout.bridgeRank});
+  copy(result, bridge + "feature_write_weights", {layout.layers, layout.hiddenSize, layout.bridgeRank});
+  copy(result, bridge + "codebook", {layout.vocabularySize, layout.codeSize});
+  return result;
+}
+
+std::vector<Image> dspineImages(const DSpineDraftLayout &layout) {
+  std::vector<Image> result;
+  for (uint32_t layer = 0; layer < layout.layers; ++layer) result.push_back(layerImage(layout, layer));
+  result.push_back(modelImage(layout));
+  return result;
+}
+
+// The configuration and the scalars this implementation is written for: fail loudly on anything else.
+void requireSupportedCheckpoint(const SafetensorsCheckpoint &source, const DSpineDraftLayout &layout) {
+  source.requireConfigNumber("hidden_size", layout.hiddenSize);
+  source.requireConfigNumber("num_hidden_layers", layout.layers);
+  source.requireConfigNumber("intermediate_size", layout.intermediateSize);
+  source.requireConfigNumber("num_attention_heads", layout.queryHeads);
+  source.requireConfigNumber("num_key_value_heads", layout.kvHeads);
+  source.requireConfigNumber("head_dim", layout.headDimension);
+  source.requireConfigNumber("vocab_size", layout.vocabularySize);
+  source.requireConfigNumber("num_target_layers", 64);
+  source.requireConfigNumber("block_size", layout.blockRows);
+  source.requireConfigNumber("rope_theta", layout.rotaryTheta);
+  source.requireConfigNumber("rms_norm_eps", 1e-6);
+  source.requireConfigNumber("dflash_config.mask_token_id", layout.maskToken);
+  source.requireConfigNumber("dflash_config.draft_block_causal", 1);
+  source.requireConfigNumber("dflash_config.selected_prefix_terminal", 0);
+  source.requireConfigNumber("dflash_config.selected_prefix_feature_writes", 1);
+  source.requireConfigString("dflash_config.selected_prefix_feature_write_mode", "independent");
+  source.requireConfigString("dflash_config.selected_prefix_decode_mode", "serial");
+  source.requireConfigNumber("dflash_config.selected_prefix_code_bridge.code_size", layout.codeSize);
+  source.requireConfigNumber("dflash_config.selected_prefix_code_bridge.rank", layout.bridgeRank);
+  source.requireConfigNumber("dflash_config.selected_prefix_code_bridge.eps", 1e-6);
+  source.requireConfigNumberList("dflash_config.selected_prefix_feature_layers", std::array<double, 5>{1, 2, 3, 4, 5});
+  std::array<double, kDSpineCaptureLayers.size()> captured{};
+  for (size_t i = 0; i < captured.size(); ++i) captured[i] = kDSpineCaptureLayers[i];
+  source.requireConfigNumberList("dflash_config.target_layer_ids", captured);
+  source.requireConfigString("code_bridge_second_pass.mode", "serial_table");
+  source.requireConfigNumber("code_bridge_second_pass.first_exact", layout.layers - 1);
+  source.requireConfigNumber("code_bridge_second_pass.head_topk", SPLASH_DSPINE_CANDIDATES);
+  source.requireConfigNumber("dflash_config.selected_prefix_last_write_refine.head_topk", SPLASH_DSPINE_CANDIDATES);
+  for (const char *name : {"draft_block_causal_version", "last_write_refine_version",
+                           "selected_prefix_bridge.independent_write_version",
+                           "selected_prefix_bridge.terminal_disabled_version"}) {
+    const SourceTensor &tensor = source.require(name);
+    int64_t value = 0;
+    if (tensor.dtype != "I64" || tensor.bytes != sizeof value)
+      throw WeightStoreError(std::string("DSpine version scalar is not one I64: ") + name);
+    tensor.read(0, {reinterpret_cast<uint8_t *>(&value), sizeof value});
+    if (value != 1)
+      throw WeightStoreError(std::string("unsupported DSpine version (expected 1): ") + name + " = " +
+                             std::to_string(value));
+  }
+  // A terminal-disabled checkpoint must carry an all-zero terminal projection.
+  const SourceTensor &terminal = source.require("selected_prefix_bridge.out.weight");
+  if (terminal.dtype != "BF16" || terminal.shape != std::vector<uint64_t>{layout.codeSize, layout.bridgeRank})
+    throw WeightStoreError("DSpine terminal projection has an unexpected type or shape");
+  std::vector<uint8_t> bytes(terminal.bytes);
+  terminal.read(0, bytes);
+  for (size_t i = 0; i + 1 < bytes.size(); i += 2)
+    if ((bytes[i] | (bytes[i + 1] & 0x7f)) != 0)  // a little-endian bf16 other than +-0
+      throw WeightStoreError("DSpine terminal-disabled checkpoint has a nonzero terminal projection (out.weight)");
+}
+
+} // namespace
+
+uint64_t dspineImageBytes() {
+  uint64_t total = 0;
+  for (const Image &image : dspineImages(DSpineDraftLayout{})) total += image.bytes;
+  return total;
+}
+
+DSpineDraftWeights loadDSpineDraftWeights(metal::MetalBackend &backend, WeightImages &images,
+                                          const std::filesystem::path &directory) {
+  const DSpineDraftLayout layout;
+  auto planned = std::make_shared<affine::PlannedCheckpoint>(directory);
+  requireSupportedCheckpoint(planned->source, layout);
+  planned->images = dspineImages(layout);
+  for (Image &image : planned->images) affine::bind(image, planned->source);
+
+  const uint64_t allocationBaseline = backend.memoryStats().allocatedBytes;
+  DSpineDraftWeights result;
+  result.layout = layout;
+  const uint64_t headNormBytes = uint64_t{layout.headDimension} * kBFloat16Bytes;
+  for (uint32_t index = 0; index < layout.layers; ++index) {
+    WeightFile file = images.load(affine::imagePlan(planned, index, "dspine"));
+    DSpineLayerWeights layer;
+    layer.inputNorm = readNorm(file, layout.hiddenSize, false, "input-norm");
+    layer.qkvProjection = readAffineProjection(file, layout.qkvSize, layout.hiddenSize, "qkv");
+    layer.queryNorm = file.section(headNormBytes, "query-norm");
+    layer.keyNorm = file.section(headNormBytes, "key-norm");
+    layer.outputProjection = readAffineProjection(file, layout.hiddenSize, layout.attentionSize, "attention-output");
+    layer.postAttentionNorm = readNorm(file, layout.hiddenSize, false, "post-attention-norm");
+    layer.gateProjection = readAffineProjection(file, layout.intermediateSize, layout.hiddenSize, "mlp-gate");
+    layer.upProjection = readAffineProjection(file, layout.intermediateSize, layout.hiddenSize, "mlp-up");
+    layer.downProjection = readAffineProjection(file, layout.hiddenSize, layout.intermediateSize, "mlp-down");
+    file.finish();
+    result.files.push_back(file.record());
+    result.layers.push_back(std::move(layer));
+  }
+  {
+    WeightFile file = images.load(affine::imagePlan(planned, layout.layers, "dspine"));
+    result.contextProjection =
+        readAffineProjection(file, layout.hiddenSize, layout.targetHiddenSize, "context-projection");
+    result.hiddenNorm = readNorm(file, layout.hiddenSize, false, "hidden-norm");
+    result.finalNorm = readNorm(file, layout.hiddenSize, false, "final-norm");
+    const uint64_t readBytes = uint64_t{layout.codeSize} * layout.hiddenSize * kBFloat16Bytes;
+    DSpineBridgeWeights &bridge = result.bridge;
+    bridge.earlyReadWeights = file.section((layout.layers - 1) * readBytes, "bridge-early-read");
+    bridge.lastReadWeight = file.section(readBytes, "bridge-read");
+    bridge.packedWeight =
+        file.section(uint64_t{3} * layout.bridgeRank * layout.codeSize * kBFloat16Bytes, "bridge-packed");
+    bridge.gateBias = file.section(uint64_t{layout.bridgeRank} * kBFloat16Bytes, "bridge-gate-bias");
+    bridge.writeWeights = file.section(
+        uint64_t{layout.layers} * layout.hiddenSize * layout.bridgeRank * kBFloat16Bytes, "bridge-write");
+    bridge.codebook =
+        file.section(uint64_t{layout.vocabularySize} * layout.codeSize * kBFloat16Bytes, "bridge-codebook");
+    file.finish();
+    result.files.push_back(file.record());
+  }
+  result.actualAllocatedBytes = metal::allocationDelta(allocationBaseline, backend.memoryStats().allocatedBytes);
+  return result;
+}
+
+} // namespace splash::model
diff --git a/runtime/model/DSpineDraft.cpp b/runtime/model/DSpineDraft.cpp
new file mode 100644
index 0000000..bd98768
--- /dev/null
+++ b/runtime/model/DSpineDraft.cpp
@@ -0,0 +1,234 @@
+#include "model/DSpineDraft.hpp"
+
+#include "metal/abi/QuantFormat.h"
+#include "model/WeightLayout.hpp"
+
+#include <limits>
+#include <stdexcept>
+#include <string>
+#include <utility>
+
+namespace splash::model {
+namespace {
+
+// Each layer's key and value rows [attentionSize, qkvSize) of its fused QKV projection, without a copy (affine
+// planes store whole kQ4StorageN-row tiles in row order), which the context writers project with.
+std::vector<ops::Projection> contextKvRows(metal::MetalBackend &backend, const DSpineDraftWeights &weights) {
+  const DSpineDraftLayout &layout = weights.layout;
+  if (layout.attentionSize % kQ4StorageN)
+    throw std::invalid_argument("DSpine key and value rows do not start at a storage tile");
+  std::vector<ops::Projection> result;
+  for (const DSpineLayerWeights &layer : weights.layers) {
+    const ops::AffineWeights &fused = layer.qkvProjection.affine();
+    const auto rows = [&](const metal::MetalBuffer &plane) {
+      const uint64_t rowBytes = plane.sizeBytes() / layout.qkvSize;
+      return backend.view(plane, uint64_t{layout.attentionSize} * rowBytes,
+                          uint64_t{layout.contextKvSize()} * rowBytes);
+    };
+    result.emplace_back(layout.contextKvSize(), layout.hiddenSize,
+                        ops::AffineWeights{rows(fused.weights), rows(fused.scales), rows(fused.biases)});
+  }
+  return result;
+}
+
+void requireBf16Norm(const ops::NormWeights &norm) {
+  if (norm.float32)
+    throw std::invalid_argument("DSpine norms are bf16");
+}
+
+} // namespace
+
+DSpineDraft::DSpineDraft(const DSpineDraftWeights &weights, metal::MetalBackend &backend,
+                         const ops::ExecutionPlans &operators)
+    : weights_(weights), backend_(backend), operators_(operators) {
+  if (!weights.loaded())
+    throw std::invalid_argument("DSpine draft weights are not loaded");
+  if (weights.layout.shape() != ops::kDSpineKernelShape || weights.layout.blockRows != SPLASH_DSPINE_MAXIMUM_ROWS ||
+      weights.layout.layers != 5)
+    throw std::invalid_argument("DSpine layout is not the one its kernels compile in");
+  for (const DSpineLayerWeights &layer : weights.layers) {
+    requireBf16Norm(layer.inputNorm);
+    requireBf16Norm(layer.postAttentionNorm);
+  }
+  requireBf16Norm(weights.finalNorm);
+  contextKvProjections_ = contextKvRows(backend, weights);
+  scratch_ = ops::allocateDSpineScratch(backend, weights.layout.layers, weights.layout.intermediateSize);
+}
+
+void DSpineDraft::addContextPrefill(metal::CommandGraph &graph, DFlashPrefillBuffers buffers, uint32_t rows,
+                                    std::span<const DFlashPrefillSpan> spans) const {
+  if (!rows || rows > ExecutionLimits::prefillTokenBudget || spans.empty())
+    throw std::invalid_argument("invalid DSpine context prefill");
+  const DSpineDraftLayout &layout = weights_.layout;
+  const uint32_t slots = draftContextWindow();
+  for (const DFlashPrefillSpan &span : spans)
+    if (span.ring.size() != layout.layers)
+      throw std::invalid_argument("DSpine prefill ring layer mismatch");
+  const ops::Linear &linear = operators_.linear();
+  linear.addPrefillSums(graph, buffers.capturedTargetHidden, buffers.projectionSums, weights_.contextProjection, rows);
+  linear.addPrefill(graph, buffers.capturedTargetHidden, weights_.contextProjection, buffers.projected,
+                    buffers.projectionSums, rows);
+  ops::Normalization::addRmsWithQ4Sums(graph, buffers.projected, weights_.hiddenNorm, buffers.hidden,
+                                       buffers.projectionSums, layout.hiddenSize, rows);
+  const uint64_t ropeRowBytes = uint64_t{layout.headDimension / 2} * sizeof(float);
+  const uint64_t kvRowBytes = uint64_t{layout.contextKvSize()} * sizeof(uint16_t);
+  for (uint32_t layer = 0; layer < layout.layers; ++layer) {
+    linear.addPrefill(graph, buffers.hidden, contextKvProjections_[layer], buffers.contextKv, buffers.projectionSums,
+                      rows);
+    for (const DFlashPrefillSpan &span : spans)
+      ops::DSpineOps::addContextRows(
+          graph, backend_.view(buffers.contextKv, span.compactRow * kvRowBytes, span.rows * kvRowBytes),
+          weights_.layers[layer].keyNorm,
+          backend_.view(buffers.ropeCos, span.compactRow * ropeRowBytes, span.rows * ropeRowBytes),
+          backend_.view(buffers.ropeSin, span.compactRow * ropeRowBytes, span.rows * ropeRowBytes),
+          span.ring[layer].keys, span.ring[layer].values, span.rows, span.startPosition, slots);
+  }
+}
+
+void DSpineDraft::addContextCommit(metal::CommandGraph &graph, DFlashContextBuffers buffers, uint32_t startPosition,
+                                   uint32_t rows) const {
+  const DSpineDraftLayout &layout = weights_.layout;
+  if (rows != ExecutionLimits::targetVerifyRows || buffers.persistentKeys.size() != layout.layers ||
+      buffers.persistentValues.size() != layout.layers)
+    throw std::invalid_argument("invalid DSpine context commit");
+  const uint32_t tiles = rows / ExecutionLimits::decodeTileRows;
+  const ops::Linear &linear = operators_.linear();
+  const ops::LinearScratch &scratch = buffers.linearScratch;
+  linear.add(graph, {.input = buffers.capturedTargetHidden, .output = buffers.projected, .scratch = scratch},
+             weights_.contextProjection, linear.decodePlan(weights_.contextProjection, tiles));
+  ops::LinearPlan kvPlan = linear.decodePlan(contextKvProjections_[0], tiles);
+  ops::PreparedInput hidden = ops::Normalization::addRms(graph, buffers.projected, weights_.hiddenNorm,
+                                                         buffers.hidden, layout.hiddenSize, rows, scratch,
+                                                         kvPlan.input());
+  for (uint32_t layer = 0; layer < layout.layers; ++layer) {
+    if (layer) kvPlan = linear.decodePlan(contextKvProjections_[layer], tiles);
+    hidden = linear.add(graph,
+                        {.input = buffers.hidden, .output = buffers.contextKv, .scratch = scratch, .prepared = hidden},
+                        contextKvProjections_[layer], kvPlan);
+    ops::DSpineOps::addContextCommit(graph, buffers.contextKv, weights_.layers[layer].keyNorm, buffers.ropeCos,
+                                     buffers.ropeSin, buffers.persistentKeys[layer][0],
+                                     buffers.persistentValues[layer][0], buffers.retainedCounts, rows, startPosition,
+                                     draftContextWindow());
+  }
+}
+
+void DSpineDraft::addDecode(metal::CommandGraph &graph, const DSpineDecodeInputs &inputs,
+                            const ops::Projection &vocabularyProjection, uint32_t anchorPosition, uint32_t anchor,
+                            uint32_t blockRows, const DFlashHeadShortlist *shortlist) const {
+  const DSpineDraftLayout &layout = weights_.layout;
+  if (blockRows != SPLASH_DSPINE_MAXIMUM_ROWS || inputs.ring.size() != layout.layers)
+    throw std::invalid_argument("invalid DSpine decode block");
+  const uint32_t rows = blockRows, tiles = rows / ExecutionLimits::decodeTileRows, positions = rows - 1;
+  const ops::Linear &linear = operators_.linear();
+  const ops::LinearScratch &linearScratch = inputs.linearScratch;
+  const ops::DSpineScratch &s = scratch_;
+  const DSpineBridgeWeights &bridge = weights_.bridge;
+  const uint32_t window = draftContextWindow();
+  DSpineBlockParams block{rows, anchorPosition, window, window, anchor, 0, 0, 0};
+  const uint64_t readBytes = uint64_t{layout.codeSize} * layout.hiddenSize * kBFloat16Bytes;
+  const uint64_t writeBytes = uint64_t{layout.hiddenSize} * layout.bridgeRank * kBFloat16Bytes;
+
+  ops::PreparedInput prepared = ops::Normalization::addRms(
+      graph, inputs.embeddedRows, weights_.layers[0].inputNorm, s.normed[0], layout.hiddenSize, rows, linearScratch,
+      linear.decodePlan(weights_.layers[0].qkvProjection, tiles).input());
+  for (uint32_t index = 0; index < layout.layers; ++index) {
+    const DSpineLayerWeights &layer = weights_.layers[index];
+    const uint32_t current = index & 1, next = current ^ 1;
+    const metal::MetalBuffer residualIn = index == 0 ? inputs.embeddedRows : s.residual[current];
+    block.layer = index;
+    linear.add(graph, {.input = s.normed[current], .output = s.qkv, .scratch = linearScratch, .prepared = prepared},
+               layer.qkvProjection, linear.decodePlan(layer.qkvProjection, tiles));
+    prepared = {};
+    ops::DSpineOps::addAttentionPrepare(graph, s, layer.queryNorm, layer.keyNorm, inputs.ropeCos, inputs.ropeSin,
+                                        block);
+    ops::DSpineOps::addAttention(graph, s, inputs.ring[index].keys, inputs.ring[index].values, block);
+    linear.add(graph,
+               {.input = s.attention, .output = s.afterAttention, .residual = residualIn, .scratch = linearScratch},
+               layer.outputProjection,
+               linear.decodePlan(layer.outputProjection, tiles, ops::LinearEpilogue::Residual));
+    const ops::LinearPlan gateUpPlan =
+        linear.decodePlan(layer.upProjection, tiles, ops::LinearEpilogue::GateUp, &layer.gateProjection);
+    const ops::PreparedInput mlpInput =
+        ops::Normalization::addRms(graph, s.afterAttention, layer.postAttentionNorm, s.mlpNormalized,
+                                   layout.hiddenSize, rows, linearScratch, gateUpPlan.input());
+    linear.add(graph,
+               {.input = s.mlpNormalized, .output = s.intermediate, .gateScratch = inputs.gateScratch,
+                .scratch = linearScratch, .prepared = mlpInput},
+               layer.upProjection, gateUpPlan, &layer.gateProjection);
+    linear.add(graph,
+               {.input = s.intermediate, .output = s.layerOutput, .residual = s.afterAttention,
+                .scratch = linearScratch},
+               layer.downProjection, linear.decodePlan(layer.downProjection, tiles, ops::LinearEpilogue::Residual));
+
+    // The bridge write after this layer (bridge.py DSpineCodeBridge.__call__ with residual None).
+    ops::DSpineOps::addBridgeNormalize(graph, s.layerOutput, s.bridgeNormalized, s.rowRms, rows);
+    const metal::MetalBuffer readWeight =
+        index + 1 < layout.layers ? backend_.view(bridge.earlyReadWeights, index * readBytes, readBytes)
+                                  : bridge.lastReadWeight;
+    ops::DSpineOps::addProjection(graph, s.bridgeNormalized, readWeight, s.projected, rows, layout.hiddenSize,
+                                  layout.codeSize);
+    ops::DSpineOps::addBridgeCodes(graph, s.projected, bridge.codebook, s.codes, block);
+    ops::DSpineOps::addProjection(graph, s.codes, bridge.packedWeight, s.packed, rows, layout.codeSize,
+                                  3 * layout.bridgeRank);
+    ops::DSpineOps::addBridgeMessage(graph, s.packed, bridge.gateBias, s.message, block);
+    ops::DSpineOps::addProjection(graph, s.message, backend_.view(bridge.writeWeights, index * writeBytes, writeBytes),
+                                  s.delta, rows, layout.bridgeRank, layout.hiddenSize);
+    const metal::MetalBuffer nextNorm =
+        index + 1 < layout.layers ? weights_.layers[index + 1].inputNorm.buffer : weights_.finalNorm.buffer;
+    ops::DSpineOps::addBridgeWrite(graph, s.layerOutput, s.rowRms, s.delta, nextNorm, s.residual[next],
+                                   s.normed[next], rows);
+  }
+
+  // Pass 1: the target head over the final normed rows (the shortlist's columns when given), then each proposal
+  // row's top 16.
+  const ops::Projection &head = shortlist ? shortlist->head : vocabularyProjection;
+  const ops::LinearPlan headPlan = linear.decodePlan(head, tiles);
+  ops::PreparedInput afterHead = linear.add(
+      graph, {.input = s.finalNormed, .output = inputs.logits, .scratch = linearScratch}, head, headPlan);
+  DraftLogitsParams columns{layout.vocabularySize, layout.vocabularySize, 0};
+  if (shortlist) {
+    const uint64_t skipped = uint64_t{shortlist->columns.split} * sizeof(float);
+    linear.add(graph,
+               {.input = s.finalNormed,
+                .output = backend_.view(inputs.logits, skipped, inputs.logits.sizeBytes() - skipped),
+                .scratch = linearScratch, .prepared = afterHead},
+               shortlist->tailHead, headPlan);
+    columns = {shortlist->width(), shortlist->columns.split, shortlist->columns.tail - shortlist->columns.split};
+  }
+  ops::DSpineOps::addCandidates(graph, inputs.logits, s, columns, positions);
+
+  // The refinement tail (propose.py RefinementTail.sampled_table) over the target head's Q4_K rows.
+  if (vocabularyProjection.layout() != ops::WeightLayout::Block32 ||
+      vocabularyProjection.blocks().segments.size() != 1 ||
+      vocabularyProjection.blocks().segments.front().formatId != GGUF_FMT_Q4K ||
+      vocabularyProjection.blocks().segments.front().inputSize != layout.hiddenSize)
+    throw std::invalid_argument("the DSpine refinement reads a Q4_K GGUF head");
+  const ops::QuantizedSegment &segment = vocabularyProjection.blocks().segments.front();
+  ops::DSpineOps::addRefinement(graph, s, bridge.codebook, bridge.packedWeight, bridge.gateBias,
+                                backend_.view(bridge.writeWeights, (layout.layers - 1) * writeBytes, writeBytes),
+                                weights_.finalNorm.buffer, segment.plane0, segment.meta, layout.hiddenSize / 32,
+                                positions, anchor);
+}
+
+void DSpineDraft::addSelection(metal::CommandGraph &graph, const DSpineSelectionOutputs &outputs, uint32_t anchor,
+                               uint32_t blockRows, const ops::VerifyTailPolicy &tail,
+                               const ops::DSpineCopyInputs *copy) const {
+  const uint32_t positions = blockRows - 1;
+  // A copy chain only ever fills rows >= SPLASH_TARGET_VERIFY_ROWS - (tip depth + 1) (dspine_copy_extend). When the
+  // tail policy drops those rows in every cycle (no keep-mass gate), the extension's rows would never be verified:
+  // it is not encoded, so the cycle's copy outcome reads zero rows.
+  constexpr uint32_t kFirstCopyRow = SPLASH_TARGET_VERIFY_ROWS - (SPLASH_DSPINE_COPY_TIP_DEPTH + 1);
+  const bool tailAlwaysDropsCopyRows = tail.firstTailRow != 0 && tail.firstTailRow <= kFirstCopyRow &&
+                                       tail.keepMass == std::numeric_limits<float>::infinity();
+  if (tailAlwaysDropsCopyRows)
+    copy = nullptr;
+  // The copy extension rewrites the tree's last rows, so with it the tail decision is its last step.
+  ops::VerifyTailPolicy none{0, 0.0F, tail.report};
+  ops::DSpineOps::addTree(graph, scratch_, outputs.proposedTokens, outputs.tree, outputs.positions, positions,
+                          anchor, copy ? none : tail);
+  if (copy)
+    ops::DSpineOps::addCopyExtension(graph, scratch_, outputs.proposedTokens, outputs.tree, outputs.positions,
+                                     positions, anchor, *copy, tail);
+}
+
