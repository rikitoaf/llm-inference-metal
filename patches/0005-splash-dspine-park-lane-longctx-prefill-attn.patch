+// DSpine draft kernels (model/DSpineDraft.hpp, ops/DSpineOps.cpp). Rounding points follow Tencent's MLX reference
+// (dspine_mlx bridge.py / propose.py): bf16 tensors where it rounds to bf16, fp32 arithmetic in between.
+#pragma clang fp reassociate(off)
+#include "metal/abi/DSpine.h"
+#include "metal/abi/KernelABI.h"
+#include "metal/abi/QuantFormat.h"
+#include "metal/kernels/common/quant_formats.h"
+#include "metal/kernels/common/rms_inverse.h"
+#include "metal/kernels/common/sgmatrix.h"
+
+#include <MetalPerformancePrimitives/MetalPerformancePrimitives.h>
+using namespace mpp::tensor_ops;
+
+namespace dspine {
+
+constant constexpr uint kHidden = 5120, kQueryHeads = 32, kKvHeads = 8, kHeadDim = 128;
+constant constexpr uint kAttention = kQueryHeads * kHeadDim, kKvWidth = kKvHeads * kHeadDim;
+constant constexpr uint kPackedQkv = kAttention + 2 * kKvWidth;
+constant constexpr uint kMaximumRows = SPLASH_DSPINE_MAXIMUM_ROWS;
+constant constexpr uint kCode = 1024, kRank = 512, kCandidates = SPLASH_DSPINE_CANDIDATES;
+constant constexpr float kBridgeEpsilon = 1e-6f, kNormEpsilon = 1e-6f;
+constant constexpr float kCodeScale = 32.0f;  // sqrt(code size), exact
+constant constexpr float kScoreScale = 0.08838834765f;  // 1 / sqrt(128)
+// Matrix rows of one attention tile: the four query heads of a KV head x eight block rows (one half of a block).
+constant constexpr ushort kTileRows = 32;
+constant constexpr uint kPartialFloats = kTileRows * kHeadDim + 2 * kTileRows;
+
+// The sum of each thread's value over a 256-thread group, in a fixed order, returned to every thread.
+inline float group_sum(float value, threadgroup float *reductions, uint thread_index, uint lane, uint simd_group) {
+  value = simd_sum(value);
+  threadgroup_barrier(mem_flags::mem_threadgroup);
+  if (lane == 0)
+    reductions[simd_group] = value;
+  threadgroup_barrier(mem_flags::mem_threadgroup);
+  float total = 0.0f;
+  for (uint i = 0; i < 8; ++i)
+    total += reductions[i];
+  return total;
+}
+
+inline float sigmoid(float x) { return 1.0f / (1.0f + metal::precise::exp(-x)); }
+
+} // namespace dspine
+
+using namespace dspine;
+
+// ---------------------------------------------------------------------------------------------------- attention
+
+// One normalization task per group (256 threads): rows x 32 query heads, then rows x 8 KV heads. A query head is
+// RMS-normalized (q_norm), rotated to its row's position and stored in the tile layout
+// [kv head][half][head of the group][row of the half][128]; a key head likewise (k_norm) into block_keys
+// [kv head][16][128], whose value head is copied into block_values [kv head][128][16].
+kernel void dspine_attention_prepare(device const bfloat *qkv [[buffer(0)]],
+                                     device bfloat *queries [[buffer(1)]],
+                                     device const bfloat *q_norm [[buffer(2)]],
+                                     device const bfloat *k_norm [[buffer(3)]],
+                                     device const float *rope_cos [[buffer(4)]],
+                                     device const float *rope_sin [[buffer(5)]],
+                                     device bfloat *block_keys [[buffer(6)]],
+                                     device bfloat *block_values [[buffer(7)]],
+                                     constant DSpineBlockParams &p [[buffer(8)]],
+                                     uint task [[threadgroup_position_in_grid]],
+                                     uint thread_index [[thread_index_in_threadgroup]],
+                                     uint lane [[thread_index_in_simdgroup]],
+                                     uint simd_group [[simdgroup_index_in_threadgroup]]) {
+  threadgroup float reductions[8];
+  threadgroup bfloat head[kHeadDim];
+  const bool query = task < p.rows * kQueryHeads;
+  const uint local = query ? task : task - p.rows * kQueryHeads;
+  const uint heads = query ? kQueryHeads : kKvHeads;
+  const uint row = local / heads, head_index = local % heads;
+  if (row >= p.rows)
+    return;
+  device const bfloat *source =
+      qkv + ulong(row) * kPackedQkv + (query ? head_index * kHeadDim : kAttention + head_index * kHeadDim);
+  device bfloat *destination;
+  if (query) {
+    const uint group = head_index / 4, in_group = head_index % 4, half_index = row / 8, half_row = row % 8;
+    destination = queries + ((((group * 2 + half_index) * 4 + in_group) * 8 + half_row) * kHeadDim);
+  } else {
+    destination = block_keys + (ulong(head_index) * kMaximumRows + row) * kHeadDim;
+    if (thread_index < kHeadDim)
+      block_values[(ulong(head_index) * kHeadDim + thread_index) * kMaximumRows + row] =
+          qkv[ulong(row) * kPackedQkv + kAttention + kKvWidth + head_index * kHeadDim + thread_index];
+  }
+  device const bfloat *weight = query ? q_norm : k_norm;
+  const float value = thread_index < kHeadDim ? float(source[thread_index]) : 0.0f;
+  const float inverse = rms_inverse_of_sums(value * value, kHeadDim, reductions, thread_index, lane, simd_group);
+  if (thread_index < kHeadDim)
+    head[thread_index] = bfloat(value * inverse * float(weight[thread_index]));
+  threadgroup_barrier(mem_flags::mem_threadgroup);
+  if (thread_index < kHeadDim / 2) {
+    const float first = float(head[thread_index]), second = float(head[thread_index + kHeadDim / 2]);
+    const float cosine = rope_cos[row * (kHeadDim / 2) + thread_index];
+    const float sine = rope_sin[row * (kHeadDim / 2) + thread_index];
+    destination[thread_index] = bfloat(first * cosine - second * sine);
+    destination[thread_index + kHeadDim / 2] = bfloat(second * cosine + first * sine);
+  }
+}
+
+// Grid {8 KV heads x halves, 1, splits}. One split of one (KV head, half) tile: the 32 matrix rows are the KV
+// head's four query heads x the half's eight block rows. The window [max(0, p - window), p) of the ring (window ==
+// ring slots) occupies one or two physical ranges; its 128-slot tiles are dealt round-robin to the splits, each
+// running an online softmax; the last split adds the block's keys 0..t of row t (block-causal). The unnormalized
+// fp32 accumulator and its row maxima and sums land in `partials` for the fixed-order reduce. Adapted from
+// draft_attention_split_phase (decode/draft.metal), whose tiles it keeps.
+kernel void dspine_attention_split(device bfloat *queries [[buffer(0)]],
+                                   device bfloat *ring_keys [[buffer(1)]],
+                                   device bfloat *ring_values [[buffer(2)]],
+                                   device bfloat *block_keys [[buffer(3)]],
+                                   device bfloat *block_values [[buffer(4)]],
+                                   device float *partials [[buffer(5)]],
+                                   constant DSpineBlockParams &p [[buffer(6)]],
+                                   uint3 group [[threadgroup_position_in_grid]],
+                                   uint thread_index [[thread_index_in_threadgroup]],
+                                   uint lane [[thread_index_in_simdgroup]],
+                                   uint simd_group [[simdgroup_index_in_threadgroup]]) {
+  constexpr ushort M = kTileRows, N = 128, D = 128, TileK = 64;
+  constexpr uint Splits = SPLASH_DSPINE_ATTENTION_SPLITS;
+  const uint halves = (p.rows + 7) / 8;
+  const uint kv_head = group.x / halves, half_index = group.x % halves, split = group.z;
+  const uint slots = p.ring_slots;
+  threadgroup float workspace[M * N + 3 * M];
+  threadgroup float *score_storage = workspace;
+  threadgroup float *row_max = workspace + M * N;
+  threadgroup float *row_sum = row_max + M;
+  threadgroup float *previous_scale = row_sum + M;
+  device bfloat *tile_queries = queries + ((kv_head * 2 + half_index) * M) * D;
+  device bfloat *keys = ring_keys + ulong(kv_head) * slots * D;
+  device bfloat *values = ring_values + ulong(kv_head) * D * slots;
+  device bfloat *current_keys_base = block_keys + ulong(kv_head) * kMaximumRows * D;
+  device bfloat *current_values_base = block_values + ulong(kv_head) * D * kMaximumRows;
+  device float *partial = partials + ((kv_head * 2 + half_index) * Splits + split) * kPartialFloats;
+
+  const uint cache_length = p.anchor_position;
+  const uint common_start = cache_length >= p.window ? cache_length - p.window : 0;
+  const uint old_count = cache_length - common_start;
+  const uint physical_start = common_start % slots;
+  const uint physical_end = physical_start + old_count;
+  const uint wrapped = physical_end > slots ? (physical_end - slots + N - 1) / N : 0;
+  const uint tail_end = (min(physical_end, slots) + N - 1) / N;
+  const uint resume = max(physical_start / N, wrapped);
+  const uint live_tiles = wrapped + tail_end - resume;
+  if (split >= live_tiles && split + 1 != Splits) {
+    if (thread_index < M)
+      partial[M * D + thread_index] = -INFINITY;
+    return;
+  }
+  auto qt = tensor(tile_queries, dextents<int, 2>{D, M}, array<int, 2>{1, D});
+  constexpr auto qk_descriptor = matmul2d_descriptor(M, N, TileK, false, true, false);
+  matmul2d<qk_descriptor, execution_simdgroups<8>> qk;
+  auto q0 = qt.slice<TileK, M>(0, 0);
+  auto pt = tensor(score_storage, dextents<int, 2>{N, M}, array<int, 2>{1, N});
+  auto p0 = pt.slice<TileK, M>(0, 0);
+  auto first_v = tensor(values, dextents<int, 2>{N, D}, array<int, 2>{1, int(slots)});
+  auto first_v0 = first_v.slice<TileK, D>(0, 0);
+  constexpr auto pv_descriptor = matmul2d_descriptor(M, D, TileK, false, true, false);
+  matmul2d<pv_descriptor, execution_simdgroups<8>> pv;
+  auto running = pv.template get_destination_cooperative_tensor<decltype(p0), decltype(first_v0), float>();
+  for (ushort i = 0; i < running.get_capacity(); ++i)
+    running[i] = 0.0f;
+  if (thread_index < M) {
+    row_max[thread_index] = -INFINITY;
+    row_sum[thread_index] = 0.0f;
+  }
+  threadgroup_barrier(mem_flags::mem_threadgroup);
+
+  for (uint tile = split; tile < live_tiles; tile += Splits) {
+    const uint slot = (tile < wrapped ? tile : resume + tile - wrapped) * N;
+    auto kt = tensor(keys + ulong(slot) * D, dextents<int, 2>{D, N}, array<int, 2>{1, D});
+    auto k0 = kt.slice<TileK, N>(0, 0);
+    auto scores = qk.template get_destination_cooperative_tensor<decltype(q0), decltype(k0), float>();
+    for (ushort i = 0; i < scores.get_capacity(); ++i)
+      scores[i] = 0.0f;
+    for (ushort chunk = 0; chunk < D / TileK; ++chunk) {
+      auto qs = qt.slice<TileK, M>(chunk * TileK, 0);
+      auto ks = kt.slice<TileK, N>(chunk * TileK, 0);
+      auto partial_scores = qk.template get_destination_cooperative_tensor<decltype(qs), decltype(ks), float>();
+      qk.run(qs, ks, partial_scores);
+      for (ushort i = 0; i < scores.get_capacity(); ++i)
+        scores[i] += partial_scores[i];
+    }
+    scores.store(pt.slice<N, M>(0, 0));
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+
+    for (ushort batch = 0; batch < M; batch += 8) {
+      const ushort matrix_row = batch + simd_group;
+      float local_scores[4];
+      float tile_max = -INFINITY;
+      for (ushort i = 0; i < 4; ++i) {
+        const uint column = lane + i * 32;
+        const uint key = slot + column;
+        const uint logical_key = key >= physical_start ? key - physical_start : key + slots - physical_start;
+        const bool valid = logical_key < old_count;
+        const float score = score_storage[matrix_row * N + column] * kScoreScale;
+        local_scores[i] = valid ? score : -INFINITY;
+        tile_max = max(tile_max, local_scores[i]);
+      }
+      tile_max = simd_max(tile_max);
+      const float next_max = max(row_max[matrix_row], tile_max);
+      const bool empty = next_max == -INFINITY;
+      const float scale = empty ? 1.0f : fast::exp(row_max[matrix_row] - next_max);
+      float tile_sum = 0.0f;
+      for (ushort i = 0; i < 4; ++i) {
+        local_scores[i] = empty ? 0.0f : fast::exp(local_scores[i] - next_max);
+        tile_sum += local_scores[i];
+      }
+      tile_sum = simd_sum(tile_sum);
+      if (lane == 0) {
+        previous_scale[matrix_row] = scale;
+        row_sum[matrix_row] = row_sum[matrix_row] * scale + tile_sum;
+        row_max[matrix_row] = next_max;
+      }
+      for (ushort i = 0; i < 4; ++i)
+        score_storage[matrix_row * N + lane + i * 32] = local_scores[i];
+    }
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+
+    auto vt = tensor(values + slot, dextents<int, 2>{N, D}, array<int, 2>{1, int(slots)});
+    auto v0 = vt.slice<TileK, D>(0, 0);
+    auto partial_output = pv.template get_destination_cooperative_tensor<decltype(p0), decltype(v0), float>();
+    for (ushort i = 0; i < partial_output.get_capacity(); ++i)
+      partial_output[i] = 0.0f;
+    for (ushort chunk = 0; chunk < N / TileK; ++chunk) {
+      auto ps = pt.slice<TileK, M>(chunk * TileK, 0);
+      auto vs = vt.slice<TileK, D>(chunk * TileK, 0);
+      auto partial_values = pv.template get_destination_cooperative_tensor<decltype(ps), decltype(vs), float>();
+      pv.run(ps, vs, partial_values);
+      for (ushort i = 0; i < partial_output.get_capacity(); ++i)
+        partial_output[i] += partial_values[i];
+    }
+    for (ushort i = 0; i < running.get_capacity(); ++i) {
+      auto index = running.get_multidimensional_index(i);
+      running[i] = running[i] * previous_scale[index[1]] + partial_output[i];
+    }
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+  }
+
+  if (split + 1 == Splits) {
+    // The block's 16 key slots; row t keeps keys 0..t (rows past the block are zero and masked).
+    constexpr ushort CurrentN = kMaximumRows;
+    threadgroup float *current_raw_scores = score_storage + M * CurrentN;
+    threadgroup bfloat *current_values =
+        reinterpret_cast<threadgroup bfloat *>(score_storage + M * CurrentN + M * CurrentN);
+    auto current_scores = tensor(current_raw_scores, dextents<int, 2>{CurrentN, M}, array<int, 2>{1, CurrentN});
+    constexpr auto current_qk_descriptor = matmul2d_descriptor(M, CurrentN, TileK, false, true, false);
+    matmul2d<current_qk_descriptor, execution_simdgroups<8>> current_qk;
+    auto current_kt = tensor(current_keys_base, dextents<int, 2>{D, CurrentN}, array<int, 2>{1, D});
+    auto current_k0 = current_kt.slice<TileK, CurrentN>(0, 0);
+    auto current = current_qk.template get_destination_cooperative_tensor<decltype(q0), decltype(current_k0), float>();
+    for (ushort i = 0; i < current.get_capacity(); ++i)
+      current[i] = 0.0f;
+    for (ushort chunk = 0; chunk < D / TileK; ++chunk) {
+      auto qs = qt.slice<TileK, M>(chunk * TileK, 0);
+      auto ks = current_kt.slice<TileK, CurrentN>(chunk * TileK, 0);
+      auto partial_scores =
+          current_qk.template get_destination_cooperative_tensor<decltype(qs), decltype(ks), float>();
+      current_qk.run(qs, ks, partial_scores);
+      for (ushort i = 0; i < current.get_capacity(); ++i)
+        current[i] += partial_scores[i];
+    }
+    current.store(current_scores.slice<CurrentN, M>(0, 0));
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+
+    for (ushort batch = 0; batch < M; batch += 8) {
+      const ushort matrix_row = batch + simd_group;
+      const uint block_row = half_index * 8 + matrix_row % 8;
+      const bool visible = lane < CurrentN && lane <= block_row && lane < p.rows;
+      const float score = visible ? current_raw_scores[matrix_row * CurrentN + lane] * kScoreScale : -INFINITY;
+      const float tile_max = simd_max(score);
+      const float next_max = max(row_max[matrix_row], tile_max);
+      const float scale = fast::exp(row_max[matrix_row] - next_max);
+      const float probability = visible ? fast::exp(score - next_max) : 0.0f;
+      const float tile_sum = simd_sum(probability);
+      if (lane == 0) {
+        previous_scale[matrix_row] = scale;
+        row_sum[matrix_row] = row_sum[matrix_row] * scale + tile_sum;
+        row_max[matrix_row] = next_max;
+      }
+      if (lane < CurrentN)
+        score_storage[matrix_row * CurrentN + lane] = probability;
+    }
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+
+    auto current_probabilities = tensor(score_storage, dextents<int, 2>{CurrentN, M}, array<int, 2>{1, CurrentN});
+    auto current_p0 = current_probabilities.slice<CurrentN, M>(0, 0);
+    for (uint index = thread_index; index < D * CurrentN; index += 256)
+      current_values[index] = current_values_base[index];
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    auto current_vt = tensor(current_values, dextents<int, 2>{CurrentN, D}, array<int, 2>{1, int(CurrentN)});
+    auto current_v0 = current_vt.slice<CurrentN, D>(0, 0);
+    constexpr auto current_pv_descriptor = matmul2d_descriptor(M, D, CurrentN, false, true, false);
+    matmul2d<current_pv_descriptor, execution_simdgroups<8>> current_pv;
+    auto current_output =
+        current_pv.template get_destination_cooperative_tensor<decltype(current_p0), decltype(current_v0), float>();
+    current_pv.run(current_p0, current_v0, current_output);
+    for (ushort i = 0; i < running.get_capacity(); ++i) {
+      auto index = running.get_multidimensional_index(i);
+      running[i] = running[i] * previous_scale[index[1]] + current_output[i];
+    }
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+  }
+
+  auto accumulator = tensor(partial, dextents<int, 2>{D, M}, array<int, 2>{1, D});
+  running.store(accumulator.slice<D, M>(0, 0));
+  if (thread_index < M) {
+    partial[M * D + thread_index] = row_max[thread_index];
+    partial[M * D + M + thread_index] = row_sum[thread_index];
+  }
+}
+
+// Grid {8 KV heads x halves}, 256 threads: the fixed-order combine of one tile's split partials into the attention
+// rows, row-major [row][query head x 128] for the output projection.
+kernel void dspine_attention_reduce(device const float *partials [[buffer(0)]],
+                                    device bfloat *output [[buffer(1)]],
+                                    constant DSpineBlockParams &p [[buffer(2)]],
+                                    uint group [[threadgroup_position_in_grid]],
+                                    uint thread_index [[thread_index_in_threadgroup]]) {
+  constexpr uint M = kTileRows, D = kHeadDim, Splits = SPLASH_DSPINE_ATTENTION_SPLITS, Chunk = D / 8;
+  const uint halves = (p.rows + 7) / 8;
+  const uint kv_head = group / halves, half_index = group % halves;
+  device const float *tile = partials + (kv_head * 2 + half_index) * Splits * kPartialFloats;
+  const uint matrix_row = thread_index / 8, dim = (thread_index % 8) * Chunk;
+  float maximum = -INFINITY;
+  for (uint split = 0; split < Splits; ++split)
+    maximum = max(maximum, tile[split * kPartialFloats + M * D + matrix_row]);
+  float total = 0.0f;
+  float accumulated[Chunk];
+  for (uint i = 0; i < Chunk; ++i)
+    accumulated[i] = 0.0f;
+  for (uint split = 0; split < Splits; ++split) {
+    device const float *partial = tile + split * kPartialFloats;
+    const float split_max = partial[M * D + matrix_row];
+    if (split_max == -INFINITY)
+      continue;
+    const float scale = fast::exp(split_max - maximum);
+    total += scale * partial[M * D + M + matrix_row];
+    for (uint i = 0; i < Chunk; ++i)
+      accumulated[i] += scale * partial[matrix_row * D + dim + i];
+  }
+  const uint block_row = half_index * 8 + matrix_row % 8, query_head = kv_head * 4 + matrix_row / 8;
+  if (block_row >= p.rows)
+    return;
+  for (uint i = 0; i < Chunk; ++i)
+    output[ulong(block_row) * kAttention + query_head * D + dim + i] = bfloat(accumulated[i] / total);
+}
+
+// ---------------------------------------------------------------------------------------------------- context
+
+inline void dspine_context_row(device const bfloat *context_kv, device const bfloat *k_norm,
+                               device const float *rope_cos, device const float *rope_sin, device bfloat *keys,
+                               device bfloat *values, uint start_position, uint active_tokens, uint slots,
+                               uint task, uint thread_index, uint lane, uint simd_group,
+                               threadgroup float *reductions, threadgroup bfloat *normalized) {
+  const uint row = task / kKvHeads;
+  if (row >= active_tokens)
+    return;
+  const uint head_index = task % kKvHeads;
+  const uint slot = (start_position + row) % slots;
+  device const bfloat *source = context_kv + ulong(row) * 2 * kKvWidth + head_index * kHeadDim;
+  device bfloat *key = keys + (ulong(head_index) * slots + slot) * kHeadDim;
+  device bfloat *value = values + ulong(head_index) * kHeadDim * slots + slot;
+  const float element = thread_index < kHeadDim ? float(source[thread_index]) : 0.0f;
+  const float inverse = rms_inverse_of_sums(element * element, kHeadDim, reductions, thread_index, lane, simd_group);
+  if (thread_index < kHeadDim) {
+    normalized[thread_index] = bfloat(element * inverse * float(k_norm[thread_index]));
+    value[ulong(thread_index) * slots] = source[kKvWidth + thread_index];
+  }
+  threadgroup_barrier(mem_flags::mem_threadgroup);
+  if (thread_index < kHeadDim / 2) {
+    const float first = float(normalized[thread_index]), second = float(normalized[thread_index + kHeadDim / 2]);
+    const float cosine = rope_cos[ulong(row) * (kHeadDim / 2) + thread_index];
+    const float sine = rope_sin[ulong(row) * (kHeadDim / 2) + thread_index];
+    key[thread_index] = bfloat(first * cosine - second * sine);
+    key[thread_index + kHeadDim / 2] = bfloat(second * cosine + first * sine);
+  }
+}
+
+// Grid tokens x 8 groups of 256: context rows (keys, then values, per row) into ring slots position % slots.
+kernel void dspine_context_kv(device const bfloat *context_kv [[buffer(0)]],
+                              device const bfloat *k_norm [[buffer(1)]],
+                              device const float *rope_cos [[buffer(2)]],
+                              device const float *rope_sin [[buffer(3)]],
+                              device bfloat *keys [[buffer(4)]], device bfloat *values [[buffer(5)]],
+                              constant DSpineContextParams &p [[buffer(6)]],
+                              uint task [[threadgroup_position_in_grid]],
+                              uint thread_index [[thread_index_in_threadgroup]],
+                              uint lane [[thread_index_in_simdgroup]],
+                              uint simd_group [[simdgroup_index_in_threadgroup]]) {
+  threadgroup float reductions[8];
+  threadgroup bfloat normalized[kHeadDim];
+  dspine_context_row(context_kv, k_norm, rope_cos, rope_sin, keys, values, p.start_position, p.tokens, p.ring_slots,
+                     task, thread_index, lane, simd_group, reductions, normalized);
+}
+
+// The decode commit: the first min(retained, tokens) rows (the accepted path in depth order).
+kernel void dspine_context_kv_commit(device const bfloat *context_kv [[buffer(0)]],
+                                     device const bfloat *k_norm [[buffer(1)]],
+                                     device const float *rope_cos [[buffer(2)]],
+                                     device const float *rope_sin [[buffer(3)]],
+                                     device bfloat *keys [[buffer(4)]], device bfloat *values [[buffer(5)]],
+                                     device const uint *retained [[buffer(6)]],
+                                     constant DSpineContextParams &p [[buffer(7)]],
+                                     uint task [[threadgroup_position_in_grid]],
+                                     uint thread_index [[thread_index_in_threadgroup]],
+                                     uint lane [[thread_index_in_simdgroup]],
+                                     uint simd_group [[simdgroup_index_in_threadgroup]]) {
+  threadgroup float reductions[8];
+  threadgroup bfloat normalized[kHeadDim];
+  dspine_context_row(context_kv, k_norm, rope_cos, rope_sin, keys, values, p.start_position,
+                     min(retained[0], p.tokens), p.ring_slots, task, thread_index, lane, simd_group, reductions,
+                     normalized);
+}
+
+// ---------------------------------------------------------------------------------------------------- bridge
+
+// bf16-weight projection on simdgroup 8x8 MMA with exact fp32 operands (gguf_float::project's tile with bf16
+// weights): one threadgroup computes output columns [8 tg.x, 8 tg.x + 8) of rows [32 tg.y, 32 tg.y + 32); simdgroup
+// s accumulates K part s of every fragment, simdgroup f then adds fragment f's parts in order. Grid
+// (output_size / 8, ceil(rows / 32)), 16 simdgroups.
+namespace dspine_project {
+constant constexpr uint kFragments = 4;
+constant constexpr uint kRows = 8 * kFragments;
+constant constexpr uint kSplits = 16;
+} // namespace dspine_project
+
+kernel void dspine_project_bf16(device const bfloat *input [[buffer(0)]],
+                                device const bfloat *weights [[buffer(1)]],
+                                device bfloat *output [[buffer(2)]],
+                                constant DSpineProjectParams &p [[buffer(3)]],
+                                uint2 tg [[threadgroup_position_in_grid]],
+                                uint sg [[simdgroup_index_in_threadgroup]],
+                                uint lane [[thread_index_in_simdgroup]]) {
+  using namespace dspine_project;
+  threadgroup float2 parts[kSplits * kFragments * 32];
+  const sgmatrix::Lane l = sgmatrix::lane_map(lane);
+  const uint K = p.input_size, column = tg.x * 8 + l.fn, row0 = tg.y * kRows;
+  const uint live = min(kRows, p.rows - row0);
+  const uint steps = K / 8, first = sg * steps / kSplits, last = (sg + 1) * steps / kSplits;
+  device const bfloat *w = weights + (ulong(p.weight_row) + column) * K + l.fm;
+  float2 acc[kFragments];
+  for (uint f = 0; f < kFragments; ++f)
+    acc[f] = float2(0);
+  for (uint step = first; step < last; ++step) {
+    const uint k = step * 8;
+    const float2 b = float2(float(w[k]), float(w[K + k]));
+    for (uint f = 0; f < kFragments; ++f) {
+      if (f * 8 >= live)
+        break;
+      const uint row = f * 8 + l.fm;
+      const float2 a = row < live ? float2(*reinterpret_cast<device const bfloat2 *>(input + ulong(row0 + row) * K + k + l.fn))
+                                  : float2(0);
+      sgmatrix::mma_acc<float>(acc[f], a, b);
+    }
+  }
+  for (uint f = 0; f < kFragments; ++f)
+    parts[(sg * kFragments + f) * 32 + lane] = acc[f];
+  threadgroup_barrier(mem_flags::mem_threadgroup);
+  const uint f = sg, row = f * 8 + l.fm;
+  if (f >= kFragments || row >= live)
+    return;
+  float2 total = float2(0);
+  for (uint s = 0; s < kSplits; ++s)
+    total += parts[(s * kFragments + f) * 32 + lane];
+  device bfloat *out = output + ulong(row0 + row) * p.output_size + column;
+  out[0] = bfloat(total.x);
+  out[1] = bfloat(total.y);
+}
+
+// Grid rows, 256 threads: rms = sqrt(max(mean(raw^2), FLT_MIN)) and normalized = bf16(raw / (rms + eps)).
+kernel void dspine_bridge_normalize(device const bfloat *raw [[buffer(0)]],
+                                    device bfloat *normalized [[buffer(1)]],
+                                    device float *rms [[buffer(2)]],
+                                    uint row [[threadgroup_position_in_grid]],
+                                    uint thread_index [[thread_index_in_threadgroup]],
+                                    uint lane [[thread_index_in_simdgroup]],
+                                    uint simd_group [[simdgroup_index_in_threadgroup]]) {
+  threadgroup float reductions[8];
+  device const bfloat *source = raw + ulong(row) * kHidden;
+  float sum = 0.0f;
+  for (uint c = thread_index; c < kHidden; c += 256) {
+    const float value = float(source[c]);
+    sum += value * value;
+  }
+  const float total = group_sum(sum, reductions, thread_index, lane, simd_group);
+  const float row_rms = sqrt(max(total / kHidden, FLT_MIN));
+  if (thread_index == 0)
+    rms[row] = row_rms;
+  for (uint c = thread_index; c < kHidden; c += 256)
+    normalized[ulong(row) * kHidden + c] = bfloat(float(source[c]) / (row_rms + kBridgeEpsilon));
+}
+
+// Grid rows, 256 threads: a row's code, 32 * projected / (|projected| + eps); row 0's is the anchor's codebook entry
+// times 32.
+kernel void dspine_bridge_codes(device const bfloat *projected [[buffer(0)]],
+                                device const bfloat *codebook [[buffer(1)]],
+                                device bfloat *codes [[buffer(2)]],
+                                constant DSpineBlockParams &p [[buffer(3)]],
+                                uint row [[threadgroup_position_in_grid]],
+                                uint thread_index [[thread_index_in_threadgroup]],
+                                uint lane [[thread_index_in_simdgroup]],
+                                uint simd_group [[simdgroup_index_in_threadgroup]]) {
+  threadgroup float reductions[8];
+  if (row == 0) {
+    for (uint c = thread_index; c < kCode; c += 256)
+      codes[c] = bfloat(kCodeScale * float(codebook[ulong(p.anchor) * kCode + c]));
+    return;
+  }
+  device const bfloat *source = projected + ulong(row) * kCode;
+  float sum = 0.0f;
+  for (uint c = thread_index; c < kCode; c += 256) {
+    const float value = float(source[c]);
+    sum += value * value;
+  }
+  const float norm = sqrt(group_sum(sum, reductions, thread_index, lane, simd_group));
+  for (uint c = thread_index; c < kCode; c += 256)
+    codes[ulong(row) * kCode + c] = bfloat(kCodeScale * float(source[c]) / (norm + kBridgeEpsilon));
+}
+
+// One thread per (row, rank): message_0 = 0, message_t = bf16(sigmoid(q_t + s_{t-1} + bias) * v_{t-1}) from the
+// packed [q | s | v] rows (codes x [G_q; G_p; A]^T).
+kernel void dspine_bridge_message(device const bfloat *packed [[buffer(0)]],
+                                  device const bfloat *gate_bias [[buffer(1)]],
+                                  device bfloat *message [[buffer(2)]],
+                                  constant DSpineBlockParams &p [[buffer(3)]],
+                                  uint index [[thread_position_in_grid]]) {
+  if (index >= p.rows * kRank)
+    return;
+  const uint row = index / kRank, r = index % kRank;
+  if (row == 0) {
+    message[r] = bfloat(0.0f);
+    return;
+  }
+  const float q = float(packed[ulong(row) * 3 * kRank + r]);
+  const float s = float(packed[ulong(row - 1) * 3 * kRank + kRank + r]);
+  const float v = float(packed[ulong(row - 1) * 3 * kRank + 2 * kRank + r]);
+  message[index] = bfloat(dspine::sigmoid((q + s) + float(gate_bias[r])) * v);
+}
+
+// Grid rows, 256 threads: out = bf16(raw + rms * delta) (row 0: raw), the next layer's residual; then its input,
+// bf16(bf16(out * rsqrt(mean(out^2) + eps)) * norm_weight).
+kernel void dspine_bridge_write(device const bfloat *raw [[buffer(0)]],
+                                device const float *rms [[buffer(1)]],
+                                device const bfloat *delta [[buffer(2)]],
+                                device const bfloat *next_norm [[buffer(3)]],
+                                device bfloat *residual_out [[buffer(4)]],
+                                device bfloat *normed_out [[buffer(5)]],
+                                uint row [[threadgroup_position_in_grid]],
+                                uint thread_index [[thread_index_in_threadgroup]],
+                                uint lane [[thread_index_in_simdgroup]],
+                                uint simd_group [[simdgroup_index_in_threadgroup]]) {
+  threadgroup float reductions[8];
+  const float row_rms = rms[row];
+  const ulong base = ulong(row) * kHidden;
+  float sum = 0.0f;
+  for (uint c = thread_index; c < kHidden; c += 256) {
+    const float f = float(raw[base + c]);
+    const float written = row == 0 ? f : f + row_rms * float(delta[base + c]);
+    const bfloat out = bfloat(written);
+    residual_out[base + c] = out;
+    const float x = float(out);
+    sum += x * x;
+  }
+  const float inverse = rsqrt(group_sum(sum, reductions, thread_index, lane, simd_group) / kHidden + kNormEpsilon);
+  for (uint c = thread_index; c < kHidden; c += 256) {
+    const float x = float(residual_out[base + c]);
+    normed_out[base + c] = bfloat(float(bfloat(x * inverse)) * float(next_norm[c]));
+  }
+}
+
+// ---------------------------------------------------------------------------------------------------- refinement
+
+// Grid 64 groups of 256: simdgroup r (0..511) of rank r. For each pair (proposal row i, predecessor candidate k),
+// e = 32 * codebook[sender] with sender the anchor (i = 0) or candidate k of row i - 1, and
+// message[pair][r] = sigmoid(q_i[r] + G_p[r] . e + bias[r]) * (A[r] . e), fp32, q_i from the last layer's packed
+// row i + 1.
+kernel void dspine_tail_messages(device const bfloat *codebook [[buffer(0)]],
+                                 device const bfloat *packed_weight [[buffer(1)]],
+                                 device const bfloat *gate_bias [[buffer(2)]],
+                                 device const bfloat *stash_packed [[buffer(3)]],
+                                 device const uint *candidates [[buffer(4)]],
+                                 device float *messages [[buffer(5)]],
+                                 constant DSpineTailParams &p [[buffer(6)]],
+                                 uint group [[threadgroup_position_in_grid]],
+                                 uint lane [[thread_index_in_simdgroup]],
+                                 uint simd_group [[simdgroup_index_in_threadgroup]]) {
+  constexpr uint PerLane = kCode / 32;
+  const uint r = group * 8 + simd_group;
+  if (r >= kRank)
+    return;
+  float predecessor_gate[PerLane], previous[PerLane];
+  for (uint i = 0; i < PerLane; ++i) {
+    predecessor_gate[i] = float(packed_weight[(ulong(kRank) + r) * kCode + lane + 32 * i]);
+    previous[i] = float(packed_weight[(ulong(2 * kRank) + r) * kCode + lane + 32 * i]);
+  }
+  const float bias = float(gate_bias[r]);
+  const uint pairs = p.positions * kCandidates;
+  for (uint pair = 0; pair < pairs; ++pair) {
+    const uint row = pair / kCandidates, k = pair % kCandidates;
+    const uint sender = row == 0 ? p.anchor : candidates[(row - 1) * kCandidates + k];
+    device const bfloat *code = codebook + ulong(sender) * kCode;
+    float gate_dot = 0.0f, value_dot = 0.0f;
+    for (uint i = 0; i < PerLane; ++i) {
+      const float e = kCodeScale * float(code[lane + 32 * i]);
+      gate_dot += predecessor_gate[i] * e;
+      value_dot += previous[i] * e;
+    }
+    gate_dot = simd_sum(gate_dot);
+    value_dot = simd_sum(value_dot);
+    if (lane == 0) {
+      const float q = float(stash_packed[ulong(row + 1) * 3 * kRank + r]);
+      messages[ulong(pair) * kRank + r] = dspine::sigmoid(q + gate_dot + bias) * value_dot;
+    }
+  }
+}
+
+// Grid (5120 / 256, ceil(pairs / 8)), 256 threads: refined[pair][d] = raw_{i+1}[d] + rms_{i+1} * (W[d] . message),
+// fp32, with W the last layer's write weights [5120][512].
+kernel void dspine_tail_refine(device const float *messages [[buffer(0)]],
+                               device const bfloat *write_weights [[buffer(1)]],
+                               device const bfloat *stash_raw [[buffer(2)]],
+                               device const float *stash_rms [[buffer(3)]],
+                               device float *refined [[buffer(4)]],
+                               constant DSpineTailParams &p [[buffer(5)]],
+                               uint2 group [[threadgroup_position_in_grid]],
+                               uint thread_index [[thread_index_in_threadgroup]]) {
+  constexpr uint PairsPerGroup = 8;
+  threadgroup float tile[PairsPerGroup * kRank];
+  const uint pairs = p.positions * kCandidates, first_pair = group.y * PairsPerGroup;
+  for (uint index = thread_index; index < PairsPerGroup * kRank; index += 256) {
+    const uint pair = first_pair + index / kRank;
+    tile[index] = pair < pairs ? messages[ulong(pair) * kRank + index % kRank] : 0.0f;
+  }
+  threadgroup_barrier(mem_flags::mem_threadgroup);
+  const uint d = group.x * 256 + thread_index;
+  device const bfloat *w = write_weights + ulong(d) * kRank;
+  float acc[PairsPerGroup];
+  for (uint j = 0; j < PairsPerGroup; ++j)
+    acc[j] = 0.0f;
+  for (uint r = 0; r < kRank; ++r) {
+    const float weight = float(w[r]);
+    for (uint j = 0; j < PairsPerGroup; ++j)
+      acc[j] += weight * tile[j * kRank + r];
+  }
+  for (uint j = 0; j < PairsPerGroup; ++j) {
+    const uint pair = first_pair + j;
+    if (pair >= pairs)
+      break;
+    const uint row = pair / kCandidates + 1;
+    refined[ulong(pair) * kHidden + d] = float(stash_raw[ulong(row) * kHidden + d]) + stash_rms[row] * acc[j];
+  }
+}
+
+// Grid positions x 16 groups of 256: proposal row i, candidate j. Its target head row (Q4_K planes, rounded to
+// bf16 as the reference's dequantize does) dotted with each of the row's 16 refined rows, normalized:
+// tables[i][k][j] = (refined_ik . (norm_weight * head_j)) / sqrt(mean(refined_ik^2) + eps).
+kernel void dspine_tail_tables(device const float *refined [[buffer(0)]],
+                               device const bfloat *final_norm [[buffer(1)]],
+                               device const uint *head_codes [[buffer(2)]],
+                               device const uint4 *head_meta [[buffer(3)]],
+                               device const uint *candidates [[buffer(4)]],
+                               device float *tables [[buffer(5)]],
+                               constant DSpineTailParams &p [[buffer(6)]],
+                               uint group [[threadgroup_position_in_grid]],
+                               uint thread_index [[thread_index_in_threadgroup]],
+                               uint lane [[thread_index_in_simdgroup]],
+                               uint simd_group [[simdgroup_index_in_threadgroup]]) {
+  constexpr uint PerThread = kHidden / 256;
+  threadgroup float reductions[2][8];
+  const uint row = group / kCandidates, j = group % kCandidates;
+  const uint token = candidates[row * kCandidates + j];
+  const uint groups = p.head_groups;
+  float weighted_head[PerThread];
+  for (uint q = 0; q < PerThread; ++q) {
+    const uint d = thread_index + 256 * q, g = d / 32, e = d % 32;
+    const uint word = head_codes[quant_tile_index(token, g, groups) * 4 + ((e >> 2) & 3)];
+    const uint pair = 2 * (e >> 4) + ((e >> 1) & 1);
+    const uint code = (word >> (4 * pair + 16 * (e & 1))) & 0xFu;
+    const QuantCoef coef = quant_k4_coef(head_meta[quant_tile_index(token, g / 8, groups / 8)], ushort(g % 8));
+    const float value = float(bfloat(coef.s.x * float(code) + coef.m.x));
+    weighted_head[q] = value * float(final_norm[d]);
+  }
+  for (uint k = 0; k < kCandidates; ++k) {
+    device const float *source = refined + (ulong(row) * kCandidates + k) * kHidden;
+    float squares = 0.0f, dot = 0.0f;
+    for (uint q = 0; q < PerThread; ++q) {
+      const float x = source[thread_index + 256 * q];
+      squares += x * x;
+      dot += x * weighted_head[q];
+    }
+    squares = simd_sum(squares);
+    dot = simd_sum(dot);
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    if (lane == 0) {
+      reductions[0][simd_group] = squares;
+      reductions[1][simd_group] = dot;
+    }
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    if (thread_index == 0) {
+      float total_squares = 0.0f, total_dot = 0.0f;
+      for (uint s = 0; s < 8; ++s) {
+        total_squares += reductions[0][s];
+        total_dot += reductions[1][s];
+      }
+      tables[(ulong(row) * kCandidates + k) * kCandidates + j] =
+          total_dot / sqrt(total_squares / kHidden + kNormEpsilon);
+    }
+  }
+}
+
+
+// ---------------------------------------------------------------------------------------------------- refinement, MMA
+// The refinement's two products on simdgroup 8x8 MMA (dspine_project_bf16's tile: 8 output columns x 32 rows per
+// threadgroup, 16 K splits reduced in a fixed order), fp32 inputs and sums, fp32 output. Grid (N / 8, ceil(rows / 32)),
+// 512 threads.
+template <typename InputT, bool Gather>
+inline void dspine_tail_gemm(device const InputT *input, device const uint *row_index, device const bfloat *weights,
+                             device float *output, constant DSpineGemmParams &p, uint2 tg, uint sg, uint lane,
+                             threadgroup float2 *parts) {
+  using namespace dspine_project;
+  const sgmatrix::Lane l = sgmatrix::lane_map(lane);
+  const uint K = p.input_size, column = tg.x * 8 + l.fn, row0 = tg.y * kRows;
+  const uint live = min(kRows, p.rows - row0);
+  const uint steps = K / 8, first = sg * steps / kSplits, last = (sg + 1) * steps / kSplits;
+  device const bfloat *w = weights + (ulong(p.weight_row) + column) * K + l.fm;
+  device const InputT *rows_of[kFragments];
+  for (uint f = 0; f < kFragments; ++f) {
+    const uint row = f * 8 + l.fm;
+    const uint source = row < live ? (Gather ? row_index[row0 + row] : row0 + row) : 0;
+    rows_of[f] = input + ulong(source) * K + l.fn;
+  }
+  float2 acc[kFragments];
+  for (uint f = 0; f < kFragments; ++f)
+    acc[f] = float2(0);
+  for (uint step = first; step < last; ++step) {
+    const uint k = step * 8;
+    const float2 b = float2(float(w[k]), float(w[K + k]));
+    for (uint f = 0; f < kFragments; ++f) {
+      if (f * 8 >= live)
+        break;
+      const float2 a = (f * 8 + l.fm) < live ? float2(rows_of[f][k], rows_of[f][k + 1]) : float2(0);
+      sgmatrix::mma_acc<float>(acc[f], a, b);
+    }
+  }
+  for (uint f = 0; f < kFragments; ++f)
+    parts[(sg * kFragments + f) * 32 + lane] = acc[f];
+  threadgroup_barrier(mem_flags::mem_threadgroup);
+  const uint f = sg, row = f * 8 + l.fm;
+  if (f >= kFragments || row >= live)
+    return;
+  float2 total = float2(0);
+  for (uint s = 0; s < kSplits; ++s)
+    total += parts[(s * kFragments + f) * 32 + lane];
+  device float *out = output + ulong(row0 + row) * p.output_size + column;
+  out[0] = p.scale * total.x;
+  out[1] = p.scale * total.y;
+}
+
+// Senders' codes x [G_p; A]^T: rows = pairs, gathered codebook rows (the sender of each pair), scale 32.
+kernel void dspine_tail_gemm_codes(device const bfloat *codebook [[buffer(0)]],
+                                   device const uint *senders [[buffer(1)]],
+                                   device const bfloat *weights [[buffer(2)]],
+                                   device float *output [[buffer(3)]],
+                                   constant DSpineGemmParams &p [[buffer(4)]],
+                                   uint2 tg [[threadgroup_position_in_grid]],
+                                   uint sg [[simdgroup_index_in_threadgroup]],
+                                   uint lane [[thread_index_in_simdgroup]]) {
+  threadgroup float2 parts[dspine_project::kSplits * dspine_project::kFragments * 32];
+  dspine_tail_gemm<bfloat, true>(codebook, senders, weights, output, p, tg, sg, lane, parts);
+}
+
+// Messages x W^T (the last layer's write weights): rows = pairs.
+kernel void dspine_tail_gemm_write(device const float *messages [[buffer(0)]],
+                                   device const uint *unused [[buffer(1)]],
+                                   device const bfloat *weights [[buffer(2)]],
+                                   device float *output [[buffer(3)]],
+                                   constant DSpineGemmParams &p [[buffer(4)]],
+                                   uint2 tg [[threadgroup_position_in_grid]],
+                                   uint sg [[simdgroup_index_in_threadgroup]],
+                                   uint lane [[thread_index_in_simdgroup]]) {
+  threadgroup float2 parts[dspine_project::kSplits * dspine_project::kFragments * 32];
+  dspine_tail_gemm<float, false>(messages, unused, weights, output, p, tg, sg, lane, parts);
+}
+
+// One thread per pair: its sender (the anchor for row 0, candidate k of row i - 1 otherwise).
+kernel void dspine_tail_senders(device const uint *candidates [[buffer(0)]],
+                                device uint *senders [[buffer(1)]],
+                                constant DSpineTailParams &p [[buffer(2)]],
+                                uint pair [[thread_position_in_grid]]) {
+  if (pair >= p.positions * kCandidates)
+    return;
+  const uint row = pair / kCandidates, k = pair % kCandidates;
+  senders[pair] = row == 0 ? p.anchor : candidates[(row - 1) * kCandidates + k];
+}
+
+// One thread per (pair, rank): message = sigmoid(q_{i+1} + G_p e + bias) * (A e) from the codes product
+// [pair][G_p e (512) | A e (512)].
+kernel void dspine_tail_gate(device const float *products [[buffer(0)]],
+                             device const bfloat *stash_packed [[buffer(1)]],
+                             device const bfloat *gate_bias [[buffer(2)]],
+                             device float *messages [[buffer(3)]],
+                             constant DSpineTailParams &p [[buffer(4)]],
+                             uint index [[thread_position_in_grid]]) {
+  if (index >= p.positions * kCandidates * kRank)
+    return;
+  const uint pair = index / kRank, r = index % kRank, row = pair / kCandidates;
+  const float q = float(stash_packed[ulong(row + 1) * 3 * kRank + r]);
+  messages[index] = dspine::sigmoid(q + products[ulong(pair) * 2 * kRank + r] + float(gate_bias[r])) *
+                    products[ulong(pair) * 2 * kRank + kRank + r];
+}
+
+// tables from the write product: refined = raw_{i+1} + rms_{i+1} * product, then as dspine_tail_tables.
+kernel void dspine_tail_tables_from_product(device const float *product [[buffer(0)]],
+                                            device const bfloat *final_norm [[buffer(1)]],
+                                            device const uint *head_codes [[buffer(2)]],
+                                            device const uint4 *head_meta [[buffer(3)]],
+                                            device const uint *candidates [[buffer(4)]],
+                                            device float *tables [[buffer(5)]],
+                                            device const bfloat *stash_raw [[buffer(6)]],
+                                            device const float *stash_rms [[buffer(7)]],
+                                            constant DSpineTailParams &p [[buffer(8)]],
+                                            uint group [[threadgroup_position_in_grid]],
+                                            uint thread_index [[thread_index_in_threadgroup]],
+                                            uint lane [[thread_index_in_simdgroup]],
+                                            uint simd_group [[simdgroup_index_in_threadgroup]]) {
+  constexpr uint PerThread = kHidden / 256;
+  threadgroup float reductions[2][8];
+  const uint row = group / kCandidates, j = group % kCandidates;
+  const uint token = candidates[row * kCandidates + j];
+  const uint groups = p.head_groups;
+  const float row_rms = stash_rms[row + 1];
+  float weighted_head[PerThread], raw[PerThread];
+  for (uint q = 0; q < PerThread; ++q) {
+    const uint d = thread_index + 256 * q, g = d / 32, e = d % 32;
+    const uint word = head_codes[quant_tile_index(token, g, groups) * 4 + ((e >> 2) & 3)];
+    const uint pair = 2 * (e >> 4) + ((e >> 1) & 1);
+    const uint code = (word >> (4 * pair + 16 * (e & 1))) & 0xFu;
+    const QuantCoef coef = quant_k4_coef(head_meta[quant_tile_index(token, g / 8, groups / 8)], ushort(g % 8));
+    weighted_head[q] = float(bfloat(coef.s.x * float(code) + coef.m.x)) * float(final_norm[d]);
+    raw[q] = float(stash_raw[ulong(row + 1) * kHidden + d]);
+  }
+  for (uint k = 0; k < kCandidates; ++k) {
+    device const float *source = product + (ulong(row) * kCandidates + k) * kHidden;
+    float squares = 0.0f, dot = 0.0f;
+    for (uint q = 0; q < PerThread; ++q) {
+      const float x = raw[q] + row_rms * source[thread_index + 256 * q];
+      squares += x * x;
+      dot += x * weighted_head[q];
+    }
+    squares = simd_sum(squares);
+    dot = simd_sum(dot);
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    if (lane == 0) {
+      reductions[0][simd_group] = squares;
+      reductions[1][simd_group] = dot;
+    }
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    if (thread_index == 0) {
+      float total_squares = 0.0f, total_dot = 0.0f;
+      for (uint s = 0; s < 8; ++s) {
+        total_squares += reductions[0][s];
+        total_dot += reductions[1][s];
+      }
+      tables[(ulong(row) * kCandidates + k) * kCandidates + j] = total_dot / sqrt(total_squares / kHidden + kNormEpsilon);
+    }
+  }
+}
