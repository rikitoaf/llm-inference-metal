@@ -0,0 +1,154 @@
+#pragma once
+
+// Tencent's DSpine drafter (tencent/Qwen3.8-27B-DSpine-b16) on Splash, selected with SPLASH_DRAFTER=dspine
+// (DrafterSelection.hpp). It has DFlash2's skeleton (5 Qwen3 layers over the target's captured hidden rows, an
+// anchor + mask block, the target's vocabulary head) with three changes, mirrored from the MLX reference
+// (dspine_mlx, splash/tools/dspine/dspine_reference.py):
+//   - block-causal attention: draft row t sees the context window and block rows 0..t;
+//   - a code bridge after every layer: each row receives a gated message from its predecessor's code
+//     (adjacent causal injection), written back scaled by the row's RMS;
+//   - a refinement tail: the last write redone for each of the 16 candidates of the previous row, giving a
+//     16 x 16 conditional logit table per proposal row, which the draft tree scores (unary 0).
+// The block is 16 rows (anchor + 15 masks), so a tree reaches depth 15 by itself; the context window is 8192
+// (SPLASH_DSPINE_WINDOW). The backbone is affine Q4 (group 64, as DFlash2's); the bridge, its codebook and the
+// refinement run in bf16 weights with fp32 arithmetic.
+
+#include "DFlashDraft.hpp"
+#include "DrafterSelection.hpp"
+#include "Model.hpp"
+#include "WeightImages.hpp"
+#include "ops/DSpineOps.hpp"
+#include "ops/ExecutionPlans.hpp"
+#include "ops/Linear.hpp"
+#include "ops/Normalization.hpp"
+
+#include <cstdint>
+#include <filesystem>
+#include <span>
+#include <vector>
+
+namespace splash::model {
+
+struct DSpineDraftLayout final {
+  uint32_t layers = 5;
+  uint32_t hiddenSize = 5120;
+  uint32_t vocabularySize = 248320;
+  uint32_t queryHeads = 32;
+  uint32_t kvHeads = 8;
+  uint32_t headDimension = 128;
+  uint32_t attentionSize = 4096;
+  uint32_t qkvSize = 6144;
+  uint32_t intermediateSize = 17408;
+  uint32_t targetHiddenSize = 25600;
+  uint32_t codeSize = 1024;
+  uint32_t bridgeRank = 512;
+  uint32_t blockRows = 16;
+  uint32_t maskToken = 248070;
+  float rotaryTheta = 10'000'000.0F;
+
+  [[nodiscard]] constexpr uint32_t contextKvSize() const noexcept { return qkvSize - attentionSize; }
+  [[nodiscard]] constexpr ops::DSpineShape shape() const noexcept {
+    return {hiddenSize, queryHeads, kvHeads, headDimension, attentionSize, qkvSize, codeSize, bridgeRank};
+  }
+  bool operator==(const DSpineDraftLayout &) const = default;
+};
+
+struct DSpineLayerWeights final {
+  ops::NormWeights inputNorm;
+  ops::Projection qkvProjection;     // q_proj, k_proj, v_proj stacked: [6144, 5120]
+  metal::MetalBuffer queryNorm;      // [128] bf16
+  metal::MetalBuffer keyNorm;        // [128] bf16
+  ops::Projection outputProjection;  // [5120, 4096]
+  ops::NormWeights postAttentionNorm;
+  ops::Projection gateProjection;
+  ops::Projection upProjection;
+  ops::Projection downProjection;
+};
+
+// The code bridge (selected_prefix_bridge.*), bf16 as the checkpoint stores it.
+struct DSpineBridgeWeights final {
+  metal::MetalBuffer earlyReadWeights;  // [layers - 1, 1024, 5120]: the read of layers 0..3
+  metal::MetalBuffer lastReadWeight;    // [1024, 5120]: the read of the last layer
+  metal::MetalBuffer packedWeight;      // [1536, 1024]: gate.weight (G_q), predecessor_gate.weight (G_p), prev.weight (A)
+  metal::MetalBuffer gateBias;          // [512]
+  metal::MetalBuffer writeWeights;      // [layers, 5120, 512]
+  metal::MetalBuffer codebook;          // [vocabulary, 1024]
+};
+
+struct DSpineDraftWeights final {
+  DSpineDraftLayout layout;
+  std::vector<DSpineLayerWeights> layers;
+  ops::Projection contextProjection;  // fc: [5120, 25600]
+  ops::NormWeights hiddenNorm;
+  ops::NormWeights finalNorm;
+  DSpineBridgeWeights bridge;
+  std::vector<WeightFileRecord> files;
+  uint64_t actualAllocatedBytes = 0;
+
+  [[nodiscard]] bool loaded() const noexcept { return !layers.empty(); }
+};
+
+// Reads the checkpoint at `directory` (config.json, model.safetensors) into images: every backbone projection
+// quantized to affine Q4 like DFlash2's, every other tensor copied as stored. Throws unless the configuration is the
+// one these kernels implement, the version scalars are 1 and the terminal projection (out.weight) is all zero.
+[[nodiscard]] DSpineDraftWeights loadDSpineDraftWeights(metal::MetalBackend &backend, WeightImages &images,
+                                                        const std::filesystem::path &directory);
+// The bytes of the images loadDSpineDraftWeights writes.
+[[nodiscard]] uint64_t dspineImageBytes();
+
+// What one DSpine decode cycle reads: the block's embedded rows (anchor + masks, the target embedding), its RoPE
+// tables (positions p..p + rows - 1), the lane's ring, and the target head's logits rows it may overwrite.
+struct DSpineDecodeInputs final {
+  metal::MetalBuffer embeddedRows;
+  metal::MetalBuffer ropeCos;
+  metal::MetalBuffer ropeSin;
+  std::span<const DFlashDraftRingLayer> ring;
+  metal::MetalBuffer logits;
+  ops::LinearScratch linearScratch;
+  metal::MetalBuffer gateScratch;
+};
+
+// What the tree selection writes for the verify: DFlash's buffers of the same names.
+struct DSpineSelectionOutputs final {
+  metal::MetalBuffer proposedTokens;
+  metal::MetalBuffer tree;
+  metal::MetalBuffer positions;
+};
+
+// The draft graph of one lane (Splash decodes one lane: SPLASH_MAXIMUM_DECODE_WIDTH), its scratch owned here.
+class DSpineDraft final {
+public:
+  DSpineDraft(const DSpineDraftWeights &weights, metal::MetalBackend &backend, const ops::ExecutionPlans &operators);
+
+  // The context writers, with DFlash2's buffers and spans: captured rows -> fc -> hidden norm -> each layer's
+  // normalized, rotated keys and values into the ring slot position % window.
+  void addContextPrefill(metal::CommandGraph &graph, DFlashPrefillBuffers buffers, uint32_t rows,
+                         std::span<const DFlashPrefillSpan> spans) const;
+  void addContextCommit(metal::CommandGraph &graph, DFlashContextBuffers buffers, uint32_t startPosition,
+                        uint32_t rows) const;
+
+  // The draft forward of a block of `blockRows` rows (8 or 16) anchored at position `anchorPosition` with token
+  // `anchor`, against the ring's window, then the head over rows 1.., the candidates and the refinement tables.
+  void addDecode(metal::CommandGraph &graph, const DSpineDecodeInputs &inputs,
+                 const ops::Projection &vocabularyProjection, uint32_t anchorPosition, uint32_t anchor,
+                 uint32_t blockRows, const DFlashHeadShortlist *shortlist = nullptr) const;
+
+  // The best-first tree over the tables (draft_select_tree's rule, unary 0) into the verify rows, then, with
+  // `copyHistory`, the copy extension below the first depth-7 node (draft_copy_extend's rule).
+  // `tail` (SPLASH_VERIFY_ROWS_LONG) is applied by the last selection kernel, once the tree is final.
+  void addSelection(metal::CommandGraph &graph, const DSpineSelectionOutputs &outputs, uint32_t anchor,
+                    uint32_t blockRows, const ops::VerifyTailPolicy &tail,
+                    const ops::DSpineCopyInputs *copy = nullptr) const;
+
+  [[nodiscard]] const ops::DSpineScratch &scratch() const noexcept { return scratch_; }
+  [[nodiscard]] const DSpineDraftWeights &weights() const noexcept { return weights_; }
+
+private:
+  const DSpineDraftWeights &weights_;
+  metal::MetalBackend &backend_;
+  const ops::ExecutionPlans &operators_;
+  std::vector<ops::Projection> contextKvProjections_;
+  ops::DSpineScratch scratch_;
+};
+
+} // namespace splash::model
