+  KvPool pool(storage, 0);
+  engine::Cache resources(pool, nullptr, nullptr);
+  Executor executor;
+  executor.decodeFinishes = false;
+  Events events;
+  engine::Engine engine({}, resources, executor, events);
+  guardReleases(storage, engine);
+  std::vector<uint32_t> prompt(97);
+  std::iota(prompt.begin(), prompt.end(), 1);
+  EngineRequest turn = request(1, prompt);
+  turn.maxNewTokens = 3;
+  engine.submit(std::move(turn));
+  runUntilIdle(engine);
+  require(engine.snapshot().parks == 1 && engine.snapshot().parkedTokens == 100 &&
+              executor.requests.contains(1) && executor.requests.at(1).parked,
+          "a finished lane was not parked at its committed tokens");
+
+  // The next turn: the prompt, the three tokens generated, then new input.
+  prompt.insert(prompt.end(), 3, 42);
+  prompt.insert(prompt.end(), 40, 500);
+  engine.submit(request(2, prompt));
+  runUntilIdle(engine);
+  EngineSnapshot counts = engine.snapshot();
+  require(executor.adoptions == 1 && executor.lastRestoredTokens == 100 &&
+              executor.plans.at(2).replayBegin == 100 && events.starts.at(1) == 100 &&
+              executor.prefillRows == 97 + 40,
+          "the next turn did not prefill on from the parked lane");
+  require(counts.parkAdoptions == 1 && counts.parkAdoptedTokens == 100 &&
+              counts.parkSavedTokens == 100 - 96 && counts.reusedTokens == 100 &&
+              counts.replayStatePublications == 2 && counts.parks == 2 &&
+              counts.parkedTokens == 141,
+          "an adoption was not counted");
+
+  // A start that does not continue the parked tokens releases them first.
+  engine.submit(request(3, std::vector<uint32_t>(50, 7)));
+  runUntilIdle(engine);
+  counts = engine.snapshot();
+  require(counts.parkMismatches == 1 && executor.adoptions == 1 &&
+              !executor.requests.contains(2) && events.starts.at(2) == 0 &&
+              counts.parks == 3 && counts.parkedTokens == 51,
+          "a start that did not continue the parked lane kept it");
+
+  // An untargeted pass keeps the parked lane; critical pressure takes it
+  // first.
+  static_cast<void>(engine.reclaimMemory({}));
+  counts = engine.snapshot();
+  require(counts.parkReclaims == 0 && counts.parkedTokens == 51,
+          "an untargeted reclaim pass took the parked lane");
+  static_cast<void>(engine.reclaimMemory(MemoryReclaimDirective{.critical = true}));
+  counts = engine.snapshot();
+  require(counts.parkReclaims == 1 && counts.parkedTokens == 0 && executor.requests.empty(),
+          "a reclaim kept the parked lane");
