diff --git a/runtime/metal/abi/DSpine.h b/runtime/metal/abi/DSpine.h
new file mode 100644
index 0000000..a540550
--- /dev/null
+++ b/runtime/metal/abi/DSpine.h
@@ -0,0 +1,126 @@
+#pragma once
+
+// Parameter layouts of the DSpine draft kernels (kernels/decode/dspine.metal, the selection kernels at the end of
+// kernels/decode/sampling.metal), shared by host dispatch code (ops/DSpineOps.cpp) and Metal.
+#include "metal/abi/ExecutionGeometry.h"
+#ifdef __METAL_VERSION__
+#include <metal_stdlib>
+#else
+#include <stdint.h>
+#endif
+
+// The largest draft block: the anchor and 15 mask rows. Kernels lay a block's per-row buffers out for this many
+// rows; an 8-row block leaves the rest untouched (zero).
+#define SPLASH_DSPINE_MAXIMUM_ROWS 16u
+#define SPLASH_DSPINE_MAXIMUM_POSITIONS (SPLASH_DSPINE_MAXIMUM_ROWS - 1u)
+// Ring tiles of one (KV head, 8-row half) split over this many threadgroups, combined in a fixed order.
+#define SPLASH_DSPINE_ATTENTION_SPLITS 8u
+// Candidates per proposal row (the refinement width, head_topk) = DFlash's selector width.
+#define SPLASH_DSPINE_CANDIDATES 16u
+// The draft tree's copy tip depth: a copy match is the anchor and the seven tokens on the path to it.
+#define SPLASH_DSPINE_COPY_TIP_DEPTH 7u
+
+// One block: `rows` rows anchored at position anchor_position with token `anchor`; draft row t attends the ring's
+// positions [max(0, anchor_position - window), anchor_position) and block rows 0..t. ring_slots is the ring's
+// slots per KV head (the value ring's stride).
+struct DSpineBlockParams {
+  uint32_t rows;
+  uint32_t anchor_position;
+  uint32_t window;
+  uint32_t ring_slots;
+  uint32_t anchor;
+  uint32_t layer;
+  uint32_t pad0;
+  uint32_t pad1;
+};
+
+#ifndef __METAL_VERSION__
+static_assert(sizeof(DSpineBlockParams) == 32, "DSpine block parameters are 32 bytes on both sides");
+#endif
+
+// out[r][n] = sum_k input[r][k] W[weight_row + n][k] for r < rows, n < output_size, bf16 weights, fp32 sums, bf16
+// output rounded once.
+struct DSpineProjectParams {
+  uint32_t rows;
+  uint32_t input_size;
+  uint32_t output_size;
+  uint32_t weight_row;
+};
+
+#ifndef __METAL_VERSION__
+static_assert(sizeof(DSpineProjectParams) == 16, "DSpine projection parameters are 16 bytes on both sides");
+#endif
+
+// The refinement's GEMMs (dspine_tail_gemm_*): out[r][n] = scale * sum_k in(r)[k] W[weight_row + n][k], fp32 output;
+// in(r) is row r of the input, or with a gather row index[r] of it.
+struct DSpineGemmParams {
+  uint32_t rows;
+  uint32_t input_size;
+  uint32_t output_size;
+  uint32_t weight_row;
+  float scale;
+  uint32_t pad0;
+  uint32_t pad1;
+  uint32_t pad2;
+};
+
+#ifndef __METAL_VERSION__
+static_assert(sizeof(DSpineGemmParams) == 32, "DSpine GEMM parameters are 32 bytes on both sides");
+#endif
+
+// Context rows [0, tokens) at positions start_position.. into ring slots position % ring_slots.
+struct DSpineContextParams {
+  uint32_t tokens;
+  uint32_t start_position;
+  uint32_t ring_slots;
+  uint32_t pad;
+};
+
+#ifndef __METAL_VERSION__
+static_assert(sizeof(DSpineContextParams) == 16, "DSpine context parameters are 16 bytes on both sides");
+#endif
+
+// The candidate and table stage: `positions` proposal rows (block rows 1..positions) of `columns` logits columns
+// each (DraftLogitsParams maps them to token ids), the anchor, and the target head's segment geometry for the
+// refinement's head rows (Q4_K planes, groups of 32 per row).
+struct DSpineTailParams {
+  uint32_t positions;
+  uint32_t anchor;
+  uint32_t head_groups;
+  uint32_t hidden;
+};
+
+#ifndef __METAL_VERSION__
+static_assert(sizeof(DSpineTailParams) == 16, "DSpine tail parameters are 16 bytes on both sides");
+#endif
+
+// The proposal rows' logits for the candidate scan: DraftLogitsParams (width, split, offset) and the positions.
+struct DSpineLogitsParams {
+  uint32_t width;
+  uint32_t split;
+  uint32_t offset;
+  uint32_t positions;
+};
+
+#ifndef __METAL_VERSION__
+static_assert(sizeof(DSpineLogitsParams) == 16, "DSpine logits parameters are 16 bytes on both sides");
+#endif
+
+// The tree over `positions` proposal positions; min_match and log_accept as SplashDraftCopyParams for the copy
+// extension, history_tokens 0 extending nothing.
+struct DSpineTreeParams {
+  uint32_t positions;
+  uint32_t anchor;
+  uint32_t history_tokens;
+  uint32_t min_match;
+  float log_accept[8][8];
+  // SPLASH_VERIFY_ROWS_LONG: rows [tail_first_row, 16) are marked SPLASH_DRAFT_TREE_ROW_UNVERIFIED when the sum of
+  // their path probabilities (the expected accepted tokens they add, by the draft's own tables) is below
+  // tail_keep_mass. tail_first_row 0: this dispatch leaves every row verified.
+  uint32_t tail_first_row;
+  float tail_keep_mass;
+};
+
+#ifndef __METAL_VERSION__
+static_assert(sizeof(DSpineTreeParams) == 280, "DSpine tree parameters are 280 bytes on both sides");
+#endif
diff --git a/runtime/metal/abi/Sampling.h b/runtime/metal/abi/Sampling.h
index 341f402..cf65cec 100644
--- a/runtime/metal/abi/Sampling.h
+++ b/runtime/metal/abi/Sampling.h
@@ -170,6 +170,20 @@ static_assert(sizeof(DraftLogitsParams) == 12,
 // bit j of ancestors[r] is set when row j is r or an ancestor of r: the verify rows r attends to. Acceptance writes
 // path[d], the row of the accepted node at depth d (path[0] = 0), for the commits. A lane without a tree carries the
 // chain: parent r - 1, depth r, ancestors 2^(r+1) - 1, path r.
+// SPLASH_VERIFY_ROWS_LONG (dev-longctx): bit 31 of ancestors[r] marks row r as unverified this cycle. The tree's
+// tail rows (the least probable nodes: rows are in best-first order) carry it when the cycle verifies fewer rows:
+// their attention tile is skipped, so their logits are meaningless and acceptance never walks into them. Bits
+// 0..15 keep their meaning (the attention mask reads only those).
+#define SPLASH_DRAFT_TREE_ROW_UNVERIFIED 0x80000000u
+// What the tail decision saw, for the step log and offline threshold fitting: every row's path log-probability by
+// the draft (a copy row's by its calibrated acceptance), and how many tail rows the cycle left unverified.
+struct SplashVerifyTailReport {
+  float row_log_probability[SPLASH_TARGET_VERIFY_ROWS];
+  uint32_t unverified_rows;
+  uint32_t pad[3];
+};
+static_assert(sizeof(SplashVerifyTailReport) == 4 * SPLASH_TARGET_VERIFY_ROWS + 16,
+              "A verify tail report is 80 bytes on both sides");
 struct SplashDraftTree {
   uint32_t parent[SPLASH_TARGET_VERIFY_ROWS];
   uint32_t depth[SPLASH_TARGET_VERIFY_ROWS];
diff --git a/runtime/metal/kernels/common/prefill_attention_v2.h b/runtime/metal/kernels/common/prefill_attention_v2.h
new file mode 100644
index 0000000..8955d91
--- /dev/null
+++ b/runtime/metal/kernels/common/prefill_attention_v2.h
@@ -0,0 +1,560 @@
+#pragma once
+
+#include "metal/kernels/common/paged_attention_tile.h"
+
+// SPLASH_PREFILL_ATTENTION_V2 (ATTN.md): the turbo-int4 prefill split with a
+// configurable query tile and KV step. Same math as
+// splash_paged_attention_turbo_int4_tile (exact-math class: the online
+// softmax's running maximum advances once per step of StepPages pages instead
+// of once per page, so intermediate roundings differ; nothing is approximated):
+// - RowsPerTile query rows (x QueryHeadsPerKVHead heads) share each K/V load;
+// - StepPages Page32 pages per softmax step: one score tile of 32 x StepPages
+//   columns, one statistics update, one rescale check and two barriers per step
+//   instead of per page (QK and PV still run one page at a time: pages are
+//   separate slabs);
+// - AliasProbabilities: the bf16 probabilities overwrite the first half of
+//   their row's fp32 scores (row stride 2N bf16), halving the tile's
+//   threadgroup memory. A row's four lanes are one simdgroup's consecutive
+//   lanes: a simdgroup barrier orders their reads before the writes.
+// Visibility per token is the production rule (causal limit, visible history)
+// plus the split's last page, so a step that runs past the split's end masks
+// the extra tokens and skips their pages' products.
+template <uint QueryHeadsPerKVHead, uint RowsPerTile, uint StepPages, bool AliasProbabilities,
+          uint KVHeads>
+inline void splash_prefill_v2_softmax(
+    threadgroup float *scores, threadgroup bfloat *probabilities,
+    threadgroup float *row_max, threadgroup float *row_sum,
+    threadgroup float *previous_scale, threadgroup atomic_uint *rescale,
+    device const SplashKvPage *page_table, thread const SplashTurboInt4Addressing<KVHeads> &addressing,
+    uint first_page, uint step_end_token, uint visible_tokens, uint committed_tokens,
+    uint active_rows, uint thread_index) {
+  constexpr uint N = SplashKvPageTokens * StepPages;
+  constexpr uint FusedRows = RowsPerTile * QueryHeadsPerKVHead;
+  constexpr uint LanesPerRow = 4;
+  constexpr uint TokensPerLane = N / LanesPerRow;
+  constexpr uint ProbabilityStride = AliasProbabilities ? 2 * N : N;
+  static_assert(TokensPerLane % 8 == 0 && TokensPerLane <= SplashKvPageTokens,
+                "a lane's tokens lie in one page, in whole float4 pairs");
+  for (uint entry = thread_index; entry < LanesPerRow * FusedRows; entry += 256) {
+    const uint fused_row = entry / LanesPerRow;
+    const uint column = entry % LanesPerRow * TokensPerLane;
+    const uint query_row = fused_row / QueryHeadsPerKVHead;
+    const uint causal_end = committed_tokens + min(query_row, active_rows - 1) + 1;
+    const uint limit = min(min(visible_tokens, causal_end), step_end_token);
+    const uint step_page = column / SplashKvPageTokens;
+    const uint page_offset = column % SplashKvPageTokens;
+    const uint token = (first_page + step_page) * SplashKvPageTokens + page_offset;
+    // Pages past the split's end are never addressed: their tokens are masked.
+    const bool page_live = (first_page + step_page) * SplashKvPageTokens < step_end_token;
+    device const float *key_scales = nullptr, *value_scales = nullptr;
+    if (page_live) {
+      const SplashTurboInt4PageTensors tensors = addressing.page(page_table[first_page + step_page]);
+      key_scales = tensors.key_scales + page_offset;
+      value_scales = tensors.value_scales + page_offset;
+    }
+    threadgroup const float4 *scores4 =
+        reinterpret_cast<threadgroup const float4 *>(scores + fused_row * N + column);
+    float score[TokensPerLane];
+    bool visible[TokensPerLane];
+    float local_max = -INFINITY;
+#pragma unroll
+    for (uint v = 0; v < TokensPerLane / 4; ++v) {
+      float4 s = scores4[v];
+      if (page_live)
+        s *= reinterpret_cast<device const float4 *>(key_scales)[v];
+      s *= 0.0625f;
+      score[4 * v] = s.x, score[4 * v + 1] = s.y, score[4 * v + 2] = s.z, score[4 * v + 3] = s.w;
+    }
+#pragma unroll
+    for (uint j = 0; j < TokensPerLane; ++j) {
+      visible[j] = token + j < limit;
+      score[j] = visible[j] ? score[j] : -INFINITY;
+      local_max = max(local_max, score[j]);
+    }
+    local_max = max(local_max, simd_shuffle_xor(local_max, 1));
+    local_max = max(local_max, simd_shuffle_xor(local_max, 2));
+    const float previous_max = row_max[fused_row];
+    const float next_max = max(previous_max, local_max);
+    float local_sum = 0.0f;
+#pragma unroll
+    for (uint j = 0; j < TokensPerLane; ++j) {
+      score[j] = visible[j] ? fast::exp(score[j] - next_max) : 0.0f;
+      local_sum += score[j];
+    }
+    local_sum += simd_shuffle_xor(local_sum, 1);
+    local_sum += simd_shuffle_xor(local_sum, 2);
+    if (column == 0) {
+      const float scale = next_max == -INFINITY || next_max == previous_max
+                              ? 1.0f
+                              : fast::exp(previous_max - next_max);
+      previous_scale[fused_row] = scale;
+      row_sum[fused_row] = row_sum[fused_row] * scale + local_sum;
+      row_max[fused_row] = next_max;
+      if (scale != 1.0f)
+        atomic_store_explicit(rescale, 1u, memory_order_relaxed);
+    }
+    if constexpr (AliasProbabilities)
+      simdgroup_barrier(mem_flags::mem_threadgroup);
+    threadgroup bfloat4 *probabilities4 = reinterpret_cast<threadgroup bfloat4 *>(
+        probabilities + fused_row * ProbabilityStride + column);
+#pragma unroll
+    for (uint v = 0; v < TokensPerLane / 4; ++v) {
+      float4 scales = page_live ? reinterpret_cast<device const float4 *>(value_scales)[v] : float4(0.0f);
+      // Masked tokens stay exactly zero whatever their stored value scale holds.
+      const float4 p(visible[4 * v] ? score[4 * v] * scales.x : 0.0f,
+                     visible[4 * v + 1] ? score[4 * v + 1] * scales.y : 0.0f,
+                     visible[4 * v + 2] ? score[4 * v + 2] * scales.z : 0.0f,
+                     visible[4 * v + 3] ? score[4 * v + 3] * scales.w : 0.0f);
+      probabilities4[v] = bfloat4(p);
+    }
+  }
+}
+
+// QkBlockRows x QkBlockTokens != 0: each simdgroup computes its own blocks of
+// the step's score tile (execution_simdgroup products) instead of all eight
+// sharing one M x 32 product per page. StageQueries copies the tile's queries
+// into threadgroup memory once (`staged_queries`, M x D bf16) for QK to read.
+// Ablation (prefill_attn_bench only; 0 in every engine kernel): 1 skips the
+// softmax, 2 the PV products, 3 the QK products. Results are then wrong.
+template <uint KVHeads, uint QueryHeadsPerKVHead, uint RowsPerTile, uint StepPages,
+          bool AliasProbabilities, uint QkBlockRows = 0, uint QkBlockTokens = 0,
+          bool StageQueries = false, uint Ablation = 0>
+inline void splash_prefill_v2_turbo_int4_tile(
+    device bfloat *tile_queries, device const SplashKvPage *page_table,
+    SplashKvLayer kv, uint kv_head, uint committed_tokens, uint active_rows, uint splits,
+    uint split, device float *partials, device float *statistics, ulong slot,
+    threadgroup float *scores, threadgroup bfloat *probabilities,
+    threadgroup float *row_max, threadgroup float *row_sum,
+    threadgroup float *previous_scale, threadgroup atomic_uint *rescale,
+    threadgroup bfloat *staged_queries, uint thread_index, uint simd_group) {
+  constexpr ushort M = RowsPerTile * QueryHeadsPerKVHead;
+  constexpr ushort P = SplashKvPageTokens;
+  constexpr ushort N = SplashKvPageTokens * StepPages;
+  constexpr ushort D = SplashKvHeadDimension;
+  constexpr ushort ProbabilityStride = AliasProbabilities ? 2 * N : N;
+  uint visible_tokens = committed_tokens + active_rows;
+  uint pages = splash_attention_pages(visible_tokens);
+  uint per_split = splash_attention_pages_per_split(pages, splits);
+  uint page_begin = split * per_split;
+  if (page_begin >= pages)
+    return;
+  uint page_end = min(pages, page_begin + per_split);
+  for (uint row = thread_index; row < M; row += 256) {
+    row_max[row] = -INFINITY;
+    row_sum[row] = 0.0f;
+  }
+  if constexpr (StageQueries) {
+    for (uint at = thread_index; at < uint(M) * D / 8; at += 256)
+      reinterpret_cast<threadgroup uint4 *>(staged_queries)[at] =
+          reinterpret_cast<device const uint4 *>(tile_queries)[at];
+  }
+  threadgroup_barrier(mem_flags::mem_threadgroup);
+
+  using Int4Tensor = tensor<device int4b_format, dextents<int, 2>, tensor_inline>;
+  threadgroup bfloat *probability_base =
+      AliasProbabilities ? reinterpret_cast<threadgroup bfloat *>(scores) : probabilities;
+  auto qt = tensor(StageQueries ? nullptr : tile_queries, dextents<int, 2>{D, M}, array<int, 2>{1, D});
+  auto qt_staged = tensor(staged_queries, dextents<int, 2>{D, M}, array<int, 2>{1, D});
+  auto st = tensor(scores, dextents<int, 2>{N, M}, array<int, 2>{1, N});
+  auto pt = tensor(probability_base, dextents<int, 2>{N, M}, array<int, 2>{1, ProbabilityStride});
+  auto p0 = pt.template slice<P, M>(0, 0);
+  auto q0 = qt.template slice<D, M>(0, 0);
+  auto operand_type = Int4Tensor(static_cast<device uchar *>(nullptr), dextents<int, 2>{D, P});
+  auto k0 = operand_type.template slice<D, P>(0, 0);
+  auto v0 = operand_type.template slice<D, P>(0, 0);
+  const SplashTurboInt4Addressing<KVHeads> addressing(kv, kv_head);
+  constexpr auto qk_descriptor =
+      matmul2d_descriptor(M, P, D, false, true, false, matmul2d_descriptor::mode::multiply);
+  constexpr auto pv_descriptor =
+      matmul2d_descriptor(M, D, P, false, false, true,
+                          matmul2d_descriptor::mode::multiply_accumulate);
+  matmul2d<qk_descriptor, execution_simdgroups<8>> qk;
+  matmul2d<pv_descriptor, execution_simdgroups<8>> pv;
+  auto running = pv.template get_destination_cooperative_tensor<decltype(p0), decltype(v0), float>();
+  const bool running_full = uint(running.get_capacity()) * (8u * 32u) == uint(M) * D;
+#pragma unroll
+  for (ushort index = 0; index < running.get_capacity(); ++index) {
+    if (running_full || running.is_valid_element(index))
+      running[index] = 0.0f;
+  }
+
+  for (uint page = page_begin; page < page_end; page += StepPages) {
+    const uint step_pages = min(uint(StepPages), page_end - page);
+    if constexpr (QkBlockRows != 0) {
+      constexpr uint RowBlocks = M / QkBlockRows;
+      constexpr uint Blocks = RowBlocks * (N / QkBlockTokens);
+      static_assert(M % QkBlockRows == 0 && P % QkBlockTokens == 0, "blocks tile the step");
+      constexpr auto block_descriptor = matmul2d_descriptor(
+          QkBlockRows, QkBlockTokens, D, false, true, false, matmul2d_descriptor::mode::multiply);
+      matmul2d<block_descriptor, execution_simdgroup> block_qk;
+      for (uint block = simd_group; block < Blocks; block += 8) {
+        const uint row0 = block % RowBlocks * QkBlockRows;
+        const uint token0 = block / RowBlocks * QkBlockTokens;
+        const uint j = token0 / P;
+        if (j < step_pages) {
+          const SplashTurboInt4PageTensors tensors = addressing.page(page_table[page + j]);
+          auto ks = Int4Tensor(tensors.keys, dextents<int, 2>{D, P})
+                        .template slice<D, QkBlockTokens>(0, token0 % P);
+          auto block_store = st.template slice<QkBlockTokens, QkBlockRows>(token0, row0);
+          if constexpr (StageQueries) {
+            auto qs = qt_staged.template slice<D, QkBlockRows>(0, row0);
+            auto block_scores = block_qk.template get_destination_cooperative_tensor<
+                decltype(qs), decltype(ks), float>();
+            if (Ablation != 3)
+              block_qk.run(qs, ks, block_scores);
+            block_scores.store(block_store);
+          } else {
+            auto qs = qt.template slice<D, QkBlockRows>(0, row0);
+            auto block_scores = block_qk.template get_destination_cooperative_tensor<
+                decltype(qs), decltype(ks), float>();
+            if (Ablation != 3)
+              block_qk.run(qs, ks, block_scores);
+            block_scores.store(block_store);
+          }
+        }
+      }
+    } else {
+#pragma unroll
+      for (uint j = 0; j < StepPages; ++j) {
+        if (j < step_pages) {
+          const SplashTurboInt4PageTensors tensors = addressing.page(page_table[page + j]);
+          auto ks = Int4Tensor(tensors.keys, dextents<int, 2>{D, P}).template slice<D, P>(0, 0);
+          if constexpr (StageQueries) {
+            auto qs = qt_staged.template slice<D, M>(0, 0);
+            auto page_scores = qk.template get_destination_cooperative_tensor<
+                decltype(qs), decltype(k0), float>();
+            if (Ablation != 3)
+              qk.run(qs, ks, page_scores);
+            page_scores.store(st.template slice<P, M>(j * P, 0));
+          } else {
+            auto page_scores = qk.template get_destination_cooperative_tensor<
+                decltype(q0), decltype(k0), float>();
+            if (Ablation != 3)
+              qk.run(q0, ks, page_scores);
+            page_scores.store(st.template slice<P, M>(j * P, 0));
+          }
+        }
+      }
+    }
+    if (thread_index == 0)
+      atomic_store_explicit(rescale, 0u, memory_order_relaxed);
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    if (Ablation != 1)
+      splash_prefill_v2_softmax<QueryHeadsPerKVHead, RowsPerTile, StepPages, AliasProbabilities, KVHeads>(
+        scores, probability_base, row_max, row_sum, previous_scale, rescale, page_table,
+        addressing, page, page_end * SplashKvPageTokens, visible_tokens, committed_tokens,
+        active_rows, thread_index);
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    if (atomic_load_explicit(rescale, memory_order_relaxed)) {
+#pragma unroll
+      for (ushort index = 0; index < running.get_capacity(); ++index) {
+        if (!running_full && !running.is_valid_element(index))
+          continue;
+        auto coordinates = running.get_multidimensional_index(index);
+        running[index] *= previous_scale[coordinates[1]];
+      }
+    }
+#pragma unroll
+    for (uint j = 0; j < StepPages; ++j) {
+      if (j < step_pages) {
+        const SplashTurboInt4PageTensors tensors = addressing.page(page_table[page + j]);
+        auto vs = Int4Tensor(tensors.values, dextents<int, 2>{D, P}).template slice<D, P>(0, 0);
+        auto ps = pt.template slice<P, M>(j * P, 0);
+        if (Ablation != 2)
+          pv.run(ps, vs, running);
+      }
+    }
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+  }
+  auto target = tensor(partials + slot * M * D, dextents<int, 2>{D, M}, array<int, 2>{1, D});
+  running.store(target.template slice<D, M>(0, 0));
+  for (uint row = thread_index; row < M; row += 256) {
+    statistics[(slot * M + row) * 2] = row_max[row];
+    statistics[(slot * M + row) * 2 + 1] = row_sum[row];
+  }
+}
+
+// The same tile with per-simdgroup PV as well: simdgroup s owns one
+// PvBlockRows x PvBlockDims block of the M x D output (eight blocks in all) and
+// accumulates it over every page with execution_simdgroup products.
+// QkBlockRows x QkBlockTokens != 0: each simdgroup computes its own blocks of
+// the step's score tile (execution_simdgroup products) instead of all eight
+// sharing one M x 32 product per page. StageQueries copies the tile's queries
+// into threadgroup memory once (`staged_queries`, M x D bf16) for QK to read.
+// Ablation (prefill_attn_bench only; 0 in every engine kernel): 1 skips the
+// softmax, 2 the PV products, 3 the QK products. Results are then wrong.
+template <uint KVHeads, uint QueryHeadsPerKVHead, uint RowsPerTile, uint StepPages,
+          bool AliasProbabilities, uint QkBlockRows = 0, uint QkBlockTokens = 0,
+          bool StageQueries, uint PvBlockRows, uint PvBlockDims, uint Ablation = 0>
+inline void splash_prefill_v2_turbo_int4_tile_simdgroup_pv(
+    device bfloat *tile_queries, device const SplashKvPage *page_table,
+    SplashKvLayer kv, uint kv_head, uint committed_tokens, uint active_rows, uint splits,
+    uint split, device float *partials, device float *statistics, ulong slot,
+    threadgroup float *scores, threadgroup bfloat *probabilities,
+    threadgroup float *row_max, threadgroup float *row_sum,
+    threadgroup float *previous_scale, threadgroup atomic_uint *rescale,
+    threadgroup bfloat *staged_queries, uint thread_index, uint simd_group) {
+  constexpr ushort M = RowsPerTile * QueryHeadsPerKVHead;
+  constexpr ushort P = SplashKvPageTokens;
+  constexpr ushort N = SplashKvPageTokens * StepPages;
+  constexpr ushort D = SplashKvHeadDimension;
+  constexpr ushort ProbabilityStride = AliasProbabilities ? 2 * N : N;
+  uint visible_tokens = committed_tokens + active_rows;
+  uint pages = splash_attention_pages(visible_tokens);
+  uint per_split = splash_attention_pages_per_split(pages, splits);
+  uint page_begin = split * per_split;
+  if (page_begin >= pages)
+    return;
+  uint page_end = min(pages, page_begin + per_split);
+  for (uint row = thread_index; row < M; row += 256) {
+    row_max[row] = -INFINITY;
+    row_sum[row] = 0.0f;
+  }
+  if constexpr (StageQueries) {
+    for (uint at = thread_index; at < uint(M) * D / 8; at += 256)
+      reinterpret_cast<threadgroup uint4 *>(staged_queries)[at] =
+          reinterpret_cast<device const uint4 *>(tile_queries)[at];
+  }
+  threadgroup_barrier(mem_flags::mem_threadgroup);
+
+  using Int4Tensor = tensor<device int4b_format, dextents<int, 2>, tensor_inline>;
+  threadgroup bfloat *probability_base =
+      AliasProbabilities ? reinterpret_cast<threadgroup bfloat *>(scores) : probabilities;
+  auto qt = tensor(StageQueries ? nullptr : tile_queries, dextents<int, 2>{D, M}, array<int, 2>{1, D});
+  auto qt_staged = tensor(staged_queries, dextents<int, 2>{D, M}, array<int, 2>{1, D});
+  auto st = tensor(scores, dextents<int, 2>{N, M}, array<int, 2>{1, N});
+  auto pt = tensor(probability_base, dextents<int, 2>{N, M}, array<int, 2>{1, ProbabilityStride});
+  auto p0 = pt.template slice<P, M>(0, 0);
+  auto q0 = qt.template slice<D, M>(0, 0);
+  auto operand_type = Int4Tensor(static_cast<device uchar *>(nullptr), dextents<int, 2>{D, P});
+  auto k0 = operand_type.template slice<D, P>(0, 0);
+  auto v0 = operand_type.template slice<D, P>(0, 0);
+  const SplashTurboInt4Addressing<KVHeads> addressing(kv, kv_head);
+  constexpr auto qk_descriptor =
+      matmul2d_descriptor(M, P, D, false, true, false, matmul2d_descriptor::mode::multiply);
+  constexpr auto pv_descriptor =
+      matmul2d_descriptor(M, D, P, false, false, true,
+                          matmul2d_descriptor::mode::multiply_accumulate);
+  matmul2d<qk_descriptor, execution_simdgroups<8>> qk;
+  (void)pv_descriptor;
+  static_assert((M / PvBlockRows) * (D / PvBlockDims) == 8 && M % PvBlockRows == 0 &&
+                    D % PvBlockDims == 0,
+                "one PV output block per simdgroup");
+  constexpr auto block_pv_descriptor = matmul2d_descriptor(
+      PvBlockRows, PvBlockDims, P, false, false, true, matmul2d_descriptor::mode::multiply_accumulate);
+  matmul2d<block_pv_descriptor, execution_simdgroup> pv;
+  const uint pv_row0 = simd_group % (M / PvBlockRows) * PvBlockRows;
+  const uint pv_dim0 = simd_group / (M / PvBlockRows) * PvBlockDims;
+  auto pv_left = pt.template slice<P, PvBlockRows>(0, pv_row0);
+  auto pv_right = operand_type.template slice<PvBlockDims, P>(pv_dim0, 0);
+  auto running = pv.template get_destination_cooperative_tensor<decltype(pv_left), decltype(pv_right), float>();
+  const bool running_full = uint(running.get_capacity()) * 32u == uint(PvBlockRows) * PvBlockDims;
+#pragma unroll
+  for (ushort index = 0; index < running.get_capacity(); ++index) {
+    if (running_full || running.is_valid_element(index))
+      running[index] = 0.0f;
+  }
+
+  for (uint page = page_begin; page < page_end; page += StepPages) {
+    const uint step_pages = min(uint(StepPages), page_end - page);
+    if constexpr (QkBlockRows != 0) {
+      constexpr uint RowBlocks = M / QkBlockRows;
+      constexpr uint Blocks = RowBlocks * (N / QkBlockTokens);
+      static_assert(M % QkBlockRows == 0 && P % QkBlockTokens == 0, "blocks tile the step");
+      constexpr auto block_descriptor = matmul2d_descriptor(
+          QkBlockRows, QkBlockTokens, D, false, true, false, matmul2d_descriptor::mode::multiply);
+      matmul2d<block_descriptor, execution_simdgroup> block_qk;
+      for (uint block = simd_group; block < Blocks; block += 8) {
+        const uint row0 = block % RowBlocks * QkBlockRows;
+        const uint token0 = block / RowBlocks * QkBlockTokens;
+        const uint j = token0 / P;
+        if (j < step_pages) {
+          const SplashTurboInt4PageTensors tensors = addressing.page(page_table[page + j]);
+          auto ks = Int4Tensor(tensors.keys, dextents<int, 2>{D, P})
+                        .template slice<D, QkBlockTokens>(0, token0 % P);
+          auto block_store = st.template slice<QkBlockTokens, QkBlockRows>(token0, row0);
+          if constexpr (StageQueries) {
+            auto qs = qt_staged.template slice<D, QkBlockRows>(0, row0);
+            auto block_scores = block_qk.template get_destination_cooperative_tensor<
+                decltype(qs), decltype(ks), float>();
+            if (Ablation != 3)
+              block_qk.run(qs, ks, block_scores);
+            block_scores.store(block_store);
+          } else {
+            auto qs = qt.template slice<D, QkBlockRows>(0, row0);
+            auto block_scores = block_qk.template get_destination_cooperative_tensor<
+                decltype(qs), decltype(ks), float>();
+            if (Ablation != 3)
+              block_qk.run(qs, ks, block_scores);
+            block_scores.store(block_store);
+          }
+        }
+      }
+    } else {
+#pragma unroll
+      for (uint j = 0; j < StepPages; ++j) {
+        if (j < step_pages) {
+          const SplashTurboInt4PageTensors tensors = addressing.page(page_table[page + j]);
+          auto ks = Int4Tensor(tensors.keys, dextents<int, 2>{D, P}).template slice<D, P>(0, 0);
+          if constexpr (StageQueries) {
+            auto qs = qt_staged.template slice<D, M>(0, 0);
+            auto page_scores = qk.template get_destination_cooperative_tensor<
+                decltype(qs), decltype(k0), float>();
+            if (Ablation != 3)
+              qk.run(qs, ks, page_scores);
+            page_scores.store(st.template slice<P, M>(j * P, 0));
+          } else {
+            auto page_scores = qk.template get_destination_cooperative_tensor<
+                decltype(q0), decltype(k0), float>();
+            if (Ablation != 3)
+              qk.run(q0, ks, page_scores);
+            page_scores.store(st.template slice<P, M>(j * P, 0));
+          }
+        }
+      }
+    }
+    if (thread_index == 0)
+      atomic_store_explicit(rescale, 0u, memory_order_relaxed);
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    if (Ablation != 1)
+      splash_prefill_v2_softmax<QueryHeadsPerKVHead, RowsPerTile, StepPages, AliasProbabilities, KVHeads>(
+        scores, probability_base, row_max, row_sum, previous_scale, rescale, page_table,
+        addressing, page, page_end * SplashKvPageTokens, visible_tokens, committed_tokens,
+        active_rows, thread_index);
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    if (atomic_load_explicit(rescale, memory_order_relaxed)) {
+#pragma unroll
+      for (ushort index = 0; index < running.get_capacity(); ++index) {
+        if (!running_full && !running.is_valid_element(index))
+          continue;
+        auto coordinates = running.get_multidimensional_index(index);
+        running[index] *= previous_scale[pv_row0 + coordinates[1]];
+      }
+    }
+#pragma unroll
+    for (uint j = 0; j < StepPages; ++j) {
+      if (j < step_pages) {
+        const SplashTurboInt4PageTensors tensors = addressing.page(page_table[page + j]);
+        auto vs = Int4Tensor(tensors.values, dextents<int, 2>{D, P})
+                      .template slice<PvBlockDims, P>(pv_dim0, 0);
+        auto ps = pt.template slice<P, PvBlockRows>(j * P, pv_row0);
+        if (Ablation != 2)
+          pv.run(ps, vs, running);
+      }
+    }
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+  }
+  auto target = tensor(partials + slot * M * D, dextents<int, 2>{D, M}, array<int, 2>{1, D});
+  running.store(target.template slice<PvBlockDims, PvBlockRows>(pv_dim0, pv_row0));
+  for (uint row = thread_index; row < M; row += 256) {
+    statistics[(slot * M + row) * 2] = row_max[row];
+    statistics[(slot * M + row) * 2 + 1] = row_sum[row];
+  }
+}
+
+// The split grid is {KV heads, query tiles of RowsPerTile rows, splits}.
+template <uint KVHeads, uint QueryHeadsPerKVHead, uint RowsPerTile, uint StepPages,
+          bool AliasProbabilities, uint QkBlockRows = 0, uint QkBlockTokens = 0,
+          bool StageQueries = false, uint PvBlockRows = 0, uint PvBlockDims = 0,
+          uint Ablation = 0>
+inline void splash_prefill_v2_turbo_int4_split_phase(
+    device bfloat *queries, device float *partials, device float *statistics,
+    device const SplashKvPage *page_table, constant SplashPrefillAttentionParams &params,
+    threadgroup float *scores, threadgroup bfloat *probabilities, threadgroup float *row_max,
+    threadgroup float *row_sum, threadgroup float *previous_scale,
+    threadgroup atomic_uint *rescale, threadgroup bfloat *staged_queries, uint3 group,
+    uint thread_index, uint simd_group) {
+  constexpr uint D = SplashKvHeadDimension;
+  uint kv_head = group.x;
+  uint split = group.z;
+  uint tile = group.y;
+  uint tile_start = tile * RowsPerTile;
+  if (!splash_prefill_attention_contract_valid(params) || kv_head >= KVHeads ||
+      split >= params.split_count || tile_start >= params.rows)
+    return;
+  uint active_rows = min(RowsPerTile, params.rows - tile_start);
+  ulong tile_offset = (ulong(kv_head) * params.chunk_stride + tile_start) * QueryHeadsPerKVHead * D;
+  ulong slot = (ulong(tile) * KVHeads + kv_head) * params.split_count + split;
+  if constexpr (PvBlockRows != 0)
+    splash_prefill_v2_turbo_int4_tile_simdgroup_pv<KVHeads, QueryHeadsPerKVHead, RowsPerTile,
+                                                   StepPages, AliasProbabilities, QkBlockRows,
+                                                   QkBlockTokens, StageQueries, PvBlockRows,
+                                                   PvBlockDims, Ablation>(
+        queries + tile_offset, page_table, params.kv, kv_head,
+        params.committed_tokens + tile_start, active_rows, params.split_count, split, partials,
+        statistics, slot, scores, probabilities, row_max, row_sum, previous_scale, rescale,
+        staged_queries, thread_index, simd_group);
+  else
+    splash_prefill_v2_turbo_int4_tile<KVHeads, QueryHeadsPerKVHead, RowsPerTile, StepPages,
+                                      AliasProbabilities, QkBlockRows, QkBlockTokens,
+                                      StageQueries, Ablation>(
+        queries + tile_offset, page_table, params.kv, kv_head,
+        params.committed_tokens + tile_start, active_rows, params.split_count, split, partials,
+        statistics, slot, scores, probabilities, row_max, row_sum, previous_scale, rescale,
+        staged_queries, thread_index, simd_group);
+}
+
+// The reduce grid is {KV heads, fused rows of a tile, query tiles}; the
+// production reduce with RowsPerTile-row tiles.
+template <uint KVHeads, uint QueryHeadsPerKVHead, uint RowsPerTile>
+inline void splash_prefill_v2_reduce_phase(
+    device const float *partials, device const float *statistics, device bfloat *output,
+    constant SplashPrefillAttentionParams &params, uint3 group, uint thread_index,
+    threadgroup float *weights, threadgroup float *group_values, threadgroup float *rotation) {
+  constexpr uint M = RowsPerTile * QueryHeadsPerKVHead;
+  constexpr uint D = SplashKvHeadDimension;
+  uint kv_head = group.x;
+  uint fused_row = group.y;
+  uint tile = group.z;
+  uint tile_start = tile * RowsPerTile;
+  if (!splash_prefill_attention_contract_valid(params) || kv_head >= KVHeads ||
+      fused_row >= M || thread_index >= D || tile_start >= params.rows)
+    return;
+  uint active_rows = min(RowsPerTile, params.rows - tile_start);
+  ulong tile_offset = (ulong(kv_head) * params.chunk_stride + tile_start) * QueryHeadsPerKVHead * D;
+  splash_attention_reduce_row<QueryHeadsPerKVHead, RowsPerTile, SplashKvHeadDimension>(
+      partials, statistics, output + tile_offset, params.committed_tokens + tile_start,
+      active_rows, params.split_count, (ulong(tile) * KVHeads + kv_head) * params.split_count,
+      fused_row, thread_index, weights, group_values, rotation);
+}
+
+// QkRows x QkTokens: per-simdgroup QK blocks (0 x 0 = one group-wide product
+// per page); Stage: queries in threadgroup memory; Ablate: bench only.
+#define SPLASH_PREFILL_V2_TURBO_INT4_SPLIT(Name, Heads, Group, Rows, Step, Alias, QkRows,      \
+                                           QkTokens, Stage, PvRows, PvDims, Ablate)            \
+  kernel void Name(device bfloat *queries [[buffer(0)]], device float *partials [[buffer(1)]], \
+                   device float *statistics [[buffer(2)]],                                     \
+                   device const SplashKvPage *page_table [[buffer(3)]],                        \
+                   constant SplashPrefillAttentionParams &params [[buffer(4)]],                \
+                   uint3 group [[threadgroup_position_in_grid]],                               \
+                   uint thread_index [[thread_index_in_threadgroup]],                          \
+                   uint simd_group [[simdgroup_index_in_threadgroup]]) {                       \
+    constexpr uint M = (Rows) * (Group);                                                       \
+    constexpr uint N = SplashKvPageTokens * (Step);                                            \
+    alignas(16) threadgroup float scores[M * N];                                               \
+    alignas(16) threadgroup bfloat probabilities[(Alias) ? 8 : M * N];                         \
+    alignas(16) threadgroup bfloat staged_queries[(Stage) ? M * SplashKvHeadDimension : 8];    \
+    threadgroup float row_max[M];                                                              \
+    threadgroup float row_sum[M];                                                              \
+    threadgroup float previous_scale[M];                                                       \
+    threadgroup atomic_uint rescale;                                                           \
+    splash_prefill_v2_turbo_int4_split_phase<Heads, Group, Rows, Step, Alias, QkRows,          \
+                                             QkTokens, Stage, PvRows, PvDims, Ablate>(         \
+        queries, partials, statistics, page_table, params, scores, probabilities, row_max,     \
+        row_sum, previous_scale, &rescale, staged_queries, group, thread_index, simd_group);   \
+  }
+
+#define SPLASH_PREFILL_V2_TURBO_INT4_REDUCE(Name, Heads, Group, Rows)                          \
+  kernel void Name(device const float *partials [[buffer(0)]],                                 \
+                   device const float *statistics [[buffer(1)]],                               \
+                   device bfloat *output [[buffer(2)]],                                        \
+                   constant SplashPrefillAttentionParams &params [[buffer(3)]],                \
+                   uint3 group [[threadgroup_position_in_grid]],                               \
+                   uint thread_index [[thread_index_in_threadgroup]]) {                        \
+    threadgroup float weights[SplashPrefillMaximumSplits];                                     \
+    threadgroup float group_values[8];                                                         \
+    threadgroup float rotation[SplashKvHeadDimension];                                         \
+    splash_prefill_v2_reduce_phase<Heads, Group, Rows>(partials, statistics, output, params,   \
+                                                       group, thread_index, weights,           \
+                                                       group_values, rotation);                \
+  }
diff --git a/runtime/metal/kernels/decode/dspine.metal b/runtime/metal/kernels/decode/dspine.metal
