+  // either drafter reads) must be complete, as a restored state's must.
+  if (metadata.requestId != requestId ||
+      metadata.lengths.targetTokens != committedTokens ||
+      !metadata.lengths.hasCompleteDraftWindow(draftContextWindow()))
+    return false;
+  entry.parked = true;
+  entry.maskWords.clear();
+  entry.finalTargetHidden.clear();
+  return true;
+}
