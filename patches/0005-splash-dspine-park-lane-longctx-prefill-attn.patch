+  switch (reason) {
+  case ParkRelease::Mismatch:
+    ++counters_.parkMismatches;
+    why = "not continued";
+    break;
+  case ParkRelease::Reclaim:
+    ++counters_.parkReclaims;
+    why = "reclaimed for";
+    break;
+  case ParkRelease::Replacement:
+    ++counters_.parkReplacements;
+    why = "replaced:";
+    break;
+  }
+  parkLog("released request " + std::to_string(lane.requestId) + "'s lane at " +
+          std::to_string(lane.tokens.size()) + " tokens, " + std::string(why) +
+          (detail.empty() ? "" : " " + std::string(detail)));
