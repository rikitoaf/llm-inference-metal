@@ -0,0 +1,195 @@
+"""gguf_mv / gguf_mm / gguf_embed against llama.cpp's own dequantizers (the ``gguf`` package) on real GGUF rows: one
+matrix of each ggml type a local GGUF file holds (K = 5120) at 1 to 128 rows, silu·mul over [gate | up] rows of two
+types, the residual epilogue, a column gather, the embedding gather. The files are large and local: set LITHOS_GGUF_TEST_FILES (paths
+joined by ':') or keep the Hub cache's Qwen3.8 GGUFs; without one the real-file tests skip. A synthetic Q8_0 / F16 /
+BF16 slab runs everywhere."""
+
+import os
+from pathlib import Path
+
+import numpy as np
+import pytest
+
+from monolith import kernels
+from monolith.formats import FORMATS, PackLayout
+from monolith.formats.fp import bf16_to_f32, f32_to_bf16
+from monolith.formats.gguf import BF16, F16, GGUFRows, Q8_0, ROW_TYPES, row_bytes
+from monolith.runtime import _native as nt
+
+K = 5120
+ROWS = 64
+
+
+def _files():
+    env = os.environ.get("LITHOS_GGUF_TEST_FILES")
+    if env:
+        return [Path(p) for p in env.split(":") if p]
+    hub = Path.home() / ".cache/huggingface/hub"
+    return sorted(hub.glob("models--unsloth--Qwen3.8-27B-GGUF/snapshots/*/*.gguf")) + \
+        sorted(Path.home().glob("models/Qwen3.8-27B-GSQ-RCO-IQ2_S.gguf"))
+
+
+@pytest.fixture(scope="module")
+def dev():
+    return nt.Device()
+
+
+@pytest.fixture(scope="module")
+def real_rows():
+    """{ggml type: GGUFRows [ROWS, row bytes]} — the first rows of one K = 5120 matrix per type."""
+    gg = pytest.importorskip("gguf")
+    out = {}
+    for f in _files():
+        if not f.is_file():
+            continue
+        r = gg.GGUFReader(str(f))
+        for t in r.tensors:
+            tt = int(t.tensor_type)
+            if tt in ROW_TYPES and tt not in out and len(t.shape) == 2 and int(t.shape[0]) == K and int(t.shape[1]) >= 2 * ROWS:
+                data = np.asarray(t.data)
+                rows = data[: 2 * ROWS].reshape(2 * ROWS, -1).view(np.uint8)
+                out[tt] = GGUFRows(np.ascontiguousarray(rows), tt)
+    if not out:
+        pytest.skip("no local GGUF file (LITHOS_GGUF_TEST_FILES)")
+    return out
+
+
+def _synthetic():
+    """Q8_0 (gguf-py's quantizer), F16 and BF16 rows."""
+    gg = pytest.importorskip("gguf")
+    rng = np.random.default_rng(0)
+    w = rng.standard_normal((2 * ROWS, K)).astype(np.float32) * 0.05
+    q8 = gg.quants.quantize(w, gg.GGMLQuantizationType.Q8_0)
+    return {Q8_0: GGUFRows(q8.reshape(2 * ROWS, -1), Q8_0),
+            F16: GGUFRows(w.astype(np.float16).view(np.uint8).reshape(2 * ROWS, -1), F16),
+            BF16: GGUFRows(f32_to_bf16(w).view(np.uint8).reshape(2 * ROWS, -1), BF16)}
+
+
+def _slab(parts, perm=None, gather=None):
+    """Stack parts the way the packer does (concatenate the specs' tensors, then the row permutation)."""
+    fmt = FORMATS.get("gguf")
+    specs = []
+    for rows in parts:
+        if gather is not None:
+            rows = GGUFRows(rows, rows.ggml_type, gather)
+        specs.append(fmt.unpack({"weight": rows}, shape=(rows.shape[0], K)))
+    stacked = {k: np.concatenate([s.tensors[k] for s in specs]) for k in specs[0].tensors}
+    if perm is not None:
+        stacked = {k: v[perm] for k, v in stacked.items()}
+    spec = type(specs[0])("gguf", (len(stacked["types"]), K), stacked, dict(specs[0].params))
+    data, info = fmt.pack(spec, PackLayout(rows=16))
+    assert fmt.unpack_pack(data, info).tensors["types"].tolist() == spec.tensors["types"].tolist()
+    return spec, data, info
+
+
+def test_embed(dev, real_rows):
+    tt = sorted(real_rows)[-1]
+    spec, data, _ = _slab([real_rows[tt][:ROWS]])
+    w = FORMATS.get("gguf").dequantize(spec)
+    lib = nt.Library(dev, kernels.gguf_gemv_source(), {}, 0)
+    pipe = nt.Pipeline(lib, "gguf_embed")
+    ids = np.array([5, 0, 63, 17, 99], np.int32)                             # 99 is outside the 64 rows: row 0
+    out = nt.Buffer(dev, len(ids) * K * 2)
+    d = (nt.Dispatch().pipeline(pipe).buffer(0, nt.Buffer(dev, ids.tobytes())).buffer(1, nt.Buffer(dev, data)).buffer(2, out)
+         .bytes(3, kernels.embed_params(K, len(ids), ROWS)).grid(len(ids)).threadgroup(32))
+    assert not nt.Queue(dev).run([d]).error
+    got = bf16_to_f32(np.frombuffer(out.read(0, len(ids) * K * 2), dtype=np.uint16).reshape(len(ids), K))
+    ref = bf16_to_f32(f32_to_bf16(w[np.where(ids < ROWS, ids, 0)]))
+    assert np.abs(got - ref).max() <= 1e-6 + 1e-2 * np.abs(ref).max()
+    assert np.mean(got == ref) > 0.999
+
+
+# ---- the type-specialized kernels (gguf_mv: T ≤ 8, gguf_mm: the matrix units above) -----------------------------------
+
+def _run_typed(dev, data, n_out, t, ggml_type, x, epilogue=None, type_b=None, up_off=0, residual=None):
+    m = kernels.gguf_kernel_macros(K, t, ggml_type, epilogue, type_b=type_b)
+    mm = t > kernels.GGUF_MV_T_MAX
+    lib = nt.Library(dev, kernels.gguf_gemv_source(), m, kernels.MSL_TENSOR_OPS if mm else 0)
+    pipe = nt.Pipeline(lib, "gguf_mm" if mm else "gguf_mv")
+    rows_total = n_out * (2 if epilogue == "silu_mul" else 1)
+    yb = nt.Buffer(dev, t * n_out * 2)
+    yb.fill(0)
+    d = (nt.Dispatch().pipeline(pipe).buffer(0, nt.Buffer(dev, data)).buffer(1, nt.Buffer(dev, np.ones(rows_total, np.float32).tobytes()))
+         .buffer(2, nt.Buffer(dev, f32_to_bf16(x).tobytes())).buffer(3, yb)
+         .bytes(4, kernels.gguf_params(0, n_out, 0, n_out, t, up_off=up_off)))
+    if residual is not None:
+        d.buffer(7, nt.Buffer(dev, f32_to_bf16(residual).tobytes()))
+    if mm:
+        d.grid(-(-t // 64), -(-n_out // (32 if epilogue == "silu_mul" else 64)), 1).threadgroup(128)
+    else:
+        rg = 2 if epilogue == "silu_mul" else 4
+        d.grid(-(-n_out // (8 * rg))).threadgroup(256)
+    r = nt.Queue(dev).run([d])
+    assert not r.error, r.error
+    return bf16_to_f32(np.frombuffer(yb.read(0, t * n_out * 2), dtype=np.uint16).reshape(t, n_out))
+
+
+@pytest.mark.parametrize("t", [1, 3, 8, 40, 128])
+def test_typed_kernels_every_type(dev, real_rows, t):
+    rng = np.random.default_rng(t)
+    for tt, rows in sorted({**_synthetic(), **real_rows}.items()):
+        spec, data, _ = _slab([rows[:ROWS]])
+        w = FORMATS.get("gguf").dequantize(spec).astype(np.float64)
+        x = bf16_to_f32(f32_to_bf16(rng.standard_normal((t, K)).astype(np.float32)))
+        got = _run_typed(dev, data, ROWS, t, tt, x)
+        ref = x.astype(np.float64) @ w.T
+        err = np.abs(got - ref).max() / np.abs(ref).max()
+        cos = float((got.ravel() @ ref.ravel()) / (np.linalg.norm(got) * np.linalg.norm(ref)))
+        tol = 5e-3 if t <= 8 else 1.5e-2                                       # gguf_mm: half weight tiles
+        assert err < tol and cos > 0.9999, (ROW_TYPES[tt], t, err, cos)
+
+
+@pytest.mark.parametrize("t", [5, 64])
+def test_typed_kernels_silu_residual_gather(dev, real_rows, t):
+    types = sorted(real_rows)
+    a, b = real_rows[types[0]][:ROWS], real_rows[types[-1]][:ROWS]
+    rng = np.random.default_rng(7)
+    x = bf16_to_f32(f32_to_bf16(rng.standard_normal((t, K)).astype(np.float32)))
+    spec, data, _ = _slab([a, b])                                             # [gate | up], no interleave
+    w = FORMATS.get("gguf").dequantize(spec).astype(np.float64)
+    acc = x.astype(np.float64) @ w.T
+    want = acc[:, :ROWS] / (1 + np.exp(-acc[:, :ROWS])) * acc[:, ROWS:]
+    got = _run_typed(dev, data, ROWS, t, types[0], x, "silu_mul", type_b=types[-1], up_off=ROWS)
+    assert np.abs(got - want).max() / np.abs(want).max() < 2e-2
+    res = bf16_to_f32(f32_to_bf16(rng.standard_normal((t, ROWS)).astype(np.float32)))
+    spec, data, _ = _slab([a])
+    w = FORMATS.get("gguf").dequantize(spec).astype(np.float64)
+    got = _run_typed(dev, data, ROWS, t, types[0], x, "residual", residual=res)
+    want = x.astype(np.float64) @ w.T + res
+    assert np.abs(got - want).max() / np.abs(want).max() < 2e-2
+    heads = np.random.default_rng(3).permutation(K // 128)
+    gather = (heads[:, None] * 128 + np.arange(128)).reshape(-1)
+    spec, data, _ = _slab([a], gather=gather)
+    w = FORMATS.get("gguf").dequantize(spec).astype(np.float64)
+    got = _run_typed(dev, data, ROWS, t, types[0], x)
+    want = x.astype(np.float64) @ w.T
+    assert np.abs(got - want).max() / np.abs(want).max() < 2e-2
+
+
+@pytest.mark.parametrize("mm", [False, True])
+def test_variants_outside_their_row_range_do_nothing(dev, mm):
+    """A predicated variant (T_LO < T ≤ T_HI) must return at once for a step of more rows than it covers: the
+    predicate takes the step's own row count, not the variant's cap (a 1–2-row variant ran whole for an 8-row step,
+    every projection of a verify step two or three times, until 2026-10-15). Its output stays untouched."""
+    from monolith.core import StepStateLayout
+
+    gg = pytest.importorskip("gguf")
+    w = np.random.default_rng(0).standard_normal((32, K)).astype(np.float32) * 0.05
+    rows = GGUFRows(gg.quants.quantize(w, gg.GGMLQuantizationType.Q8_0).reshape(32, -1), Q8_0)
+    _, data, _ = _slab([rows])
+    layout = StepStateLayout()
+    lo, hi = (2, 4) if mm else (0, 2)
+    macros = dict(kernels.gguf_kernel_macros(K, hi, Q8_0, mm=mm), STEP_STATE="1", T_SRC="0", T_LO=str(lo), T_HI=str(hi))
+    src = kernels.gguf_gemv_source().replace(kernels.PRELUDE, kernels.PRELUDE + layout.to_msl() + "\n", 1)
+    lib = nt.Library(dev, src, macros, kernels.MSL_TENSOR_OPS if mm else 0)
+    pipe = nt.Pipeline(lib, "gguf_mm" if mm else "gguf_mv")
+    x = f32_to_bf16(np.ones((8, K), np.float32))
+    for t_step, touched in ((8, False), (hi, True)):
+        y = nt.Buffer(dev, 8 * 32 * 2)
+        y.write(b"\xab" * (8 * 32 * 2), 0)
+        st = nt.Buffer(dev, layout.pack({"t_this_step": t_step}))
+        d = (nt.Dispatch().pipeline(pipe).buffer(0, nt.Buffer(dev, data)).buffer(1, nt.Buffer(dev, np.ones(32, np.float32).tobytes()))
+             .buffer(2, nt.Buffer(dev, x.tobytes())).buffer(3, y).bytes(4, kernels.gguf_params(0, 32, 0, 32, hi)).buffer(15, st))
+        d.grid(1, 1, 1).threadgroup(128) if mm else d.grid(1).threadgroup(256)
+        assert not nt.Queue(dev).run([d]).error
+        assert (y.read(0, 8 * 32 * 2) != b"\xab" * (8 * 32 * 2)) == touched, (t_step, touched)
