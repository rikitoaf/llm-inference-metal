@@ -0,0 +1,185 @@
+"""GGUF quantized matrices kept as llama.cpp stores them (``gguf``): every row of a slab is its tensor's row of GGUF
+blocks, unchanged, and keeps its own ggml type, so a slab may stack parts of different types (a GGUF file picks the
+type per tensor: the q, k, v and gate projections of one layer can be four types). The kernels
+(``kernels/common/gguf_gemv.metal``) read the blocks through llama.cpp's dequantizers; nothing is re-quantized.
+
+Supported row types: F32, F16, BF16, Q8_0, Q2_K … Q6_K, IQ1_S, IQ1_M, IQ2_XXS, IQ2_XS, IQ2_S, IQ3_XXS, IQ3_S, IQ4_XS
+(``ROW_TYPES``). The checkpoint side is ``formats.gguf_checkpoint``: it hands a matrix over as a :class:`GGUFRows`
+(``uint8 [N, row bytes]`` with its ggml type) and, for a matrix whose input columns llama.cpp reordered, the column
+gather the kernel applies to its input instead (``col_gather[i]``: the input index column ``i`` reads).
+
+Pack layout (all little-endian)::
+
+    header   uint32 magic 'GGUF', n, k, gather_offset (0 = no gather)
+    rows     n × uint2 (byte offset of the row from the slab start, ggml type)
+    gather   k / 32 × uint32 (input index of each 32-column group's first column; the groups are contiguous runs),
+             then k / 32 × uint32: the inverse (the stored group holding each run of 32 input columns)
+    data     the rows, each starting on a 16-byte boundary
+
+The oracle (``dequantize``) is llama.cpp's own Python dequantizer (the ``gguf`` package), with the column gather
+undone so the matrix is in the model's column order.
+"""
+
+from __future__ import annotations
+
+import struct
+from typing import Any, Dict, Mapping, Optional, Tuple
+
+import numpy as np
+
+from .base import DequantSpec, Format, PackLayout
+from .blm import PackInfo
+from .registry import register_format
+
+MAGIC = 0x46554747                         # 'GGUF'
+LAYOUT = 2                                 # pack layout revision (2: silu·mul slabs [gate | up], inverse gather runs); in the pack cache key
+HEADER_BYTES = 16
+ROW_ALIGN = 16
+GATHER_RUN = 32
+
+# ggml type ids (ggml.h) of the row types the kernels decode
+F32, F16, Q8_0, Q2_K, Q3_K, Q4_K, Q5_K, Q6_K = 0, 1, 8, 10, 11, 12, 13, 14
+IQ2_XXS, IQ2_XS, IQ3_XXS, IQ1_S, IQ3_S, IQ2_S, IQ4_XS, IQ1_M, BF16 = 16, 17, 18, 19, 21, 22, 23, 29, 30
+ROW_TYPES = {F32: "F32", F16: "F16", BF16: "BF16", Q8_0: "Q8_0", Q2_K: "Q2_K", Q3_K: "Q3_K", Q4_K: "Q4_K", Q5_K: "Q5_K",
+             Q6_K: "Q6_K", IQ1_S: "IQ1_S", IQ1_M: "IQ1_M", IQ2_XXS: "IQ2_XXS", IQ2_XS: "IQ2_XS", IQ2_S: "IQ2_S",
+             IQ3_XXS: "IQ3_XXS", IQ3_S: "IQ3_S", IQ4_XS: "IQ4_XS"}
+# (weights per block, bytes per block): ggml's type traits
+BLOCK = {F32: (1, 4), F16: (1, 2), BF16: (1, 2), Q8_0: (32, 34), Q2_K: (256, 84), Q3_K: (256, 110), Q4_K: (256, 144),
+         Q5_K: (256, 176), Q6_K: (256, 210), IQ2_XXS: (256, 66), IQ2_XS: (256, 74), IQ3_XXS: (256, 98), IQ1_S: (256, 50),
+         IQ3_S: (256, 110), IQ2_S: (256, 82), IQ4_XS: (256, 136), IQ1_M: (256, 56)}
+
+
+def row_bytes(ggml_type: int, k: int) -> int:
+    wpb, bpb = BLOCK[ggml_type]
+    if k % wpb:
+        raise ValueError(f"gguf: K = {k} is not a multiple of {ROW_TYPES[ggml_type]}'s block of {wpb}")
+    return k // wpb * bpb
+
+
+class GGUFRows(np.ndarray):
+    """``uint8 [N, row bytes]``: a GGUF matrix's rows, with ``ggml_type`` (and ``col_gather``, or None) riding along
+    through row selection and concatenation of the same type."""
+
+    def __new__(cls, data: np.ndarray, ggml_type: int, col_gather: Optional[np.ndarray] = None) -> "GGUFRows":
+        obj = np.asarray(data, dtype=np.uint8).view(cls)
+        obj.ggml_type = int(ggml_type)
+        obj.col_gather = col_gather
+        return obj
+
+    def __array_finalize__(self, obj: Any) -> None:
+        self.ggml_type = getattr(obj, "ggml_type", -1)
+        self.col_gather = getattr(obj, "col_gather", None)
+
+
+def _dequantize_rows(data: np.ndarray, ggml_type: int, k: int) -> np.ndarray:
+    if ggml_type == F32:
+        return np.ascontiguousarray(data).view(np.float32).reshape(-1, k).astype(np.float32)
+    if ggml_type == F16:
+        return np.ascontiguousarray(data).view(np.float16).reshape(-1, k).astype(np.float32)
+    if ggml_type == BF16:
+        return (np.ascontiguousarray(data).view(np.uint16).astype(np.uint32) << 16).view(np.float32).reshape(-1, k)
+    from gguf import GGMLQuantizationType, quants                                   # llama.cpp's reference dequantizers
+    return np.asarray(quants.dequantize(np.ascontiguousarray(data), GGMLQuantizationType(ggml_type)), dtype=np.float32).reshape(-1, k)
+
+
+def _gather_runs(col_gather: Optional[np.ndarray], k: int) -> Optional[np.ndarray]:
+    """The per-32-column run starts of a column gather (each run must be 32 contiguous input columns)."""
+    if col_gather is None:
+        return None
+    g = np.asarray(col_gather, dtype=np.int64)
+    if g.shape != (k,) or sorted(g.tolist()) != list(range(k)):
+        raise ValueError("gguf: col_gather is not a permutation of the K input columns")
+    starts = g[::GATHER_RUN]
+    if not np.array_equal(g, (starts[:, None] + np.arange(GATHER_RUN)).reshape(-1)):
+        raise ValueError("gguf: col_gather must move whole runs of 32 contiguous columns")
+    return starts.astype(np.uint32)
+
+
+@register_format("gguf")
+class GGUFFormat(Format):
+    bytes_per_weight = 0.5                   # nominal: the rows' own types decide (a slab's nbytes is exact)
+    weights_per_word = 0
+    pack_k_multiple = 256
+
+    def unpack(self, tensors: Mapping[str, Any], *, shape: Tuple[int, int]) -> DequantSpec:
+        n, k = shape
+        w = tensors["weight"]
+        if not isinstance(w, GGUFRows) or w.ggml_type not in ROW_TYPES:
+            raise ValueError("gguf: the weight must be GGUFRows of a supported ggml type (formats.gguf_checkpoint)")
+        if w.shape != (n, row_bytes(w.ggml_type, k)):
+            raise ValueError(f"gguf: rows {w.shape} do not match [{n}, {row_bytes(w.ggml_type, k)}] for {ROW_TYPES[w.ggml_type]}")
+        rows = np.empty(n, dtype=object)
+        for i in range(n):
+            rows[i] = np.asarray(w[i]).tobytes()
+        params: Dict[str, Any] = {}
+        if w.col_gather is not None:
+            params["col_gather"] = np.asarray(w.col_gather, dtype=np.int64)
+        return DequantSpec("gguf", (n, k), {"rows": rows, "types": np.full(n, w.ggml_type, dtype=np.int32)}, params)
+
+    def dequantize(self, spec: DequantSpec) -> np.ndarray:
+        n, k = spec.shape
+        rows, types = spec.tensors["rows"], np.asarray(spec.tensors["types"])
+        out = np.empty((n, k), dtype=np.float32)
+        for t in np.unique(types):
+            idx = np.nonzero(types == t)[0]
+            data = np.frombuffer(b"".join(rows[i] for i in idx), dtype=np.uint8).reshape(len(idx), -1)
+            out[idx] = _dequantize_rows(data, int(t), k)
+        gather = spec.params.get("col_gather")
+        if gather is not None:                                  # column i reads input gather[i]: back to the model's order
+            model = np.empty_like(out)
+            model[:, np.asarray(gather)] = out
+            out = model
+        return out
+
+    def pack(self, spec: DequantSpec, layout: PackLayout) -> Tuple[bytes, PackInfo]:
+        n, k = spec.shape
+        rows, types = spec.tensors["rows"], np.asarray(spec.tensors["types"])
+        runs = _gather_runs(spec.params.get("col_gather"), k)
+        table_end = HEADER_BYTES + 8 * n
+        gather_off = table_end if runs is not None else 0
+        if runs is not None:
+            inverse = np.empty_like(runs)
+            inverse[runs // GATHER_RUN] = np.arange(len(runs), dtype=np.uint32)
+            runs = np.concatenate([runs, inverse])
+        data_off = table_end + (runs.nbytes if runs is not None else 0)
+        data_off += (-data_off) % ROW_ALIGN
+        desc = np.zeros((n, 2), dtype=np.uint32)
+        chunks, pos = [], data_off
+        for i in range(n):
+            t = int(types[i])
+            if len(rows[i]) != row_bytes(t, k):
+                raise ValueError(f"gguf: row {i} has {len(rows[i])} bytes, {ROW_TYPES[t]} needs {row_bytes(t, k)}")
+            desc[i] = (pos, t)
+            pad = (-len(rows[i])) % ROW_ALIGN
+            chunks.append(rows[i] + b"\0" * pad)
+            pos += len(rows[i]) + pad
+        if pos >= 1 << 32:
+            raise ValueError("gguf: a slab above 4 GiB (32-bit row offsets)")
+        head = struct.pack("<4I", MAGIC, n, k, gather_off) + desc.tobytes()
+        head += runs.tobytes() if runs is not None else b""
+        head += b"\0" * (data_off - len(head))
+        data = head + b"".join(chunks)
+        n_blocks = -(-n // layout.rows)
+        info = PackInfo("gguf", n, k, layout.rows, 0, 0, 0, layout.lane_order, n_blocks)
+        return data, info
+
+    def unpack_pack(self, data: bytes, info: PackInfo) -> DequantSpec:
+        magic, n, k, gather_off = struct.unpack_from("<4I", data, 0)
+        if magic != MAGIC:
+            raise ValueError("gguf: not a gguf slab")
+        desc = np.frombuffer(data, dtype=np.uint32, count=2 * n, offset=HEADER_BYTES).reshape(n, 2)
+        rows = np.empty(n, dtype=object)
+        for i in range(n):
+            off, t = int(desc[i, 0]), int(desc[i, 1])
+            rows[i] = bytes(data[off: off + row_bytes(t, k)])
+        params: Dict[str, Any] = {}
+        if gather_off:
+            starts = np.frombuffer(data, dtype=np.uint32, count=k // GATHER_RUN, offset=gather_off).astype(np.int64)
+            params["col_gather"] = (starts[:, None] + np.arange(GATHER_RUN)).reshape(-1)
+        return DequantSpec("gguf", (n, k), {"rows": rows, "types": desc[:, 1].astype(np.int32)}, params)
+
+
+def slab_types(data: bytes) -> np.ndarray:
+    """The ggml type of every row of a packed gguf slab (emitter checks and tests)."""
+    _, n, _, _ = struct.unpack_from("<4I", data, 0)
+    return np.frombuffer(data, dtype=np.uint32, count=2 * n, offset=HEADER_BYTES).reshape(n, 2)[:, 1].copy()
