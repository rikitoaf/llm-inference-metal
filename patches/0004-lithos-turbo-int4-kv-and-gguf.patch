+++ b/kernels/common/gqa_turbo_mma.metal
@@ -0,0 +1,380 @@
+// gqa_decode_mma over a turbo-int4 K/V cache (TURBO_INT4; the helpers are in gqa_common.metal), with bounded partitions:
+// the target's matrix-accelerator attention (gqa_decode_mma.metal's structure: one threadgroup per (KV head, key
+// partition, 16-query tile)) where a partition holds as many KN-key tiles as keep the partial count within the
+// workspace (BOUNDED_CHUNK: pick_chunk's ch = KN · ⌈ctx / (KN · n_chunks_max)⌉, the merge's rule too). A threadgroup
+// walks its partition's tiles with an online softmax — the running maximum and denominator per query row in
+// threadgroup memory, the value accumulator rescaled before each tile's P·V — and writes one (o, m, d) partial, the
+// gqa_merge contract. Up to KN · n_chunks_max keys every partition is one tile, as in gqa_decode_mma.
+//
+// Turbo-int4: the cached keys and values are dequantized from their rows while they are staged, the step's own ones
+// quantized, appended once (the r0 = 0 blocks) and staged as their dequantized values, the queries rotated after
+// RoPE; gqa_merge (TURBO_INT4) rotates the folded output back.
+//
+// DRAFT (a DSpark drafter's block attention, gqa_decode.metal's DRAFT contract): the keys are the drafter's context
+// cache [0, position) (turbo-int4 rows), the n_new injected context positions from the feature projection (buffer 11,
+// row stride pad1: normed, RoPE'd, quantized and appended by the r0 = 0 blocks) and the block's own γ rows (normed,
+// RoPE'd and rotated, never cached: used as they are); the queries are the block, unmasked. No LM_MODE or DIRECT_KV form.
+// Macros: D, CH (= KN, keys per tile), MMA_SG, MMA_PROB_FP16, STEP_STATE, DRAFT.
+#include <MetalPerformancePrimitives/MetalPerformancePrimitives.h>
+using namespace mpp::tensor_ops;
+#if !TURBO_INT4 || LM_MODE || DIRECT_KV || !BOUNDED_CHUNK
+#error "gqa_turbo_mma: turbo-int4 attention with bounded partitions (target or DSpark drafter) only"
+#endif
+#ifndef MMA_SG
+#define MMA_SG 8
+#endif
+#ifndef MMA_PROB_FP16
+#define MMA_PROB_FP16 0
+#endif
+#define QM 16
+#define KN CH
+using GqaTG = tensor<threadgroup bfloat, dextents<int, 2>, tensor_inline>;
+#if MMA_PROB_FP16
+using GqaProbability = half;
+#else
+using GqaProbability = bfloat;
+#endif
+using GqaProbTG = tensor<threadgroup GqaProbability, dextents<int, 2>, tensor_inline>;
+using GqaFloatTG = tensor<threadgroup float, dextents<int, 2>, tensor_inline>;
+constexpr constant auto score_desc = matmul2d_descriptor(QM, KN, D, false, true, false, matmul2d_descriptor::mode::multiply_accumulate);
+constexpr constant auto value_desc = matmul2d_descriptor(QM, D, KN, false, false, false, matmul2d_descriptor::mode::multiply_accumulate);
+
+kernel void gqa_decode_mma(device const ushort* qkvg [[buffer(0)]], device uchar* k_cache [[buffer(1)]], device uchar* v_cache [[buffer(2)]],
+                          device const ushort* cos_t [[buffer(3)]], device const ushort* sin_t [[buffer(4)]],
+                          device const float* q_norm [[buffer(5)]], device const float* k_norm [[buffer(6)]],
+                          device float* part_o [[buffer(7)]], device float* part_md [[buffer(8)]], constant GqaParams& p [[buffer(9)]],
+#if DRAFT
+                          device const ushort* kvp [[buffer(11)]],
+#endif
+#if STEP_STATE
+                          device const StepState* st [[buffer(15)]],
+#endif
+                          uint tgid [[threadgroup_position_in_grid]], uint lane [[thread_index_in_simdgroup]],
+                          uint sgi [[simdgroup_index_in_threadgroup]]) {
+  threadgroup bfloat query[QM * D];                    // kept for every tile of the partition
+  threadgroup float score[QM * KN];
+  threadgroup bfloat kv_tile[KN * D];
+  threadgroup GqaProbability prob[QM * KN];
+  threadgroup float m_run[QM], d_run[QM], alpha[QM];
+#if STEP_STATE
+  if (st->done) return;
+#if DRAFT
+  const uint T = p.t_active, position = st->drafter_ctx_len, n_new = st->n_inject;
+#else
+  const uint T = st->t_this_step, position = st->position, n_new = 0u;
+#endif
+#else
+  const uint T = p.t_active, position = p.position;
+#if DRAFT
+  const uint n_new = p.pad0;
+#else
+  const uint n_new = 0u;
+#endif
+#endif
+  if (T == 0u) return;
+  const uint qpos0 = position + n_new;                 // the first query position (DRAFT: after the new context)
+  const uint rows = T * (p.heads / p.kv_heads), rep = p.heads / p.kv_heads;
+  const uint ctx = qpos0 + T;
+  const uint ch = pick_chunk(ctx, p.kv_heads, rep, p.n_sg, p.n_chunks_max);   // keys per partition (a multiple of KN)
+  const uint chunks = (ctx + ch - 1u) / ch, tiles = ch / KN;
+  const uint groups = (rows + QM - 1u) / QM;
+  for (uint block = tgid; block < p.kv_heads * chunks * groups; block += p.n_sg) {
+    const uint j = block / (chunks * groups), c = (block / groups) % chunks, r0 = (block % groups) * QM;
+    for (uint r = sgi; r < QM; r += MMA_SG) {
+      float q[DL];
+      const uint row = r0 + r, t = row / rep, h = j * rep + row % rep;
+      for (uint e = 0; e < DL; e++) q[e] = 0.0f;
+      if (row < rows) {
+        load_dl(qkvg + t * p.in_stride + p.q_off + h * D + lane * DL, q);
+        norm_rope(q, q_norm, cos_t + (qpos0 + t) * D, sin_t + (qpos0 + t) * D, p.eps, lane);
+        turbo_rotate(q, lane, false);
+      }
+      for (uint e = 0; e < DL; e++) query[r * D + lane * DL + e] = bfloat(q[e]);
+      if (lane == 0) { m_run[r] = -INFINITY; d_run[r] = 0.0f; }
+    }
+    matmul2d<value_desc, execution_simdgroups<MMA_SG>> value_op;
+    GqaProbTG pt(prob, dextents<int, 2>(KN, QM));
+    GqaTG vt(kv_tile, dextents<int, 2>(D, KN));
+    auto out = value_op.get_destination_cooperative_tensor<GqaProbTG, decltype(vt), float>();
+    for (uint16_t i = 0; i < out.get_capacity(); i++) if (out.is_valid_element(i)) out[i] = 0.0f;
+    const uint k_first = c * ch, k_end = min(k_first + ch, ctx);
+    for (uint tt = 0; tt < tiles; tt++) {
+      const uint kt = k_first + tt * KN;
+      if (kt >= k_end) break;
+      // keys of this tile: cached rows dequantized, the step's own normed, RoPE'd, quantized (appended by r0 == 0)
+      for (uint kk = sgi; kk < KN; kk += MMA_SG) {
+        const uint key = kt + kk;
+        float k[DL];
+        for (uint e = 0; e < DL; e++) k[e] = 0.0f;
+        if (key < position) {
+          turbo_load(k_cache + (key * p.kv_heads + j) * KV_ROW, lane, k);
+#if DRAFT
+        } else if (key < qpos0) {                        // an injected context position: quantized, appended once
+          const uint tk = key - position;
+          load_dl(kvp + tk * p.pad1 + j * D + lane * DL, k);
+          norm_rope(k, k_norm, cos_t + key * D, sin_t + key * D, p.eps, lane);
+          turbo_fresh(k, k_cache + (key * p.kv_heads + j) * KV_ROW, lane, r0 == 0);
+          if (r0 == 0) {
+            float v[DL];
+            load_dl(kvp + tk * p.pad1 + p.kv_heads * D + j * D + lane * DL, v);
+            turbo_fresh(v, v_cache + (key * p.kv_heads + j) * KV_ROW, lane, true);
+          }
+        } else if (key < ctx) {                          // the block's own key: never cached, used as it is
+          load_dl(qkvg + (key - qpos0) * p.in_stride + p.k_off + j * D + lane * DL, k);
+          norm_rope(k, k_norm, cos_t + key * D, sin_t + key * D, p.eps, lane);
+          turbo_rotate(k, lane, false);
+#else
+        } else if (key < ctx) {
+          const uint tk = key - position;
+          load_dl(qkvg + tk * p.in_stride + p.k_off + j * D + lane * DL, k);
+          norm_rope(k, k_norm, cos_t + key * D, sin_t + key * D, p.eps, lane);
+          turbo_fresh(k, k_cache + (key * p.kv_heads + j) * KV_ROW, lane, r0 == 0);
+          if (r0 == 0) {
+            float v[DL];
+            load_dl(qkvg + tk * p.in_stride + p.v_off + j * D + lane * DL, v);
+            turbo_fresh(v, v_cache + (key * p.kv_heads + j) * KV_ROW, lane, true);
+          }
+#endif
+        }
+        for (uint e = 0; e < DL; e++) kv_tile[kk * D + lane * DL + e] = bfloat(k[e]);
+      }
+      threadgroup_barrier(mem_flags::mem_threadgroup);
+      matmul2d<score_desc, execution_simdgroups<MMA_SG>> score_op;
+      GqaTG qt(query, dextents<int, 2>(D, QM));
+      GqaTG kt_t(kv_tile, dextents<int, 2>(D, KN));
+      auto scores = score_op.get_destination_cooperative_tensor<GqaTG, decltype(kt_t), float>();
+      for (uint16_t i = 0; i < scores.get_capacity(); i++) if (scores.is_valid_element(i)) scores[i] = 0.0f;
+      score_op.run(qt, kt_t, scores);
+      threadgroup_barrier(mem_flags::mem_threadgroup);
+      GqaFloatTG score_tile(score, dextents<int, 2>(KN, QM));
+      scores.store(score_tile);
+      threadgroup_barrier(mem_flags::mem_threadgroup);
+      // online softmax: the tile's probabilities against the running maximum; alpha rescales what came before
+      for (uint r = sgi; r < QM; r += MMA_SG) {
+        const uint row = r0 + r, t = row / rep;
+        float sc[KN / 32];
+        for (uint u = 0; u < KN / 32; u++) {
+          const uint key = kt + lane + u * 32;
+#if DRAFT
+          sc[u] = row < rows && key < ctx ? round_bf16(round_bf16(score[r * KN + lane + u * 32]) * p.scaling) : -INFINITY;   // unmasked
+#else
+          sc[u] = row < rows && key < ctx && key <= position + t ? round_bf16(round_bf16(score[r * KN + lane + u * 32]) * p.scaling) : -INFINITY;
+#endif
+        }
+        float local_max = -INFINITY;
+        for (uint u = 0; u < KN / 32; u++) local_max = max(local_max, sc[u]);
+        const float m_old = m_run[r], m_new = max(m_old, simd_max(local_max));
+        const float a = (m_new == -INFINITY) ? 1.0f : exp(m_old - m_new);   // exp(−inf) = 0 on the first live tile
+        float den = 0.0f;
+        for (uint u = 0; u < KN / 32; u++) {
+          const float pr = sc[u] == -INFINITY ? 0.0f : exp(sc[u] - m_new);
+          prob[r * KN + lane + u * 32] = GqaProbability(pr);
+          den += pr;
+        }
+        den = simd_sum(den);
+        if (lane == 0) { alpha[r] = a; m_run[r] = m_new; d_run[r] = d_run[r] * a + den; }
+      }
+      // values of this tile
+      for (uint kk = sgi; kk < KN; kk += MMA_SG) {
+        const uint key = kt + kk;
+        float v[DL];
+        for (uint e = 0; e < DL; e++) v[e] = 0.0f;
+        if (key < position) turbo_load(v_cache + (key * p.kv_heads + j) * KV_ROW, lane, v);
+#if DRAFT
+        else if (key < qpos0) {
+          load_dl(kvp + (key - position) * p.pad1 + p.kv_heads * D + j * D + lane * DL, v);
+          turbo_fresh(v, v_cache, lane, false);
+        } else if (key < ctx) {
+          load_dl(qkvg + (key - qpos0) * p.in_stride + p.v_off + j * D + lane * DL, v);
+          turbo_rotate(v, lane, false);
+        }
+#else
+        else if (key < ctx) {
+          load_dl(qkvg + (key - position) * p.in_stride + p.v_off + j * D + lane * DL, v);
+          turbo_fresh(v, v_cache, lane, false);
+        }
+#endif
+        for (uint e = 0; e < DL; e++) kv_tile[kk * D + lane * DL + e] = bfloat(v[e]);
+      }
+      threadgroup_barrier(mem_flags::mem_threadgroup);
+      for (uint16_t i = 0; i < out.get_capacity(); i++) if (out.is_valid_element(i)) {
+        auto idx = out.get_multidimensional_index(i);                        // [0]: dim, [1]: query row of the tile
+        out[i] *= alpha[idx[1]];
+      }
+      value_op.run(pt, vt, out);
+      threadgroup_barrier(mem_flags::mem_threadgroup);
+    }
+    for (uint r = sgi; r < QM; r += MMA_SG) {
+      const uint row = r0 + r;
+      if (lane == 0 && row < rows) {
+        const uint base = ((j * p.n_chunks_max + c) * p.rows_max + row) * 2;
+        part_md[base] = m_run[r]; part_md[base + 1] = d_run[r];
+      }
+    }
+    for (uint16_t i = 0; i < out.get_capacity(); i++) if (out.is_valid_element(i)) {
+      auto idx = out.get_multidimensional_index(i);
+      const uint row = r0 + idx[1], dim = idx[0];
+      if (row < rows) part_o[((j * p.n_chunks_max + c) * p.rows_max + row) * D + dim] = out[i];
+    }
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+  }
+}
+
+// ---- PREPARED (the target only): queries prepared once, every key and value read from the cache --------------------
+// gqa_turbo_prepare writes each query row normed, RoPE'd and rotated into qprep ([kv head][row][D] BF16, rows padded to
+// QP) and appends the step's keys and values to the cache (quantized); gqa_turbo_mma_q then reads every key and value
+// from the cache (the step's own as the dequantized rows a later pass reads) and takes QP query rows per block, so a
+// staged K/V tile serves QP rows instead of 16 (a 128-row prompt chunk: 768 rows, 12 blocks instead of 48 per tile).
+#if !DRAFT
+#ifndef QP
+#define QP 64
+#endif
+kernel void gqa_turbo_prepare(device const ushort* qkvg [[buffer(0)]], device uchar* k_cache [[buffer(1)]], device uchar* v_cache [[buffer(2)]],
+                              device const ushort* cos_t [[buffer(3)]], device const ushort* sin_t [[buffer(4)]],
+                              device const float* q_norm [[buffer(5)]], device const float* k_norm [[buffer(6)]],
+                              constant GqaParams& p [[buffer(9)]], device bfloat* qprep [[buffer(10)]],
+#if STEP_STATE
+                              device const StepState* st [[buffer(15)]],
+#endif
+                              uint gid [[thread_position_in_grid]], uint lane [[thread_index_in_simdgroup]], uint sw [[threads_per_simdgroup]]) {
+#if STEP_STATE
+  if (st->done) return;
+  const uint T = st->t_this_step, position = st->position;
+#else
+  const uint T = p.t_active, position = p.position;
+#endif
+  const uint idx = gid / sw, rep = p.heads / p.kv_heads, padded = (p.rows_max + QP - 1u) / QP * QP;
+  if (idx < T * p.heads) {                                       // query row (t, h) → qprep[j][t·rep + h % rep]
+    const uint t = idx / p.heads, h = idx % p.heads, j = h / rep;
+    float q[DL];
+    load_dl(qkvg + t * p.in_stride + p.q_off + h * D + lane * DL, q);
+    norm_rope(q, q_norm, cos_t + (position + t) * D, sin_t + (position + t) * D, p.eps, lane);
+    turbo_rotate(q, lane, false);
+    device bfloat* dst = qprep + ((ulong)j * padded + t * rep + h % rep) * D + lane * DL;
+    for (uint e = 0; e < DL; e++) dst[e] = bfloat(q[e]);
+  } else if (idx < T * p.heads + T * p.kv_heads) {               // key and value (t, j): appended, quantized
+    const uint i = idx - T * p.heads, t = i / p.kv_heads, j = i % p.kv_heads, key = position + t;
+    float k[DL], v[DL];
+    load_dl(qkvg + t * p.in_stride + p.k_off + j * D + lane * DL, k);
+    norm_rope(k, k_norm, cos_t + key * D, sin_t + key * D, p.eps, lane);
+    turbo_fresh(k, k_cache + (key * p.kv_heads + j) * KV_ROW, lane, true);
+    load_dl(qkvg + t * p.in_stride + p.v_off + j * D + lane * DL, v);
+    turbo_fresh(v, v_cache + (key * p.kv_heads + j) * KV_ROW, lane, true);
+  }
+}
+
+using GqaDevTG = tensor<device bfloat, dextents<int, 2>, tensor_inline>;
+constexpr constant auto score_desc_q = matmul2d_descriptor(QP, KN, D, false, true, false, matmul2d_descriptor::mode::multiply_accumulate);
+constexpr constant auto value_desc_q = matmul2d_descriptor(QP, D, KN, false, false, false, matmul2d_descriptor::mode::multiply_accumulate);
+
+kernel void gqa_turbo_mma_q(device const uchar* k_cache [[buffer(1)]], device const uchar* v_cache [[buffer(2)]],
+                            device float* part_o [[buffer(7)]], device float* part_md [[buffer(8)]], constant GqaParams& p [[buffer(9)]],
+                            device bfloat* qprep [[buffer(10)]],
+#if STEP_STATE
+                            device const StepState* st [[buffer(15)]],
+#endif
+                            uint tgid [[threadgroup_position_in_grid]], uint lane [[thread_index_in_simdgroup]],
+                            uint sgi [[simdgroup_index_in_threadgroup]]) {
+  // the scores, BF16-rounded as the reference's matmul output, then overwritten in place by the probabilities (each
+  // lane reads its own elements before writing them): a third of the threadgroup memory of separate FP32 scores
+  threadgroup union { bfloat score[QP * KN]; GqaProbability prob[QP * KN]; } sp;
+  threadgroup bfloat kv_tile[KN * D];
+  threadgroup float m_run[QP], d_run[QP], alpha[QP];
+#if STEP_STATE
+  if (st->done) return;
+  const uint T = st->t_this_step, position = st->position;
+#else
+  const uint T = p.t_active, position = p.position;
+#endif
+  if (T == 0u) return;
+  const uint rows = T * (p.heads / p.kv_heads), rep = p.heads / p.kv_heads;
+  const uint padded = (p.rows_max + QP - 1u) / QP * QP;
+  const uint ctx = position + T;
+  const uint ch = pick_chunk(ctx, p.kv_heads, rep, p.n_sg, p.n_chunks_max);
+  const uint chunks = (ctx + ch - 1u) / ch, tiles = ch / KN;
+  const uint groups = (rows + QP - 1u) / QP;
+  for (uint block = tgid; block < p.kv_heads * chunks * groups; block += p.n_sg) {
+    const uint j = block / (chunks * groups), c = (block / groups) % chunks, r0 = (block % groups) * QP;
+    // a partition entirely after this group's last query is masked for all its rows: write empty partials
+    const uint k_first = c * ch, k_end = min(k_first + ch, ctx);
