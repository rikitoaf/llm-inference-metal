index 0000000..071b587
--- /dev/null
+++ b/monolith/formats/gguf_checkpoint.py
@@ -0,0 +1,202 @@
+"""A llama.cpp GGUF file read as an HF checkpoint, for the architectures a package registers an adapter for
+(:func:`register_gguf_arch`; the model packages and drafters own their names and conventions).
+
+``prepare_gguf(file, dir)`` writes a checkpoint directory: ``config.json`` (the HF config, from the GGUF's metadata, by
+the adapter), the tokenizer files when the adapter wants them (copied from an HF tokenizer directory — the one Splash
+keeps for the model, or ``tokenizer_dir`` — and checked token by token against the GGUF's vocabulary) and ``gguf.json``
+(the file it reads). Every reader of a package's checkpoints (``SafetensorsDir``) then opens that directory as a
+:class:`GGUFCheckpoint`, which serves each tensor under the HF name the adapter gives it:
+
+* a matrix (rule ``matrix``) as :class:`formats.gguf.GGUFRows` — format ``gguf``, its blocks untouched; whole rows may
+  be selected (``rows``: ``hf[r] = gguf[rows[r]]``) and an input column gather attached (``gather``) for columns a
+  conversion reordered inside the blocks;
+* a small tensor as FP32 (rule ``f32``, through the rule's ``value`` map), as BF16 of a given shape (``bf16``) or as a
+  ``[1, n]`` row (``row``).
+"""
+
+from __future__ import annotations
+
+import json
+import shutil
+from dataclasses import dataclass, field
+from pathlib import Path
+from typing import Any, Callable, Dict, Iterator, List, Optional, Tuple
+
+import numpy as np
+
+from .fp import f32_to_bf16
+from .gguf import BF16, F16, F32, ROW_TYPES, GGUFRows
+
+MANIFEST = "gguf.json"
+TOKENIZER_FILES = ("tokenizer.json", "tokenizer_config.json", "chat_template.jinja", "special_tokens_map.json")
+
+
+@dataclass
+class Rule:
+    """How one GGUF tensor is served: ``hf`` name, ``kind`` (``matrix`` | ``f32`` | ``bf16`` | ``row``), and for a
+    matrix the row selection and column gather; for ``f32`` / ``bf16`` an optional value map and the served shape."""
+
+    hf: str
+    kind: str = "matrix"
+    rows: Optional[np.ndarray] = None
+    gather: Optional[np.ndarray] = None
+    value: Optional[Callable[[np.ndarray], np.ndarray]] = None
+    shape: Optional[Tuple[int, ...]] = None
+
+
+@dataclass
+class GGUFArch:
+    """An adapter: ``config(reader) → dict`` (the checkpoint's ``config.json``), ``rules(config, tensor names) →
+    {gguf name: Rule}`` (tensors without a rule are ignored), ``tokenizer`` (whether the directory needs one)."""
+
+    config: Callable[[Any], Dict[str, Any]]
+    rules: Callable[[Dict[str, Any], List[str]], Dict[str, Rule]]
+    tokenizer: bool = True
+    extra: Dict[str, Any] = field(default_factory=dict)
+
+
+GGUF_ARCHS: Dict[str, GGUFArch] = {}
+
+
+def register_gguf_arch(name: str, arch: GGUFArch) -> GGUFArch:
+    if name in GGUF_ARCHS:
+        raise ValueError(f"gguf: architecture {name!r} is registered twice")
+    GGUF_ARCHS[name] = arch
+    return arch
+
+
+def gguf_arch(name: str) -> GGUFArch:
+    if name not in GGUF_ARCHS:
+        from .. import models, spec  # noqa: F401  (the packages register their adapters on import)
+    if name not in GGUF_ARCHS:
+        raise ValueError(f"gguf: no adapter for architecture {name!r} (registered: {sorted(GGUF_ARCHS)})")
+    return GGUF_ARCHS[name]
+
+
+@dataclass(frozen=True)
+class GGUFTensorInfo:
+    name: str
+    dtype: str                 # "GGUF" for a matrix; "F32" / "BF16" for the small tensors as the package expects them
+    shape: Tuple[int, ...]
+
+
+def reader(path: str):
+    from gguf import GGUFReader
+    return GGUFReader(path)
+
+
+def field_value(r, key: str, default=None):
+    """A metadata value of the GGUF (``default`` when absent)."""
+    f = r.fields.get(key)
+    return default if f is None else f.contents()
+
+
+def v_head_order(n_k: int, per_k: int, head: int) -> np.ndarray:
+    """llama.cpp's ``_reorder_v_heads`` (convert_hf_to_gguf.py) on indices: ``fwd[i]`` = the grouped-by-K-head (HF)
+    index a tensor stores at tiled position ``i``."""
+    return np.arange(n_k * per_k * head).reshape(n_k, per_k, head).transpose(1, 0, 2).reshape(-1)
+
+
+class GGUFCheckpoint:
+    """The ``SafetensorsDir`` interface (``names``, ``info``, ``get``, ``close``) over a prepared directory."""
+
+    def __init__(self, path: str | Path) -> None:
+        p = Path(path)
+        self.file = json.loads((p / MANIFEST).read_text())["file"]
+        self.r = reader(self.file)
+        self.arch = field_value(self.r, "general.architecture")
+        self.config = json.loads((p / "config.json").read_text())
+        self.tensors = {t.name: t for t in self.r.tensors}
+        rules = gguf_arch(self.arch).rules(self.config, list(self.tensors))
+        self.rules = {rule.hf: (g, rule) for g, rule in rules.items()}
+
+    def names(self) -> List[str]:
+        return sorted(self.rules)
+
+    def info(self, name: str) -> GGUFTensorInfo:
+        g, rule = self.rules[name]
+        shape = tuple(int(x) for x in reversed(self.tensors[g].shape))           # ggml's ne is innermost first
+        if rule.kind == "matrix":
+            return GGUFTensorInfo(name, "GGUF", shape)
+        if rule.kind == "row":
+            return GGUFTensorInfo(name, "BF16" if int(self.tensors[g].tensor_type) == BF16 else "F32", (1,) + shape)
+        return GGUFTensorInfo(name, "BF16" if rule.kind == "bf16" else "F32", rule.shape or shape)
+
+    def get(self, name: str) -> np.ndarray:
+        g, rule = self.rules[name]
+        t = self.tensors[g]
+        data, ttype = np.asarray(t.data), int(t.tensor_type)
+        if rule.kind == "matrix":
+            if ttype not in ROW_TYPES:
+                raise ValueError(f"gguf: {g} has ggml type {t.tensor_type.name}, which the kernels do not decode")
+            rows = data.reshape(data.shape[0], -1).view(np.uint8) if ttype in (F32, F16, BF16) else data
+            if rule.rows is not None:
+                rows = rows[rule.rows]
+            return GGUFRows(np.ascontiguousarray(rows), ttype, rule.gather)
+        if rule.kind == "row":
+            return data.reshape(1, -1) if ttype == BF16 else np.asarray(data, dtype=np.float32).reshape(1, -1)
+        x = np.asarray(data, dtype=np.float32)
+        if rule.value is not None:
+            x = rule.value(x)
+        if rule.kind == "bf16":
+            return f32_to_bf16(np.ascontiguousarray(x).reshape(rule.shape or x.shape))
+        return np.ascontiguousarray(x, dtype=np.float32)
+
+    def __iter__(self) -> Iterator[Tuple[str, np.ndarray]]:
+        for n in self.names():
+            yield n, self.get(n)
+
+    def close(self) -> None:
+        pass
+
+
+# ---- preparing a checkpoint directory ------------------------------------------------------------------------------
+
+def splash_tokenizer_dirs() -> List[Path]:
+    root = Path.home() / "Library/Application Support/Splash/models/.metadata"
+    return sorted(d / "tokenizer" for d in root.glob("*") if (d / "tokenizer/tokenizer.json").is_file()) if root.is_dir() else []
+
+
+def check_tokenizer(r, tok_dir: Path) -> None:
+    """The tokenizer's vocabulary must be the GGUF's, token for token."""
+    tokens = [bytes(x).decode("utf-8") if isinstance(x, (bytes, bytearray)) else str(x) for x in field_value(r, "tokenizer.ggml.tokens")]
+    tj = json.loads((tok_dir / "tokenizer.json").read_text())
+    vocab = dict(tj["model"]["vocab"])
+    for a in tj.get("added_tokens", []):
+        vocab[a["content"]] = a["id"]
+    by_id = {i: s for s, i in vocab.items()}
+    bad = [i for i, s in enumerate(tokens) if i in by_id and by_id[i] != s]
+    if bad or len([i for i in range(len(tokens)) if i in by_id]) < min(len(tokens), len(by_id)) - 8:
+        raise ValueError(f"gguf: the tokenizer in {tok_dir} does not match the GGUF vocabulary ({len(bad)} tokens differ)")
+
+
+def prepare_gguf(gguf_file: str | Path, out_dir: str | Path, *, tokenizer_dir: Optional[str | Path] = None,
+                 tokenizer: bool = True) -> Path:
+    """Write the checkpoint directory for ``gguf_file`` (see the module docstring); returns it. ``tokenizer=False``
+    writes none (synthetic models; an adapter that needs none — a drafter — never writes one)."""
+    gguf_file, out = Path(gguf_file).resolve(), Path(out_dir)
+    r = reader(str(gguf_file))
+    arch = gguf_arch(field_value(r, "general.architecture"))
+    out.mkdir(parents=True, exist_ok=True)
+    (out / "config.json").write_text(json.dumps(arch.config(r), indent=2) + "\n")
+    if tokenizer and arch.tokenizer:
+        for tok in ([Path(tokenizer_dir)] if tokenizer_dir else splash_tokenizer_dirs()):
+            try:
+                check_tokenizer(r, tok)
+            except ValueError:
+                if tokenizer_dir:
+                    raise
+                continue
+            for f in TOKENIZER_FILES:
+                if (tok / f).is_file():
+                    shutil.copyfile(tok / f, out / f)
+            break
+        else:
+            raise ValueError("gguf: no HF tokenizer directory matches this GGUF's vocabulary (pass tokenizer_dir)")
+    stat = gguf_file.stat()
+    (out / MANIFEST).write_text(json.dumps({"file": str(gguf_file), "bytes": stat.st_size, "mtime_ns": stat.st_mtime_ns}, indent=2) + "\n")
+    return out
+
+
+def is_gguf_dir(path: str | Path) -> bool:
+    return (Path(path) / MANIFEST).is_file()
