index 502e608..cfaba53 100644
--- a/monolith/nn/oracle.py
+++ b/monolith/nn/oracle.py
@@ -134,6 +134,85 @@ def attention_step(q: torch.Tensor, k_new: torch.Tensor, v_new: torch.Tensor, k_
     return out
 
 
+# ---- turbo-int4 K/V (GQAAttention kv_format="turbo-int4"; kernels/common/gqa_common.metal) ----------------------
+TURBO_SIGNS_1 = (0xa097d901, 0xa038e573, 0xca2221ff, 0x45093648, 0x290f5046, 0x0de9bed1, 0x012987db, 0xa51d810e)
+TURBO_SIGNS_2 = (0x5c73128a, 0x6cc37310, 0xc8bab385, 0xd9d9ff54, 0x63ee4d71, 0xa2b23130, 0x32884643, 0xb6e6c2f6)
+TURBO_CLIP = 2.7
+
+
+def turbo_rotation(d: int) -> torch.Tensor:
+    """``R = S2 · H · S1 / √d`` (FP32 ``[d, d]``, orthogonal): H the Sylvester Hadamard matrix, S1 / S2 the sign words
+    (element i = bit i % 32 of word i // 32, set = -1)."""
+    def signs(words):
+        return torch.tensor([-1.0 if (words[i >> 5] >> (i & 31)) & 1 else 1.0 for i in range(d)], dtype=torch.float64)
+    idx = torch.arange(d)
+    h = torch.tensor([[(-1.0) ** bin(int(i) & int(j)).count("1") for j in idx] for i in idx], dtype=torch.float64)
+    return (signs(TURBO_SIGNS_2)[:, None] * h * signs(TURBO_SIGNS_1)[None, :] / d ** 0.5).to(F32)
+
+
+def turbo_quantize(x: torch.Tensor) -> Tuple[torch.Tensor, torch.Tensor]:
+    """Rotated rows ``[..., d]`` (FP32) → codes ``[..., d]`` (int, -8..7) and FP32 scales ``[...]``: the step covers
+    min(2.7·rms, max|x|) over 8 levels, the larger side takes the 8th level, the scale is refit by least squares."""
+    x = x.to(F32)
+    pos = x.amax(dim=-1).clamp(min=0.0)
+    neg = (-x).amax(dim=-1).clamp(min=0.0)
+    rms = (x * x).mean(dim=-1).sqrt()
+    half = torch.minimum(TURBO_CLIP * rms, torch.maximum(pos, neg)) * 0.125
+    step = torch.where(pos > neg, -half, half)
+    inv = torch.where(half > 0, 1.0 / step, torch.zeros_like(step))
+    codes = torch.round(x * inv[..., None]).clamp(-8, 7)
+    cc = (codes * codes).sum(dim=-1)
+    scale = torch.where(cc > 0, (x * codes).sum(dim=-1) / cc, torch.zeros_like(cc))
+    return codes.to(torch.int32), scale
+
+
+def turbo_pack(codes: torch.Tensor, scale: torch.Tensor) -> torch.Tensor:
+    """Codes ``[..., d]`` and scales ``[...]`` → cache rows ``[..., d / 2 + 4]`` uint8 (element 2i in the low nibble of
+    byte i, then the FP32 scale's little-endian bytes)."""
+    c = (codes & 0xF).to(torch.uint8)
+    nib = c[..., 0::2] | (c[..., 1::2] << 4)
+    sb = scale.to(F32).contiguous().view(torch.uint8).reshape(*scale.shape, 4)
+    return torch.cat([nib, sb], dim=-1)
+
+
+def turbo_unpack(rows: torch.Tensor) -> torch.Tensor:
+    """Cache rows ``[..., d / 2 + 4]`` uint8 → the dequantized rotated vectors ``[..., d]`` FP32."""
+    nib = rows[..., :-4].to(torch.int32)
+    lo, hi = nib & 0xF, nib >> 4
+    codes = torch.stack([lo, hi], dim=-1).flatten(-2)
+    codes = torch.where(codes >= 8, codes - 16, codes).to(F32)
+    scale = rows[..., -4:].contiguous().view(F32)                               # [..., 1]
+    return codes * scale
+
+
+def turbo_attention_step(q: torch.Tensor, k_new: torch.Tensor, v_new: torch.Tensor, k_cache: torch.Tensor,
+                         v_cache: torch.Tensor, pos: int, scaling: float, key_perm: Optional[torch.Tensor] = None) -> torch.Tensor:
+    """:func:`attention_step` over turbo-int4 caches (``[ctx_max, Hkv, d / 2 + 4]`` uint8, updated in place): the new
+    keys and values are rotated, quantized and appended, the queries rotated, the scores and ``P·V`` taken in the
+    rotated space against the dequantized rows (the step's own rows included), and the output rotated back. ``key_perm``: the head-dim order the
+    kernel holds queries and keys in (the load-time RoPE permutation), so the cached key codes are the kernel's."""
+    t, h, d = q.shape
+    hkv = k_new.shape[1]
+    r = turbo_rotation(d).to(q.device)
+    if key_perm is not None:
