+"""The turbo-int4 K/V cache contract without a GPU: state entries, format validation, the emitted kernels (TURBO_INT4
+on the v1 core where the chip's policy picks v1, v2 or v3, on the turbo matrix core with prepared queries where it
+picks the matrix attention, never its direct or adaptive forms), and the oracle's rotation and row packing."""
+import copy
+import sys
+from pathlib import Path
+
+import pytest
+
+sys.path.insert(0, str(Path(__file__).resolve().parent))
+import test_nn_lowering  # noqa: E402
+from monolith.formats import PackLayout
+from monolith.models.qwen3_5 import Qwen3_5Model
+from monolith.nn import GQAAttention, KV_FORMATS, set_kv_format
+from monolith.nn.pack_plan import pack_model
+from monolith.packs import PackFile
+
+
+def test_state_entries_and_validation():
+    a = GQAAttention(64, 8, 2, 256, 64, 1e4, 1e-6, hf_prefix="x.", prefix="l.", max_context=100, kv_format="turbo-int4")
+    assert [(e.name, e.shape, e.dtype.short) for e in a.state_entries()] == [
+        ("l.k_cache", (100, 2, 132), "u8"), ("l.v_cache", (100, 2, 132), "u8")]
+    bf = GQAAttention(64, 8, 2, 256, 64, 1e4, 1e-6, hf_prefix="x.", prefix="l.", max_context=100)
+    assert bf.kv_format == "bf16" and bf.state_entries()[0].shape == (100, 2, 256)
+    # 132 bytes against BF16's 512 per (token, kv head)
+    assert 2 * 256 / 132 > 3.8
+    with pytest.raises(ValueError, match="head_dim"):
+        GQAAttention(64, 8, 2, 32, 32, 1e4, 1e-6, hf_prefix="x.", max_context=8, kv_format="turbo-int4")
+    with pytest.raises(ValueError, match="kv_format"):
+        bf.set_kv_format("int8")
+    assert KV_FORMATS == ("bf16", "turbo-int4")
+
+
+@pytest.mark.parametrize("attention,accelerator,core", [("v1", "off", "gqa_decode"), ("v3", "off", "gqa_decode"),
+                                                      ("v1", "on", "gqa_decode"), ("v2", "on", "gqa_decode"),
+                                                      ("v3", "on", "gqa_turbo_mma_q"), ("auto", "on", "gqa_turbo_mma_q"),
+                                                      ("mma", "on", "gqa_turbo_mma_q"), ("mma-direct", "on", "gqa_turbo_mma_q")])
+def test_emits_turbo_kernels_under_every_attention_policy(tmp_path, attention, accelerator, core):
+    from monolith.compiler import compile_program
+    from monolith.core.profile import Profile
+
+    saved = copy.deepcopy(test_nn_lowering.CFG)
+    test_nn_lowering.CFG["text_config"]["head_dim"] = 128
+    try:
+        test_nn_lowering._checkpoint(tmp_path)
+    finally:
+        test_nn_lowering.CFG.clear()
+        test_nn_lowering.CFG.update(saved)
+    m = Qwen3_5Model.from_checkpoint(str(tmp_path), max_context=64)
+    pack_model(m, str(tmp_path), str(tmp_path / "pack"), PackLayout(rows=16))
+    assert set_kv_format(m, "turbo-int4") == 1
+    prof = Profile.from_dict("p", {"gpu_cores": 16, "nominal_gbps": 307.0, "engine": {"family": "Apple10", "lane_order": "interleaved16"}})
+    prog = compile_program(m, PackFile(tmp_path / "pack"), prof, t=8, eos=7, passes=(), attention=attention, accelerator=accelerator)
+    attn = [prog.kernels[o.kernel] for o in prog.ops if prog.kernels[o.kernel].function.startswith("gqa_")]
+    assert sorted(k.function for k in attn) == sorted([core, "gqa_merge"] + (["gqa_turbo_prepare"] if core == "gqa_turbo_mma_q" else []))
+    assert all(k.macros.get("TURBO_INT4") == "1" for k in attn)
+    assert all(k.macros.get("DIRECT_KV", "0") == "0" and k.macros.get("ADAPTIVE_CHUNK", "0") == "0" for k in attn)
+    assert prog.buffers["layers.1.self_attn.k_cache"].nbytes == 64 * 2 * (128 // 2 + 4)
+
+
+def test_oracle_rotation_and_rows():
+    torch = pytest.importorskip("torch")
+    from monolith.nn import oracle
+
+    for d in (64, 128, 256):
+        r = oracle.turbo_rotation(d)
+        assert torch.allclose(r @ r.T, torch.eye(d), atol=1e-5)
+    x = torch.randn(5, 3, 256) @ oracle.turbo_rotation(256).T
+    codes, scale = oracle.turbo_quantize(x)
+    assert codes.min() >= -8 and codes.max() <= 7 and (codes == -8).any() | (codes == 7).any()
+    rows = oracle.turbo_pack(codes, scale)
+    assert rows.dtype == torch.uint8 and rows.shape == (5, 3, 132)
+    deq = oracle.turbo_unpack(rows)
+    assert torch.equal(deq, codes.float() * scale[..., None])
+    err = ((deq - x).norm(dim=-1) / x.norm(dim=-1)).mean()
+    assert err < 0.11, err                                                   # ~0.10 for Gaussian rows (Splash: 0.096-0.102)
+    lsq = (x * codes).sum(-1) / (codes * codes).sum(-1)                      # the scale is the least-squares fit
+    assert torch.allclose(scale, lsq, rtol=1e-5)
