diff --git a/kernels/common/gguf_gemv.metal b/kernels/common/gguf_gemv.metal
new file mode 100644
index 0000000..c581a9a
--- /dev/null
+++ b/kernels/common/gguf_gemv.metal
@@ -0,0 +1,386 @@
+// gguf_mv / gguf_mm / gguf_embed: projections and the embedding gather over a gguf slab (monolith.formats.gguf):
+// every row is its GGUF tensor's row of blocks, unchanged, with its own ggml type; gguf_quants.metal (ggml's dequantizers,
+// pasted ahead of this file) turns 16 weights at a time into floats. A projection dispatch covers one run of rows of one
+// type (GGUF_TYPE; silu·mul: gate rows of GGUF_TYPE and their up rows of GGUF_TYPE_B) and keeps gemv_T's contract
+// (gemv_T.metal): BF16 activations x[t][k], FP32 accumulation, one rounding to BF16, the per-row scale, EPILOGUE 1
+// (residual add before the rounding; EPILOGUE_ROUND: round first) and 2 (silu·mul), and with STEP_STATE the step's row
+// count (T_SRC) and the predicated variants (T_LO < T ≤ T_HI). No fused norm or hoisted statistics. A slab with a
+// column gather (its header's gather offset ≠ 0) reads input columns in runs of 32 through it.
+//
+// Macros: GG_K (columns), GG_T (the variant's rows), GGUF_TYPE, GGUF_TYPE_B, GGUF_MM, EPILOGUE, EPILOGUE_ROUND, SILU_ROUND.
+
+#ifndef EPILOGUE
+#define EPILOGUE 0
+#endif
+#ifndef EPILOGUE_ROUND
+#define EPILOGUE_ROUND 0
+#endif
+#ifndef T_SRC
+#define T_SRC 0
+#endif
+#ifndef T_STATIC_ROWS
+#define T_STATIC_ROWS 1u
+#endif
+#ifndef STEP_STATE
+#define STEP_STATE 0
+#endif
+
+#define GGUF_F32 0u
+#define GGUF_F16 1u
+#define GGUF_Q8_0 8u
+#define GGUF_Q2_K 10u
+#define GGUF_Q3_K 11u
+#define GGUF_Q4_K 12u
+#define GGUF_Q5_K 13u
+#define GGUF_Q6_K 14u
+#define GGUF_IQ2_XXS 16u
+#define GGUF_IQ2_XS 17u
+#define GGUF_IQ3_XXS 18u
+#define GGUF_IQ1_S 19u
+#define GGUF_IQ3_S 21u
+#define GGUF_IQ2_S 22u
+#define GGUF_IQ4_XS 23u
+#define GGUF_IQ1_M 29u
+#define GGUF_BF16 30u
+
+struct EmbedParams { uint k; uint t_active; uint vocab; uint mask_id; };
+
+static inline float gguf_bf16(ushort u) { return as_type<float>(uint(u) << 16); }
+static inline float gguf_round_bf16(float v) { uint u = as_type<uint>(v); u += 0x7FFFu + ((u >> 16) & 1u); return as_type<float>(u & 0xFFFF0000u); }
+
+// columns [16c, 16c + 16) of a row of ggml type `type` starting at `row`
+static inline float4x4 gguf_chunk(device const uchar* row, uint type, uint c) {
+  float4x4 r;
+  switch (type) {
+    case GGUF_F32: {
+      device const float4* f = (device const float4*)row + 4u * c;
+      r = float4x4(f[0], f[1], f[2], f[3]);
+      break;
+    }
+    case GGUF_F16: {
+      device const half4* h = (device const half4*)row + 4u * c;
+      r = float4x4(float4(h[0]), float4(h[1]), float4(h[2]), float4(h[3]));
+      break;
+    }
+    case GGUF_BF16: {
+      device const ushort4* b = (device const ushort4*)row + 4u * c;
+      for (uint i = 0; i < 4; i++) r[i] = float4(gguf_bf16(b[i].x), gguf_bf16(b[i].y), gguf_bf16(b[i].z), gguf_bf16(b[i].w));
+      break;
+    }
+    case GGUF_Q8_0: dequantize_q8_0((device const block_q8_0*)row + c / 2u, short(c % 2u), r); break;
+    case GGUF_Q2_K: dequantize_q2_K((device const block_q2_K*)row + c / 16u, short(c % 16u), r); break;
+    case GGUF_Q3_K: dequantize_q3_K((device const block_q3_K*)row + c / 16u, short(c % 16u), r); break;
+    case GGUF_Q4_K: dequantize_q4_K((device const block_q4_K*)row + c / 16u, short(c % 16u), r); break;
+    case GGUF_Q5_K: dequantize_q5_K((device const block_q5_K*)row + c / 16u, short(c % 16u), r); break;
+    case GGUF_Q6_K: dequantize_q6_K((device const block_q6_K*)row + c / 16u, short(c % 16u), r); break;
+    case GGUF_IQ2_XXS: dequantize_iq2_xxs((device const block_iq2_xxs*)row + c / 16u, short(c % 16u), r); break;
+    case GGUF_IQ2_XS: dequantize_iq2_xs((device const block_iq2_xs*)row + c / 16u, short(c % 16u), r); break;
+    case GGUF_IQ3_XXS: dequantize_iq3_xxs((device const block_iq3_xxs*)row + c / 16u, short(c % 16u), r); break;
+    case GGUF_IQ1_S: dequantize_iq1_s((device const block_iq1_s*)row + c / 16u, short(c % 16u), r); break;
+    case GGUF_IQ3_S: dequantize_iq3_s((device const block_iq3_s*)row + c / 16u, short(c % 16u), r); break;
+    case GGUF_IQ2_S: dequantize_iq2_s((device const block_iq2_s*)row + c / 16u, short(c % 16u), r); break;
+    case GGUF_IQ4_XS: dequantize_iq4_xs((device const block_iq4_xs*)row + c / 16u, short(c % 16u), r); break;
+    case GGUF_IQ1_M: dequantize_iq1_m((device const block_iq1_m*)row + c / 16u, short(c % 16u), r); break;
+    default: r = float4x4(0.0f); break;
+  }
+  return r;
+}
+
+// 16 BF16 activations as four float4
+static inline float4x4 gguf_x16(device const ushort* x) {
+  const uint4 a = *(device const uint4*)x, b = *(device const uint4*)(x + 8);
+  return float4x4(float4(as_type<float>(a.x << 16), as_type<float>(a.x & 0xFFFF0000u), as_type<float>(a.y << 16), as_type<float>(a.y & 0xFFFF0000u)),
+                  float4(as_type<float>(a.z << 16), as_type<float>(a.z & 0xFFFF0000u), as_type<float>(a.w << 16), as_type<float>(a.w & 0xFFFF0000u)),
+                  float4(as_type<float>(b.x << 16), as_type<float>(b.x & 0xFFFF0000u), as_type<float>(b.y << 16), as_type<float>(b.y & 0xFFFF0000u)),
+                  float4(as_type<float>(b.z << 16), as_type<float>(b.z & 0xFFFF0000u), as_type<float>(b.w << 16), as_type<float>(b.w & 0xFFFF0000u)));
+}
+
+static inline float gguf_dot16(float4x4 w, float4x4 x) {
+  return dot(w[0], x[0]) + dot(w[1], x[1]) + dot(w[2], x[2]) + dot(w[3], x[3]);
+}
+
+// h[t][:] = bf16(dequantize(table[token t])): one SIMD-group per token. EMBED_IDS as embed.metal (1: a draft block —
+// row 0 reads tokens[0], the others the mask id; 2: an LM drafter's ingest; 3: its ingest rows then the anchor).
+#ifndef EMBED_IDS
+#define EMBED_IDS 0
+#endif
+kernel void gguf_embed(device const int* tokens [[buffer(0)]], device const uchar* table [[buffer(1)]], device ushort* h [[buffer(2)]],
+                       constant EmbedParams& p [[buffer(3)]],
+#if STEP_STATE
+                       device const StepState* st [[buffer(15)]],
+#endif
+                       uint gid [[thread_position_in_grid]], uint lane [[thread_index_in_simdgroup]], uint sw [[threads_per_simdgroup]]) {
+  const uint t = gid / sw;
+#if STEP_STATE
+  if (st->done || t >= ((T_SRC == 1) ? st->n_inject : ((T_SRC == 3) ? st->n_chain : ((T_SRC == 4) ? st->n_inject + st->n_chain : ((T_SRC == 2) ? T_STATIC_ROWS : st->t_this_step))))) return;
+#else
+  if (t >= p.t_active) return;
+#endif
+#if EMBED_IDS == 3
+  uint tok = (t < st->n_inject) ? uint(tokens[st->checkpoint_index - st->n_inject + t]) : uint(st->anchor);
+#elif EMBED_IDS == 2
+  uint tok = uint(tokens[st->checkpoint_index - st->n_inject + t]);
+#elif EMBED_IDS
+  uint tok = (t == 0u) ? uint(tokens[0]) : p.mask_id;
+#else
+  uint tok = uint(tokens[t]);
+#endif
+  if (tok >= p.vocab) tok = 0u;
+  const uint2 d = ((device const uint2*)(table + 16))[tok];
+  device const uchar* row = table + d.x;
+  device ushort* out = h + (ulong)t * p.k;
+  for (uint c = lane; c < p.k / 16u; c += 32u) {
+    const float4x4 f = gguf_chunk(row, d.y, c);
+    for (uint i = 0; i < 4; i++)
+      for (uint j = 0; j < 4; j++) out[16u * c + 4u * i + j] = ushort(as_type<uint>(gguf_round_bf16(f[i][j])) >> 16);
+  }
+}
+
+// ---- type-specialized kernels: one dispatch per run of rows of one ggml type (GGUF_TYPE, and GGUF_TYPE_B for the up
+// rows of silu·mul), rows addressed through the slab's row table ------------------------------------------------------
+#ifdef GGUF_TYPE
+#ifndef GGUF_TYPE_B
+#define GGUF_TYPE_B GGUF_TYPE
+#endif
+// the rows of a dispatch: slab rows [row0, row0 + n_rows) → output columns [out0, out0 + n_rows) of rows out_stride wide;
+// silu·mul: gate row row0 + i and up row row0 + up_off + i → output column out0 + i
+struct GgufParams { uint row0; uint n_rows; uint out0; uint out_stride; uint up_off; uint t_active; uint n_tg; uint pad; };
+
+static inline uint gguf_rows_this_step(
+#if STEP_STATE
+    device const StepState* st,
+#endif
+    constant GgufParams& p) {
+#if STEP_STATE
+  return (T_SRC == 1) ? st->n_inject : ((T_SRC == 3) ? st->n_chain : ((T_SRC == 4) ? st->n_inject + st->n_chain : ((T_SRC == 2) ? T_STATIC_ROWS : st->t_this_step)));
+#else
+  return p.t_active;
+#endif
+}
+
+#ifndef NSG
+#define NSG 8u                                            // SIMD-groups per threadgroup (gguf_mv)
+#endif
+#ifndef RG
+#define RG (EPILOGUE == 2 ? 2u : 4u)                      // outputs per SIMD-group (silu·mul: each two rows)
+#endif
+#define KW (GG_K < 512u ? GG_K : 512u)                    // activation window (columns staged in threadgroup memory)
+#define ROWS_PER_OUT (EPILOGUE == 2 ? 2u : 1u)
+
+static inline void gguf_epilogue(device ushort* y, uint t, uint col, constant GgufParams& p, float v, float u,
+#if EPILOGUE == 1
+                                 device const ushort* residual,
+#endif
+                                 uint dummy) {
+#if EPILOGUE == 2
+  v = silu_mul(v, u);
+#elif EPILOGUE == 1
+#if EPILOGUE_ROUND
+  v = gguf_round_bf16(v);
+#endif
+  v += gguf_bf16(residual[(ulong)t * p.out_stride + col]);
+#endif
+  y[(ulong)t * p.out_stride + col] = ushort(as_type<uint>(gguf_round_bf16(v)) >> 16);
+}
+
+// GG_T ≤ 8 rows: a threadgroup takes NSG·RG outputs; the activations are staged KW columns at a time (FP32, GG_T rows) and
+// every SIMD-group dequantizes 16 weights per lane per row against them.
+kernel void gguf_mv(device const uchar* w [[buffer(0)]], device const float* row_scale [[buffer(1)]],
+                    device const ushort* x [[buffer(2)]], device ushort* y [[buffer(3)]],
+                    constant GgufParams& p [[buffer(4)]],
+#if EPILOGUE == 1
+                    device const ushort* residual [[buffer(7)]],
+#endif
+#if STEP_STATE
+                    device const StepState* st [[buffer(15)]],
+#endif
+                    uint tg [[threadgroup_position_in_grid]], uint sgi [[simdgroup_index_in_threadgroup]],
+                    uint lane [[thread_index_in_simdgroup]], uint tid [[thread_index_in_threadgroup]]) {
+  threadgroup float xs[GG_T][KW];
+#if STEP_STATE
+  if (st->done) return;
+  const uint T_step = gguf_rows_this_step(st, p);                       // the predicate takes the step's own row count
+#ifdef T_HI
+  if (T_step > T_HI || T_step <= T_LO) return;
+#endif
+  const uint T_act = min(T_step, GG_T);
+#else
+  const uint T_act = min(p.t_active, GG_T);
+#endif
+  if (T_act == 0u) return;
+  device const uint* head = (device const uint*)w;
+  device const uint2* desc = (device const uint2*)(w + 16);
+  const uint gather_off = head[3];
+  device const uint* runs = (device const uint*)(w + gather_off);
+  const uint o_base = (tg * NSG + sgi) * RG;                               // this SIMD-group's first output
+  float acc[RG][ROWS_PER_OUT][GG_T];
+  for (uint i = 0; i < RG; i++) for (uint s = 0; s < ROWS_PER_OUT; s++) for (uint t = 0; t < GG_T; t++) acc[i][s][t] = 0.0f;
+  device const uchar* rows[RG][ROWS_PER_OUT];
+  for (uint i = 0; i < RG; i++) {
+    const uint o = min(o_base + i, p.n_rows - 1u);
+    rows[i][0] = w + desc[p.row0 + o].x;
+#if EPILOGUE == 2
+    rows[i][1] = w + desc[p.row0 + p.up_off + o].x;
+#endif
+  }
+  for (uint k0 = 0; k0 < GG_K; k0 += KW) {
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    for (uint e = tid; e < GG_T * KW; e += NSG * 32u) {
+      const uint t = e / KW, c = e % KW, k = k0 + c;
+      const uint src = gather_off ? runs[k / 32u] + k % 32u : k;
+      xs[t][c] = (t < T_act && k < GG_K) ? gguf_bf16(x[(ulong)t * GG_K + src]) : 0.0f;
+    }
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    const uint c = lane;                                                   // the lane's 16-column chunk of the window
+    if (k0 + 16u * c >= GG_K) continue;
+    const uint cg = (k0 >> 4) + c;
+    half4x4 f[RG][ROWS_PER_OUT];                                           // the chunk of every row, decoded once
+    for (uint i = 0; i < RG; i++) {
+      f[i][0] = half4x4(gguf_chunk(rows[i][0], GGUF_TYPE, cg));
+#if EPILOGUE == 2
+      f[i][1] = half4x4(gguf_chunk(rows[i][1], GGUF_TYPE_B, cg));
+#endif
+    }
+    for (uint t = 0; t < GG_T; t++) {                                     // each activation chunk read once for all rows (rows
+      threadgroup const float4* xv = (threadgroup const float4*)&xs[t][16u * c];
+      const float4 x0 = xv[0], x1 = xv[1], x2 = xv[2], x3 = xv[3];
+      for (uint i = 0; i < RG; i++)
+        for (uint s = 0; s < ROWS_PER_OUT; s++)
+          acc[i][s][t] += dot(float4(f[i][s][0]), x0) + dot(float4(f[i][s][1]), x1) + dot(float4(f[i][s][2]), x2) + dot(float4(f[i][s][3]), x3);
+    }                                                                     // past the step's T are zero: compile-time loops keep acc in registers)
+  }
+  for (uint i = 0; i < RG; i++) {
+    const uint o = o_base + i;
+    if (o >= p.n_rows) break;
+    const float sa = row_scale[p.row0 + o];
+#if EPILOGUE == 2
+    const float sb = row_scale[p.row0 + p.up_off + o];
+#endif
+    for (uint t = 0; t < GG_T; t++) {
+      const float v = simd_sum(acc[i][0][t]) * sa;
+#if EPILOGUE == 2
+      const float u = simd_sum(acc[i][1][t]) * sb;
+#else
+      const float u = 0.0f;
+#endif
+      if (lane == 0u && t < T_act) gguf_epilogue(y, t, p.out0 + o, p, v, u,
+#if EPILOGUE == 1
+                                    residual,
+#endif
+                                    0u);
+    }
+  }
+}
+
+// GG_T > 8 rows (prefill): a threadgroup of 4 SIMD-groups takes a tile of MM_ROWS weight rows (silu·mul: MM_ROWS / 2 gate
+// rows and their up rows) × MM_TOK tokens; per K step of MM_K columns it dequantizes its rows into threadgroup memory
+// (half) and multiplies them with the activations in device memory on the matrix units (MPP matmul2d), FP32 accumulation.
+#if GGUF_MM
+#include <MetalPerformancePrimitives/MetalPerformancePrimitives.h>
+using namespace mpp::tensor_ops;
+#define MM_ROWS 64
+#ifndef MM_TOK
+#define MM_TOK (GG_T <= 16u ? 16u : 64u)                // tokens per tile: a verify step's 8 rows fill a 16-token tile
+#endif
+#define MM_K 32
+#define MM_SG 4
+kernel void gguf_mm(device const uchar* w [[buffer(0)]], device const float* row_scale [[buffer(1)]],
+                    device const ushort* x [[buffer(2)]], device ushort* y [[buffer(3)]],
+                    constant GgufParams& p [[buffer(4)]],
+#if EPILOGUE == 1
+                    device const ushort* residual [[buffer(7)]],
+#endif
+#if STEP_STATE
+                    device const StepState* st [[buffer(15)]],
+#endif
+                    uint2 tg [[threadgroup_position_in_grid]], uint tid [[thread_index_in_threadgroup]]) {
+  threadgroup half sa[MM_ROWS * MM_K];
+#if EPILOGUE == 2
+  threadgroup float so[MM_TOK * MM_ROWS];
+#endif
+#if STEP_STATE
+  if (st->done) return;
+  const uint T_step = gguf_rows_this_step(st, p);                       // the predicate takes the step's own row count
+#ifdef T_HI
+  if (T_step > T_HI || T_step <= T_LO) return;
+#endif
+  const uint T_act = min(T_step, GG_T);
+#else
+  const uint T_act = min(p.t_active, GG_T);
+#endif
+  const uint tok0 = tg.x * MM_TOK;
+  if (tok0 >= T_act) return;
+  device const uint* head = (device const uint*)w;
+  device const uint2* desc = (device const uint2*)(w + 16);
+  const uint gather_off = head[3];
+#if EPILOGUE == 2
+  const uint o0 = tg.y * (MM_ROWS / 2);                                   // first output column of the tile (relative)
+#else
+  const uint o0 = tg.y * MM_ROWS;
+#endif
+  // the tile row `r` reads slab row `tile_row(r)` (out of range: a zero row)
+  auto tA = tensor(sa, dextents<int32_t, 2>(MM_K, MM_ROWS));
+  device bfloat* xb = (device bfloat*)x;
+  auto tB = tensor(xb, dextents<int32_t, 2>(GG_K, T_act), array<int, 2>({1, GG_K}));
+  matmul2d<matmul2d_descriptor(MM_TOK, MM_ROWS, MM_K, false, true, true, matmul2d_descriptor::mode::multiply_accumulate),
+           execution_simdgroups<MM_SG>> mm;
+  auto cT = mm.get_destination_cooperative_tensor<decltype(tB), decltype(tA), float>();
+  for (uint16_t i = 0; i < cT.get_capacity(); i++) if (cT.is_valid_element(i)) cT[i] = 0.0f;
+  for (uint k0 = 0; k0 < GG_K; k0 += MM_K) {
+    for (uint e = tid; e < MM_ROWS * (MM_K / 16u); e += MM_SG * 32u) {
+      const uint r = e / (MM_K / 16u), part = e % (MM_K / 16u);
+#if EPILOGUE == 2
+      const uint o = o0 + r % (MM_ROWS / 2u);
+      const bool up = r >= MM_ROWS / 2u;
+      const bool live = o < p.n_rows;
+      const uint row = p.row0 + (up ? p.up_off : 0u) + o;
+#else
+      const uint o = o0 + r;
+      const bool up = false;
+      const bool live = o < p.n_rows;
+      const uint row = p.row0 + o;
+#endif
+      float4x4 f = float4x4(0.0f);
+      if (live) {
+        device const uchar* rp = w + desc[row].x;
+        uint cg = (k0 >> 4) + part;                                           // model columns [16·cg, +16)
+        if (gather_off)                                                       // stored in the run the inverse table names
+          cg = 2u * ((device const uint*)(w + gather_off))[GG_K / 32u + (k0 >> 5)] + part;
+        f = up ? gguf_chunk(rp, GGUF_TYPE_B, cg) : gguf_chunk(rp, GGUF_TYPE, cg);
+      }
+      for (uint q = 0; q < 16u; q++) sa[r * MM_K + part * 16u + q] = half(f[q / 4u][q % 4u]);
+    }
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    auto mA = tA.slice(0, 0);
+    auto mB = tB.slice(int(k0), int(tok0));
+    mm.run(mB, mA, cT);
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+  }
+#if EPILOGUE == 2
+  for (uint16_t i = 0; i < cT.get_capacity(); i++) if (cT.is_valid_element(i)) {
+    auto idx = cT.get_multidimensional_index(i);                          // [0]: tile row, [1]: token
+    so[idx[1] * MM_ROWS + idx[0]] = cT[i];
+  }
+  threadgroup_barrier(mem_flags::mem_threadgroup);
+  for (uint e = tid; e < MM_TOK * (MM_ROWS / 2u); e += MM_SG * 32u) {
+    const uint t = e / (MM_ROWS / 2u), j = e % (MM_ROWS / 2u), o = o0 + j;
+    if (tok0 + t >= T_act || o >= p.n_rows) continue;
+    const float v = so[t * MM_ROWS + j] * row_scale[p.row0 + o];
+    const float u = so[t * MM_ROWS + MM_ROWS / 2u + j] * row_scale[p.row0 + p.up_off + o];
+    gguf_epilogue(y, tok0 + t, p.out0 + o, p, v, u, 0u);
+  }
+#else
+  for (uint16_t i = 0; i < cT.get_capacity(); i++) if (cT.is_valid_element(i)) {
+    auto idx = cT.get_multidimensional_index(i);
+    const uint o = o0 + idx[0], t = tok0 + idx[1];
+    if (o >= p.n_rows || t >= T_act) continue;
+    gguf_epilogue(y, t, p.out0 + o, p, cT[i] * row_scale[p.row0 + o], 0.0f,
+#if EPILOGUE == 1
+                  residual,
+#endif
+                  0u);
+  }
+#endif
+}
+#endif
+#endif
