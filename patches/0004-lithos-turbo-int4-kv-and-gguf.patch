index 0000000..829c926
--- /dev/null
+++ b/tests/kernels/test_gguf_model.py
@@ -0,0 +1,233 @@
+"""The GGUF path end to end on a synthetic Qwen3.5 hybrid: the lowering tests' checkpoint is converted to a ``qwen35``
+GGUF here with llama.cpp's conversion transforms (convert_hf_to_gguf.py: ``1 + w`` norms, ``ssm_a = −exp(A_log)``,
+the linear-attention V heads tiled, ``out_proj``'s columns with them), read back through formats.gguf_checkpoint
+(every tensor must come back as the checkpoint held it), and run through the compiled programs: BF16 rows decode
+the tokens the safetensors checkpoint decodes; Q8_0 rows the tokens of the oracle on the dequantized GGUF."""
+import copy
+import sys
+from pathlib import Path
+
+import numpy as np
+import pytest
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "contract"))
+import test_nn_lowering
+from monolith.formats import PackLayout
+from monolith.formats.fp import bf16_to_f32, f32_to_bf16
+from monolith.formats.gguf_checkpoint import prepare_gguf
+from monolith.formats.safetensors_reader import SafetensorsDir
+from monolith.generate import Session
+from monolith.models.qwen3_5 import Qwen3_5Model
+from monolith.nn.pack_plan import pack_model
+
+gguf = pytest.importorskip("gguf")
+CTX = 256
+
+
+def _v_tiled(n_k, per_k, head):
+    """llama.cpp's _reorder_v_heads as an index map: tiled position i holds grouped index fwd[i]."""
+    return np.arange(n_k * per_k * head).reshape(n_k, per_k, head).transpose(1, 0, 2).reshape(-1)
+
+
+def write_qwen35_gguf(hf_dir: Path, out: Path, matrix_type) -> None:
+    cfg = test_nn_lowering.CFG["text_config"]
+    st = SafetensorsDir(str(hf_dir))
+    P = test_nn_lowering.P
+    nk, nv, dk, dv = cfg["linear_num_key_heads"], cfg["linear_num_value_heads"], cfg["linear_key_head_dim"], cfg["linear_value_head_dim"]
+    v_fwd, h_fwd, qk = _v_tiled(nk, nv // nk, dv), _v_tiled(nk, nv // nk, 1), 2 * nk * dk
+    w = gguf.GGUFWriter(str(out), "qwen35")
+    n_layer = cfg["num_hidden_layers"]
+    a = "qwen35."
+    w.add_uint32(a + "block_count", n_layer)
+    w.add_uint32(a + "context_length", cfg["max_position_embeddings"])
+    w.add_uint32(a + "embedding_length", cfg["hidden_size"])
+    w.add_uint32(a + "feed_forward_length", cfg["intermediate_size"])
+    w.add_uint32(a + "attention.head_count", cfg["num_attention_heads"])
+    w.add_uint32(a + "attention.head_count_kv", cfg["num_key_value_heads"])
+    w.add_uint32(a + "attention.key_length", cfg["head_dim"])
+    w.add_uint32(a + "attention.value_length", cfg["head_dim"])
+    w.add_float32(a + "rope.freq_base", cfg["rope_parameters"]["rope_theta"])
+    w.add_uint32(a + "rope.dimension_count", int(cfg["head_dim"] * cfg["rope_parameters"]["partial_rotary_factor"]))
+    w.add_float32(a + "attention.layer_norm_rms_epsilon", cfg["rms_norm_eps"])
+    w.add_uint32(a + "ssm.conv_kernel", cfg["linear_conv_kernel_dim"])
+    w.add_uint32(a + "ssm.state_size", dk)
+    w.add_uint32(a + "ssm.group_count", nk)
+    w.add_uint32(a + "ssm.time_step_rank", nv)
+    w.add_uint32(a + "ssm.inner_size", nv * dv)
+    w.add_uint32(a + "full_attention_interval", 2)
+    w.add_uint32("tokenizer.ggml.eos_token_id", 7)
+
+    def f32(name, x):
+        w.add_tensor(name, np.ascontiguousarray(np.asarray(x, dtype=np.float32)))
+
+    def mat(name, m):
+        m = np.ascontiguousarray(np.asarray(m, dtype=np.float32))
+        if matrix_type == gguf.GGMLQuantizationType.BF16:
+            w.add_tensor(name, f32_to_bf16(m), raw_dtype=matrix_type)
+        else:
+            w.add_tensor(name, gguf.quants.quantize(m, matrix_type), raw_dtype=matrix_type)
+
+    def get(n):
+        x = st.get(n)
+        return bf16_to_f32(x) if st.info(n).dtype == "BF16" else np.asarray(x, dtype=np.float32)
+
+    mat("token_embd.weight", get(P + "embed_tokens.weight"))
+    f32("output_norm.weight", get(P + "norm.weight") + 1)
+    for i, kind in enumerate(cfg["layer_types"]):
+        lp, g = f"{P}layers.{i}.", f"blk.{i}."
+        f32(g + "attn_norm.weight", get(lp + "input_layernorm.weight") + 1)
+        f32(g + "post_attention_norm.weight", get(lp + "post_attention_layernorm.weight") + 1)
+        for hf, gg in (("gate_proj", "ffn_gate"), ("up_proj", "ffn_up"), ("down_proj", "ffn_down")):
+            mat(g + gg + ".weight", get(lp + f"mlp.{hf}.weight"))
+        if kind == "full_attention":
+            for hf, gg in (("q_proj", "attn_q"), ("k_proj", "attn_k"), ("v_proj", "attn_v"), ("o_proj", "attn_output")):
+                mat(g + gg + ".weight", get(lp + f"self_attn.{hf}.weight"))
+            f32(g + "attn_q_norm.weight", get(lp + "self_attn.q_norm.weight") + 1)
+            f32(g + "attn_k_norm.weight", get(lp + "self_attn.k_norm.weight") + 1)
+        else:
+            la = lp + "linear_attn."
+            qkv = get(la + "in_proj_qkv.weight")
+            mat(g + "attn_qkv.weight", np.concatenate([qkv[:qk], qkv[qk:][v_fwd]]))
+            mat(g + "attn_gate.weight", get(la + "in_proj_z.weight")[v_fwd])
+            mat(g + "ssm_alpha.weight", get(la + "in_proj_a.weight")[h_fwd])
+            mat(g + "ssm_beta.weight", get(la + "in_proj_b.weight")[h_fwd])
+            mat(g + "ssm_out.weight", get(la + "out_proj.weight")[:, v_fwd])
+            conv = get(la + "conv1d.weight").reshape(qk + nv * dv, -1)
+            f32(g + "ssm_conv1d.weight", np.concatenate([conv[:qk], conv[qk:][v_fwd]]))
+            f32(g + "ssm_a", -np.exp(get(la + "A_log"))[h_fwd])
+            f32(g + "ssm_dt.bias", get(la + "dt_bias")[h_fwd])
+            f32(g + "ssm_norm.weight", get(la + "norm.weight"))
+    w.write_header_to_file()
+    w.write_kv_data_to_file()
+    w.write_tensors_to_file()
+    w.close()
+    st.close()
