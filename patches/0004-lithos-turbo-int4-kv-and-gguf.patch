+def test_reader_returns_the_checkpoint(checkpoints):
+    """Every tensor the HF checkpoint holds comes back from the BF16 GGUF unchanged (the inverse of llama.cpp's
+    conversion); the GGUF's matrices are bound as gguf slabs and dequantize to the HF matrices."""
+    from monolith.formats import FORMATS
+    hf, g, _ = checkpoints
+    a, b = SafetensorsDir(str(hf)), SafetensorsDir(str(g))
+    text = [n for n in a.names() if n.startswith(test_nn_lowering.P)]
+    assert sorted(text) == b.names()
+    for n in text:
+        ref = a.get(n)
+        ref = bf16_to_f32(ref) if a.info(n).dtype == "BF16" else np.asarray(ref, np.float32)
+        info = b.info(n)
+        if info.dtype == "GGUF":
+            got = FORMATS.get("gguf").dequantize(FORMATS.get("gguf").unpack({"weight": b.get(n)}, shape=info.shape))
+        else:
+            got = b.get(n)
+            got = bf16_to_f32(got) if info.dtype == "BF16" else np.asarray(got, np.float32)
+            if n.endswith("layernorm.weight") or n.endswith(("q_norm.weight", "k_norm.weight")) or n == test_nn_lowering.P + "norm.weight":
+                ref = ref.astype(np.float32)
+        assert got.shape == ref.reshape(got.shape).shape, n
+        tol = 1e-6 if not n.endswith("A_log") else 1e-5
+        assert np.allclose(got, ref.reshape(got.shape), atol=tol, rtol=tol), (n, np.abs(got - ref.reshape(got.shape)).max())
+
