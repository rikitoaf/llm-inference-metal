index 0000000..5c7a3a0
--- /dev/null
+++ b/tools/vendor_ggml_quants.py
@@ -0,0 +1,75 @@
+"""Write kernels/common/gguf_quants.metal from a llama.cpp checkout: ggml's block layouts and grid tables
+(ggml/src/ggml-common.h, compiled as Metal) and the Metal dequantizers of the GGUF row types monolith.formats.gguf
+decodes (ggml/src/ggml-metal/ggml-metal.metal). The code is ggml's, MIT licensed; the file keeps the license and the
+source commit. Run: python tools/vendor_ggml_quants.py <llama.cpp root> [<upstream name>]
+"""
+
+from __future__ import annotations
+
+import re
+import subprocess
+import sys
+from pathlib import Path
+
+FUNCTIONS = ("get_scale_min_k4_just2", "dequantize_q8_0", "dequantize_q2_K", "dequantize_q3_K", "dequantize_q4_K",
+             "dequantize_q5_K", "dequantize_q6_K", "dequantize_iq2_xxs", "dequantize_iq2_xs", "dequantize_iq3_xxs",
+             "dequantize_iq3_s", "dequantize_iq2_s", "dequantize_iq1_s", "dequantize_iq1_m", "dequantize_iq4_xs")
+
+
+# Edits to ggml's code, applied after extraction (each must match once):
+#   Q4_K: ``xb->d / 16.h`` divides the half block scale in half precision, which drops mantissa bits when d is a
+#   half subnormal (< 6.1e-5, common in real Q4_K matrices: up to 0.7 % output error); Q5_K already divides in float.
+EDITS = (("dequantize_q4_K", "const float d   = il < 2 ? xb->d : xb->d / 16.h;", "const float d   = il < 2 ? xb->d : xb->d / 16.f;"),)
+
+
+def extract(source: str, name: str) -> str:
+    """The definition of ``name`` (with a ``template <...>`` line before it), braces matched."""
+    m = re.search(r"(template <typename type4x4>\n)?(static inline )?[\w:<>]+\s+" + re.escape(name) + r"\(", source)
+    if m is None:
+        raise ValueError(f"{name} not found")
+    i = source.index("{", m.end())
+    depth = 0
+    for j in range(i, len(source)):
+        depth += {"{": 1, "}": -1}.get(source[j], 0)
+        if depth == 0:
+            return source[m.start(): j + 1]
+    raise ValueError(f"{name}: unbalanced braces")
+
+
+def main() -> None:
+    root = Path(sys.argv[1])
+    upstream = sys.argv[2] if len(sys.argv) > 2 else "ggml-org/llama.cpp"
+    common = (root / "ggml/src/ggml-common.h").read_text()
+    metal = (root / "ggml/src/ggml-metal/ggml-metal.metal").read_text()
+    license_text = (root / "LICENSE").read_text().strip()
+    commit = subprocess.run(["git", "-C", str(root), "rev-parse", "HEAD"], capture_output=True, text=True).stdout.strip()
+    kvalues = re.search(r"constexpr constant static float kvalues_iq4nl_f\[16\] = \{[^}]*\};", metal).group(0)
+    bodies = {f: extract(metal, f) for f in FUNCTIONS}
+    for f, old, new in EDITS:
+        if bodies[f].count(old) != 1:
+            raise ValueError(f"{f}: the edit {old!r} no longer applies")
+        bodies[f] = bodies[f].replace(old, new)
+    funcs = "\n\n".join(bodies[f] for f in FUNCTIONS)
+    out = Path(__file__).resolve().parents[1] / "kernels/common/gguf_quants.metal"
+    header = "\n".join("// " + line if line else "//" for line in license_text.splitlines())
+    out.write_text(f"""// GGUF block layouts, grid tables and Metal dequantizers, vendored from {upstream}
+// (ggml/src/ggml-common.h and ggml/src/ggml-metal/ggml-metal.metal @ {commit}) by tools/vendor_ggml_quants.py.
+// Do not edit: re-run the tool (its EDITS list the changes to ggml's code). Used by gguf_gemv.metal (monolith.formats.gguf).
+//
+{header}
+#ifndef GGUF_QUANTS_METAL
+#define GGUF_QUANTS_METAL
+#define GGML_COMMON_DECL_METAL
+#define GGML_COMMON_IMPL_METAL
+{common}
+
+{kvalues}
+
+{funcs}
+#endif
+""")
+    print(f"wrote {out} ({out.stat().st_size} bytes) from {commit[:12]}")
+
+
+if __name__ == "__main__":
+    main()
