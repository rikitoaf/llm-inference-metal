+"""A DSpark drafter stored by llama.cpp (GGUF architecture ``dflash`` with the Markov head) read as this package's
+checkpoint (formats.gguf_checkpoint): llama.cpp's ``DFlashModel`` / ``DSparkModel`` conversion writes the tap layers as
+``target_layer_ids + 1`` and drops the embedding and the head (the drafter shares the target's); its norms are the
+standard RMSNorm and are stored as they are. Tensor names: ``fc`` (the tap projection), ``enc.output_norm`` (DFlash's
+``hidden_norm``), ``markov_w1`` / ``markov_w2``, ``conf_proj`` (the confidence head), ``blk.<i>.*`` (the layers)."""
+
+from __future__ import annotations
+
+from typing import Dict, List
+
+from ...formats.gguf_checkpoint import GGUFArch, Rule, field_value, register_gguf_arch
+
+ARCH = "dflash"
+
+
+def config(r) -> dict:
+    get = lambda k, d=None: field_value(r, f"{ARCH}.{k}", d)                     # noqa: E731
+    t = {x.name: x for x in r.tensors}
+    if "markov_w1.weight" not in t:
+        raise ValueError("gguf: a dflash file without the Markov head is a DFlash drafter, not DSpark")
+    vocab, rank = int(t["markov_w1.weight"].shape[1]), int(t["markov_w1.weight"].shape[0])
+    hidden = int(get("embedding_length"))
+    taps = [int(x) - 1 for x in get("target_layers")]                           # stored as target_layer_ids + 1
+    conf = t.get("conf_proj.weight")
+    return {"architectures": ["DSparkDraftModel"], "hidden_size": hidden,
+            "intermediate_size": int(get("feed_forward_length")), "num_hidden_layers": int(get("block_count")),
+            "num_attention_heads": int(get("attention.head_count")), "num_key_value_heads": int(get("attention.head_count_kv")),
+            "head_dim": int(get("attention.key_length")), "rms_norm_eps": float(get("attention.layer_norm_rms_epsilon")),
+            "vocab_size": vocab, "max_position_embeddings": int(get("context_length")),
+            "rope_parameters": {"rope_type": "default", "rope_theta": float(get("rope.freq_base"))},
+            "block_size": int(get("block_size")), "target_layer_ids": taps,
+            "mask_token_id": int(field_value(r, "tokenizer.ggml.mask_token_id")), "markov_rank": rank, "markov_head_type": "vanilla",
+            "enable_confidence_head": conf is not None,
+            "confidence_head_with_markov": conf is not None and int(conf.shape[0]) == hidden + rank,
+            "target_hidden_size": int(t["fc.weight"].shape[0]) // len(taps), "tie_word_embeddings": False}
+
+
+def rules(cfg: dict, names: List[str]) -> Dict[str, Rule]:
+    out: Dict[str, Rule] = {"fc.weight": Rule("fc.weight"), "enc.output_norm.weight": Rule("hidden_norm.weight", "f32"),
+                            "output_norm.weight": Rule("norm.weight", "f32"),
+                            "markov_w1.weight": Rule("markov_head.markov_w1.weight"),
+                            "markov_w2.weight": Rule("markov_head.markov_w2.weight"),
+                            "conf_proj.weight": Rule("confidence_head.proj.weight", "row"),
+                            "conf_proj.bias": Rule("confidence_head.proj.bias", "f32")}
+    for i in range(cfg["num_hidden_layers"]):
+        g, lp = f"blk.{i}.", f"layers.{i}."
+        out[g + "attn_norm.weight"] = Rule(lp + "input_layernorm.weight", "f32")
+        out[g + "ffn_norm.weight"] = Rule(lp + "post_attention_layernorm.weight", "f32")
+        out[g + "attn_q_norm.weight"] = Rule(lp + "self_attn.q_norm.weight", "f32")
+        out[g + "attn_k_norm.weight"] = Rule(lp + "self_attn.k_norm.weight", "f32")
+        for gg, hf in (("attn_q", "q_proj"), ("attn_k", "k_proj"), ("attn_v", "v_proj"), ("attn_output", "o_proj")):
+            out[f"{g}{gg}.weight"] = Rule(f"{lp}self_attn.{hf}.weight")
+        for gg, hf in (("ffn_gate", "gate_proj"), ("ffn_up", "up_proj"), ("ffn_down", "down_proj")):
+            out[f"{g}{gg}.weight"] = Rule(f"{lp}mlp.{hf}.weight")
+    present = set(names)
+    return {g: r for g, r in out.items() if g in present}
+
+
+register_gguf_arch(ARCH, GGUFArch(config=config, rules=rules, tokenizer=False))
