+def _within_ties(torch, oracle, ids, got, margin=0.1):
+    """``got`` follows the oracle's greedy choices up to the first step where they differ, and there the oracle rated
+    ``got``'s token within ``margin`` of its best (a tie broken by rounding: this random-weight model's top logits lie
+    within 0.06 of each other at ~1.5, and 4-bit K/V plus gguf_mm's half weight tiles move them by a few BF16 steps).
+    Later tokens follow a different prefix and are not judged."""
+    from monolith.nn.oracle import greedy_decode
+    with torch.no_grad():
+        want, _, _ = greedy_decode(oracle, ids, len(got))
+        i = next((j for j, (a, b) in enumerate(zip(got, want)) if a != b), None)
+        if i is None:
+            return
+        logits, _, _ = oracle.forward(torch.tensor(ids + got[:i]), oracle.init_state(), 0)
+        last = logits[-1].float()
+        assert float(last.max() - last[got[i]]) <= margin, (i, got[i], want[i], float(last.max() - last[got[i]]))
+
