+// ---- turbo-int4 K/V cache (TURBO_INT4 = 1; the v1 kernels only) ----------------------------------------------
+// Each (token, kv head) vector of keys and of values is rotated by a randomized Hadamard transform R = S2·H·S1/√D
+// (one rotation over the whole head, so one scale fits it) and stored as D signed 4-bit codes (-8..7, two's
+// complement, element 2i in the low nibble of byte i) followed by one FP32 scale: D/2 + 4 bytes against BF16's 2·D.
+// The quantizer is Splash's turbo-int4 r2: the step covers min(2.7·rms, max|x|) over 8 levels, the side with the
+// larger magnitude takes the 8th level, and the scale is refit by least squares (Σx·c / Σc²). Queries are rotated by
+// R before scoring (q·k = Rq·Rk) and the merged output by R^T after the fold, so P·V runs on the stored values.
+// Keys and values of the step's own tokens are used as their dequantized codes, the same values a later pass reads
+// from the cache: a T-row prompt pass equals its EXACT_SUB-row sub-passes.
+#ifndef TURBO_INT4
+#define TURBO_INT4 0
+#endif
+#if TURBO_INT4
+#if DL != 2u && DL != 4u && DL != 8u
+#error "TURBO_INT4: head_dim must be 64, 128 or 256"
+#endif
+#define KV_T uchar
+#define KV_ROW (D / 2u + 4u)                 // bytes per (token, kv head): D nibbles, then the FP32 scale
+#define TURBO_CLIP 2.7f
+// The random signs of the 256-point rotation (Python random.Random(250419874), Splash's turbo-int4): element i is
+// bit i % 32 of word i / 32, a set bit is -1. A smaller head uses the leading words.
+constant uint TURBO_SIGNS_1[8] = {0xa097d901u, 0xa038e573u, 0xca2221ffu, 0x45093648u,
+                                  0x290f5046u, 0x0de9bed1u, 0x012987dbu, 0xa51d810eu};
+constant uint TURBO_SIGNS_2[8] = {0x5c73128au, 0x6cc37310u, 0xc8bab385u, 0xd9d9ff54u,
+                                  0x63ee4d71u, 0xa2b23130u, 0x32884643u, 0xb6e6c2f6u};
+static inline float turbo_sign(constant const uint* s, uint i) { return ((s[i >> 5u] >> (i & 31u)) & 1u) ? -1.0f : 1.0f; }
+
+// R (or R^T = S1·H·S2/√D with inverse) of a D-vector held DL-per-lane (element lane·DL + e): the butterflies of the
+// index bits below DL in registers, the five above across the SIMD-group. Every lane must be active.
+static inline void turbo_rotate(thread float* f, uint lane, bool inverse) {
+  constant const uint* s1 = inverse ? TURBO_SIGNS_2 : TURBO_SIGNS_1;
+  constant const uint* s2 = inverse ? TURBO_SIGNS_1 : TURBO_SIGNS_2;
+  for (uint e = 0; e < DL; e++) f[e] *= turbo_sign(s1, lane * DL + e);
+  for (uint st = 1u; st < DL; st <<= 1u) {
+    for (uint e = 0; e < DL; e++) {
+      if (e & st) continue;
+      const float a = f[e], b = f[e + st];
+      f[e] = a + b;
+      f[e + st] = a - b;
+    }
+  }
+  for (uint st = 1u; st < 32u; st <<= 1u) {
+    const bool upper = (lane & st) != 0u;
+    for (uint e = 0; e < DL; e++) {
+      const float partner = simd_shuffle_xor(f[e], ushort(st));
+      f[e] = upper ? partner - f[e] : f[e] + partner;
+    }
+  }
+  const float norm = rsqrt(float(D));
+  for (uint e = 0; e < DL; e++) f[e] *= norm * turbo_sign(s2, lane * DL + e);
+}
+
+// Quantizes a rotated vector (DL per lane) in place to its dequantized values; codes[e] receive the 4-bit codes.
+// Returns the scale. Every lane must be active.
+static inline float turbo_quantize(thread float* x, thread int* codes) {
+  float lp = 0.0f, ln = 0.0f, lsq = 0.0f;
+  for (uint e = 0; e < DL; e++) { lp = max(lp, x[e]); ln = max(ln, -x[e]); lsq = fma(x[e], x[e], lsq); }
+  const float pos = simd_max(lp), neg = simd_max(ln);
+  const float rms = sqrt(simd_sum(lsq) * (1.0f / float(D)));
+  const float half_range = min(TURBO_CLIP * rms, max(pos, neg)) * 0.125f;
+  const float step = pos > neg ? -half_range : half_range;
+  const float inv = half_range > 0.0f ? 1.0f / step : 0.0f;
+  float lxc = 0.0f, lcc = 0.0f;
+  for (uint e = 0; e < DL; e++) {
+    codes[e] = clamp(int(rint(x[e] * inv)), -8, 7);
+    lxc = fma(x[e], float(codes[e]), lxc);
+    lcc += float(codes[e] * codes[e]);
+  }
+  const float xc = simd_sum(lxc), cc = simd_sum(lcc);
+  const float scale = cc > 0.0f ? xc / cc : 0.0f;
+  for (uint e = 0; e < DL; e++) x[e] = float(codes[e]) * scale;
+  return scale;
+}
+
+// The lane's DL codes and the row's scale into a cache row (D/2 + 4 bytes).
+static inline void turbo_store(device uchar* row, uint lane, const thread int* codes, float scale) {
+  uint w = 0u;
+  for (uint e = 0; e < DL; e++) w |= (uint(codes[e]) & 0xFu) << (4u * e);
+#if DL == 8
+  *(device uint*)(row + lane * 4u) = w;
+#elif DL == 4
+  *(device ushort*)(row + lane * 2u) = ushort(w);
+#else
+  row[lane] = uchar(w);
+#endif
+  if (lane == 0u) *(device float*)(row + D / 2u) = scale;
+}
+
+// A cache row's DL dequantized values for this lane (rotated space).
+static inline void turbo_load(device const uchar* row, uint lane, thread float* f) {
+#if DL == 8
+  const uint w = *(device const uint*)(row + lane * 4u);
+#elif DL == 4
+  const uint w = uint(*(device const ushort*)(row + lane * 2u));
+#else
+  const uint w = uint(row[lane]);
+#endif
+  const float scale = *(device const float*)(row + D / 2u);
+  for (uint e = 0; e < DL; e++) f[e] = float(int(w << (28u - 4u * e)) >> 28) * scale;
+}
+
+// A fresh row from the projection (already normed and RoPE'd for keys): rotated, quantized to the values a cache
+// read returns, and appended when `append`.
+static inline void turbo_fresh(thread float* f, device uchar* row, uint lane, bool append) {
+  turbo_rotate(f, lane, false);
+  int codes[DL];
+  const float scale = turbo_quantize(f, codes);
+  if (append) turbo_store(row, lane, codes, scale);
+}
+#else
+#define KV_T ushort
+#endif
