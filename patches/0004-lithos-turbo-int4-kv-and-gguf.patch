--- /dev/null
+++ b/tests/kernels/test_turbo_session.py
@@ -0,0 +1,116 @@
+"""A turbo-int4 K/V cache through the compiled step programs (Session): the cache allocation, greedy tokens against
+the turbo-int4 model oracle, chunked and exact prefill against one-step prompts, the prefix cache, and DSpark
+speculative decoding against plain decode, on a synthetic Qwen3.5 hybrid with 128-dim attention heads."""
+import copy
+import sys
+from pathlib import Path
+
+import numpy as np
+import pytest
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+sys.path.insert(0, str(Path(__file__).resolve().parents[1] / 'contract'))
+import test_nn_lowering
+from dspark_synth import build, write_checkpoint as write_dspark
+from monolith.formats import PackLayout
+from monolith.generate import Session
+from monolith.models.qwen3_5 import Qwen3_5Model
+from monolith.nn import set_kv_format
+from monolith.nn.pack_plan import pack_model
+
+D = 128
+CTX = 512
+
+
+@pytest.fixture(scope='module')
+def target(tmp_path_factory):
+    """The synthetic hybrid of the lowering tests with 128-dim attention heads (turbo-int4 takes 64, 128 or 256)."""
+    path = tmp_path_factory.mktemp('turbo-target')
+    saved = copy.deepcopy(test_nn_lowering.CFG)
+    test_nn_lowering.CFG['text_config']['head_dim'] = D
+    try:
+        test_nn_lowering._checkpoint(path)
+    finally:
+        test_nn_lowering.CFG.clear()
+        test_nn_lowering.CFG.update(saved)
+    pack_model(Qwen3_5Model.from_checkpoint(str(path), max_context=CTX), str(path), str(path / 'pack'), PackLayout(rows=16))
+    return path
+
+
+def _model(target, kv_format='turbo-int4', max_context=CTX):
+    m = Qwen3_5Model.from_checkpoint(str(target), max_context=max_context)
+    assert set_kv_format(m, kv_format) == 1
+    return m
+
+
+def _session(target, **options):
+    options = dict(dict(eos=-1, autotune=False, accelerator='off', attention='auto'), **options)
+    return Session(_model(target), str(target / 'pack'), **options)
+
+
+def test_cache_allocation_and_v1_kernels(target):
+    s = _session(target)
+    s.generate([1, 2, 3], 2)
+    engine = s.engine(1)
+    for name in ('layers.1.self_attn.k_cache', 'layers.1.self_attn.v_cache'):
+        assert engine.program.buffers[name].nbytes == CTX * 2 * (D // 2 + 4)
+    attention = [k for k in engine.program.kernels.values() if k.function.startswith('gqa_')]
+    assert attention and all(k.function in ('gqa_decode', 'gqa_merge') and k.macros.get('TURBO_INT4') == '1' for k in attention)
+
+
+def test_greedy_tokens_match_the_turbo_oracle(target):
+    torch = pytest.importorskip('torch')
+    from monolith.models.qwen3_5.weights import load_oracle
+    from monolith.nn.oracle import greedy_decode
+
+    oracle = _model(target, max_context=64)
+    load_oracle(oracle, str(target))
+    s = _session(target)
+    for seed, count in ((0, 5), (1, 17), (2, 33)):
+        ids = np.random.default_rng(seed).integers(0, 50, count).tolist()
+        with torch.no_grad():
+            ref, _, _ = greedy_decode(oracle, ids, 12)
+        assert s.generate(ids, 12).tokens == ref, (count, ref)
+
+
+@pytest.mark.parametrize('accelerator', ['off', 'on'])
+def test_chunked_and_exact_prefill_and_prefix_cache(target, accelerator):
+    """Prompts in 8-row chunks, in 128-row chunks and in one exact 512-row pass decode the same tokens; a cached
+    prefix replays only the last token. With the accelerator on, a BF16 cache would take the matrix attention from
+    four rows: the turbo-int4 cache keeps the v1 kernels."""
+    small = _session(target, prefill_chunk_size=8, accelerator=accelerator)
+    large = _session(target, prefix_cache=True, accelerator=accelerator)
+    exact = _session(target, prefill_chunk_size=512, prefill_exact=True, accelerator=accelerator)
+    for count in (5, 129, 259):
+        ids = np.random.default_rng(count).integers(0, 50, count).tolist()
+        ref = small.generate(ids, 12).tokens
+        assert large.generate(ids, 12).tokens == ref
+        assert exact.generate(ids, 12).tokens == ref
+        again = large.generate(ids, 12)
+        assert again.tokens == ref and again.cached_prompt_tokens == count - 1
+        if count > 128:              # the server's min_tokens: a message prefix under it falls back to p - 1
+            served = _session(target, prefix_cache=True, prefix_cache_min_tokens=128, accelerator=accelerator)
+            assert served.generate(ids, 12, cache_prefix_tokens=4).tokens == ref
+            assert served.generate(ids, 12, cache_prefix_tokens=4).cached_prompt_tokens == count - 1
+        if count > 128:                                  # the 128-row prompt program: prepared queries on the matrix core
+            cores = {k.function for k in large.prefill_engine(count).program.kernels.values()
+                     if k.function in ('gqa_decode', 'gqa_decode_mma', 'gqa_turbo_mma_q') and k.macros.get('TURBO_INT4') == '1'}
+            assert cores == ({'gqa_turbo_mma_q'} if accelerator == 'on' else {'gqa_decode'})
+
+
+@pytest.mark.parametrize('accelerator', ['off', 'on'])
+def test_dspark_speculative_decode_equals_plain(target, tmp_path, accelerator):
+    draft = tmp_path / 'draft'
+    draft.mkdir()
+    plain = _session(target, accelerator=accelerator)
+    m = _model(target)
+    write_dspark(draft, with_head=False, vocab_size=50, target_hidden_size=256, target_layer_ids=[-1, 1], head_dim=128)
+    d, _, _, _ = build(draft, target_lm_head=m.lm_head, max_context=CTX)
+    pack_model(d, str(draft), str(draft / 'pack'), PackLayout(rows=16))
+    if accelerator == 'on':                                               # the drafter's context cache turbo-int4 too
+        set_kv_format(d, 'turbo-int4')
+    spec = Session(m, str(target / 'pack'), eos=-1, autotune=False, accelerator=accelerator, attention='auto',
+                   drafter=d, drafter_pack=str(draft / 'pack'), verify='fixed', verify_length=3)
+    for count in (7, 40):
+        ids = np.random.default_rng(100 + count).integers(0, 50, count).tolist()
+        assert spec.generate(ids, 24).tokens == plain.generate(ids, 24).tokens
