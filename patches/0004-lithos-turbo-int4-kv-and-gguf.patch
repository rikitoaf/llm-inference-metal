new file mode 100644
index 0000000..cc57eb4
--- /dev/null
+++ b/tests/kernels/test_turbo_draft.py
@@ -0,0 +1,106 @@
+"""The DSpark draft pass with a turbo-int4 context cache (DraftAttention.kv_format) as an emitted program on the GPU vs
+the drafter's turbo-int4 oracle: four successive injections over a context that grows past one partition, comparing
+the block hidden state, the base logits and the cached context rows (code for code)."""
+
+import sys
+from pathlib import Path
+
+import numpy as np
+import pytest
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+from dspark_synth import build, write_checkpoint  # noqa: E402
+
+from monolith.bench import profile_for_device  # noqa: E402
+from monolith.compiler import emit_program  # noqa: E402
+from monolith.compiler.passes import DEFAULT_PASSES  # noqa: E402
+from monolith.core import DType, Graph, T  # noqa: E402
+from monolith.formats import PackLayout  # noqa: E402
+from monolith.formats.fp import bf16_to_f32, f32_to_bf16  # noqa: E402
+from monolith.nn import set_kv_format  # noqa: E402
+from monolith.nn.pack_plan import load_oracle_weights, pack_model  # noqa: E402
+from monolith.packs import PackFile  # noqa: E402
+from monolith.runtime import Engine  # noqa: E402
+from monolith.runtime import _native as nt  # noqa: E402
+from monolith.spec import DraftContext  # noqa: E402
+from monolith.spec.dspark.weights import load_oracle  # noqa: E402
+
+
+def _bars(got, ref):
+    got, ref = np.asarray(got, np.float64).ravel(), np.asarray(ref, np.float64).ravel()
+    return float(got @ ref / (np.linalg.norm(got) * np.linalg.norm(ref) + 1e-30))
+
+
+def _bf16(buf, shape):
+    return bf16_to_f32(np.frombuffer(buf, dtype=np.uint16)).reshape(shape)
+
+
+def test_turbo_draft_program_matches_oracle(tmp_path):
+    torch = pytest.importorskip("torch")
+    dev = nt.Device()
+    info = dev.info()
+    prof = profile_for_device(info.gpu_cores, info.apple_family)
+    if prof is None or info.apple_family < 10:
+        pytest.skip("needs a chip profile with the matrix units")
+    write_checkpoint(tmp_path, head_dim=128, num_attention_heads=4, num_key_value_heads=1, block_size=7)
+    drafter, head, cfg, pair = build(tmp_path, max_context=4096)
+    assert set_kv_format(drafter, "turbo-int4") == cfg.num_hidden_layers
+    pack_model(pair, str(tmp_path), str(tmp_path / "pack"), PackLayout(rows=16, lane_order=prof.lane_order))
+    pf = PackFile(tmp_path / "pack")
+    load_oracle(drafter, str(tmp_path))
+    load_oracle_weights(head, str(tmp_path))
+    gamma, ht, hid = cfg.block_size, cfg.target_hidden, cfg.hidden_size
+    g = Graph("draft")
+    taps = [g.input(f"tap.{i}", (T, ht), DType.BF16) for i in range(cfg.n_taps)]
+    anchor = g.input("anchor", (1,), DType.I32)
+    block = drafter.lower_draft(g, DraftContext(taps, anchor))
+    drafter.lower_select(g, block, prof)
+    g.check()
+    for p in DEFAULT_PASSES:
+        p(g)
+    prog = emit_program(g, pack=pf, profile=prof, dynamic_t=True, tail=None, accelerator="on")
+    fns = {prog.kernels[o.kernel].function: prog.kernels[o.kernel].macros for o in prog.ops}
+    assert fns["gqa_decode_mma"].get("TURBO_INT4") == "1" and fns["gqa_decode_mma"].get("BOUNDED_CHUNK") == "1"
+    eng = Engine(prog, dev)
+    lay = prog.layout
+    st = eng.buffers[prog.step_state]
+    rng = np.random.default_rng(5)
+    state = {e.name: torch.zeros(e.shape, dtype=torch.uint8) for e in drafter.state_entries()}
+    # a quantized context of 2100 positions already cached: past 64 partitions of one 32-key tile, so every
+    # partition walks two tiles (pick_chunk's BOUNDED_CHUNK rule)
+    from monolith.nn import oracle
+    ctx_len = 2100
+    rot = oracle.turbo_rotation(cfg.head_dim)
+    for name, tensor in state.items():
+        x = torch.from_numpy(rng.normal(0, 0.5, (ctx_len, cfg.num_key_value_heads, cfg.head_dim)).astype(np.float32))
+        codes, scale = oracle.turbo_quantize(x @ rot.T)
+        tensor[:ctx_len] = oracle.turbo_pack(codes, scale)
+        eng.buffers[name].write(tensor[:ctx_len].numpy().tobytes(), 0)
+    initial = eng.state()
+    initial["drafter_ctx_len"] = ctx_len
+    st.write(lay.pack(initial), 0)
+    for step, (n_new, a0) in enumerate(((8, 17), (8, 42), (3, 11), (8, 27))):
+        tap_np = [f32_to_bf16((rng.standard_normal((lay.t_max, ht)) * 2).astype(np.float32)) for _ in range(cfg.n_taps)]
+        for i, arr in enumerate(tap_np):
+            eng.buffers[f"tap.{i}"].write(arr.tobytes(), 0)
+        s = lay.unpack(st.read(0, lay.size))
+        s.update(t_this_step=1, anchor=a0, n_inject=n_new, prefill_left=0)
+        st.write(lay.pack(s), 0)
+        r = eng.run(1, steps_per_cb=1, in_flight=1)
+        assert r.steps == 1 and not r.done
+        taps_t = torch.cat([torch.from_numpy(bf16_to_f32(arr[:n_new])).to(torch.bfloat16) for arr in tap_np], dim=1)
+        with torch.no_grad():
+            feats = drafter.project_features(taps_t)
+            hidden = drafter.draft_block(a0, feats, state, ctx_len=ctx_len)
+            base = head.forward(hidden)
+        assert _bars(_bf16(eng.read("draft.hidden"), (gamma, hid)), hidden.float().numpy()) > 0.999, ("block hidden", step)
+        assert _bars(_bf16(eng.read("draft.base_logits"), (gamma, cfg.vocab_size)), base.float().numpy()) > 0.999, ("base logits", step)
+        row = cfg.head_dim // 2 + 4
+        for name in ("draft.layers.0.self_attn.k_ctx", "draft.layers.0.self_attn.v_ctx"):
+            got = np.frombuffer(eng.read(name), dtype=np.uint8).reshape(drafter.max_context, cfg.num_key_value_heads, row)
+            ref = state[name].numpy()
+            n = ctx_len + n_new
+            codes_differ = np.mean(got[:n, :, :-4] != ref[:n, :, :-4])
+            assert codes_differ < 5e-3, (name, step, codes_differ)               # FP32 rotation order: rare boundary flips
+            assert not np.any(got[n:]), "speculative rows escaped into the persistent cache"
+        ctx_len += n_new
