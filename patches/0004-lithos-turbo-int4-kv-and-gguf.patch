+@pytest.mark.parametrize("cap", [3, 7])
+def test_bounded_partitions_match_single_tiles(dev, cap):
+    """The turbo matrix core with at most ``cap`` partitions per (kv head, row) — each a run of 32-key tiles merged by
+    an online softmax — against the same core with one tile per partition and against the v1 core: the same outputs to
+    the probabilities' BF16 rounding, the same cache rows."""
+    rng = np.random.default_rng(40 + cap)
+    qn, kn = _norms(rng, 256)
+    big = Cfg(24, 4, 256, 64, 1600, 8, mma=True)
+    small = Cfg(24, 4, 256, 64, 1600, 8, mma=True)
+    small.n_chunks_max = cap
+    v1 = Cfg(24, 4, 256, 64, 1600, 8)
+    hs = [TurboHarness(dev, c, qn, kn) for c in (big, small, v1)]
+    pos = 0
+    for t in [8] * 160 + [1, 5, 8]:
+        proj = _random_proj(rng, big, t)
+        outs = [h.step(proj, pos) for h in hs]
+        if pos % 160 == 0 or t != 8:
+            for o in outs[1:]:
+                assert _bars(o, outs[0])[0] > 0.9995, (pos, t, _bars(o, outs[0]))
+        pos += t
+    caches = [h.caches() for h in hs]
+    for c in caches[1:]:
+        assert all(np.array_equal(a, b) for a, b in zip(c, caches[0]))
