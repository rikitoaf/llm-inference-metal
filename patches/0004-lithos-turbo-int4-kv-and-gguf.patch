+@pytest.mark.parametrize("mma", [False, True], ids=["v1", "mma"])
+@pytest.mark.parametrize("d,rot", [(256, 64), (128, 32)])
+def test_turbo_accuracy_against_bf16_cache(dev, d, rot, mma):
+    """The same prompt through the BF16 and the turbo-int4 caches: the attention outputs stay close (the quantization
+    error of 16 levels after the rotation, ~0.1 relative per row, averages out over the keys)."""
+    cfg = Cfg(8, 2, d, rot, 2048, 8, mma=mma)
+    rng = np.random.default_rng(21)
+    qn, kn = _norms(rng, d)
+    ref, tur = Harness(dev, cfg, qn, kn), TurboHarness(dev, cfg, qn, kn)
+    pos, worst = 0, 1.0
+    for t in [8] * 128 + [1] * 8:
+        proj = _random_proj(rng, cfg, t)
+        a, b = ref.step(proj, pos), tur.step(proj, pos)
+        if pos >= 64:
+            worst = min(worst, _bars(b, a)[0])
+        pos += t
+    assert worst > 0.97, worst
