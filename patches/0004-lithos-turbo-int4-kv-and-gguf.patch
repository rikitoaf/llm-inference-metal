+class PreparedHarness(TurboHarness):
+    """gqa_turbo_prepare + gqa_turbo_mma_q (QP query rows per block) + gqa_merge."""
+
+    def __init__(self, dev, cfg, qn, kn, qp=64):
+        super().__init__(dev, cfg, qn, kn)
+        macros = dict(kernels.gqa_macros(cfg.d, chunk=cfg.chunk, rb_max=16), BOUNDED_CHUNK="1", QK_NORM="1",
+                      MMA_SG="8", TURBO_INT4="1", QP=str(qp))
+        lib = nt.Library(dev, kernels.gqa_source(mma=True, turbo=True), macros, kernels.MSL_TENSOR_OPS)
+        self.p_prep, self.p_core, self.p_merge = (nt.Pipeline(lib, f) for f in ("gqa_turbo_prepare", "gqa_turbo_mma_q", "gqa_merge"))
+        self.qp = qp
+        self.qprep = nt.Buffer(dev, cfg.kv * (-(-cfg.rows_max // qp) * qp) * cfg.d * 2)
+
+    def step(self, proj_bf16, position, t_active=None, dispatch_sg=None, state=None):
+        c = self.cfg
+        t = proj_bf16.shape[0]
+        n_tg = self.dev.info().gpu_cores * 4
+        params = kernels.gqa_params(heads=c.heads, kv_heads=c.kv, t_active=t, position=position, n_sg=n_tg, q_off=c.q_off,
+                                    gate_off=c.gate_off, k_off=c.k_off, v_off=c.v_off, in_stride=c.n1, out_stride=c.heads * c.d,
+                                    ctx_max=c.ctx_max, eps=1e-6, scaling=c.scaling, has_gate=c.gate, n_chunks_max=c.n_chunks_max,
+                                    rows_max=c.rows_max, nominal_sg=n_tg)
+        pb = nt.Buffer(self.dev, proj_bf16.tobytes())
+        out = nt.Buffer(self.dev, t * c.heads * c.d * 2)
+        bufs = lambda d: (d.buffer(0, pb).buffer(1, self.k_cache).buffer(2, self.v_cache).buffer(3, self.bufs["cos"]).buffer(4, self.bufs["sin"])
+                          .buffer(5, self.bufs["qn"]).buffer(6, self.bufs["kn"]).bytes(9, params).buffer(10, self.qprep))
+        d0 = bufs(nt.Dispatch().pipeline(self.p_prep)).grid(-(-(t * (c.heads + c.kv)) // 4)).threadgroup(128).barrier()
+        d1 = (bufs(nt.Dispatch().pipeline(self.p_core)).buffer(7, self.part_o).buffer(8, self.part_md)
+              .grid(n_tg).threadgroup(256).barrier())
+        d2 = (nt.Dispatch().pipeline(self.p_merge).buffer(0, self.part_o).buffer(1, self.part_md).buffer(2, pb).buffer(3, out)
+              .bytes(4, params).grid(t * c.heads).threadgroup(32))
+        r = nt.Queue(self.dev).run([d0, d1, d2])
+        assert not r.error, r.error
+        return bf16_to_f32(np.frombuffer(out.read(0, t * c.heads * c.d * 2), dtype=np.uint16).reshape(t, c.heads * c.d))
+
+
+@pytest.mark.parametrize("cap", [7, 64])
+def test_prepared_queries_match_the_staged_core(dev, cap):
+    """Queries prepared once and every key from the cache, 64 query rows per block, causal tiles skipped: the staged
+    core's outputs (to the probabilities' BF16 rounding) and its cache rows exactly."""
+    rng = np.random.default_rng(60 + cap)
+    qn, kn = _norms(rng, 256)
+    a, b = (Cfg(24, 4, 256, 64, 1600, 128, mma=True) for _ in range(2))
+    a.n_chunks_max = b.n_chunks_max = cap
+    ha, hb = TurboHarness(dev, a, qn, kn), PreparedHarness(dev, b, qn, kn)
+    pos = 0
+    for t in [128] * 10 + [8, 1, 5, 8, 128]:
+        proj = _random_proj(rng, a, t)
+        x, y = ha.step(proj, pos), hb.step(proj, pos)
+        assert _bars(y, x)[0] > 0.9995, (pos, t, _bars(y, x))
+        pos += t
+    for u, w in zip(ha.caches(), hb.caches()):
+        assert np.array_equal(u, w)
