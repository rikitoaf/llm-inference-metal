diff --git a/monolith/models/qwen3_5/gguf_adapter.py b/monolith/models/qwen3_5/gguf_adapter.py
new file mode 100644
index 0000000..66b96f5
--- /dev/null
+++ b/monolith/models/qwen3_5/gguf_adapter.py
@@ -0,0 +1,106 @@
+"""The ``qwen35`` GGUF architecture (llama.cpp's Qwen3.5 / Qwen3.6 / Qwen3.8 dense hybrids) read as this package's HF
+checkpoint (formats.gguf_checkpoint). llama.cpp's conversion (convert_hf_to_gguf.py: ``Qwen3NextModel.modify_tensors``,
+``_LinearAttentionVReorderBase``) is undone:
+
+* the zero-centered RMSNorms (input / post-attention / final, q / k) are stored as ``1 + w``: served as ``w``;
+* ``A_log`` is stored as ``ssm_a = −exp(A_log)``; ``dt_bias`` as ``ssm_dt.bias``; the conv taps squeezed to ``[C, K]``;
+* the linear-attention V heads are stored tiled instead of grouped by K head — rows of ``in_proj_qkv`` (its V part),
+  ``in_proj_z``, ``in_proj_a`` / ``b``, the entries of ``A_log`` / ``dt_bias``, the conv taps' V channels: put back in
+  grouped order (row selections: exact); ``out_proj``'s input columns: served with the column gather its kernel applies;
+* the full-attention layers keep the HF layouts (``attn_q`` holds the query and gate rows per head);
+* the MTP block (``blk.<n_layer>``) is ignored, as the package ignores ``mtp.*``.
+"""
+
+from __future__ import annotations
+
+from typing import Dict, List
+
+import numpy as np
+
+from ...formats.gguf_checkpoint import GGUFArch, Rule, field_value, register_gguf_arch, v_head_order
+from .weights import TEXT_PREFIX
+
+ARCH = "qwen35"
+
+
+def config(r) -> dict:
+    get = lambda k, d=None: field_value(r, f"{ARCH}.{k}", d)                     # noqa: E731
+    names = {t.name for t in r.tensors}
+    n_layer = int(get("block_count")) - int(get("nextn_predict_layers", 0) or 0)
+    head_dim = int(get("attention.key_length"))
+    n_v = int(get("ssm.time_step_rank"))
+    emb = next(t for t in r.tensors if t.name == "token_embd.weight")
+    text = {
+        "hidden_size": int(get("embedding_length")), "intermediate_size": int(get("feed_forward_length")),
+        "num_hidden_layers": n_layer, "num_attention_heads": int(get("attention.head_count")),
+        "num_key_value_heads": int(get("attention.head_count_kv")), "head_dim": head_dim,
+        "layer_types": ["full_attention" if f"blk.{i}.attn_q.weight" in names else "linear_attention" for i in range(n_layer)],
+        "linear_num_key_heads": int(get("ssm.group_count")), "linear_num_value_heads": n_v,
+        "linear_key_head_dim": int(get("ssm.state_size")), "linear_value_head_dim": int(get("ssm.inner_size")) // n_v,
+        "linear_conv_kernel_dim": int(get("ssm.conv_kernel")), "rms_norm_eps": float(get("attention.layer_norm_rms_epsilon")),
+        "vocab_size": int(emb.shape[1]), "max_position_embeddings": int(get("context_length")),
+        "attn_output_gate": True, "tie_word_embeddings": "output.weight" not in names, "hidden_act": "silu",
+        "eos_token_id": int(field_value(r, "tokenizer.ggml.eos_token_id")),
+        "rope_parameters": {"rope_type": "default", "rope_theta": float(get("rope.freq_base")),
+                            "partial_rotary_factor": int(get("rope.dimension_count")) / head_dim},
+        "model_type": "qwen3_5_text",
+    }
+    return {"architectures": ["Qwen3_5ForConditionalGeneration"], "model_type": "qwen3_5", "text_config": text,
+            "tie_word_embeddings": text["tie_word_embeddings"]}
+
+
+def rules(cfg: dict, names: List[str]) -> Dict[str, Rule]:
+    c = cfg["text_config"]
+    nk, nv, dk, dv = c["linear_num_key_heads"], c["linear_num_value_heads"], c["linear_key_head_dim"], c["linear_value_head_dim"]
+    qk = 2 * nk * dk
+    if nv != nk:
+        v_fwd, h_fwd = v_head_order(nk, nv // nk, dv), v_head_order(nk, nv // nk, 1)
+        v_inv, h_inv = np.argsort(v_fwd), np.argsort(h_fwd)
+    else:
+        v_fwd = h_fwd = v_inv = h_inv = None
+
+    def minus_one(x):
+        return (x - np.float32(1)).astype(np.float32)                            # stored 1 + w
+
+    def a_log(x):
+        x = np.log(-x).astype(np.float32)                                         # stored −exp(A_log)
+        return x[h_inv] if h_inv is not None else x
+
+    def heads(x):
+        return x[h_inv] if h_inv is not None else x
+
+    def conv(x):
+        x = x.reshape(x.shape[0], -1)                                             # [C, K]
+        return x if v_inv is None else np.concatenate([x[:qk], x[qk:][v_inv]])
+
+    out: Dict[str, Rule] = {"token_embd.weight": Rule(TEXT_PREFIX + "embed_tokens.weight"),
+                            "output.weight": Rule("lm_head.weight"),
+                            "output_norm.weight": Rule(TEXT_PREFIX + "norm.weight", "f32", value=minus_one)}
+    for i in range(c["num_hidden_layers"]):
+        lp, g = f"{TEXT_PREFIX}layers.{i}.", f"blk.{i}."
+        out[g + "attn_norm.weight"] = Rule(lp + "input_layernorm.weight", "f32", value=minus_one)
+        out[g + "post_attention_norm.weight"] = Rule(lp + "post_attention_layernorm.weight", "f32", value=minus_one)
+        for gg, hf in (("ffn_gate", "gate_proj"), ("ffn_up", "up_proj"), ("ffn_down", "down_proj")):
+            out[f"{g}{gg}.weight"] = Rule(f"{lp}mlp.{hf}.weight")
+        if c["layer_types"][i] == "full_attention":
+            for gg, hf in (("attn_q", "q_proj"), ("attn_k", "k_proj"), ("attn_v", "v_proj"), ("attn_output", "o_proj")):
+                out[f"{g}{gg}.weight"] = Rule(f"{lp}self_attn.{hf}.weight")
+            out[g + "attn_q_norm.weight"] = Rule(lp + "self_attn.q_norm.weight", "f32", value=minus_one)
+            out[g + "attn_k_norm.weight"] = Rule(lp + "self_attn.k_norm.weight", "f32", value=minus_one)
+            continue
+        la = lp + "linear_attn."
+        out[g + "attn_qkv.weight"] = Rule(la + "in_proj_qkv.weight",
+                                          rows=None if v_inv is None else np.concatenate([np.arange(qk), qk + v_inv]))
+        out[g + "attn_gate.weight"] = Rule(la + "in_proj_z.weight", rows=v_inv)
+        out[g + "ssm_alpha.weight"] = Rule(la + "in_proj_a.weight", rows=h_inv)
+        out[g + "ssm_beta.weight"] = Rule(la + "in_proj_b.weight", rows=h_inv)
+        out[g + "ssm_out.weight"] = Rule(la + "out_proj.weight", gather=v_fwd)
+        out[g + "ssm_conv1d.weight"] = Rule(la + "conv1d.weight", "bf16", value=conv, shape=(qk + nv * dv, 1, c["linear_conv_kernel_dim"]))
+        out[g + "ssm_a"] = Rule(la + "A_log", "f32", value=a_log)
+        out[g + "ssm_dt.bias"] = Rule(la + "dt_bias", "f32", value=heads)
+        out[g + "ssm_norm.weight"] = Rule(la + "norm.weight", "f32")
+    present = set(names)
+    return {g: r for g, r in out.items() if g in present}
+
+
+register_gguf_arch(ARCH, GGUFArch(config=config, rules=rules))
