+"""The attention with a turbo-int4 K/V cache (TURBO_INT4 = 1), v1 (gqa_decode) and the staged matrix core
+(gqa_decode_mma), each with gqa_merge: against the GQAAttention layer oracle in turbo-int4 mode (the same rotation,
+quantizer and packed rows), the two cores against each other, a T-row pass against its EXACT_SUB-row passes, repeat
+runs, and the accuracy against the BF16 cache on the same inputs."""
+
+import numpy as np
+import pytest
+
+from monolith import kernels
+from monolith.formats.fp import bf16_to_f32, f32_to_bf16
+from monolith.packs.transforms import rope_head_perm
+from monolith.runtime import _native as nt
+
+from .test_gqa_decode import EPS, THETA, Cfg, Harness, _bars, _norms, _random_proj, dev  # noqa: F401 (the fixture)
+
+
+class TurboHarness(Harness):
+    """The v1 core (or the matrix core, ``cfg.mma``) and the merge built with TURBO_INT4 = 1, and caches of
+    ``D / 2 + 4``-byte rows."""
+
+    def __init__(self, dev, cfg, qn, kn):
+        super().__init__(dev, cfg, qn, kn)
+        if cfg.mma:
+            macros = dict(kernels.gqa_macros(cfg.d, chunk=cfg.chunk, rb_max=16), BOUNDED_CHUNK="1", QK_NORM="1",
+                          MMA_SG=str(kernels.gqa_mma_simdgroups(cfg.d, cfg.rep)), TURBO_INT4="1")
+            lib = nt.Library(dev, kernels.gqa_source(mma=True, turbo=True), macros, kernels.MSL_TENSOR_OPS)
+            self.p_dec, self.p_merge = nt.Pipeline(lib, "gqa_decode_mma"), nt.Pipeline(lib, "gqa_merge")
+        else:
+            macros = dict(kernels.gqa_macros(cfg.d, chunk=cfg.chunk, rb_max=cfg.rb), QK_NORM="1", TURBO_INT4="1")
+            if getattr(cfg, "exact_sub", 0):
+                macros["EXACT_SUB"] = f"{cfg.exact_sub}u"
+            lib = nt.Library(dev, kernels.gqa_source(), macros, 0)
+            self.p_dec, self.p_merge = nt.Pipeline(lib, "gqa_decode"), nt.Pipeline(lib, "gqa_merge")
+        self.row = cfg.d // 2 + 4
+        self.cache_bytes = cfg.ctx_max * cfg.kv * self.row
+        self.k_cache, self.v_cache = nt.Buffer(dev, self.cache_bytes), nt.Buffer(dev, self.cache_bytes)
+        self.k_cache.fill(0)
+        self.v_cache.fill(0)
+
+    def set_rows(self, k, v):
+        self.k_cache.write(np.ascontiguousarray(k, dtype=np.uint8).tobytes(), 0)
+        self.v_cache.write(np.ascontiguousarray(v, dtype=np.uint8).tobytes(), 0)
+
+    def caches(self):
+        c, shape = self.cfg, (self.cfg.ctx_max, self.cfg.kv, self.row)
+        return (np.frombuffer(self.k_cache.read(0, self.cache_bytes), dtype=np.uint8).reshape(shape).copy(),
+                np.frombuffer(self.v_cache.read(0, self.cache_bytes), dtype=np.uint8).reshape(shape).copy())
+
+
+def _codes_and_scales(rows):
+    """Cache rows ``[..., D/2 + 4]`` → (codes ``[..., D]`` int, scales ``[...]`` FP32)."""
+    nib = rows[..., :-4].astype(np.int32)
+    codes = np.stack([nib & 0xF, nib >> 4], axis=-1).reshape(*rows.shape[:-1], -1)
+    return np.where(codes >= 8, codes - 16, codes), np.ascontiguousarray(rows[..., -4:]).view(np.float32)[..., 0]
+
+
+def _assert_rows_close(got, ref, n):
+    """The kernel's rows vs the oracle's: the FP32 rotation differs in summation order (butterflies vs a matmul), so a
+    value on a rounding boundary may take the neighbouring code; scales agree to FP32 noise."""
+    gc, gs = _codes_and_scales(got[:n])
+    rc, rs = _codes_and_scales(ref[:n])
+    assert np.abs(gc - rc).max() <= 1 and np.mean(gc != rc) < 2e-3, np.mean(gc != rc)
+    assert np.allclose(gs, rs, rtol=1e-3, atol=1e-7)
+
+
+def _turbo_layer(torch, heads, kv, d, rot, ctx_max, seed):
+    from monolith.nn import GQAAttention
+
+    rng = np.random.default_rng(seed)
+    mod = GQAAttention(64, heads, kv, d, rot, THETA, EPS, hf_prefix="x.", prefix="l.", max_context=ctx_max,
+                       kv_format="turbo-int4")
+    qn_w, kn_w = (rng.standard_normal(d) * 0.1).astype(np.float32), (rng.standard_normal(d) * 0.1).astype(np.float32)
+    mod.set_param("q_norm", torch.from_numpy(qn_w).to(torch.bfloat16))
+    mod.set_param("k_norm", torch.from_numpy(kn_w).to(torch.bfloat16))
+    perm = rope_head_perm(d, rot)
+    qn_p, kn_p = (1.0 + bf16_to_f32(f32_to_bf16(qn_w)))[perm], (1.0 + bf16_to_f32(f32_to_bf16(kn_w)))[perm]
+    return mod, rng, qn_p, kn_p
+
+
+@pytest.mark.parametrize("mma", [False, True], ids=["v1", "mma"])
+@pytest.mark.parametrize("heads,kv,d,rot,ctx_max", [(8, 2, 256, 64, 512), (24, 4, 256, 64, 512), (4, 1, 128, 32, 256)],
+                         ids=["d256_rep4", "qwen3.8_heads", "d128"])
+def test_turbo_matches_layer_oracle(dev, heads, kv, d, rot, ctx_max, mma):
+    """The turbo-int4 GQAAttention.mix (torch) vs the kernel: prefill and decode steps over a growing cache; the
+    outputs to the composite bar (the matrix core rounds its staged tiles and probabilities to BF16) and the cached
+    rows code for code."""
+    torch = pytest.importorskip("torch")
+    mod, rng, qn_p, kn_p = _turbo_layer(torch, heads, kv, d, rot, ctx_max, heads * 7 + d)
+    cfg = Cfg(heads, kv, d, rot, ctx_max, 8, mma=mma)
+    h = TurboHarness(dev, cfg, qn_p, kn_p)
+    state = {e.name: torch.zeros(e.shape, dtype=torch.uint8) for e in mod.state_entries()}
+    assert state["l.k_cache"].dtype == torch.uint8 and tuple(state["l.k_cache"].shape) == (ctx_max, kv, d // 2 + 4)
+    col_perm = mod.qkv.row_perm
+    pos = 0
+    for t in (8, 8, 7, 1, 3, 1, 1, 8):
+        proj_hf = torch.from_numpy(rng.standard_normal((t, cfg.n1)).astype(np.float32)).to(torch.bfloat16)
+        with torch.no_grad():
+            ref = mod.mix(proj_hf, state, pos).float().numpy()
+        got = h.step(f32_to_bf16(proj_hf.float().numpy()[:, col_perm]), pos)
+        cos, max_abs, scale = _bars(got, ref)
+        assert cos > (0.9995 if mma else 0.9999) and max_abs <= 4e-2 * scale, (t, pos, cos, max_abs, scale)
+        kc, vc = h.caches()
+        _assert_rows_close(kc, state["l.k_cache"].numpy(), pos + t)
+        _assert_rows_close(vc, state["l.v_cache"].numpy(), pos + t)
+        pos += t
+
+
+def test_turbo_mma_core_equals_v1_caches(dev):
+    """Both cores append the same rows (the quantizer runs on the same normed, RoPE'd vectors) and agree on the
+    outputs to the BF16 rounding of the matrix core's tiles."""
+    cfg, mcfg = Cfg(24, 4, 256, 64, 1024, 8), Cfg(24, 4, 256, 64, 1024, 8, mma=True)
+    rng = np.random.default_rng(31)
+    qn, kn = _norms(rng, 256)
+    a, b = TurboHarness(dev, cfg, qn, kn), TurboHarness(dev, mcfg, qn, kn)
+    pos = 0
+    for t in [8] * 40 + [1, 3, 8]:
+        proj = _random_proj(rng, cfg, t)
+        x, y = a.step(proj, pos), b.step(proj, pos)
+        assert _bars(y, x)[0] > 0.999, (pos, _bars(y, x))
+        pos += t
+    for u, w in zip(a.caches(), b.caches()):
+        assert np.array_equal(u, w)
+
+
+def test_turbo_repeat_runs_are_bit_identical(dev):
+    cfg = Cfg(8, 2, 256, 64, 256, 4)
+    rng = np.random.default_rng(5)
+    h = TurboHarness(dev, cfg, *_norms(rng, cfg.d))
+    proj = _random_proj(rng, cfg, 4)
+    a, ca = h.step(proj, 0), h.caches()
+    h.k_cache.fill(0)
+    h.v_cache.fill(0)
+    b, cb = h.step(proj, 0), h.caches()
+    assert np.array_equal(a, b) and all(np.array_equal(x, y) for x, y in zip(ca, cb))
+    h.k_cache.fill(0)
+    h.v_cache.fill(0)
+    c = h.step(proj, 0, t_active=2)
+    assert np.array_equal(c[:2], a[:2]) and np.all(c[2:] == 0)
+    kc, _ = h.caches()
+    assert np.all(kc[2:] == 0)                                             # only t_active positions appended
+
+
+def test_turbo_exact_sub_reproduces_shorter_passes(dev):
+    """One T-row pass equals its EXACT_SUB-row passes bit for bit, outputs and caches: the step's own keys and values
+    enter the attention as the dequantized codes a later pass reads back."""
+    cfg = Cfg(heads=8, kv=2, d=256, rot=64, ctx_max=1024, t_max=256)
+    ecfg = Cfg(heads=8, kv=2, d=256, rot=64, ctx_max=1024, t_max=256)
+    ecfg.exact_sub = 64
+    rng = np.random.default_rng(13)
+    qn, kn = _norms(rng, cfg.d)
+    sub, whole = TurboHarness(dev, cfg, qn, kn), TurboHarness(dev, ecfg, qn, kn)
+    sub.n_sg = whole.n_sg = 48
+    position, t = 600, 256
+    pre = _random_proj(rng, cfg, 200)
+    for s0 in range(0, position, 200):                                     # a quantized history from the kernel itself
+        sub.step(pre, s0)
+    k, v = sub.caches()
+    proj = _random_proj(rng, cfg, t)
+    ref = np.concatenate([sub.step(proj[s0:s0 + 64], position + s0) for s0 in range(0, t, 64)])
+    whole.set_rows(k, v)
+    got = whole.step(proj, position)
+    assert np.array_equal(got, ref)
+    for a, b in zip(whole.caches(), sub.caches()):
+        assert np.array_equal(a, b)
+
