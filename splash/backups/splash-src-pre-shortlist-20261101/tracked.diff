+// The chain a lane without a tree carries (SplashDraftTree).
+inline void draft_tree_chain(device SplashDraftTree &tree) {
+  for (uint r = 0; r < SPLASH_TARGET_VERIFY_ROWS; ++r) {
+    tree.parent[r] = r == 0 ? 0xffffffffu : r - 1;
+    tree.depth[r] = r;
+    tree.ancestors[r] = (2u << r) - 1u;
+    tree.path[r] = r;
+  }
+}
+
+// After draft_select_dflash, one thread per lane. A tree lane (params.tree_mask) replaces DFlash's chain with the
+// seven most probable nodes of its proposal tree, chosen best first (DDTree): a node's probability is its parent's
+// times the softmax, over the parent's 16 children, of their scores at the node's position (unary + the edge from
+// the parent's candidate, the scores draft_select_dflash walks). Each step takes the most probable child not yet
+// taken of any node above the last position, so a parent's row is always below its children's. Writes the rows'
+// tokens (ProposedTokens, read by the verify input), the tree, and the rows' RoPE positions (the anchor's plus the
+// depth). Its proposals are deterministic, so a sampled tree lane's q is zero: the target's draws at its rows are
+// plain draws, and decode_accept_tree takes the child that equals a row's draw, which samples the target exactly.
+// Other lanes get the chain's tree and keep everything draft_select_dflash wrote.
+kernel void draft_select_tree(
+    device const uint *candidates [[buffer(0)]],
+    device const float *unary [[buffer(1)]],
+    device const float *partial_values [[buffer(2)]],
+    device uint *tokens [[buffer(3)]], device float *q_probs [[buffer(4)]],
+    device SplashDraftTree *trees [[buffer(5)]],
+    device uint *positions [[buffer(6)]],
+    constant SelectorBatchParams &params [[buffer(7)]],
+    uint batch [[thread_position_in_grid]]) {
+  constexpr uint Rows = SPLASH_TARGET_VERIFY_ROWS;
+  constexpr uint Positions = SPLASH_DRAFT_PROPOSAL_TOKENS;
+  constexpr uint Shards = SPLASH_DRAFT_SAMPLING_SHARDS;
+  constexpr uint Candidates = SPLASH_DRAFT_CANDIDATES;
+  if (batch >= params.lanes)
+    return;
+  device SplashDraftTree &tree = trees[batch];
+  if ((params.tree_mask & (1u << batch)) == 0) {
+    draft_tree_chain(tree);
+    return;
+  }
+  candidates += batch * Positions * Candidates;
+  unary += batch * Positions * Candidates;
+  device const float *tables = partial_values +
+                               params.lanes * Positions * Shards * Candidates +
+                               batch * Positions * Candidates * Candidates;
+  tokens += batch * (Rows - 1);
+  q_probs += batch * Positions * Candidates;
+  positions += batch * Rows * 3;
+
+  // The score of child j of a node whose candidate is `from`, at position `position`.
+  const auto score = [&](uint position, uint from, uint j) {
+    return unary[position * Candidates + j] +
+           tables[(position * Candidates + from) * Candidates + j];
+  };
+  const auto log_normalizer = [&](uint position, uint from) {
+    float maximum = -INFINITY;
+    for (uint j = 0; j < Candidates; ++j)
+      maximum = max(maximum, score(position, from, j));
+    float sum = 0.0f;
+    for (uint j = 0; j < Candidates; ++j)
+      sum += exp(score(position, from, j) - maximum);
+    return maximum + log(sum);
+  };
+  uint candidate[Rows], depth[Rows], parent[Rows], ancestors[Rows], taken[Rows];
+  float log_probability[Rows], normalizer[Rows];
+  candidate[0] = 0;   // the anchor: draft_select_dflash's predecessor of position 0
+  depth[0] = 0;
+  parent[0] = 0xffffffffu;
+  ancestors[0] = 1u;
+  taken[0] = 0;
+  log_probability[0] = 0.0f;
+  normalizer[0] = log_normalizer(0, 0);
+  for (uint r = 1; r < Rows; ++r) {
+    float best = -INFINITY;
+    uint best_node = 0, best_child = 0;
+    for (uint n = 0; n < r; ++n) {
+      if (depth[n] >= Positions)
+        continue;
+      for (uint j = 0; j < Candidates; ++j) {
+        if (taken[n] & (1u << j))
+          continue;
+        const float value = log_probability[n] + score(depth[n], candidate[n], j) - normalizer[n];
+        if (value > best) {
+          best = value;
+          best_node = n;
+          best_child = j;
+        }
+      }
+    }
+    taken[best_node] |= 1u << best_child;
+    candidate[r] = best_child;
+    depth[r] = depth[best_node] + 1;
+    parent[r] = best_node;
+    ancestors[r] = ancestors[best_node] | (1u << r);
+    taken[r] = 0;
+    log_probability[r] = best;
+    normalizer[r] = depth[r] < Positions ? log_normalizer(depth[r], best_child) : 0.0f;
+    tokens[r - 1] = candidates[depth[best_node] * Candidates + best_child];
+  }
+  for (uint r = 0; r < Rows; ++r) {
+    tree.parent[r] = parent[r];
+    tree.depth[r] = depth[r];
+    tree.ancestors[r] = ancestors[r];
+    tree.path[r] = r;
+    for (uint axis = 0; axis < 3; ++axis)
+      positions[r * 3 + axis] = positions[axis] + depth[r];
+  }
+  for (uint i = 0; i < Positions * Candidates; ++i)
+    q_probs[i] = 0.0f;
+}
