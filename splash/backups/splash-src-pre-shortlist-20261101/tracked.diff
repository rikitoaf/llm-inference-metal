+// One KV head's slab of a TurboQuant int4 page: 32 token rows of 128 bytes
+// for keys and for values, and their scales.
+struct SplashTurboInt4PageTensors {
+  device uchar *keys;
+  device uchar *values;
+  device float *key_scales;
+  device float *value_scales;
+};
