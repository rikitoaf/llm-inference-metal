+template <uint KVHeads> struct SplashTurboInt4Addressing {
+  using Bytes = SplashTurboInt4PageBytes<KVHeads>;
+  uint layer_offset;
+  uint head;
+  ulong key_scales_offset;
+  ulong values_offset;
+  ulong value_scales_offset;
