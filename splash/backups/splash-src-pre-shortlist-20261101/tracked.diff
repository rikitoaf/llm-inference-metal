+// After acceptance, a lane with a draft tree stores the accepted path again in depth order: row d of the kept rows
+// (d < retained) gets its node's staged K/V row, path[d] (SplashDraftTree), at slot committed + d, quantized as the
+// verify store quantizes it. Rows already in place, the anchor and the rows past the kept ones are left alone, so a
+// chain does nothing. The staged rows are linear in the token: a key row moves by the head dimension per token, a
+// value row by one.
+template <uint KVHeads, typename CacheElement>
+inline void splash_restore_verify_phase(
+    device const bfloat *chunk_keys, device const bfloat *chunk_values,
+    device const SplashKvPage *page_table0, device const SplashKvPage *page_table1,
+    device const SplashKvPage *page_table2, device const SplashKvPage *page_table3,
+    constant SplashChunkedPrefillParams *params, device const SplashDraftTree *trees,
+    device const uint *retained, threadgroup float *maxima, uint group, uint thread_index,
+    uint simd_lane, uint simd_group) {
+  constexpr uint Rows = SPLASH_TARGET_VERIFY_ROWS;
+  constexpr uint GroupsPerLane = 2 * Rows * KVHeads;
+  const uint batch = group / GroupsPerLane;
+  const uint local_group = group % GroupsPerLane;
+  const uint rows = Rows * KVHeads;
+  const uint row = local_group >= rows ? local_group - rows : local_group;
+  const uint depth = row % Rows;
+  const uint source = trees[batch].path[depth];
+  if (depth == 0 || depth >= retained[batch] || source == depth)
+    return;
+  const uint shift = source - depth;
+  splash_store_verify_phase<KVHeads, CacheElement>(
+      chunk_keys + ulong(shift) * SplashKvHeadDimension, chunk_values + shift,
+      page_table0, page_table1, page_table2, page_table3, params, maxima, group,
+      thread_index, simd_lane, simd_group);
+}
