index 0000000..f741c9a
--- /dev/null
+++ b/dev/tests/engine/test_default_temperature.py
@@ -0,0 +1,43 @@
+import math
+import unittest
+
+from dev.tests import test_server as fixtures
+
+
+class DefaultTemperatureTests(unittest.TestCase):
+    def harness(self, temperature=None):
+        runtime = fixtures.FakeRuntime()
+        harness = fixtures.Harness(runtime, default_temperature=temperature)
+        self.addCleanup(harness.close)
+        return harness, runtime
+
+    def sampled(self, harness, runtime, path="/v1/chat/completions", **fields):
+        runtime.requests.clear()
+        body = {"model": "test-model", "messages": [{"role": "user", "content": "hello"}]}
+        if path == "/v1/responses":
+            body = {"model": "test-model", "input": "hello"}
+        body.update(fields)
+        status, _, payload = harness.request("POST", path, body)
+        self.assertEqual(status, 200, payload)
+        return runtime.requests[0].frame.sampling.temperature
+
+    def test_default_applies_only_when_the_request_sets_no_temperature(self):
+        for default in (None, 0.0, 0.6, 1.0):
+            harness, runtime = self.harness(default)
+            for path in ("/v1/chat/completions", "/v1/responses"):
+                with self.subTest(default=default, path=path):
+                    expected = 1.0 if default is None else default
+                    self.assertTrue(math.isclose(self.sampled(harness, runtime, path), expected, abs_tol=1e-6))
+                    self.assertEqual(self.sampled(harness, runtime, path, temperature=0), 0.0)
+                    self.assertTrue(
+                        math.isclose(self.sampled(harness, runtime, path, temperature=0.3), 0.3, abs_tol=1e-6)
+                    )
+
+    def test_an_invalid_default_is_refused(self):
+        for bad in (-0.1, 2.5, float("nan"), "0.6"):
+            with self.subTest(bad=bad), self.assertRaises(ValueError):
+                fixtures.Harness(fixtures.FakeRuntime(), default_temperature=bad)
+
+
+if __name__ == "__main__":
+    unittest.main()
