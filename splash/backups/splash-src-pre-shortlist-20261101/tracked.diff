+// Moves a lane's accepted path rows (SplashDraftTree::path) to rows 0..retained - 1 of a [lane][row][width] bf16
+// tensor, in place: path[d] >= d and grows with d, so row path[d] is read before anything above row d - 1 is
+// written. Grid {width / 256 rounded up, lanes}, 256 threads.
+kernel void gather_path_rows_bf16(
+    device ushort *rows [[buffer(0)]],
+    device const SplashDraftTree *trees [[buffer(1)]],
+    device const uint *retained [[buffer(2)]],
+    constant uint &width [[buffer(3)]],
+    uint2 group [[threadgroup_position_in_grid]],
+    uint thread_index [[thread_index_in_threadgroup]]) {
+  const uint column = group.x * 256 + thread_index;
+  const uint batch = group.y;
+  if (column >= width)
+    return;
+  device ushort *lane_rows = rows + ulong(batch) * SPLASH_TARGET_VERIFY_ROWS * width;
+  device const SplashDraftTree &tree = trees[batch];
+  for (uint d = 1; d < retained[batch]; ++d) {
+    const uint source = tree.path[d];
+    if (source != d)
+      lane_rows[ulong(d) * width + column] = lane_rows[ulong(source) * width + column];
+  }
+}
