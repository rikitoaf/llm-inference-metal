+    return {PrefillRegion::LayerScratch, 1};
+  case PrefillTensor::GateIntermediate:
+  case PrefillTensor::Intermediate:
+    return {PrefillRegion::LayerScratch, 2};
+  case PrefillTensor::GdnOutput:
+    return {PrefillRegion::MixerOutput, 0};
+  case PrefillTensor::AttentionOutput:
+    return {PrefillRegion::MixerOutput, 1};
+  default:
