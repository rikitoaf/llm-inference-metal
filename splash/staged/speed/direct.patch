+// The direct decode tile (GGUF_DECODE_DIRECT): one simdgroup's 32 columns over steps [step_begin, step_end) of K in
+// 32-input steps, each lane dequantizing straight into matmul2d's right input cooperative tensor, so the weights never
+// pass through threadgroup memory and no barrier separates the dequantization from the matmul. In that operand
+// (32 inputs x 32 columns, probed with splash/tools/coop) lane L holds chunk c = (L & 1) | ((L >> 3) & 1) << 1 of
+// columns base + 8j, base = ((L >> 1) & 3) + 4 ((L >> 4) & 1), j = 0..3: element 4j + t is input 4c + t and element
+// 16 + 4j + t input 16 + 4c + t. Every weight is the half dequant32 stages, so the sums are the staged tile's.
+template <class F, ushort Rows, class Acc>
+inline void direct_accumulate(device bfloat *input, device uchar *w0, device uchar *w1, device uchar *meta, uint input_size,
+                              uint output_origin, threadgroup half2 *tl, uint lane, uint step_begin, uint step_end, thread Acc &acc) {
+  constexpr ushort Cols = 32, KS = 32;
+  auto a = tensor(input, dextents<int, 2>{int(input_size), Rows}, array<int, 2>{1, int(input_size)});
+  constexpr auto descriptor = matmul2d_descriptor(Rows, Cols, KS, false, true, false, matmul2d_descriptor::mode::multiply_accumulate);
+  matmul2d<descriptor, execution_simdgroups<1>> operation;
+  auto b = operation.template get_right_input_cooperative_tensor<bfloat, half, float>();
+  const uint groups = input_size / 32;
+  const uint plane_tile = output_origin / QUANT_TILE_ROWS, plane_row = output_origin % QUANT_TILE_ROWS;
+  const uint units = groups / F::MetaGroups;
+  device uchar *tw0 = w0 + (ulong(plane_tile) * groups * QUANT_TILE_ROWS + plane_row) * F::P0;
+  device uchar *tw1 = w1 + (ulong(plane_tile) * groups * QUANT_TILE_ROWS + plane_row) * F::P1;
+  device uchar *tmeta = meta + (ulong(plane_tile) * units * QUANT_TILE_ROWS + plane_row) * F::MetaBytes;
+  const ushort c = ushort((lane & 1) | (((lane >> 3) & 1) << 1));
+  const uint base = ((lane >> 1) & 3) + 4 * ((lane >> 4) & 1);
+  typename F::Payload packed[4]; typename F::Meta hdr[4];
+  uint hdr_unit = step_begin / F::MetaGroups;
+#pragma unroll
+  for (ushort j = 0; j < 4; ++j) {
+    const uint col = base + 8 * j;
+    if (step_begin < step_end) packed[j] = F::load(tw0 + (ulong(step_begin) * QUANT_TILE_ROWS + col) * F::P0, tw1 + (ulong(step_begin) * QUANT_TILE_ROWS + col) * F::P1);
+    hdr[j] = F::loadMeta(tmeta + (ulong(hdr_unit) * QUANT_TILE_ROWS + col) * F::MetaBytes);
+  }
+  for (uint step = step_begin; step < step_end; ++step) {
+    const uint unit = step / F::MetaGroups; const ushort jg = step % F::MetaGroups;
+    if (unit != hdr_unit) {
+#pragma unroll
+      for (ushort j = 0; j < 4; ++j) hdr[j] = F::loadMeta(tmeta + (ulong(unit) * QUANT_TILE_ROWS + base + 8 * j) * F::MetaBytes);
+      hdr_unit = unit;
+    }
+    typename F::Payload next[4];
+    if (step + 1 < step_end) {
+#pragma unroll
+      for (ushort j = 0; j < 4; ++j) {
+        const uint col = base + 8 * j;
+        next[j] = F::load(tw0 + (ulong(step + 1) * QUANT_TILE_ROWS + col) * F::P0, tw1 + (ulong(step + 1) * QUANT_TILE_ROWS + col) * F::P1);
+      }
+    }
+#pragma unroll
+    for (ushort j = 0; j < 4; ++j) {
+      QuantCoef k;
+      if constexpr (F::ScaleInChunk) k = F::coef(hdr[j], F::chunk(packed[j], 0)); else k = F::coef(hdr[j], jg);
+      half4 lo, hi;
+      dequant_chunk<F>(packed[j], k, c, tl, lo, hi);
+#pragma unroll
+      for (ushort t = 0; t < 4; ++t) { b[4 * j + t] = lo[t]; b[16 + 4 * j + t] = hi[t]; }
+    }
+    auto a_slice = a.template slice<KS, Rows>(step * KS, 0);
+    operation.run(a_slice, b, acc);
+    if (step + 1 < step_end) {
+#pragma unroll
+      for (ushort j = 0; j < 4; ++j) packed[j] = next[j];
+    }
+  }
+}
+
+#ifndef GGUF_DECODE_DIRECT
+#define GGUF_DECODE_DIRECT 1
+#endif
