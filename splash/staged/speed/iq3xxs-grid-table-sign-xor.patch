 // Fills the threadgroup table of format F's value pairs, as half2 (staged tiles) or bfloat2 (register tiles), entry
 // b = (F::value(b & 15), F::value(b >> 4)) for the index byte b of a pair, when F is a codebook format; called by all
 // threads of the threadgroup.
+// The entries a kernel specialised for format F declares for its table: the codebook formats' value pairs, and
+// IQ3_XXS's 256 grid words (quant_pair_table); one, unused, for the other formats.
+template <class F>
+constexpr uint quant_table_entries() {
+  return F::Kind == QuantCodebook || F::Id == GGUF_FMT_IQ3XXS ? kQuantPairTableEntries : 1;
+}
+
 template <class F, class T>
 inline void quant_pair_table(threadgroup T *table, uint thread_index, uint threads) {
   if constexpr (F::Kind == QuantCodebook) {
     for (uint i = thread_index; i < kQuantPairTableEntries; i += threads) table[i] = T(float2(F::value(i & 15), F::value(i >> 4)));
     threadgroup_barrier(mem_flags::mem_threadgroup);
+  } else if constexpr (F::Id == GGUF_FMT_IQ3XXS) {
+    // IQ3_XXS's 256 grid words fill the table's 1 KB: lanes look them up with divergent indices, which threadgroup
+    // memory serves faster than the constant address space.
+    static_assert(sizeof(T) == 4, "the IQ3_XXS grid is 256 words");
+    threadgroup uint *grid = reinterpret_cast<threadgroup uint *>(table);
+    for (uint i = thread_index; i < kQuantPairTableEntries; i += threads) grid[i] = kIQ3XXSGrid[i];
+    threadgroup_barrier(mem_flags::mem_threadgroup);
   }
 }
 
